    <Item class="ModuleScript" referent="6">
      <Properties>
        <string name="Name">CombatRules</string>
        <string name="Source"><![CDATA[local Config=require(game:GetService("ReplicatedStorage").Shared.Config)
local Rules={}
function Rules.CanCast(session,sound,now)
 return sound~=nil and sound.level<=session.data.level and now>=session.protectedUntil and now>=session.dodgingUntil and now>=session.nextCast and now>=(session.knockedUntil or 0)
end
function Rules.CanTarget(attackerPosition,targetPosition,targetProtectedUntil,now,radius)
 return Config.InArena(attackerPosition) and Config.InArena(targetPosition) and now>=targetProtectedUntil and (targetPosition-attackerPosition).Magnitude<=radius
end
function Rules.InBeam(origin,direction,target,length,width,targetRadius)
 local delta=target-origin;local along=delta:Dot(direction)
 if along<0 or along>length then return false end
 return (delta-direction*along).Magnitude<=width/2+(targetRadius or 0)
end
function Rules.VehicleSweep(previous,nextFrame,target,halfSize)
 local a=previous:PointToObjectSpace(target);local b=nextFrame:PointToObjectSpace(target)
 local delta=b-a;local enter,leave=0,1
 for _,axis in ipairs({"X","Y","Z"}) do
  local origin,speed,extent=a[axis],delta[axis],halfSize[axis]
  if math.abs(speed)<.00001 then if math.abs(origin)>extent then return false end
  else
   local near,far=(-extent-origin)/speed,(extent-origin)/speed
   if near>far then near,far=far,near end
   enter=math.max(enter,near);leave=math.min(leave,far);if enter>leave then return false end
  end
 end
 return true
end
return Rules
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="7">
      <Properties>
        <string name="Name">DeveloperAccess</string>
        <string name="Source"><![CDATA[local Access = {}

-- This is the account that owns the published Scream Simulator experience.
-- The client only receives a visibility flag; every cheat is checked again on the server.
Access.PublicTestingEnabled = true
Access.OwnerUserId = 11499795799

function Access.IsAuthorized(player, creatorType, creatorId)
    return (Access.PublicTestingEnabled and player ~= nil) or (player ~= nil
        and player.UserId == Access.OwnerUserId
        and creatorType == Enum.CreatorType.User
        and creatorId == Access.OwnerUserId)
end

return Access
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="8">
      <Properties>
        <string name="Name">Profiles</string>
        <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local Profiles = {}
local store
local storeReady, storeResult = pcall(function()
    return DataStoreService:GetDataStore("ScreamSimulator_v1")
end)
if storeReady then
    store = storeResult
else
    warn("ScreamSimulator save data unavailable; using temporary test profiles.")
end

local function wholeNumber(value, fallback, minimum, maximum)
    if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
        return fallback
    end
    return math.clamp(math.floor(value), minimum, maximum)
end

function Profiles.Default()
    return {coins=0,level=1,xp=0,sound="TinyAah",aura="Gold",quests={},settings={volume=0.55,reducedShake=false}}
end
function Profiles.Sanitize(raw)
    local data=Profiles.Default()
    if type(raw)~="table" then return data end
    data.coins=wholeNumber(raw.coins,0,0,1000000000)
    data.level=wholeNumber(raw.level,1,1,Config.MaxLevel)
    data.xp=wholeNumber(raw.xp,0,0,Config.XPToNext(data.level)-1)
    local sound=Config.GetSound(raw.sound)
    if sound and sound.level<=data.level then data.sound=sound.id end
    if type(raw.aura)=="string" and Config.Auras[raw.aura] then data.aura=raw.aura end
    if type(raw.quests)=="table" then
        for _,q in ipairs(Config.Quests) do
            local old=raw.quests[q.id]
            if type(old)=="table" then data.quests[q.id]={progress=wholeNumber(old.progress,0,0,q.goal),claimed=old.claimed==true} end
        end
    end
    if type(raw.settings)=="table" then
        local v=raw.settings.volume
        if type(v)=="number" and v==v then data.settings.volume=math.clamp(v,0,1) end
        data.settings.reducedShake=raw.settings.reducedShake==true
    end
    -- Legacy shield and purchased-track fields are deliberately discarded.
    return data
end

function Profiles.Load(userId)
    if not store then
        return Profiles.Default(), false
    end
    local key = "Player_" .. userId
    for attempt = 1, 3 do
        local success, result = pcall(function()
            return store:GetAsync(key)
        end)
        if success then
            return Profiles.Sanitize(result), true
        end
        warn("ScreamSimulator profile load failed", userId, attempt, result)
        task.wait(attempt)
    end
    -- Keep an in-memory profile, but never overwrite stored data after a failed load.
    return Profiles.Default(), false
end

function Profiles.Save(userId, data)
    if not store then
        return false
    end
    local snapshot = Profiles.Sanitize(data)
    local key = "Player_" .. userId
    for attempt = 1, 3 do
        local success, err = pcall(function()
            store:UpdateAsync(key, function()
                return snapshot
            end)
        end)
        if success then
            return true
        end
        warn("ScreamSimulator profile save failed", userId, attempt, err)
        task.wait(attempt)
    end
    return false
end

return Profiles
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="9">
      <Properties>
        <string name="Name">World</string>
        <string name="Source"><![CDATA[local Config = require(game:GetService("ReplicatedStorage").Shared.Config)
local RunService = game:GetService("RunService")
local PathfindingService = game:GetService("PathfindingService")

local World = {}
World.ZoneMin = Config.ZoneMin
World.ZoneMax = Config.ZoneMax
World.SafeSpawn = CFrame.new(-600, 4, 210)
World.Cars = {}
local PhysicsService=game:GetService("PhysicsService")
local City=require(script.Parent.City)
World.Bots = {}
World.WalkPoints = {}
World.ActivityPoints = {}

local rng = Random.new(8044)
local C = {
    road = Color3.fromRGB(43, 48, 54), concrete = Color3.fromRGB(184, 183, 171),
    gold = Color3.fromRGB(247, 192, 59), glass = Color3.fromRGB(76, 139, 159),
    dark = Color3.fromRGB(30, 50, 52), green = Color3.fromRGB(60, 126, 79),
}

local function part(parent, name, size, cf, color, material, solid)
    local p = Instance.new("Part")
    p.Name, p.Size = name, size
    p.CFrame = typeof(cf) == "CFrame" and cf or CFrame.new(cf)
    p.Anchored = true
    p.Color = color
    p.Material = material or Enum.Material.SmoothPlastic
    p.CanCollide = solid ~= false
    p.CanQuery = solid ~= false
    p.Parent = parent
    return p
end

local function billboard(parent, words, offset, width)
    local gui = Instance.new("BillboardGui")
    gui.Name = "Label"
    gui.Size = UDim2.fromOffset(math.min(width or 150, 180), 30)
    gui.StudsOffsetWorldSpace = offset
    gui.AlwaysOnTop = false
    gui.MaxDistance = 24
    gui.Parent = parent
    local text = Instance.new("TextLabel")
    text.Size = UDim2.fromScale(1, 1)
    text.BackgroundColor3 = C.dark
    text.BackgroundTransparency = 0.12
    text.TextColor3 = Color3.fromRGB(255, 247, 218)
    text.Font = Enum.Font.GothamBold
    text.TextSize = 12
    text.TextWrapped = true
    text.Text = words
    text.Parent = gui
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = text
    return text
end

local function vehicle(parent, kind, paint)
    local model = Instance.new("Model")
    model.Name = kind .. "Car"
    model.Parent = parent
    local body = part(model, "PaintedBody", Vector3.new(12, 1.8, 5.7), CFrame.new(), paint, Enum.Material.SmoothPlastic, false)
    model.PrimaryPart = body
    local hull=part(model,"CollisionHull",Vector3.new(12.6,4.2,6.2),CFrame.new(0,.55,0),paint,Enum.Material.SmoothPlastic,true)
    hull.Transparency=1;hull.CanTouch=true
    hull.CustomPhysicalProperties=PhysicalProperties.new(1,.35,0)
    model:SetAttribute("Vehicle",true)
    part(model, "LowerChassis", Vector3.new(12.5, 0.65, 5.9), CFrame.new(0, -0.85, 0),
        Color3.fromRGB(37, 43, 47), Enum.Material.Metal, false)
    part(model, "Hood", Vector3.new(3.1, 0.45, 5.35), CFrame.new(4.3, 1.03, 0), paint, Enum.Material.SmoothPlastic, false)
    part(model, "Trunk", Vector3.new(2.3, 0.35, 5.35), CFrame.new(-4.65, 1, 0), paint, Enum.Material.SmoothPlastic, false)
    part(model, "Cabin", Vector3.new(5.8, 1.8, 4.9), CFrame.new(-0.2, 1.8, 0),
        Color3.fromRGB(47, 72, 78), Enum.Material.Metal, false)
    part(model, "CabinRoof", Vector3.new(5.4, 0.25, 4.8), CFrame.new(-0.2, 2.78, 0), paint, Enum.Material.SmoothPlastic, false)
    for _, side in ipairs({-1, 1}) do
        local z = side * 2.52
        for _, x in ipairs({-1.45, 1.05}) do
            part(model, "SideGlass", Vector3.new(2, 1.25, 0.12), CFrame.new(x, 1.85, z),
                Color3.fromRGB(95, 150, 169), Enum.Material.Glass, false)
        end
        for _, x in ipairs({-4.2, 0.2}) do
            part(model, "DoorHandle", Vector3.new(0.85, 0.13, 0.15), CFrame.new(x, 0.38, side * 2.93),
                Color3.fromRGB(210, 218, 216), Enum.Material.Metal, false)
        end
        part(model, "SideMirror", Vector3.new(0.7, 0.35, 0.7), CFrame.new(2.65, 1.25, side * 3),
            Color3.fromRGB(42, 50, 54), Enum.Material.Metal, false)
        for _, x in ipairs({-3.85, 3.85}) do
            local tire = part(model, "RubberTire", Vector3.new(0.8, 2.1, 2.1),
                CFrame.new(x, -1.05, side * 2.83) * CFrame.Angles(0, math.pi / 2, 0),
                Color3.fromRGB(26, 29, 32), Enum.Material.Rubber, false)
            tire.Shape = Enum.PartType.Cylinder
            local hub = part(model, "WheelHub", Vector3.new(0.84, 1.05, 1.05),
                CFrame.new(x, -1.05, side * 3.27) * CFrame.Angles(0, math.pi / 2, 0),
                Color3.fromRGB(156, 165, 163), Enum.Material.Metal, false)
            hub.Shape = Enum.PartType.Cylinder
        end
        part(model, "Headlight", Vector3.new(0.2, 0.55, 1.1), CFrame.new(6.08, 0.3, side * 1.7),
            Color3.fromRGB(255, 239, 194), Enum.Material.Neon, false)
        part(model, "Taillight", Vector3.new(0.2, 0.58, 1.1), CFrame.new(-6.08, 0.3, side * 1.7),
            Color3.fromRGB(197, 58, 54), Enum.Material.Neon, false)
    end
    part(model, "Windshield", Vector3.new(0.18, 1.62, 4.55),
        CFrame.new(2.78, 1.8, 0) * CFrame.Angles(0, 0, math.rad(-23)),
        Color3.fromRGB(106, 162, 177), Enum.Material.Glass, false)
    part(model, "RearGlass", Vector3.new(0.18, 1.55, 4.55),
        CFrame.new(-3.15, 1.78, 0) * CFrame.Angles(0, 0, math.rad(22)),
        Color3.fromRGB(86, 139, 158), Enum.Material.Glass, false)
    part(model, "FrontGrille", Vector3.new(0.2, 0.65, 3), CFrame.new(6.12, -0.28, 0),
        Color3.fromRGB(45, 54, 59), Enum.Material.Metal, false)
    for _, x in ipairs({-6.2, 6.2}) do
        part(model, "Bumper", Vector3.new(0.35, 0.35, 5.75), CFrame.new(x, -0.75, 0),
            Color3.fromRGB(65, 73, 74), Enum.Material.Metal, false)
    end
    if kind == "Taxi" then
        part(model, "TaxiRoofSign", Vector3.new(2.8, 0.8, 1.35), CFrame.new(-0.2, 3.36, 0),
            Color3.fromRGB(252, 227, 161), Enum.Material.Neon, false)
        part(model, "TaxiChecker", Vector3.new(8, 0.25, 0.12), CFrame.new(0, -0.12, -2.94),
            Color3.fromRGB(44, 50, 52), Enum.Material.Metal, false)
    elseif kind == "Delivery" then
        part(model, "CargoRoof", Vector3.new(5.8, 0.7, 4.8), CFrame.new(-0.4, 3.17, 0),
            Color3.fromRGB(214, 212, 198), Enum.Material.Metal, false)
    end
    return model
end

local function taxi(parent, x, z, kind, paint)
    local car = vehicle(parent, kind or "Taxi", paint or Color3.fromRGB(244, 184, 42))
    car:PivotTo(CFrame.new(x, 2, z))
end

local names = {
    "Alex", "Jordan", "Sam", "Casey", "Taylor", "Riley", "Morgan", "Jamie", "Avery", "Cameron",
    "Drew", "Robin", "Parker", "Quinn", "Sky", "Hayden", "Blake", "Rowan", "Nico", "Ari",
    "Ellis", "Remy", "Sage", "Kit", "Milo", "Lena", "Zoe", "Noor", "Owen", "Jules",
    "Kai", "Maya", "Theo", "Ada", "Rafi", "Indie", "Marin", "Leo", "Nia", "Finn",
    "Uma", "Ezra", "Luca", "Iris", "Mira", "Dani", "June", "Sol", "Tess", "Jae", "Bea",
}
local lines = {"That was loud!", "Can you hear me?", "This city is wild!", "Nice scream!", "Watch out for the War Zone!", "I need some quiet.", "Whoa, my ears!", "You leveled up yet?"}
local roleLines = {
    Busker = {"One more song before the train!", "The market's got rhythm today.", "Toss me a request!"},
    Commuter = {"The next train is always late.", "I know a shortcut through the square.", "Coffee first, then the commute."},
    Tourist = {"That plaza is incredible!", "Where's the best snack cart?", "I keep finding new corners."},
    Local = {"I grew up on this block.", "The pier is my quiet spot.", "Meet me by the market later."},
    Fighter = {"The War Zone is getting loud.", "Time your dodge when you see a scream coming.", "I heard a knockout from the plaza."},
    Vendor = {"Fresh snacks on the corner!", "Busy day at the market.", "Try the stall across the street."},
}
local skinColors = {
    Color3.fromRGB(244, 204, 164), Color3.fromRGB(204, 149, 107), Color3.fromRGB(130, 88, 63),
    Color3.fromRGB(238, 184, 135), Color3.fromRGB(89, 59, 46), Color3.fromRGB(174, 118, 83),
    Color3.fromRGB(229, 172, 125), Color3.fromRGB(108, 72, 53),
}
local shirtColors = {
    Color3.fromRGB(63, 120, 173), Color3.fromRGB(192, 83, 79), Color3.fromRGB(77, 145, 105),
    Color3.fromRGB(169, 117, 65), Color3.fromRGB(117, 88, 150), Color3.fromRGB(56, 91, 114),
    Color3.fromRGB(203, 159, 96), Color3.fromRGB(65, 121, 124), Color3.fromRGB(170, 105, 141),
}
local pantsColors = {
    Color3.fromRGB(49, 58, 70), Color3.fromRGB(77, 64, 58), Color3.fromRGB(46, 68, 93),
    Color3.fromRGB(107, 102, 88), Color3.fromRGB(43, 49, 56), Color3.fromRGB(98, 76, 68),
}
local hairColors = {
    Color3.fromRGB(42, 33, 29), Color3.fromRGB(94, 58, 37), Color3.fromRGB(174, 128, 73),
    Color3.fromRGB(55, 61, 65), Color3.fromRGB(105, 74, 58), Color3.fromRGB(184, 164, 129),
}

local function rigPart(model, name, size, cf, color, collide)
    local p = Instance.new("Part")
    p.Name, p.Size, p.CFrame = name, size, cf
    p.Color = color
    p.CanCollide = collide == true
    p.CanQuery = false
    p.CanTouch = false
    p.CollisionGroup="Residents"
    p.Massless=name~="HumanoidRootPart"
    p.Parent = model
    return p
end

local function joint(parent, name, p0, p1, c0, c1)
    local m = Instance.new("Motor6D")
    m.Name, m.Part0, m.Part1, m.C0, m.C1 = name, p0, p1, c0, c1
    m.Parent = parent
    return m
end

local function accessory(model, attachedTo, name, size, offset, color, material, shape)
    local p = rigPart(model, name, size, attachedTo.CFrame * offset, color, false)
    p.Material = material or Enum.Material.SmoothPlastic
    p.Massless = true
    if shape then p.Shape = shape end
    local weld = Instance.new("WeldConstraint")
    weld.Part0, weld.Part1, weld.Parent = attachedTo, p, p
    return p
end

local function faceToward(bot, position)
    if not bot.alive or not bot.model.Parent then return end
    local flat = Vector3.new(position.X, bot.root.Position.Y, position.Z)
    if (flat - bot.root.Position).Magnitude > 0.4 then
        bot.root.CFrame = CFrame.lookAt(bot.root.Position, flat)
    end
end

function World.Speak(bot, message)
    if not bot.model.Parent or not bot.alive then return end
    bot.speech.Text = message
    bot.speech.Visible = true
    bot.speechToken = (bot.speechToken or 0) + 1
    local token = bot.speechToken
    task.delay(3.5, function()
        if bot.speechToken == token and bot.speech.Parent then bot.speech.Visible = false end
    end)
end

function World.Talk(bot, player)
    if player and player.Character then
        local root = player.Character:FindFirstChild("HumanoidRootPart")
        if root then faceToward(bot, root.Position) end
        bot.gestureUntil = os.clock() + 2.2
        bot.socialUntil = os.clock() + 5
    end
    local options = roleLines[bot.role] or lines
    local message = options[rng:NextInteger(1, #options)]
    World.Speak(bot, message)
    return message
end

local function chooseDestination(bot)
    local candidates = {}
    local useActivity = rng:NextNumber() < 0.47
    local source = useActivity and World.ActivityPoints or World.WalkPoints
    for _, entry in ipairs(source) do
        local point = useActivity and entry.position or entry
        local homeDistance = (point - bot.start).Magnitude
        local currentDistance = (point - bot.root.Position).Magnitude
        if homeDistance < bot.roamRadius and currentDistance > 14 and currentDistance < 145
            and (not bot.lastDestination or (point - bot.lastDestination).Magnitude > 18) then
            table.insert(candidates, {position = point, kind = useActivity and entry.kind or "Stroll"})
        end
    end
    if #candidates == 0 then return bot.start, "Stroll" end
    local chosen = candidates[rng:NextInteger(1, #candidates)]
    bot.lastDestination = chosen.position
    return chosen.position, chosen.kind
end

local function roamTo(bot, destination)
    local path = PathfindingService:CreatePath({AgentRadius=2, AgentHeight=5, AgentCanJump=false, AgentCanClimb=false, WaypointSpacing=5})
    local ok = pcall(function() path:ComputeAsync(bot.root.Position, destination) end)
    if not ok or path.Status ~= Enum.PathStatus.Success then task.wait(0.3); return end
    local blocked = false
    local connection = path.Blocked:Connect(function() blocked = true end)
    for _, waypoint in ipairs(path:GetWaypoints()) do
        if blocked or not bot.alive or not bot.model.Parent or (bot.reactionUntil or 0) > os.clock() then break end
        if waypoint.Action == Enum.PathWaypointAction.Jump then break end
        bot.humanoid:MoveTo(waypoint.Position)
        local started, lastProgress, previous = os.clock(), os.clock(), bot.root.Position
        while (Vector3.new(waypoint.Position.X,bot.root.Position.Y,waypoint.Position.Z)-bot.root.Position).Magnitude > 2.8 do
            if not bot.alive or blocked or (bot.reactionUntil or 0) > os.clock() or os.clock()-started > 4 then break end
            if (bot.root.Position-previous).Magnitude > 0.7 then previous = bot.root.Position; lastProgress = os.clock() end
            if os.clock()-lastProgress > 0.8 then bot.humanoid:MoveTo(bot.root.Position); blocked=true; break end
            task.wait(0.06)
        end
    end
    connection:Disconnect()
end

local function socialize(bot)
    if (bot.socialUntil or 0) > os.clock() then return false end
    local friends = {}
    for _, other in ipairs(World.Bots) do
        if other ~= bot and other.alive and (other.socialUntil or 0) < os.clock()
            and (other.root.Position - bot.root.Position).Magnitude < 22 then
            table.insert(friends, other)
        end
    end
    if #friends == 0 then return false end
    local friend = friends[rng:NextInteger(1, #friends)]
    bot.socialUntil, friend.socialUntil = os.clock() + 8, os.clock() + 8
    bot.gestureUntil, friend.gestureUntil = os.clock() + 3, os.clock() + 3
    faceToward(bot, friend.root.Position)
    faceToward(friend, bot.root.Position)
    World.Speak(bot, roleLines[bot.role][rng:NextInteger(1, #roleLines[bot.role])])
    task.delay(1.8, function()
        if friend.alive and friend.model.Parent then
            World.Speak(friend, roleLines[friend.role][rng:NextInteger(1, #roleLines[friend.role])])
        end
    end)
    return true
end

local function noticePlayers(bot)
    if (bot.lastGreeting or 0) + 14 > os.clock() then return end
    for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if root and (root.Position - bot.root.Position).Magnitude < 16 then
            bot.lastGreeting = os.clock()
            bot.gestureUntil = os.clock() + 1.5
            faceToward(bot, root.Position)
            World.Speak(bot, ({"Hey there!", "Nice to see you around!", "What a day in the city!"})[rng:NextInteger(1, 3)])
            return
        end
    end
end

function World.ReactToScream(bot, origin)
    bot.reactionUntil = os.clock() + 2.3
    bot.gestureUntil = bot.reactionUntil
    local delta = bot.root.Position - origin
    local away = Vector3.new(delta.X,0,delta.Z)
    if away.Magnitude > 0.5 then
        bot.humanoid:MoveTo(bot.root.Position + away.Unit * 8)
    end
    World.Speak(bot, ({"Whoa, my ears!", "That echoed down the block!", "Careful with that scream!"})[rng:NextInteger(1, 3)])
end

local function makeBot(parent, index, x, z, role)
    local displayName = names[(index - 1) % #names + 1] .. (index > #names and " " .. ({"Park", "Reed", "Chen", "Rivera", "Brooks", "Shah"})[(index-1)%6+1] or "")
    local model = Instance.new("Model")
    model.Name = displayName .. "_TrainingNPC"
    model.Parent = parent
    model:SetAttribute("NpcId", "Bot" .. index)
    model:SetAttribute("DisplayName", displayName)
    model:SetAttribute("Role", role)
    local avatarRng = Random.new(8044 + index * 479)
    local cf = CFrame.new(x, 3.9, z)
    local skin = skinColors[avatarRng:NextInteger(1, #skinColors)]
    local shirt = shirtColors[avatarRng:NextInteger(1, #shirtColors)]
    local pants = pantsColors[avatarRng:NextInteger(1, #pantsColors)]
    local hairColor = hairColors[avatarRng:NextInteger(1, #hairColors)]
    local outfit = avatarRng:NextInteger(1, 5)
    model:SetAttribute("OutfitVariant", outfit)
    local root = rigPart(model, "HumanoidRootPart", Vector3.new(2, 2, 1), cf, Color3.new(1, 1, 1), false)
    root.Transparency = 1
    root.CanCollide = false
    local torso = rigPart(model, "Torso", Vector3.new(2, 2, 1), cf, shirt, true)
    local head = rigPart(model, "Head", Vector3.new(2, 1, 1), cf * CFrame.new(0, 1.5, 0), skin, false)
    local headMesh = Instance.new("SpecialMesh")
    headMesh.MeshType = Enum.MeshType.Head
    headMesh.Scale = Vector3.new(1.08, 1.08, 1.08)
    headMesh.Parent = head
    local la = rigPart(model, "Left Arm", Vector3.new(1, 2, 1), cf * CFrame.new(-1.5, 0, 0), skin, false)
    local ra = rigPart(model, "Right Arm", Vector3.new(1, 2, 1), cf * CFrame.new(1.5, 0, 0), skin, false)
    local ll = rigPart(model, "Left Leg", Vector3.new(1, 2, 1), cf * CFrame.new(-0.5, -2, 0), pants, false)
    local rl = rigPart(model, "Right Leg", Vector3.new(1, 2, 1), cf * CFrame.new(0.5, -2, 0), pants, false)
    joint(torso, "RootJoint", root, torso, CFrame.new(), CFrame.new())
    joint(torso, "Neck", torso, head, CFrame.new(0, 1, 0), CFrame.new(0, -0.5, 0))
    local ls = joint(torso, "Left Shoulder", torso, la, CFrame.new(-1, 0.5, 0), CFrame.new(0.5, 0.5, 0))
    local rs = joint(torso, "Right Shoulder", torso, ra, CFrame.new(1, 0.5, 0), CFrame.new(-0.5, 0.5, 0))
    local lh = joint(torso, "Left Hip", torso, ll, CFrame.new(-0.5, -1, 0), CFrame.new(0, 1, 0))
    local rh = joint(torso, "Right Hip", torso, rl, CFrame.new(0.5, -1, 0), CFrame.new(0, 1, 0))
    local face = Instance.new("Decal")
    face.Name, face.Texture, face.Face = "face", "rbxasset://textures/face.png", Enum.NormalId.Front
    face.Parent = head
    accessory(model, la, "LeftSleeve", Vector3.new(1.03, 0.9, 1.03), CFrame.new(0, 0.58, 0), shirt)
    accessory(model, ra, "RightSleeve", Vector3.new(1.03, 0.9, 1.03), CFrame.new(0, 0.58, 0), shirt)
    local shoeColor = avatarRng:NextNumber() < 0.5 and Color3.fromRGB(38, 42, 47) or Color3.fromRGB(230, 224, 209)
    accessory(model, ll, "LeftShoe", Vector3.new(1.05, 0.43, 1.22), CFrame.new(0, -0.78, -0.1), shoeColor)
    accessory(model, rl, "RightShoe", Vector3.new(1.05, 0.43, 1.22), CFrame.new(0, -0.78, -0.1), shoeColor)
    if outfit == 1 then
        accessory(model, head, "Beanie", Vector3.new(2.2, 0.6, 1.25), CFrame.new(0, 0.66, 0), hairColor, Enum.Material.Fabric)
        accessory(model, head, "BeanieBand", Vector3.new(2.24, 0.22, 1.3), CFrame.new(0, 0.34, 0), shirt, Enum.Material.Fabric)
    elseif outfit == 2 then
        accessory(model, head, "Cap", Vector3.new(2.15, 0.48, 1.2), CFrame.new(0, 0.66, 0), shirt, Enum.Material.Fabric)
        accessory(model, head, "CapBrim", Vector3.new(1.7, 0.13, 1.0), CFrame.new(0, 0.49, -0.85), shirt, Enum.Material.Fabric)
    elseif outfit == 3 then
        accessory(model, head, "Hair", Vector3.new(2.14, 0.5, 1.18), CFrame.new(0, 0.62, 0), hairColor)
        for _, dx in ipairs({-0.65, 0, 0.65}) do
            accessory(model, head, "CurlyHair", Vector3.new(0.78, 0.65, 0.8), CFrame.new(dx, 0.82, -0.21), hairColor, nil, Enum.PartType.Ball)
        end
    elseif outfit == 4 then
        accessory(model, head, "Hair", Vector3.new(2.17, 0.62, 1.27), CFrame.new(0, 0.66, 0), hairColor)
        for _, dx in ipairs({-1.07, 1.07}) do
            accessory(model, head, "HeadphoneEar", Vector3.new(0.35, 0.8, 0.7), CFrame.new(dx, 0.05, 0), C.dark)
        end
        accessory(model, head, "HeadphoneBand", Vector3.new(2.3, 0.18, 0.5), CFrame.new(0, 1.0, 0), C.dark)
    else
        accessory(model, head, "Hair", Vector3.new(2.16, 0.42, 1.2), CFrame.new(0, 0.61, 0), hairColor)
        accessory(model, torso, "Jacket", Vector3.new(2.12, 1.65, 0.18), CFrame.new(0, 0.05, -0.58),
            Color3.fromRGB(52, 67, 70), Enum.Material.Fabric)
    end
    if avatarRng:NextNumber() < 0.42 then
        for _, dx in ipairs({-0.47, 0.47}) do
            accessory(model, head, "GlassesLens", Vector3.new(0.68, 0.32, 0.1),
                CFrame.new(dx, 0.08, -0.58), Color3.fromRGB(58, 87, 93), Enum.Material.Glass)
        end
        accessory(model, head, "GlassesBridge", Vector3.new(0.28, 0.08, 0.14),
            CFrame.new(0, 0.09, -0.62), C.dark, Enum.Material.Metal)
    end
    if role == "Vendor" then
        accessory(model, torso, "VendorApron", Vector3.new(1.65, 1.4, 0.14),
            CFrame.new(0, -0.32, -0.61), Color3.fromRGB(222, 215, 188), Enum.Material.Fabric)
    elseif role == "Tourist" then
        accessory(model, torso, "Backpack", Vector3.new(1.4, 1.5, 0.55),
            CFrame.new(0, 0.05, 0.75), Color3.fromRGB(102, 74, 89), Enum.Material.Fabric)
    elseif role == "Fighter" then
        accessory(model, ra, "FighterArmband", Vector3.new(1.08, 0.3, 1.08),
            CFrame.new(0, 0.38, 0), C.gold, Enum.Material.Fabric)
    elseif role == "Commuter" then
        accessory(model, torso, "CrossbodyBag", Vector3.new(1.25, 0.9, 0.35),
            CFrame.new(0.4, -0.5, -0.72), Color3.fromRGB(86, 61, 47), Enum.Material.Fabric)
    end
    local humanoid = Instance.new("Humanoid")
    humanoid.RigType = Enum.HumanoidRigType.R6
    humanoid.HipHeight=0;humanoid.AutoJumpEnabled=false;humanoid.JumpPower=0;humanoid.JumpHeight=0
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping,false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing,false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown,false)
    humanoid.MaxHealth, humanoid.Health = Config.BotMaxHealth, Config.BotMaxHealth
    humanoid.WalkSpeed = avatarRng:NextInteger(7, 11)
    humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    humanoid.Parent = model
    model.PrimaryPart = root
    if RunService:IsRunning() then root:SetNetworkOwner(nil) end
    local nameLabel = billboard(head, displayName .. "  " .. Config.BotMaxHealth .. "/" .. Config.BotMaxHealth, Vector3.new(0, 2.5, 0))
    local speech = billboard(head, "", Vector3.new(0, 4.4, 0), 185)
    nameLabel.Parent.MaxDistance = 18
    speech.Parent.MaxDistance = 24
    speech.Visible = false
    speech.BackgroundColor3 = Color3.fromRGB(244, 237, 211)
    speech.TextColor3 = C.dark
    local bot = {id = "Bot" .. index, name = displayName, role = role, model = model, root = root, humanoid = humanoid,
        health = Config.BotMaxHealth, alive = true, label = nameLabel, speech = speech,
        start = Vector3.new(x, 3.9, z), lastGrounded=Vector3.new(x,3.9,z), roamRadius = role == "Commuter" and 200 or 125,
        joints = {ls, rs, lh, rh}, lastGreeting = -1000}
    for _, limb in ipairs(bot.joints) do limb:SetAttribute("RestPose", limb.C0) end
    table.insert(World.Bots, bot)
    if RunService:IsRunning() then
        task.spawn(function()
            task.wait(index * 0.08)
            while model.Parent do
                if bot.alive then
                    if (bot.reactionUntil or 0) > os.clock() then
                        task.wait(0.5)
                    else
                        local choice = rng:NextNumber()
                        if choice < 0.23 then
                            bot.gestureUntil = os.clock() + rng:NextNumber(1.5, 3.5)
                            if role == "Busker" or role == "Vendor" or rng:NextNumber() < 0.45 then
                                World.Talk(bot)
                            end
                            task.wait(rng:NextNumber(2.5, 5.5))
                        elseif choice < 0.45 and socialize(bot) then
                            task.wait(rng:NextNumber(2.5, 4.5))
                        else
                            local destination, kind = chooseDestination(bot)
                            roamTo(bot, destination)
                            if bot.alive and (destination - bot.root.Position).Magnitude < 13 then
                                if kind == "Browse" or kind == "Watch" or kind == "Rest" then
                                    bot.gestureUntil = os.clock() + 2.5
                                    task.wait(rng:NextNumber(2, 4))
                                elseif rng:NextNumber() < 0.3 then
                                    task.wait(rng:NextNumber(0.7, 2))
                                end
                            end
                        end
                    end
                else task.wait(0.5) end
            end
        end)
        task.spawn(function()
            task.wait(3 + index % 9)
            while model.Parent do
                if bot.alive then noticePlayers(bot) end
                task.wait(2.5 + index % 4)
            end
        end)
    end
end

local function atmosphere()
    local lighting = game:GetService("Lighting")
    lighting.ClockTime = 16.5
    lighting.Brightness = 3
    lighting.EnvironmentDiffuseScale = 0.65
    lighting.EnvironmentSpecularScale = 0.65
    lighting.GlobalShadows = true
    lighting.ShadowSoftness = 0.35
    local grade = lighting:FindFirstChild("CityGrade") or Instance.new("ColorCorrectionEffect")
    grade.Name = "CityGrade"
    grade.Contrast = 0.08
    grade.Saturation = 0.08
    grade.TintColor = Color3.fromRGB(255, 248, 237)
    grade.Parent = lighting
    local haze = lighting:FindFirstChild("CityHaze")
    if not haze then
        haze = Instance.new("Atmosphere")
        haze.Name = "CityHaze"
        haze.Parent = lighting
    end
    haze.Density = 0.17
    haze.Haze = 0.3
    haze.Color = Color3.fromRGB(235, 210, 181)
end


function World.IsInWarZone(position) return Config.InArena(position) end

local function carAt(car,distance)
    local x=-690+distance*car.direction
    if car.direction<0 then x=690-distance end
    return CFrame.new(x,2.05,car.lane)*CFrame.Angles(0,car.direction>0 and 0 or math.pi,0)
end
function World.Build()
    local old=workspace:FindFirstChild("ScreamSimulatorWorld");if old then old:Destroy() end
    table.clear(World.Bots);table.clear(World.Cars)
    pcall(function() PhysicsService:RegisterCollisionGroup("Residents") end)
    PhysicsService:CollisionGroupSetCollidable("Residents","Residents",false)
    atmosphere()
    local parent=Instance.new("Model");parent.Name="ScreamSimulatorWorld";parent.Parent=workspace
    local layout=City.Build(parent);World.WalkPoints=layout.walk;World.ActivityPoints=layout.activities;World.SafeSpawn=layout.spawn
    local spawn=Instance.new("SpawnLocation");spawn.Name="SafeSpawn";spawn.Size=Vector3.new(7,.2,7);spawn.CFrame=World.SafeSpawn-Vector3.new(0,3,0);spawn.Anchored=true;spawn.Neutral=true;spawn.Duration=0;spawn.Transparency=1;spawn.CanCollide=false;spawn.Parent=parent
    local roles={"Local","Tourist","Vendor","Commuter","Busker","Fighter"}
    -- Cluster residents at destinations; leave roads and building interiors clear.
    local seeds={{-625,205},{-575,205},{-600,185},{-610,265},{-360,180},{-360,260},{-120,-32},{-145,15},{-92,15},{85,-71},{155,-71},{85,7},{155,7},{-240,403},{0,403},{200,403},{420,403},{-540,403}}
    for i=1,24 do local point=layout.walk[((i-1)*29+5)%#layout.walk+1];table.insert(seeds,{point.X,point.Z}) end
    for i,spot in ipairs(seeds) do makeBot(parent,i,spot[1],spot[2],roles[(i-1)%#roles+1]) end
    for i,spec in ipairs({{-368,1,23},{-352,-1,21},{112,1,20},{128,-1,24},{352,1,18},{368,-1,22}}) do
        local m=vehicle(parent,i%2==0 and "Sedan" or "Taxi",i%2==0 and Color3.fromRGB(65+i*15,104,115) or Color3.fromRGB(226,177,64));m.Name="TrafficCar"..i
        local car={model=m,hull=m.CollisionHull,lane=spec[1],direction=spec[2],speed=spec[3],distance=(i-1)*210};m:PivotTo(carAt(car,car.distance));table.insert(World.Cars,car)
    end
    for i,pos in ipairs({{-490,-110},{490,105},{-490,130},{690,120}}) do taxi(parent,pos[1],pos[2],"Sedan",Color3.fromRGB(91+i*22,93,99)) end
    if RunService:IsRunning() then
        task.spawn(function()
            local grounding=0
            while parent.Parent do
                local dt=RunService.Heartbeat:Wait();local now=os.clock();grounding+=dt
                for _,car in ipairs(World.Cars) do
                    local previous=car.model:GetPivot();local travel=math.min(dt,.1)*car.speed;car.distance+=travel
                    local wrapped=car.distance>1380;if wrapped then car.distance-=1380 end
                    local nextFrame=carAt(car,car.distance)
                    if not wrapped and World.OnVehicleSweep then World.OnVehicleSweep(car,previous,nextFrame) end
                    car.model:PivotTo(nextFrame)
                    car.model:SetAttribute("Speed",car.speed)
                end
                for _,bot in ipairs(World.Bots) do
                    if not bot.alive or not bot.root.Parent then continue end
                    local velocity=bot.root.AssemblyLinearVelocity;local speed=Vector3.new(velocity.X,0,velocity.Z).Magnitude
                    local moving=speed>.4 and bot.humanoid.FloorMaterial~=Enum.Material.Air
                    local swing=moving and math.sin(now*math.max(6,speed*1.2)+tonumber(bot.id:sub(4)))*.42 or 0
                    for i,j in ipairs(bot.joints) do
                        local angle=(i==1 or i==4) and swing or -swing
                        if not moving and (bot.gestureUntil or 0)>now and i==1 then angle=-.8+math.sin(now*5)*.15 end
                        j.C0=j:GetAttribute("RestPose")*CFrame.Angles(angle,0,0)
                    end
                    if grounding>=.25 then
                        local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
                        local exclude={};for _,b in ipairs(World.Bots) do table.insert(exclude,b.model) end
                        for _,player in ipairs(game.Players:GetPlayers()) do if player.Character then table.insert(exclude,player.Character) end end
                        params.FilterDescendantsInstances=exclude;params.RespectCanCollide=true
                        local hit=workspace:Raycast(bot.root.Position+Vector3.new(0,2,0),Vector3.new(0,-20,0),params)
                        local gap=hit and bot.root.Position.Y-hit.Position.Y or 99
                        if gap>5 or gap<1.5 or bot.root.Position.Y>8 or bot.root.Position.Y< -3 then
                            bot.airSince=bot.airSince or now
                            if now-bot.airSince>.45 then
                                bot.model:PivotTo(CFrame.new(bot.lastGrounded or bot.start));bot.root.AssemblyLinearVelocity=Vector3.zero;bot.root.AssemblyAngularVelocity=Vector3.zero;bot.humanoid:MoveTo(bot.root.Position);bot.airSince=nil
                            end
                        else bot.airSince=nil;bot.lastGrounded=bot.root.Position end
                    end
                end
                if grounding>=.25 then grounding=0 end
            end
        end)
    end
    return parent
end
function World.UpdateBot(bot)
    bot.label.Text=bot.alive and (bot.name.."  "..bot.health.."/"..Config.BotMaxHealth) or "RECOVERING"
    if bot.alive then
        bot.humanoid.Health=bot.health
        if bot.health==Config.BotMaxHealth then
            bot.root.Anchored=false;bot.model:PivotTo(CFrame.new(bot.start));bot.root.AssemblyLinearVelocity=Vector3.zero;bot.root:SetNetworkOwner(nil)
        end
    else
        bot.humanoid:MoveTo(bot.root.Position);bot.root.Anchored=true;bot.model:PivotTo(CFrame.new(bot.start-Vector3.new(0,100,0)));bot.speech.Visible=false
    end
end
return World
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="10">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterCharacterScripts" referent="11">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="Script" referent="12">
        <Properties>
          <string name="Name">Health</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- This script intentionally replaces Roblox's default Health regeneration script.
-- Scream Simulator handles its 10-second, 20-health healing rule on the server.
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="13">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="14">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local UIS=game:GetService("UserInputService")
local Run=game:GetService("RunService")
local Tween=game:GetService("TweenService")
local Debris=game:GetService("Debris")
local p=Players.LocalPlayer
local Config=require(RS:WaitForChild("Shared"):WaitForChild("Config"))
local remotes=RS:WaitForChild("ScreamRemotes")
local action=remotes:WaitForChild("Action")
local gui=Instance.new("ScreenGui");gui.Name="ScreamUI";gui.ResetOnSpawn=false;gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling;gui.Parent=p:WaitForChild("PlayerGui")
local dark=Color3.fromRGB(19,32,40);local panel=Color3.fromRGB(29,47,55);local gold=Color3.fromRGB(255,205,111);local white=Color3.fromRGB(239,244,240);local muted=Color3.fromRGB(165,188,193)
local data={level=1,xp=0,xpNext=103,coins=0,health=100,sound="TinyAah",aura="Gold",quests={},settings={volume=.55,reducedShake=false}}
local function frame(parent,name,size,pos,color)
 local f=Instance.new("Frame");f.Name=name;f.Size=size;f.Position=pos;f.BackgroundColor3=color or dark;f.BorderSizePixel=0;f.Parent=parent
 local c=Instance.new("UICorner");c.CornerRadius=UDim.new(0,10);c.Parent=f;return f
end
local function label(parent,text,size,pos,fontSize,color)
 local l=Instance.new("TextLabel");l.Size=size;l.Position=pos;l.BackgroundTransparency=1;l.Text=text;l.TextSize=fontSize or 15;l.Font=Enum.Font.GothamMedium;l.TextColor3=color or white;l.TextXAlignment=Enum.TextXAlignment.Left;l.TextWrapped=true;l.Parent=parent;return l
end
local function button(parent,name,text,size,pos,callback,color)
 local b=Instance.new("TextButton");b.Name=name;b.Size=size;b.Position=pos;b.BackgroundColor3=color or panel;b.TextColor3=white;b.Text=text;b.TextSize=14;b.Font=Enum.Font.GothamBold;b.AutoButtonColor=true;b.BorderSizePixel=0;b.Parent=parent
 local c=Instance.new("UICorner");c.CornerRadius=UDim.new(0,8);c.Parent=b;b.Activated:Connect(callback);return b
end
local top=frame(gui,"Navigation",UDim2.fromOffset(250,40),UDim2.fromOffset(14,12));top.BackgroundTransparency=1
local modal=frame(gui,"Menu",UDim2.fromOffset(720,520),UDim2.fromScale(.5,.5));modal.AnchorPoint=Vector2.new(.5,.5);modal.Visible=false
local menuScale=Instance.new("UIScale");menuScale.Parent=modal
local title=label(modal,"SCREAM COLLECTION",UDim2.new(1,-85,0,36),UDim2.fromOffset(22,15),23,gold)
local subtitle=label(modal,"Train for XP. Unlock a new scream every five levels.",UDim2.new(1,-44,0,25),UDim2.fromOffset(22,52),14,muted)
button(modal,"Close","X",UDim2.fromOffset(38,34),UDim2.new(1,-52,0,16),function() modal.Visible=false end)
local content=Instance.new("ScrollingFrame");content.Name="Content";content.Size=UDim2.new(1,-40,1,-148);content.Position=UDim2.fromOffset(20,132);content.BackgroundTransparency=1;content.BorderSizePixel=0;content.ScrollBarThickness=4;content.AutomaticCanvasSize=Enum.AutomaticSize.Y;content.CanvasSize=UDim2.new();content.Parent=modal
local list=Instance.new("UIListLayout");list.Padding=UDim.new(0,10);list.SortOrder=Enum.SortOrder.LayoutOrder;list.Parent=content
local selected="Screams";local render;local tabs={};local mapDot
local function toggle() modal.Visible=not modal.Visible;if modal.Visible then render() end end
local shop=button(top,"ShopToggle","SCREAMS  [B]",UDim2.fromOffset(125,36),UDim2.fromOffset(0,0),toggle,gold);shop.TextColor3=dark
button(top,"QuestsToggle","QUESTS",UDim2.fromOffset(95,36),UDim2.fromOffset(134,0),function() selected="Quests";modal.Visible=not(modal.Visible and title.Text=="CITY QUESTS");render() end)
local hud=frame(gui,"CompactHUD",UDim2.fromOffset(242,94),UDim2.new(0,14,1,-108));hud.BackgroundTransparency=.08
local stats=label(hud,"LEVEL 1     •     0 coins",UDim2.new(1,-24,0,22),UDim2.fromOffset(12,7),14,gold)
local health=label(hud,"100 HP",UDim2.fromOffset(65,20),UDim2.fromOffset(12,31),12)
local hb=frame(hud,"HealthTrack",UDim2.fromOffset(142,6),UDim2.fromOffset(83,38),panel)
local hf=frame(hb,"Fill",UDim2.fromScale(1,1),UDim2.new(),Color3.fromRGB(105,224,158))
local xpText=label(hud,"0 / 103 XP",UDim2.new(1,-24,0,19),UDim2.fromOffset(12,52),12,muted)
local xb=frame(hud,"XPTrack",UDim2.fromOffset(218,4),UDim2.fromOffset(12,79),panel)
local xf=frame(xb,"Fill",UDim2.fromScale(0,1),UDim2.new(),gold)
local zone=label(gui,"SAFE CITY • PvP off",UDim2.fromOffset(240,28),UDim2.new(.5,-120,0,12),13);zone.TextXAlignment=Enum.TextXAlignment.Center
local tracked=label(gui,"",UDim2.fromOffset(250,66),UDim2.fromOffset(16,56),13);tracked.TextYAlignment=Enum.TextYAlignment.Top
local toast=label(gui,"",UDim2.new(.7,0,0,48),UDim2.new(.15,0,.72,0),16,gold);toast.TextXAlignment=Enum.TextXAlignment.Center
local toastUntil=0
local function notify(t) toast.Text=t;toastUntil=os.clock()+4 end
local nextCast=0
local function cast()
 if modal.Visible or (p:GetAttribute("ProtectionEnds") or 0)>workspace:GetServerTimeNow() or os.clock()<nextCast then return end
 local sound=Config.GetSound(data.sound);nextCast=os.clock()+sound.cooldown;action:FireServer("Cast")
end
local function dodge() if not modal.Visible then action:FireServer("Dodge") end end
local controls=frame(gui,"Actions",UDim2.fromOffset(260,88),UDim2.new(1,-274,1,-102));controls.BackgroundTransparency=1
local castButton=button(controls,"Cast","SCREAM  [E]",UDim2.fromOffset(144,44),UDim2.fromOffset(116,0),cast,gold);castButton.TextColor3=dark
local dodgeButton=button(controls,"Dodge","DODGE  [Q]",UDim2.fromOffset(108,44),UDim2.fromOffset(0,0),dodge)
local sprinting=false
local sprintButton=button(controls,"Sprint","SPRINT [SHIFT]",UDim2.fromOffset(164,32),UDim2.fromOffset(96,52),function() sprinting=not sprinting;action:FireServer("Sprint",sprinting) end)
local talkTarget
local talkButton=button(gui,"Talk","TALK [T]",UDim2.fromOffset(120,34),UDim2.new(.5,-60,1,-52),function() if talkTarget then action:FireServer("Talk",talkTarget:GetAttribute("NpcId") or talkTarget.Name) end end);talkButton.Visible=false
local devPanel=frame(gui,"TestPanel",UDim2.fromOffset(230,330),UDim2.new(1,-244,0,60));devPanel.Visible=false
label(devPanel,"TEST SESSION",UDim2.fromOffset(210,25),UDim2.fromOffset(10,8),17,gold)
label(devPanel,"Test commands disable saving this session.",UDim2.fromOffset(210,38),UDim2.fromOffset(10,35),12,muted)
for i,item in ipairs({{"XP","+500 XP"},{"Coins","+1,000 coins"},{"MaxLevel","Level 30"},{"LevelOne","Level 1"},{"Heal","Heal"},{"Hub","Safe hub"},{"Arena","Arena"},{"Beach","Beach"},{"ResetQuests","Reset quests"},{"ResetBots","Reset bots"}}) do
 button(devPanel,item[1],item[2],UDim2.fromOffset(100,39),UDim2.fromOffset(10+((i-1)%2)*110,80+math.floor((i-1)/2)*47),function() action:FireServer("DevCommand",item[1]) end)
end
local testButton=button(gui,"TestToggle","TEST TOOLS",UDim2.fromOffset(112,32),UDim2.new(1,-126,0,14),function() devPanel.Visible=not devPanel.Visible end);testButton.Visible=false
local function card(height) return frame(content,"Card",UDim2.new(1,-8,0,height),UDim2.new(),panel) end
local function info(text,height) local c=card(height or 70);label(c,text,UDim2.new(1,-28,1,-20),UDim2.fromOffset(14,10),15);return c end
render=function()
 for _,c in ipairs(content:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
 for name,b in pairs(tabs) do b.BackgroundColor3=name==selected and Color3.fromRGB(64,93,99) or panel end
 if selected=="Screams" then
  title.Text="SCREAM COLLECTION";subtitle.Text="Level "..data.level.."  •  "..data.xp.." / "..data.xpNext.." XP  •  New unlocks at 5, 10, 15, 20, 25"
  for _,s in ipairs(Config.Sounds) do
   local c=card(101);label(c,s.name.."  /  LEVEL "..s.level,UDim2.new(1,-156,0,26),UDim2.fromOffset(14,8),17,gold)
   label(c,s.description,UDim2.new(1,-158,0,25),UDim2.fromOffset(14,36),13)
   label(c,s.damage.." DAMAGE    "..s.range.." RANGE / "..s.width.." WIDTH    "..s.cooldown.."s COOLDOWN",UDim2.new(1,-28,0,23),UDim2.fromOffset(14,69),12,muted)
   local unlocked=data.level>=s.level
   local b=button(c,s.id,data.sound==s.id and "EQUIPPED" or unlocked and "EQUIP" or "LEVEL "..s.level,UDim2.fromOffset(116,37),UDim2.new(1,-130,0,21),function() if unlocked then action:FireServer("EquipSound",s.id) end end)
   if not unlocked then b.TextColor3=muted end
  end
 elseif selected=="Quests" then
  title.Text="CITY QUESTS";subtitle.Text="Choose an activity. Complete it, then claim your XP and coins."
  for _,q in ipairs(Config.Quests) do
   local v=data.quests[q.id] or {progress=0};local c=card(123)
   label(c,q.name,UDim2.new(1,-150,0,25),UDim2.fromOffset(14,8),17,gold)
   label(c,q.description,UDim2.new(1,-158,0,49),UDim2.fromOffset(14,36),13)
   label(c,v.progress.." / "..q.goal.."   •   +"..q.xp.." XP   •   +"..q.coins.." coins",UDim2.new(1,-28,0,23),UDim2.fromOffset(14,93),12,muted)
   button(c,q.id,v.claimed and "CLAIMED" or v.progress>=q.goal and "CLAIM" or data.activeQuest==q.id and "TRACKING" or "ACCEPT",UDim2.fromOffset(116,38),UDim2.new(1,-130,0,32),function()
    if not v.claimed then action:FireServer(v.progress>=q.goal and "ClaimQuest" or "AcceptQuest",q.id) end
   end)
  end
 elseif selected=="Style" then
  title.Text="YOUR SIGNATURE";subtitle.Text="Choose the color of your scream effects."
  for name,color in pairs(Config.Auras) do
   local c=card(56);label(c,name,UDim2.fromOffset(240,36),UDim2.fromOffset(15,10),17,color)
   button(c,name,data.aura==name and "EQUIPPED" or "USE COLOR",UDim2.fromOffset(126,36),UDim2.new(1,-140,0,10),function() action:FireServer("SetAura",name) end)
  end
 elseif selected=="Map" then
  title.Text="CITY & COAST";subtitle.Text="Arena District: 40% PvP. Outer neighborhoods and beach: 60% safe."
  local c=card(250)
  local map=frame(c,"Map",UDim2.new(1,-26,1,-26),UDim2.fromOffset(13,13),Color3.fromRGB(45,66,72))
  local function area(t,x,y,w,h,col) local f=frame(map,t,UDim2.fromScale(w,h),UDim2.fromScale(x,y),col);local l=label(f,t,UDim2.fromScale(1,1),UDim2.new(),13);l.TextXAlignment=Enum.TextXAlignment.Center;return f end
  area("SAFE NORTH",0,0,1,.2,Color3.fromRGB(50,93,82));area("SAFE\nWEST",0,.2,.166,.6,Color3.fromRGB(50,93,82));area("SAFE\nEAST",.833,.2,.167,.6,Color3.fromRGB(50,93,82))
  area("ARENA DISTRICT • PvP\n40% of playable land",.166,.2,.667,.6,Color3.fromRGB(136,65,70));area("BARCELONETA • SAFE BEACH",0,.8,1,.2,Color3.fromRGB(159,137,91))
  local root=p.Character and p.Character:FindFirstChild("HumanoidRootPart");if root then local pos=root.Position;mapDot=area("YOU",math.clamp((pos.X+720)/1440,0,.94),math.clamp((pos.Z+600)/1200,0,.94),.06,.06,gold) end
  info("Spawn: Plaça del Sol, southwest. Beach: south. Coffee: west promenade café → music stage. Race: lifeguard start → east promenade finish. PvP ends at the marked district boundary.",86)
 else
  title.Text="SETTINGS & CONTROLS";subtitle.Text="Keep the action comfortable and easy to read."
  info("E / tap SCREAM: fire a beam straight ahead\nQ / tap DODGE: roll with a 4-second cooldown\nShift / tap SPRINT: 10 seconds of sprint, then a 5-second rest\nT: talk to nearby residents • F: quest interactions • B: toggle menu",125)
  local c=card(58);button(c,"Volume","AUDIO: "..math.floor(data.settings.volume*100).."%",UDim2.fromOffset(260,38),UDim2.fromOffset(12,10),function() action:FireServer("SetSettings",{volume=data.settings.volume>=.99 and 0 or math.min(1,data.settings.volume+.25)}) end)
  local d=card(58);button(d,"ReducedFX","REDUCED EFFECTS: "..(data.settings.reducedShake and "ON" or "OFF"),UDim2.fromOffset(260,38),UDim2.fromOffset(12,10),function() action:FireServer("SetSettings",{reducedShake=not data.settings.reducedShake}) end)
 end
end
for i,name in ipairs({"Screams","Quests","Style","Map","Settings"}) do tabs[name]=button(modal,name,name:upper(),UDim2.fromOffset(126,34),UDim2.fromOffset(20+(i-1)*134,88),function() selected=name;render() end) end
local lastMenuKey=""
remotes.State.OnClientEvent:Connect(function(nextData)
 data=nextData;stats.Text="LEVEL "..data.level.."    •    "..data.coins.." coins";health.Text=data.health.."/"..(data.maxHealth or 100);hf.Size=UDim2.fromScale(data.health/(data.maxHealth or 100),1)
 xpText.Text=data.level>=Config.MaxLevel and "MAX LEVEL" or data.xp.." / "..data.xpNext.." XP";xf.Size=UDim2.fromScale(data.level>=Config.MaxLevel and 1 or data.xp/data.xpNext,1)
 zone.Text=data.inWarZone and "ARENA DISTRICT • PvP ON" or "SAFE CITY • PvP OFF";zone.TextColor3=data.inWarZone and Color3.fromRGB(255,140,139) or white
 testButton.Visible=data.devAccess==true
 local q=Config.GetQuest(data.activeQuest);local v=q and data.quests[q.id]
 tracked.Text=q and (q.name.."  "..v.progress.."/"..q.goal..(data.questTime>0 and "  •  "..data.questTime.."s" or "")) or ""
 if data.message then notify(data.message) end
 local key=game:GetService("HttpService"):JSONEncode({data.level,data.xp,data.sound,data.aura,data.quests,data.activeQuest,data.settings})
 if modal.Visible and key~=lastMenuKey then render() end;lastMenuKey=key
end)
UIS.InputBegan:Connect(function(input,processed)
 if processed then return end
 local k=input.KeyCode
 if k==Enum.KeyCode.E then cast() elseif k==Enum.KeyCode.Q then dodge() elseif k==Enum.KeyCode.B then toggle()
 elseif k==Enum.KeyCode.M then selected="Map";modal.Visible=not modal.Visible;render()
 elseif k==Enum.KeyCode.LeftShift then action:FireServer("Sprint",true)
 elseif k==Enum.KeyCode.T and talkTarget then action:FireServer("Talk",talkTarget:GetAttribute("NpcId") or talkTarget.Name) end
end)
UIS.InputEnded:Connect(function(input) if input.KeyCode==Enum.KeyCode.LeftShift then action:FireServer("Sprint",false) end end)
UIS.WindowFocusReleased:Connect(function() sprinting=false;action:FireServer("Sprint",false) end)
local function fxPart(position,color,size)
 local f=Instance.new("Part");f.Anchored=true;f.CanCollide=false;f.CanTouch=false;f.CanQuery=false;f.Material=Enum.Material.Neon;f.Color=color;f.Size=size;f.Position=position;f.Transparency=.3;f.Parent=workspace;Debris:AddItem(f,1.1);return f
end
remotes.Effect.OnClientEvent:Connect(function(kind,pos,id,aura,direction,length)
 if kind=="ResetCollected" then for _,o in ipairs(workspace.ScreamSimulatorWorld.QuestObjects:GetChildren()) do o.LocalTransparencyModifier=0;local prompt=o:FindFirstChildOfClass("ProximityPrompt");if prompt then prompt.Enabled=true end end;return end
 if kind=="Collected" then if pos and pos.Parent then pos.LocalTransparencyModifier=1;local prompt=pos:FindFirstChildOfClass("ProximityPrompt");if prompt then prompt.Enabled=false end end;return end
 local root=p.Character and p.Character:FindFirstChild("HumanoidRootPart");if root and (root.Position-pos).Magnitude>180 then return end
 local color=Config.Auras[kind=="Dodge" and id or aura] or gold
 if kind=="Dodge" then local f=fxPart(pos,color,Vector3.new(2,3,2));Tween:Create(f,TweenInfo.new(.35),{Transparency=1,Size=Vector3.new(5,1,5)}):Play();return end
 local s=Config.GetSound(id);if not s then return end
 do
  local carrier=Instance.new("Part");carrier.Anchored=true;carrier.CanCollide=false;carrier.CanQuery=false;carrier.Transparency=1;carrier.Position=pos;carrier.Parent=workspace
  local audio=Instance.new("Sound");audio.SoundId=s.assetId~="" and s.assetId or "rbxasset://sounds/oof.ogg";audio.PlaybackSpeed=({Pulse=1.4,Echo=1.1,Feathers=1.9,Quake=.65,Storm=.85,Nova=.5})[s.effect] or 1
  audio.Volume=data.settings.volume;audio.RollOffMaxDistance=s.range*1.5;audio.Parent=carrier
  if s.effect=="Echo" then local echo=Instance.new("EchoSoundEffect");echo.Delay=.15;echo.Feedback=.4;echo.Parent=audio end
  audio:Play();Debris:AddItem(carrier,5)
 end
 direction=direction or Vector3.new(0,0,-1);length=length or s.range
 local width=s.width;local center=pos+direction*length/2
 local beam=fxPart(center,color,Vector3.new(width,width,length));beam.Name="ScreamBeam";beam.CFrame=CFrame.lookAt(center,center+direction);beam.Transparency=.55
 local core=fxPart(center,Color3.fromRGB(255,245,206),Vector3.new(width*.22,width*.22,length));core.CFrame=beam.CFrame
 Tween:Create(beam,TweenInfo.new(.38),{Transparency=1,Size=Vector3.new(width*.5,width*.5,length)}):Play()
 Tween:Create(core,TweenInfo.new(.25),{Transparency=1}):Play()
 if not data.settings.reducedShake then
  local count=s.effect=="Pulse" and 4 or 9
  for i=1,count do
   local side=Vector3.new(-direction.Z,0,direction.X);local phase=i*math.pi*2/count
   local offset=(side*math.cos(phase)+Vector3.yAxis*math.sin(phase))*width*.35
   local shard=fxPart(pos+offset,color,s.effect=="Feathers" and Vector3.new(.3,1.6,.7) or Vector3.new(.3,.3,2))
   shard.CFrame=CFrame.lookAt(pos+offset,pos+offset+direction)
   Tween:Create(shard,TweenInfo.new(.18+length/300),{Position=pos+direction*length+offset,Transparency=1}):Play()
  end
 end
end)
local elapsed=0
Run.RenderStepped:Connect(function(dt)
 local viewport=workspace.CurrentCamera.ViewportSize
 local short=viewport.Y<550
 menuScale.Scale=math.min(1,(viewport.X-32)/720)
 local menuHeight=short and math.max(230,(viewport.Y-125)/menuScale.Scale) or 520
 modal.Size=UDim2.fromOffset(720,menuHeight);modal.Position=UDim2.new(.5,0,.5,short and 18 or 0)
 subtitle.Visible=not short
 for _,b in pairs(tabs) do b.Position=UDim2.fromOffset(b.Position.X.Offset,short and 54 or 88) end
 content.Position=UDim2.fromOffset(20,short and 96 or 132);content.Size=UDim2.new(1,-40,1,short and -108 or -148)
 -- Keep desktop controls compact; smaller displays retain readable button text.
 local touch=UIS.TouchEnabled
 hud.Position=touch and UDim2.fromOffset(14,56) or UDim2.new(0,14,1,-108)
 controls.Position=UDim2.new(1,-274,1,touch and -195 or -102)
 hud.Visible=not modal.Visible;controls.Visible=not modal.Visible
 tracked.Position=UDim2.fromOffset(16,touch and 158 or 56)
 if touch then sprintButton.TextSize=12 end
 tracked.Visible=not modal.Visible;zone.Visible=viewport.X>740
 local now=workspace:GetServerTimeNow();local protected=math.max(0,(p:GetAttribute("ProtectionEnds") or 0)-now)
 castButton.Text=protected>0 and "PROTECTED "..math.ceil(protected).."s" or os.clock()<nextCast and string.format("SCREAM %.1fs",nextCast-os.clock()) or "SCREAM [E]"
 castButton.BackgroundColor3=protected>0 and muted or gold
 local cd=math.max(0,(p:GetAttribute("DodgeReady") or 0)-now);dodgeButton.Text=cd>0 and string.format("DODGE %.1fs",cd) or "DODGE [Q]"
 local rest=p:GetAttribute("SprintCooldown") or 0;sprintButton.Text=rest>0 and string.format("REST %.1fs",rest) or string.format("SPRINT %.1fs [SHIFT]",p:GetAttribute("SprintCharge") or 10)
 if os.clock()>toastUntil then toast.Text="" end
 elapsed+=dt;if elapsed<.25 then return end;elapsed=0
 talkTarget=nil;local root=p.Character and p.Character:FindFirstChild("HumanoidRootPart");local world=workspace:FindFirstChild("ScreamSimulatorWorld");local best=13
 if root and world then for _,bot in ipairs(world:GetChildren()) do local r=bot:IsA("Model") and bot:FindFirstChild("HumanoidRootPart");if r then local distance=(r.Position-root.Position).Magnitude;if distance<best then best=distance;talkTarget=bot end end end end
 if root and mapDot and mapDot.Parent then mapDot.Position=UDim2.fromScale(math.clamp((root.Position.X+720)/1440,0,.94),math.clamp((root.Position.Z+600)/1200,0,.94)) end
 talkButton.Visible=talkTarget~=nil and not modal.Visible
end)
action:FireServer("Sync")
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="15">
        <Properties>
          <string name="Name">RunAnimation</string>
          <string name="Source"><![CDATA[-- Additive animation layer on every client: running and a grounded forward roll.
local Players=game:GetService("Players")
local Run=game:GetService("RunService")
local Config=require(game.ReplicatedStorage.Shared.Config)
local rigs={}
local function watch(player)
 local function added(character)
  local humanoid=character:WaitForChild("Humanoid");local root=character:WaitForChild("HumanoidRootPart")
  local rig={character=character,humanoid=humanoid,root=root,joints={},offsets={},phase=0,blend=0};rigs[player]=rig
  local function collect(item)
   if item:IsA("Motor6D") or item:IsA("AnimationConstraint") then
    rig.joints[item.Name]=item
    if item:IsA("Motor6D") and item.Part0==root or item:IsA("AnimationConstraint") and item.Attachment0 and item.Attachment0.Parent==root then rig.rootJoint=item end
   end
  end
  for _,item in ipairs(character:GetDescendants()) do collect(item) end
  character.DescendantAdded:Connect(collect)
 end
 player.CharacterAdded:Connect(added);if player.Character then task.spawn(added,player.Character) end
end
for _,p in ipairs(Players:GetPlayers()) do watch(p) end;Players.PlayerAdded:Connect(watch);Players.PlayerRemoving:Connect(function(p) rigs[p]=nil end)
Run.PreAnimation:Connect(function()
 for _,rig in pairs(rigs) do for joint,offset in pairs(rig.offsets) do if joint.Parent then joint.Transform=joint.Transform*offset:Inverse() end end;table.clear(rig.offsets) end
end)
Run.PreSimulation:Connect(function(dt)
 for player,rig in pairs(rigs) do
  if not rig.character.Parent then continue end
  local function pose(name,offset)
   local j=rig.joints[name];if j then j.Transform=j.Transform*offset;rig.offsets[j]=offset end
  end
  local now=workspace:GetServerTimeNow();local ends=player:GetAttribute("DodgeEnds") or 0;local started=player:GetAttribute("DodgeStarted") or 0
  if now<ends and started>0 then
   local t=math.clamp((now-started)/Config.DodgeDuration,0,1);local tuck=math.sin(t*math.pi)
   local rootJoint=rig.rootJoint or rig.joints.RootJoint or rig.joints.Root or rig.joints.RootMotor
   if rootJoint then
    local roll=CFrame.new(0,-1.1*tuck,0)*CFrame.Angles(-math.pi*2*t,0,0)
    local basis=rootJoint:IsA("Motor6D") and rootJoint.C0 or rootJoint.Attachment0 and rootJoint.Attachment0.CFrame or CFrame.identity
    local offset=basis:Inverse()*roll*basis
    pose(rootJoint.Name,offset)
   end
   for _,name in ipairs({"Left Shoulder","Right Shoulder","LeftShoulder","RightShoulder"}) do pose(name,CFrame.Angles(-1.4*tuck,0,0)) end
   for _,name in ipairs({"Left Hip","Right Hip","LeftHip","RightHip"}) do pose(name,CFrame.Angles(1.2*tuck,0,0)) end
   for _,name in ipairs({"LeftKnee","RightKnee"}) do pose(name,CFrame.Angles(-1.6*tuck,0,0)) end
   pose("Waist",CFrame.Angles(-.4*tuck,0,0))
   rig.character:SetAttribute("RollAnimationProgress",t)
   continue
  end
  rig.character:SetAttribute("RollAnimationProgress",-1)
  local v=rig.root.AssemblyLinearVelocity;local speed=Vector3.new(v.X,0,v.Z).Magnitude
  local sprinting=player:GetAttribute("Sprinting") and speed>3 and rig.humanoid.FloorMaterial~=Enum.Material.Air and now>=(player:GetAttribute("KnockdownEnds") or 0)
  rig.blend+=((sprinting and 1 or 0)-rig.blend)*math.min(dt*12,1)
  if rig.blend<.01 then continue end
  rig.phase+=dt*13;local swing=math.sin(rig.phase)*.32*rig.blend
  for _,spec in ipairs({{"Left Shoulder",swing},{"Right Shoulder",-swing},{"Left Hip",-swing},{"Right Hip",swing},{"LeftShoulder",swing},{"RightShoulder",-swing},{"LeftHip",-swing},{"RightHip",swing},{"LeftKnee",math.max(0,swing)*.7},{"RightKnee",math.max(0,-swing)*.7}}) do pose(spec[1],CFrame.Angles(spec[2],0,0)) end
  pose("Waist",CFrame.Angles(-.14*rig.blend,math.sin(rig.phase)*.04*rig.blend,0));rig.character:SetAttribute("SprintAnimationBlend",rig.blend)
 end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>