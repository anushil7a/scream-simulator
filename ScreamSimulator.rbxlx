<roblox version="4">
  <Item class="ReplicatedStorage" referent="0">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="1">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[local Config = {}
Config.MaxLevel = 30
Config.MaxHealth = 100
Config.MapMin=Vector3.new(-720,-20,-600)
Config.MapMax=Vector3.new(720,200,600)
function Config.HealthForLevel(level) return 100+8*(math.clamp(level,1,Config.MaxLevel)-1) end
Config.HealQuietSeconds = 10
Config.HealAmount = 20
Config.BotMaxHealth = 60
Config.BotRespawnSeconds = 6
Config.WalkSpeed = 16
Config.SprintSpeed = 25
Config.SprintDuration = 10
Config.SprintRecovery = 5
Config.SpawnProtection = 5
Config.DodgeCooldown = 4
Config.DodgeDuration = 0.6
Config.DodgeDistance = 14
Config.ZoneMin = Vector3.new(-480,-20,-360)
Config.ZoneMax = Vector3.new(480,200,360)
Config.Sounds = {
 {id="TinyAah",name="Tiny Aah",level=1,damage=12,range=30,width=4,cooldown=2.4,effect="Pulse",description="A focused forward sound beam.",assetId=""},
 {id="IyoPop",name="Echo Pop",level=5,damage=18,range=42,width=5,cooldown=2.6,effect="Echo",description="A longer beam wrapped in echo rings.",assetId=""},
 {id="PanicChicken",name="Panic Chicken",level=10,damage=25,range=56,width=6,cooldown=2.8,effect="Feathers",description="A piercing stream of golden feathers.",assetId=""},
 {id="Laughquake",name="Laughquake",level=15,damage=32,range=72,width=7,cooldown=3,effect="Quake",description="A broad ground-rumbling sound beam.",assetId=""},
 {id="MegaChaos",name="Storm Siren",level=20,damage=40,range=90,width=8,cooldown=3.2,effect="Storm",description="A crackling electric sound lance.",assetId=""},
 {id="Supernova",name="Supernova",level=25,damage=48,range=112,width=10,cooldown=3.5,effect="Nova",description="A brilliant long-range sound ray.",assetId=""},
}
Config.Auras={Gold=Color3.fromRGB(255,203,99),Mint=Color3.fromRGB(98,244,187),Violet=Color3.fromRGB(188,137,255),Ice=Color3.fromRGB(110,207,255),Coral=Color3.fromRGB(255,128,128)}
Config.Quests={
 {id="beach",name="Leave Only Footprints",description="Collect 6 washed-up bottles on the beach. Hold F near litter.",goal=6,xp=100,coins=50,event="Litter"},
 {id="delivery",name="Coffee Before the Encore",description="Pick up a café order, then deliver it to the boardwalk stage within 90 seconds.",goal=1,xp=120,coins=60,event="Delivery"},
 {id="crowd",name="Three's a Crowd",description="Line up 3 training residents and hit them with one beam.",goal=1,xp=100,coins=40,event="Crowd"},
 {id="sprint",name="Boardwalk Dash",description="Start beside the lifeguard tower and follow the promenade east to the finish in 25 seconds.",goal=1,xp=120,coins=50,event="Race"},
 {id="dodge",name="Can't Touch This",description="Dodge 3 enemy screams in the central arena.",goal=3,xp=160,coins=70,event="Evade"},
 {id="arena",name="Underdog",description="Knock out a player whose level is at least yours in the central arena.",goal=1,xp=180,coins=80,event="Underdog"},
}
function Config.GetSound(id) for _,s in ipairs(Config.Sounds) do if s.id==id then return s end end end
function Config.GetQuest(id) for _,q in ipairs(Config.Quests) do if q.id==id then return q end end end
function Config.XPToNext(level) return math.floor(70+level*25+level^1.55*8) end
function Config.PlayerKOXP(level) return 50+math.clamp(level,1,Config.MaxLevel)*12 end
function Config.InArena(p) return p.X>=Config.ZoneMin.X and p.X<=Config.ZoneMax.X and p.Z>=Config.ZoneMin.Z and p.Z<=Config.ZoneMax.Z and p.Y>=Config.ZoneMin.Y and p.Y<=Config.ZoneMax.Y end
return Config
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="3">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="4">
      <Properties>
        <string name="Name">Bootstrap</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local Config=require(ReplicatedStorage.Shared.Config)
local World=require(script.Parent.World)
local Profiles=require(script.Parent.Profiles)
local Access=require(script.Parent.DeveloperAccess)
local Rules=require(script.Parent.CombatRules)
World.Build()
local old=ReplicatedStorage:FindFirstChild("ScreamRemotes");if old then old:Destroy() end
local remotes=Instance.new("Folder");remotes.Name="ScreamRemotes";remotes.Parent=ReplicatedStorage
local function remote(name) local r=Instance.new("RemoteEvent");r.Name=name;r.Parent=remotes;return r end
local action=remote("Action");local stateRemote=remote("State");local effect=remote("Effect")
local sessions={}
local function parts(p)
 local c=p.Character;local r=c and c:FindFirstChild("HumanoidRootPart");local h=c and c:FindFirstChildOfClass("Humanoid")
 if r and h and h.Health>0 then return c,r,h end
end
local function state(p,message)
 local s=sessions[p];if not s or not p.Parent then return end
 local _,r,h=parts(p)
 stateRemote:FireClient(p,{coins=s.data.coins,level=s.data.level,xp=s.data.xp,xpNext=Config.XPToNext(s.data.level),sound=s.data.sound,aura=s.data.aura,
 quests=s.data.quests,activeQuest=s.activeQuest,questTime=s.questDeadline and math.max(0,math.ceil(s.questDeadline-os.clock())) or 0,
 health=h and math.ceil(h.Health) or Config.HealthForLevel(s.data.level),maxHealth=Config.HealthForLevel(s.data.level),inWarZone=r and Config.InArena(r.Position) or false,
 protection=math.max(0,s.protectedUntil-os.clock()),dodgeCooldown=math.max(0,s.nextDodge-os.clock()),
 settings=s.data.settings,devAccess=Access.IsAuthorized(p,game.CreatorType,game.CreatorId),savingAvailable=s.canSave,message=message})
end
local function syncHealth(p,full)
 local s=sessions[p];local _,_,h=parts(p);if not s or not h then return end
 local maximum=Config.HealthForLevel(s.data.level);local gain=maximum-h.MaxHealth
 h.MaxHealth=maximum;h.Health=full and maximum or math.clamp(h.Health+gain,1,maximum)
end
local function xp(p,amount)
 local s=sessions[p];if not s then return end
 local d=s.data;if d.level>=Config.MaxLevel then return end
 d.xp+=math.max(0,math.floor(amount));local before=d.level
 while d.level<Config.MaxLevel and d.xp>=Config.XPToNext(d.level) do d.xp-=Config.XPToNext(d.level);d.level+=1 end
 if d.level==Config.MaxLevel then d.xp=0 end
 if d.level>before then
  syncHealth(p,false)
  local unlock="";for _,v in ipairs(Config.Sounds) do if v.level>before and v.level<=d.level then unlock=" · Unlocked "..v.name end end
  state(p,"Level "..d.level..unlock)
 end
end
local function questProgress(p,event,amount)
 local s=sessions[p];if not s or not s.activeQuest then return end
 local q=Config.GetQuest(s.activeQuest);if not q or q.event~=event then return end
 local v=s.data.quests[q.id];if not v or v.claimed then return end
 v.progress=math.min(q.goal,v.progress+(amount or 1));state(p,v.progress==q.goal and "Quest complete! Claim your reward in Quests." or nil)
end
local function protect(p,s)
 s.protectedUntil=os.clock()+Config.SpawnProtection
 p:SetAttribute("ProtectionEnds",workspace:GetServerTimeNow()+Config.SpawnProtection)
 local c=p.Character;if c then local oldField=c:FindFirstChild("SpawnProtection");if oldField then oldField:Destroy() end
  local f=Instance.new("ForceField");f.Name="SpawnProtection";f.Parent=c
  task.delay(Config.SpawnProtection,function() if f.Parent then f:Destroy() end end)
 end
end
local function eject(p,h)
 local s=sessions[p];h.Health=Config.HealthForLevel(s.data.level);p.Character:PivotTo(World.SafeSpawn);s.dodgingUntil=0;protect(p,s)
 s.nextHeal=os.clock()+Config.HealQuietSeconds;state(p,"Knocked out · back at the safe hub")
end
local function audible(c,origin,target,targetModel)
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={c,targetModel}
 return workspace:Raycast(origin,target-origin,params)==nil
end
local function cast(p)
 local s=sessions[p];local c,r=parts(p);if not s or not r then return end
 local now=os.clock();local sound=Config.GetSound(s.data.sound)
 if not Rules.CanCast(s,sound,now) then return end
 s.nextCast=now+sound.cooldown
 local origin=r.Position+Vector3.new(0,1,0)
 local direction=Vector3.new(r.CFrame.LookVector.X,0,r.CFrame.LookVector.Z)
 if direction.Magnitude<.01 then return end;direction=direction.Unit
 local exclude={c};for _,bot in ipairs(World.Bots) do table.insert(exclude,bot.model) end
 for _,other in ipairs(Players:GetPlayers()) do if other.Character then table.insert(exclude,other.Character) end end
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances=exclude;params.RespectCanCollide=true
 local obstruction=workspace:Raycast(origin,direction*sound.range,params)
 local length=obstruction and obstruction.Distance or sound.range
 effect:FireAllClients("Scream",origin,sound.id,s.data.aura,direction,length)
 local hits=0;local paid=0
 for _,bot in ipairs(World.Bots) do
  if bot.alive and bot.root.Parent and Rules.InBeam(origin,direction,bot.root.Position,length,sound.width,1) and audible(c,origin,bot.root.Position,bot.model) then
   hits+=1;bot.health=math.max(0,bot.health-sound.damage);local ko=bot.health==0
   if ko then bot.alive=false;task.delay(Config.BotRespawnSeconds,function() if bot.model.Parent then bot.health=Config.BotMaxHealth;bot.alive=true;World.UpdateBot(bot) end end)
   else World.ReactToScream(bot,r.Position) end
   World.UpdateBot(bot)
   if now>=(s.botRewards[bot.id] or 0) and paid<5 then
    s.botRewards[bot.id]=now+5;paid+=1;s.data.coins+=ko and 5 or 2;xp(p,ko and 16 or 5)
   end
  end
 end
 if hits>=3 then questProgress(p,"Crowd") end
 if Config.InArena(r.Position) then
  for _,target in ipairs(Players:GetPlayers()) do
   local ts=sessions[target];local tc,tr,th=parts(target)
   if target~=p and ts and tr and Rules.CanTarget(r.Position,tr.Position,ts.protectedUntil,now,sound.range+2) and Rules.InBeam(origin,direction,tr.Position,length,sound.width,1) and audible(c,origin,tr.Position,tc) then
    if now<ts.dodgingUntil then questProgress(target,"Evade")
    else
     ts.nextHeal=now+Config.HealQuietSeconds
     if th.Health<=sound.damage then
      local targetLevel=ts.data.level;local attackerLevel=s.data.level;eject(target,th)
      -- A repeated victim has a reward cooldown, independent from hit rewards.
      if now>=(s.koRewards[target.UserId] or 0) then
       s.koRewards[target.UserId]=now+30;local reward=Config.PlayerKOXP(targetLevel);xp(p,reward);s.data.coins+=20
       if targetLevel>=attackerLevel then questProgress(p,"Underdog") end
       state(p,"Player knockout · +"..reward.." XP")
      end
     else th.Health-=sound.damage;state(target) end
    end
   end
  end
 end
 state(p)
end
local function dodge(p)
 local s=sessions[p];local c,r,h=parts(p);local now=os.clock()
 if not s or not r or now<s.nextDodge or now<(s.knockedUntil or 0) or h.FloorMaterial==Enum.Material.Air then return end
 s.nextDodge=now+Config.DodgeCooldown;s.dodgingUntil=now+Config.DodgeDuration
 p:SetAttribute("DodgeEnds",workspace:GetServerTimeNow()+Config.DodgeDuration)
 p:SetAttribute("DodgeReady",workspace:GetServerTimeNow()+Config.DodgeCooldown)
 local direction=h.MoveDirection;if direction.Magnitude<0.1 then direction=r.CFrame.LookVector end
 direction=Vector3.new(direction.X,0,direction.Z).Unit
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={c}
 local hit=workspace:Blockcast(r.CFrame,Vector3.new(2,3,2),direction*Config.DodgeDistance,params)
 local distance=hit and math.max(0,hit.Distance-1) or Config.DodgeDistance
 local start=r.CFrame;r:SetNetworkOwner(nil);h.AutoRotate=false
 r.CFrame=CFrame.lookAt(r.Position,r.Position+direction)
 p:SetAttribute("DodgeStarted",workspace:GetServerTimeNow());p:SetAttribute("DodgeDirection",direction)
 effect:FireAllClients("Dodge",r.Position,s.data.aura)
 task.spawn(function()
  local previousDistance=0
  while c.Parent and p.Character==c and h.Health>0 and s.dodgingUntil>os.clock() and os.clock()-now<Config.DodgeDuration do
   local t=math.clamp((os.clock()-now)/Config.DodgeDuration,0,1)
   local desired=distance*(t*t*(3-2*t));local step=desired-previousDistance
   local blocked=step>0 and workspace:Blockcast(r.CFrame,Vector3.new(2,2.5,2),direction*step,params)
   if blocked then break end
   r.CFrame=CFrame.lookAt(r.Position+direction*step,r.Position+direction*(step+1));previousDistance=desired
   r.AssemblyLinearVelocity=Vector3.zero;RunService.Heartbeat:Wait()
  end
  if h.Parent then h.AutoRotate=true end
  if r.Parent and os.clock()>=(s.knockedUntil or 0) then r:SetNetworkOwnershipAuto() end
 end)
 state(p)
end
local function talk(p,id)
 local s=sessions[p];local _,r=parts(p);if not s or not r or type(id)~="string" or os.clock()<(s.nextTalk or 0) then return end
 for _,b in ipairs(World.Bots) do if b.id==id and b.alive and b.root.Parent and (b.root.Position-r.Position).Magnitude<=14 then
  s.nextTalk=os.clock()+2;state(p,b.name..": "..World.Talk(b,p));return
 end end
end
local function dev(p,command)
 local s=sessions[p];if not s or not Access.IsAuthorized(p,game.CreatorType,game.CreatorId) then return end
 local c,_,h=parts(p)
 local positions={Hub=World.SafeSpawn,Arena=CFrame.new(0,6,0),Beach=CFrame.new(0,4,403)}
 if command=="Coins" then s.data.coins+=1000
 elseif command=="XP" then s.canSave=false;xp(p,500)
 elseif command=="MaxLevel" then s.data.level=Config.MaxLevel;s.data.xp=0
 elseif command=="LevelOne" then s.data.level=1;s.data.xp=0;s.data.sound="TinyAah"
 elseif command=="Heal" and h then h.Health=h.MaxHealth
 elseif positions[command] and c then c:PivotTo(positions[command]);protect(p,s)
 elseif command=="ResetQuests" then s.data.quests={};s.activeQuest=nil;s.questDeadline=nil;s.collected={};effect:FireClient(p,"ResetCollected")
 elseif command=="ResetBots" then for _,b in ipairs(World.Bots) do b.health=Config.BotMaxHealth;b.alive=true;World.UpdateBot(b) end
 else return end
 syncHealth(p,command=="Heal");s.canSave=false;state(p,"Test applied · this session does not save")
end
World.OnVehicleSweep=function(car,previous,nextFrame)
 for player,s in pairs(sessions) do
  local character,root,humanoid=parts(player);local now=os.clock()
  if root and now>=s.protectedUntil and now>=(s.nextCarHit or 0) and Rules.VehicleSweep(previous*CFrame.new(0,.55,0),nextFrame*CFrame.new(0,.55,0),root.Position,Vector3.new(8,4,4.5)) then
   s.nextCarHit=now+4;s.knockedUntil=now+1.3;s.dodgingUntil=0;s.sprintRequested=false;s.nextHeal=now+10
   player:SetAttribute("DodgeEnds",0);player:SetAttribute("KnockdownEnds",workspace:GetServerTimeNow()+1.3)
   local damage=math.clamp(math.floor(car.speed*1.1),15,35)
   if humanoid.Health<=damage then eject(player,humanoid);s.knockedUntil=0
   else
    humanoid.Health-=damage;humanoid.PlatformStand=true;humanoid.AutoRotate=false;root:SetNetworkOwner(nil)
    local direction=(nextFrame.Position-previous.Position).Unit
    local sideways=Vector3.new(0,0,car.lane%240<120 and -1 or 1)
    root.AssemblyLinearVelocity=direction*8+sideways*28+Vector3.new(0,12,0);root.AssemblyAngularVelocity=Vector3.new(0,0,4)*car.direction
    task.delay(1.3,function()
     if player.Character==character and humanoid.Parent and humanoid.Health>0 then
      humanoid.PlatformStand=false;humanoid.AutoRotate=true;root.AssemblyAngularVelocity=Vector3.zero
      local look=root.CFrame.LookVector;look=Vector3.new(look.X,0,look.Z);if look.Magnitude<.01 then look=Vector3.new(0,0,-1) end
      local recovered=root.Position+Vector3.new(0,2,0)
      root.AssemblyLinearVelocity=Vector3.zero
      root.CFrame=CFrame.lookAt(recovered,recovered+look)
      humanoid:ChangeState(Enum.HumanoidStateType.GettingUp);root:SetNetworkOwnershipAuto()
     end
    end)
   end
   state(player,"Traffic hit · -"..damage.." HP")
  end
 end
end
for _,obj in ipairs(workspace.ScreamSimulatorWorld.QuestObjects:GetDescendants()) do
 if obj:IsA("ProximityPrompt") then obj.Triggered:Connect(function(p)
  local s=sessions[p];local _,r=parts(p);local marker=obj.Parent
  if not s or not r or (r.Position-marker.Position).Magnitude>12 then return end
  local kind=marker:GetAttribute("QuestAction")
  if kind=="Litter" and s.activeQuest=="beach" then
   if s.collected[marker.Name] then state(p,"Already collected this bottle.");return end
   s.collected[marker.Name]=true;questProgress(p,"Litter");effect:FireClient(p,"Collected",marker)
  elseif kind=="Pickup" and s.activeQuest=="delivery" then s.questDeadline=os.clock()+90;s.carrying=true;state(p,"Order collected · deliver to the boardwalk stage in 90s")
  elseif kind=="Dropoff" and s.activeQuest=="delivery" then
   if s.carrying and s.questDeadline and os.clock()<=s.questDeadline then questProgress(p,"Delivery");s.carrying=false;s.questDeadline=nil
   else state(p,"Pick up a fresh order from the café first.") end
  elseif kind=="RaceStart" and s.activeQuest=="sprint" then s.questDeadline=os.clock()+25;s.raceStart=os.clock();state(p,"Go! Follow the boardwalk to the pier finish · 25s")
  elseif kind=="RaceFinish" and s.activeQuest=="sprint" then
   if s.raceStart and os.clock()-s.raceStart>=3 and s.questDeadline and os.clock()<=s.questDeadline then questProgress(p,"Race");s.questDeadline=nil;s.raceStart=nil
   else state(p,"Start at the lifeguard tower and beat 25 seconds.") end
  else state(p,"Accept the matching quest from the Quests menu first.") end
 end) end
end
action.OnServerEvent:Connect(function(p,verb,arg)
 local s=sessions[p];if not s or type(verb)~="string" then return end
 if verb=="Cast" then cast(p);return elseif verb=="Dodge" then dodge(p);return
 elseif verb=="Sprint" then if type(arg)=="boolean" then s.sprintRequested=arg end;return end
 local now=os.clock();if now<s.nextAction then return end;s.nextAction=now+0.15
 if verb=="Sync" then state(p)
 elseif verb=="Talk" then talk(p,arg)
 elseif verb=="DevCommand" then dev(p,arg)
 elseif verb=="EquipSound" then local sound=type(arg)=="string" and Config.GetSound(arg);if sound and sound.level<=s.data.level then s.data.sound=sound.id;state(p,sound.name.." equipped") end
 elseif verb=="SetAura" and type(arg)=="string" and Config.Auras[arg] then s.data.aura=arg;state(p)
 elseif verb=="AcceptQuest" then
  local q=type(arg)=="string" and Config.GetQuest(arg)
  if q then local v=s.data.quests[q.id];if not v then v={progress=0,claimed=false};s.data.quests[q.id]=v end
   if not v.claimed then s.activeQuest=q.id;s.questDeadline=nil;s.carrying=false;s.raceStart=nil;state(p,q.name.." accepted") end end
 elseif verb=="ClaimQuest" then
  local q=type(arg)=="string" and Config.GetQuest(arg);local v=q and s.data.quests[q.id]
  if v and not v.claimed and v.progress>=q.goal then v.claimed=true;s.data.coins+=q.coins;xp(p,q.xp);if s.activeQuest==q.id then s.activeQuest=nil end;state(p,"Quest reward · +"..q.xp.." XP · +"..q.coins.." coins") end
 elseif verb=="SetSettings" and type(arg)=="table" then
  if type(arg.volume)=="number" and arg.volume==arg.volume then s.data.settings.volume=math.clamp(arg.volume,0,1) end
  if type(arg.reducedShake)=="boolean" then s.data.settings.reducedShake=arg.reducedShake end;state(p)
 end
end)
local function joined(p)
 local data,save=Profiles.Load(p.UserId);if not p.Parent then return end
 local s={data=data,canSave=save,protectedUntil=0,nextCast=0,nextDodge=0,dodgingUntil=0,nextAction=0,nextHeal=os.clock()+10,
 botRewards={},koRewards={},collected={},sprintRequested=false,sprintCharge=10,sprintLockedUntil=0,lastStep=os.clock()};sessions[p]=s
 local function spawn(c)
  local h=c:WaitForChild("Humanoid",10);if not h or p.Character~=c then return end
  h.MaxHealth=Config.HealthForLevel(s.data.level);h.Health=h.MaxHealth;h.WalkSpeed=16;s.sprintCharge=10;s.sprintRequested=false;s.sprintLockedUntil=0;s.dodgingUntil=0
  protect(p,s);state(p)
 end
 p.CharacterAdded:Connect(spawn);if p.Character then task.spawn(spawn,p.Character) end
 state(p,"Welcome · train for XP, unlock screams, and explore the coast")
end
Players.PlayerAdded:Connect(joined);for _,p in ipairs(Players:GetPlayers()) do task.spawn(joined,p) end
Players.PlayerRemoving:Connect(function(p) local s=sessions[p];if s and s.canSave then Profiles.Save(p.UserId,s.data) end;sessions[p]=nil end)
task.spawn(function()
 local tick=0
 while true do task.wait(0.1);tick+=1;local now=os.clock()
  for p,s in pairs(sessions) do
   local dt=math.clamp(now-s.lastStep,0,.25);s.lastStep=now;local _,r,h=parts(p)
   if s.sprintLockedUntil>0 and now>=s.sprintLockedUntil then s.sprintLockedUntil=0;s.sprintCharge=10 end
   local running=h and s.sprintRequested and s.sprintCharge>0 and now>=s.sprintLockedUntil
   if running then s.sprintCharge=math.max(0,s.sprintCharge-dt);if s.sprintCharge==0 then running=false;s.sprintLockedUntil=now+5 end
   elseif now>=s.sprintLockedUntil then s.sprintCharge=math.min(10,s.sprintCharge+dt*2) end
   if h then h.WalkSpeed=now<(s.knockedUntil or 0) and 0 or now<s.dodgingUntil and 0 or running and 25 or 16
    if h.Health<h.MaxHealth and now>=s.nextHeal then h.Health=math.min(h.MaxHealth,h.Health+h.MaxHealth*.2);s.nextHeal=now+10 end
    if r.Position.Y< -20 then p.Character:PivotTo(World.SafeSpawn);protect(p,s) end
   end
   if s.questDeadline and now>s.questDeadline then s.questDeadline=nil;s.carrying=false;s.raceStart=nil;state(p,"Time's up · restart at the quest's starting point") end
   p:SetAttribute("SprintCharge",s.sprintCharge);p:SetAttribute("SprintCooldown",math.max(0,s.sprintLockedUntil-now));p:SetAttribute("Sprinting",running==true)
   if tick%5==0 then state(p) end
  end
 end
end)
task.spawn(function() while true do task.wait(60);for p,s in pairs(sessions) do if s.canSave then task.spawn(Profiles.Save,p.UserId,s.data) end end end end)
game:BindToClose(function() local pending=0;for p,s in pairs(sessions) do if s.canSave then pending+=1;task.spawn(function() Profiles.Save(p.UserId,s.data);pending-=1 end) end end;local deadline=os.clock()+25;while pending>0 and os.clock()<deadline do task.wait(.1) end end)
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="5">
      <Properties>
        <string name="Name">City</string>
        <string name="Source"><![CDATA[-- Original Barcelona-inspired city geometry. All art is generated locally; no downloaded scripts/assets.
local City={}
local V=Vector3.new
local palette={Color3.fromRGB(219,192,151),Color3.fromRGB(227,206,171),Color3.fromRGB(195,151,117),Color3.fromRGB(234,214,180),Color3.fromRGB(191,169,135),Color3.fromRGB(220,174,143)}
local stone=Color3.fromRGB(207,191,159)
local dark=Color3.fromRGB(48,62,61)
local iron=Color3.fromRGB(39,53,53)
local glass=Color3.fromRGB(66,104,112)
local leaf=Color3.fromRGB(80,120,72)
local terra=Color3.fromRGB(168,89,60)
local cream=Color3.fromRGB(245,224,180)
local rng=Random.new(230926)
local function part(parent,name,size,cf,color,material,solid)
 local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=typeof(cf)=="CFrame" and cf or CFrame.new(cf);p.Color=color;p.Material=material or Enum.Material.SmoothPlastic
 p.Anchored=true;p.CanCollide=solid~=false;p.CanQuery=solid~=false;p.CanTouch=false;p.Parent=parent;return p
end
local function model(parent,name) local m=Instance.new("Model");m.Name=name;m.Parent=parent;return m end
local function ellipsoid(parent,name,size,position,color,material)
 local p=part(parent,name,size,position,color,material,false);local mesh=Instance.new("SpecialMesh");mesh.MeshType=Enum.MeshType.Sphere;mesh.Parent=p;return p
end
local function cylinder(parent,name,radius,height,pos,color,material)
 local p=part(parent,name,V(height,radius*2,radius*2),CFrame.new(pos)*CFrame.Angles(0,0,math.pi/2),color,material);p.Shape=Enum.PartType.Cylinder;return p
end
local function sign(parent,text,cf,width)
 local p=part(parent,"FacadeSign",V(width,2,.25),cf,dark,nil,false)
 local g=Instance.new("SurfaceGui");g.Face=Enum.NormalId.Front;g.PixelsPerStud=28;g.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud;g.Parent=p
 local t=Instance.new("TextLabel");t.Size=UDim2.fromScale(1,1);t.BackgroundTransparency=1;t.Font=Enum.Font.GothamBold;t.TextColor3=cream;t.TextScaled=true;t.Text=text;t.Parent=g;return p
end
local function tree(parent,x,z,palm)
 local h=palm and rng:NextNumber(14,20) or rng:NextNumber(10,15)
 cylinder(parent,"TreeTrunk",.65,h,V(x,h/2+1,z),Color3.fromRGB(116,96,69),Enum.Material.Wood)
 if palm then
  for j=1,7 do
   local cf=CFrame.new(x,h+1,z)*CFrame.Angles(0,j*math.pi*2/7,0)
   for k=1,3 do part(parent,"PalmFrond",V(2.4,.22,3.5),cf*CFrame.new(0,-(k-1)^2*.35,k*2.2)*CFrame.Angles((k-2)*.23,0,0),leaf,Enum.Material.Grass,false) end
  end
 else
  for j=1,3 do ellipsoid(parent,"PlaneTreeCrown",V(9+j,7,9+j),V(x+(j-2)*2,h+j,z+(j%2)*2),Color3.fromRGB(71+j*9,113+j*8,64+j*3),Enum.Material.Grass) end
 end
end
local function lamp(parent,x,z)
 cylinder(parent,"StreetLamp",.22,12,V(x,7,z),iron,Enum.Material.Metal)
 local top=part(parent,"Lantern",V(1.4,2,1.4),V(x,13,z),cream,Enum.Material.Neon,false)
 part(parent,"LanternCap",V(2,.3,2),V(x,14.2,z),iron,Enum.Material.Metal,false)
 -- Limit dynamic lights: bright lantern geometry reads well without hundreds of shadow maps.
 if math.abs(x)<100 and math.abs(z)<100 then local l=Instance.new("PointLight");l.Range=16;l.Brightness=.3;l.Color=cream;l.Parent=top end
end
local function bench(parent,cf)
 part(parent,"BenchSeat",V(8,.5,2.5),cf*CFrame.new(0,2,0),Color3.fromRGB(139,100,66),Enum.Material.WoodPlanks)
 part(parent,"BenchBack",V(8,2.2,.35),cf*CFrame.new(0,3.2,1.1),Color3.fromRGB(139,100,66),Enum.Material.WoodPlanks)
 for _,x in ipairs({-3,3}) do part(parent,"BenchLeg",V(.35,2,.9),cf*CFrame.new(x,1,0),iron,Enum.Material.Metal) end
end
local function cafe(parent,x,z,color)
 cylinder(parent,"CafeTable",2,.25,V(x,3,z),stone,Enum.Material.Marble)
 cylinder(parent,"TableLeg",.2,2,V(x,2,z),iron,Enum.Material.Metal)
 for _,dx in ipairs({-3.2,3.2}) do
  part(parent,"CafeChair",V(2,.4,2),V(x+dx,2,z),color,Enum.Material.Wood)
  part(parent,"CafeChairBack",V(.4,2.7,2),V(x+dx+(dx>0 and .9 or -.9),3,z),color,Enum.Material.Wood)
 end
 cylinder(parent,"Cup",.3,.55,V(x,3.45,z),cream,Enum.Material.CeramicTiles)
end
local shops={"FORN DEL SOL","CAFÈ MARINA","FLORS I FULLes","LLIBRERIA","GELATS","MERCAT LOCAL","TAPES DEL BARRI","ESTUDI D'ART","PANADERIA","MÚSICA","FRUITA FRESCA","CASA DE TE"}
local function building(parent,cf,w,d,floors,index,style)
 local m=model(parent,"Casa_"..index)
 local h=floors*8+7;local color=palette[Random.new(index*7919):NextInteger(1,#palette)]
 local function b(name,size,pos,c,mat,solid) return part(m,name,size,cf*CFrame.new(pos),c,mat,solid) end
 b("Masonry",V(w,h,d),V(0,h/2+1,0),color,Enum.Material.Plaster)
 b("StonePlinth",V(w+.3,5,d+.3),V(0,3.5,0),stone,Enum.Material.Limestone)
 b("Cornice",V(w+1.7,.8,d+1.7),V(0,h+1,0),cream,Enum.Material.Limestone)
 b("TerracottaRoof",V(w+1.1,.5,d+1.1),V(0,h+1.7,0),terra,Enum.Material.RoofShingles)
 b("RoofParapet",V(w,.9,.5),V(0,h+2,-d/2),stone,Enum.Material.Limestone)
 b("Chimney",V(2,4,2),V(w*.25,h+3,0),stone,Enum.Material.Brick)
 b("EntranceDoor",V(3.5,5.8,.3),V(0,4,-d/2-.35),Color3.fromRGB(84,66,49),Enum.Material.Wood,false)
 b("DoorTransom",V(3.4,1.1,.4),V(0,7,-d/2-.35),glass,Enum.Material.Glass,false)
 for _,dx in ipairs({-w/2+.6,w/2-.6}) do b("CornerPilaster",V(1.2,h,.6),V(dx,h/2+1,-d/2-.4),stone,Enum.Material.Limestone,false) end
 local cols=math.max(2,math.floor(w/9));local spacing=(w-7)/cols
 for floor=1,floors do
  local y=4+floor*8
  for col=1,cols do
   local x=(col-(cols+1)/2)*spacing
   b("WindowRecess",V(3.1,4.6,.2),V(x,y,-d/2-.16),iron,nil,false)
   b("WindowGlass",V(2.6,4.1,.22),V(x,y,-d/2-.3),glass,Enum.Material.Glass,false)
   b("WindowLintel",V(3.8,.4,.6),V(x,y+2.5,-d/2-.35),cream,Enum.Material.Limestone,false)
   if style=="Born" or col%2==0 then
    b("Shutter",V(.8,4.4,.35),V(x-2,y,-d/2-.35),Color3.fromRGB(73,101,83),Enum.Material.Wood,false)
    b("Shutter",V(.8,4.4,.35),V(x+2,y,-d/2-.35),Color3.fromRGB(73,101,83),Enum.Material.Wood,false)
   end
   if (floor+col+index)%2==0 then
    b("BalconySlab",V(4.7,.3,2.1),V(x,y-2.2,-d/2-1),stone,Enum.Material.Limestone,false)
    b("IronBalconyRail",V(4.7,1,.15),V(x,y-1.25,-d/2-2),iron,Enum.Material.Metal,false)
    for _,dx in ipairs({-1.7,0,1.7}) do b("Baluster",V(.12,1.6,.15),V(x+dx,y-1.4,-d/2-2),iron,Enum.Material.Metal,false) end
    if col==1 then b("WindowFlowers",V(3,.55,.55),V(x,y-.9,-d/2-2),Color3.fromRGB(174,79,100),Enum.Material.Grass,false) end
   end
  end
  for col=1,cols do
   local x=(col-(cols+1)/2)*spacing
   b("CourtyardWindow",V(2.8,4,.15),V(x,y,d/2+.1),glass,Enum.Material.Glass,false)
  end
  for _,side in ipairs({-1,1}) do for k=-1,1 do
   b("SideWindow",V(.15,4,2.7),V(side*(w/2+.1),y,k*d/4),glass,Enum.Material.Glass,false)
  end end
 end
 for _,x in ipairs({-w*.23,w*.23}) do
  b("ShopGlazing",V(w*.31,5.3,.25),V(x,4,-d/2-.25),glass,Enum.Material.Glass,false)
  b("ShopAwning",V(w*.35,.5,3),V(x,7,-d/2-1),index%2==0 and Color3.fromRGB(118,67,57) or Color3.fromRGB(61,111,99),Enum.Material.Fabric,false)
 end
 sign(m,shops[(index-1)%#shops+1],cf*CFrame.new(0,8.7,-d/2-.5),math.min(w-3,26))
 if style=="Modernista" then
  for i=-2,2 do
   local ornament=b("CeramicCrown",V(3,2.8+math.abs(i),2),V(i*w/6,h+2.5,-d/2),i%2==0 and Color3.fromRGB(78,146,145) or cream,Enum.Material.CeramicTiles,false)
   ornament.Shape=Enum.PartType.Ball
  end
 end
 return m
end
local function octagon(parent,x,z)
 part(parent,"ChamferedPaving",V(208,1,152),V(x,.3,z),stone,Enum.Material.Pavement)
 part(parent,"ChamferedPaving",V(152,1,208),V(x,.3,z),stone,Enum.Material.Pavement)
 -- Four diamond infills turn the square cutouts into 45-degree corners.
 for _,sx in ipairs({-1,1}) do for _,sz in ipairs({-1,1}) do
  part(parent,"Chamfer",V(39.6,1,39.6),CFrame.new(x+sx*76,.3,z+sz*76)*CFrame.Angles(0,math.pi/4,0),stone,Enum.Material.Pavement)
 end end
end
local function garden(parent,x,z)
 part(parent,"CourtyardGarden",V(110,.3,110),V(x,1,z),Color3.fromRGB(112,138,79),Enum.Material.Grass)
 part(parent,"GardenPath",V(12,.12,110),V(x,1.2,z),Color3.fromRGB(209,192,153),Enum.Material.Pavement)
 part(parent,"GardenPath",V(110,.12,12),V(x,1.21,z),Color3.fromRGB(209,192,153),Enum.Material.Pavement)
 for _,dx in ipairs({-33,33}) do for _,dz in ipairs({-33,33}) do tree(parent,x+dx,z+dz,false) end end
 bench(parent,CFrame.new(x+18,0,z+14));bench(parent,CFrame.new(x-18,0,z-14)*CFrame.Angles(0,math.pi,0))
end
local function block(parent,x,z,index,style,walk,activities)
 local m=model(parent,style.."Block_"..index);octagon(m,x,z);garden(m,x,z)
 for _,side in ipairs({-1,1}) do
  for j,offset in ipairs({-40,40}) do
   building(m,CFrame.lookAt(V(x+offset,0,z+side*82),V(x+offset,0,z+side*150)),68,28,3+(index+j)%3,index*20+j+(side+1)*2,style)
   building(m,CFrame.lookAt(V(x+side*82,0,z+offset),V(x+side*150,0,z+offset)),68,28,3+(index+j+1)%3,index*20+7+j+(side+1)*2,style)
  end
 end
 for _,sx in ipairs({-1,1}) do for _,sz in ipairs({-1,1}) do
  building(m,CFrame.lookAt(V(x+sx*79,0,z+sz*79),V(x+sx*150,0,z+sz*150)),34,23,4+index%2,index*20+14+(sx+1)+(sz+1)*2,style)
 end end
 -- Perimeter paths never cross the buildings; courtyard entrances are between facades.
 for _,side in ipairs({-1,1}) do for _,n in ipairs({-70,0,70}) do
  table.insert(walk,V(x+n,4,z+side*109));table.insert(walk,V(x+side*109,4,z+n))
 end end
 table.insert(activities,{position=V(x,4,z),kind="Rest"})
 for _,dx in ipairs({-110,110}) do lamp(m,x+dx,z-60);tree(m,x+dx,z+42,false) end
 if index%2==0 then cafe(m,x,z+108,Color3.fromRGB(103,129,108)) end
end
local function oldTown(parent,x,z,index,walk,activities)
 local m=model(parent,"BornLanes_"..index);octagon(m,x,z)
 part(m,"OldTownPaving",V(185,.12,185),V(x,.88,z),Color3.fromRGB(179,163,139),Enum.Material.Cobblestone)
 -- Staggered, narrow houses create small lanes and a sheltered café court.
 for row=-1,1 do for col=-2,2 do
  if row==0 and math.abs(col)<2 then continue end
  local px=x+col*37+(row%2)*5;local pz=z+row*65
  local yaw=(row==1 and math.pi or 0)+(col%2==0 and .035 or -.035)
  building(m,CFrame.new(px,0,pz)*CFrame.Angles(0,yaw,0),29,32,2+(index+col+row)%3,index*100+row*10+col,"Born")
 end end
 for n=-2,2 do table.insert(walk,V(x+n*28,4,z+29));table.insert(walk,V(x+n*28,4,z-29)) end
 for _,dx in ipairs({-22,22}) do cafe(m,x+dx,z,Color3.fromRGB(132,77,61));tree(m,x+dx,z+12,false) end
 table.insert(activities,{position=V(x,4,z),kind="Browse"})
 for j=-2,2 do
  local cf=CFrame.new(x+j*25,17,z+27)
  part(m,"FestivalPennant",V(5,3,.12),cf,({cream,terra,Color3.fromRGB(81,144,147)})[(j+2)%3+1],Enum.Material.Fabric,false)
 end
 part(m,"FestivalString",V(120,.08,.08),V(x,18.5,z+27),iron,nil,false)
 sign(m,"CARRER DEL SOL",CFrame.new(x-60,6,z-48),19)
end
local function waterfrontHomes(parent,x,z,index,walk,activities)
 local m=model(parent,"MaritimeQuarter_"..index);octagon(m,x,z)
 for row=-1,1,2 do for j=-2,2 do
  building(m,CFrame.new(x+j*37,0,z+row*59)*CFrame.Angles(0,row==1 and math.pi or 0,0),31,32,2+(j+index)%2,index*100+j+row*10,"Born")
 end end
 for i=-3,3 do
  tree(m,x+i*26,z,true);table.insert(walk,V(x+i*26,4,z+14))
 end
 for _,dx in ipairs({-45,45}) do cafe(m,x+dx,z+26,Color3.fromRGB(74,132,154));table.insert(activities,{position=V(x+dx,4,z+20),kind="Rest"}) end
end
local function landmarkQuarter(parent,x,z,walk,activities)
 local m=model(parent,"TorreLlumQuarter");octagon(m,x,z)
 part(m,"InnovationGarden",V(185,.15,185),V(x,.9,z),Color3.fromRGB(106,135,83),Enum.Material.Grass)
 for _,dx in ipairs({-52,52}) do part(m,"PedestrianWalk",V(15,.1,185),V(x+dx,1,z),stone,Enum.Material.Pavement);table.insert(walk,V(x+dx,4,z)) end
 -- Original tapered glass landmark, a visible orientation point for the east district.
 for level=0,17 do
  local taper=level>12 and (level-12)*2.4 or 0
  cylinder(m,"TowerGlass",23-taper,7.7,V(x,5+level*8,z),Color3.fromRGB(64+level*2,112+level,130+level),Enum.Material.Glass)
  cylinder(m,"TowerSunshade",23.5-taper,.35,V(x,8.6+level*8,z),Color3.fromRGB(159,185,182),Enum.Material.Metal)
 end
 ellipsoid(m,"TowerCrown",V(23,17,23),V(x,146,z),Color3.fromRGB(100,154,170),Enum.Material.Glass)
 for _,dx in ipairs({-75,75}) do for _,dz in ipairs({-70,0,70}) do tree(m,x+dx,z+dz,false) end end
 for _,dz in ipairs({-65,65}) do building(m,CFrame.new(x,0,z+dz)*CFrame.Angles(0,dz>0 and math.pi or 0,0),70,24,2,700+dz,"Modernista") end
 for _,dx in ipairs({-50,50}) do bench(m,CFrame.new(x+dx,0,z+34));table.insert(activities,{position=V(x+dx,4,z+26),kind="Watch"}) end
end
local function fountain(parent,x,z)
 cylinder(parent,"FountainBasin",15,1,V(x,1.5,z),stone,Enum.Material.Marble)
 cylinder(parent,"FountainWater",13,.2,V(x,2.1,z),Color3.fromRGB(75,166,177),Enum.Material.Glass)
 cylinder(parent,"FountainPedestal",2,5,V(x,4,z),cream,Enum.Material.Marble)
 cylinder(parent,"FountainBowl",6,.7,V(x,6.4,z),stone,Enum.Material.Marble)
 for i=1,8 do local a=i*math.pi/4;local f=part(parent,"WaterJet",V(.15,3,.15),V(x+math.cos(a)*4,4.5,z+math.sin(a)*4),Color3.fromRGB(153,216,218),Enum.Material.Glass,false);f.Transparency=.35 end
end
local function square(parent,x,z,name,walk,activities)
 local m=model(parent,name);octagon(m,x,z)
 part(m,"SquareInlay",V(130,.08,130),CFrame.new(x,.86,z)*CFrame.Angles(0,math.pi/4,0),Color3.fromRGB(162,137,113),Enum.Material.Cobblestone)
 fountain(m,x,z)
 for i=1,8 do local a=i*math.pi/4;local px,pz=x+math.cos(a)*58,z+math.sin(a)*58
  tree(m,px,pz,false);bench(m,CFrame.lookAt(V(x+math.cos(a)*43,0,z+math.sin(a)*43),V(x,0,z)))
  table.insert(walk,V(x+math.cos(a)*32,4,z+math.sin(a)*32));table.insert(activities,{position=V(x+math.cos(a)*32,4,z+math.sin(a)*32),kind="Watch"})
 end
 for i=1,4 do cafe(m,x-75+i*30,z+81,Color3.fromRGB(116,93,70)) end
 sign(m,name:upper(),CFrame.new(x,7,z+98),34)
 return m
end
local function basilica(parent,x,z)
 local m=model(parent,"BasilicaDelSol")
 part(m,"BasilicaNave",V(70,50,112),V(x,26,z),Color3.fromRGB(191,165,123),Enum.Material.Limestone)
 for _,dx in ipairs({-30,-10,10,30}) do
  
  for tier=0,4 do cylinder(m,"CarvedSpire",6-tier*.9,18,V(x+dx,57+tier*18,z+49),stone,Enum.Material.Limestone) end
  ellipsoid(m,"MosaicFinial",V(5,12,5),V(x+dx,145,z+49),Color3.fromRGB(222,175,74),Enum.Material.CeramicTiles)
 end
 for _,side in ipairs({-1,1}) do for j=-3,3 do
  part(m,"FlyingButtress",V(3,43,5),CFrame.new(x+side*39,25,z+j*14)*CFrame.Angles(0,0,side*.12),stone,Enum.Material.Limestone)
  part(m,"StainedGlass",V(.3,25,5),V(x+side*35.2,26,z+j*14),j%2==0 and Color3.fromRGB(70,139,171) or Color3.fromRGB(204,125,77),Enum.Material.Glass,false)
 end end
 for _,dx in ipairs({-20,0,20}) do part(m,"ArchDoor",V(12,18,.4),V(x+dx,10,z+56.4),dark,Enum.Material.Wood) end
 sign(m,"BASÍLICA DEL SOL",CFrame.new(x,6,z+85)*CFrame.Angles(0,math.pi,0),30)
end
local function market(parent,x,z,walk,activities)
 local m=model(parent,"MercatDelMar");octagon(m,x,z)
 for _,sx in ipairs({-1,1}) do for j=-3,3 do part(m,"MarketColumn",V(1,23,1),V(x+sx*60,12,z+j*23),Color3.fromRGB(57,94,84),Enum.Material.Metal) end end
 for _,side in ipairs({-1,1}) do part(m,"MarketRoof",V(66,1,165),CFrame.new(x+side*30,27,z)*CFrame.Angles(0,0,side*-.16),Color3.fromRGB(109,137,118),Enum.Material.Metal) end
 for i=1,8 do
  local px=x+((i-1)%2==0 and -35 or 35);local pz=z-60+math.floor((i-1)/2)*39
  part(m,"ProduceStall",V(20,3,8),V(px,2.3,pz),Color3.fromRGB(141,97,65),Enum.Material.WoodPlanks)
  for j=-3,3 do ellipsoid(m,"Produce",V(1.8,1.5,1.8),V(px+j*2,4.4,pz),i%2==0 and Color3.fromRGB(213,117,64) or Color3.fromRGB(114,152,67),Enum.Material.SmoothPlastic) end
  sign(m,({"FRUITA","FLORS","PA FRESC","GELATS"})[(i-1)%4+1],CFrame.new(px,7,pz-4),18)
  table.insert(activities,{position=V(px,4,pz-11),kind="Browse"});table.insert(walk,V(px,4,pz-11))
 end
 sign(m,"MERCAT DEL MAR",CFrame.new(x,23,z-84),75)
end
local function coast(parent,walk,activities)
 local m=model(parent,"BarcelonetaCoast")
 part(m,"Beach",V(1440,3,170),V(0,-.5,515),Color3.fromRGB(227,208,156),Enum.Material.Sand)
 part(m,"Mediterranean",V(3200,1,1800),V(0,-1,1500),Color3.fromRGB(48,143,169),Enum.Material.Glass,false).Transparency=.16
 part(m,"PasseigMaritim",V(1440,1,52),V(0,.25,401),Color3.fromRGB(197,176,141),Enum.Material.Pavement)
 for x=-680,680,40 do
  part(m,"PromenadeTileBand",V(1,.05,52),V(x,.79,401),Color3.fromRGB(152,138,117),Enum.Material.Cobblestone,false)
  if x%80==0 then tree(m,x,421,true);lamp(m,x,380);bench(m,CFrame.new(x+14,0,412));end
  table.insert(walk,V(x,3.8,403));table.insert(activities,{position=V(x,3.8,407),kind="Stroll"})
 end
 for i=1,18 do
  local x=-660+(i-1)*77;local z=470+(i%3)*25;local color=i%2==0 and Color3.fromRGB(215,116,85) or Color3.fromRGB(78,153,157)
  cylinder(m,"ParasolPole",.18,7,V(x,4,z),stone,Enum.Material.Metal)
  for j=1,8 do
   local w=Instance.new("WedgePart");w.Name="StripedParasol";w.Size=V(4.5,2,5.7);w.CFrame=CFrame.new(x,7.5,z)*CFrame.Angles(0,j*math.pi/4,0)*CFrame.new(0,0,2.5);w.Color=j%2==0 and color or cream;w.Material=Enum.Material.Fabric;w.Anchored=true;w.CanCollide=false;w.CanQuery=false;w.Parent=m
  end
  part(m,"BeachLounger",V(3,.5,7),V(x+4,1.6,z+5),cream,Enum.Material.Fabric)
  part(m,"LoungerBack",V(3,3,.4),CFrame.new(x+4,2.8,z+8)*CFrame.Angles(.4,0,0),color,Enum.Material.Fabric)
  if i%3==0 then ellipsoid(m,"SandDune",V(27,4,18),V(x,.7,565),Color3.fromRGB(219,200,148),Enum.Material.Sand) end
 end
 for x=-700,700,60 do local p=part(m,"SurfLine",V(40,.05,1.2),V(x,.08,600),Color3.fromRGB(214,235,225),nil,false);p.Transparency=.35 end
 part(m,"TimberPier",V(28,1.5,125),V(525,1.5,537),Color3.fromRGB(144,113,78),Enum.Material.WoodPlanks)
 for z=480,590,22 do for _,x in ipairs({511,539}) do cylinder(m,"PierPost",.4,6,V(x,2,z),dark,Enum.Material.Wood) end end
 for _,x in ipairs({511,539}) do part(m,"PierRail",V(.5,.5,110),V(x,4,535),stone,Enum.Material.Wood) end
 -- Café and performance terrace are entirely pedestrian.
 building(m,CFrame.new(-480,0,399)*CFrame.Angles(0,math.pi,0),48,23,1,501,"Marina")
 for i=1,4 do cafe(m,-522+i*17,439,Color3.fromRGB(59,115,106)) end
 part(m,"EncoreStage",V(32,1.5,20),V(150,1.7,428),dark,Enum.Material.WoodPlanks)
 for _,x in ipairs({136,164}) do part(m,"StageSpeaker",V(3,6,3),V(x,5,433),iron,Enum.Material.Metal) end
 sign(m,"MÚSICA A LA MAR",CFrame.new(150,8,437)*CFrame.Angles(0,math.pi,0),30)
 part(m,"LifeguardCabin",V(14,8,12),V(-240,7,458),Color3.fromRGB(112,173,181),Enum.Material.WoodPlanks)
 part(m,"LifeguardRoof",V(18,.7,16),V(-240,11.5,458),terra,Enum.Material.RoofShingles)
 for _,x in ipairs({-246,-234}) do part(m,"LifeguardLeg",V(1,4,1),V(x,2,458),dark,Enum.Material.Wood) end
 for _,x in ipairs({-70,-30}) do cylinder(m,"VolleyballPost",.3,9,V(x,5.5,505),iron,Enum.Material.Metal) end
 for y=5,9 do part(m,"VolleyballNet",V(40,.1,.1),V(-50,y,505),cream,nil,false) end
 for x=-70,-30,2 do part(m,"VolleyballNet",V(.1,4,.1),V(x,7,505),cream,nil,false) end
 return m
end
function City.Build(parent)
 rng=Random.new(230926)
 local walk,activities={},{}
 local ground=part(parent,"CityLand",V(1440,3,1200),V(0,-1.6,0),Color3.fromRGB(126,139,108),Enum.Material.Ground)
 ground:SetAttribute("GroundSurface",true)
 local backdrop=model(parent,"CoastalBackdrop")
 part(backdrop,"Mainland",V(5200,10,2500),V(0,-7,-1850),Color3.fromRGB(105,127,91),Enum.Material.Grass)
 for i=-5,5 do
  ellipsoid(backdrop,"CollserolaRidge",V(1300,480+(i%3)*80,1400),V(i*490,-175,-2350-math.abs(i)*70),Color3.fromRGB(105,129,106),Enum.Material.Grass)
 end
 local roads=model(parent,"Boulevards")
 for x=-720,720,240 do part(roads,"TrafficAvenue",V(28,.2,960),V(x,0,-120),Color3.fromRGB(64,65,61),Enum.Material.Asphalt) end
 for z=-600,360,240 do part(roads,"TrafficStreet",V(1440,.2,28),V(0,.01,z),Color3.fromRGB(64,65,61),Enum.Material.Asphalt) end
 for x=-700,700,24 do for _,z in ipairs({-360,120,360}) do part(roads,"LaneMark",V(10,.03,.16),V(x,.14,z),cream,nil,false) end end
 for x=-480,480,240 do for z=-360,360,240 do
  for d=-8,8,4 do part(roads,"Crosswalk",V(2,.03,7),V(x+d,.15,z+21),cream,nil,false);part(roads,"Crosswalk",V(7,.03,2),V(x+21,.15,z+d),cream,nil,false) end
 end end
 local index=0
 for z=-480,240,240 do for x=-600,600,240 do
  index+=1
  if x==-600 and z==240 then square(parent,x,z,"Plaça del Sol",walk,activities)
  elseif x==-120 and z==0 then square(parent,x,z,"Plaça Central",walk,activities)
  elseif x==120 and z==0 then market(parent,x,z,walk,activities)
  elseif x==120 and z==-240 then
   local m=model(parent,"BasilicaSquare");octagon(m,x,z);basilica(m,x,z)
   for _,dx in ipairs({-93,93}) do table.insert(walk,V(x+dx,4,z));tree(m,x+dx,z+60,false) end
  elseif x==-360 and z==240 then
   local m=model(parent,"RamblaGardens");octagon(m,x,z)
   part(m,"RamblaWalk",V(50,.15,200),V(x,1,z),Color3.fromRGB(221,202,164),Enum.Material.Cobblestone)
   for n=-80,80,32 do tree(m,x-35,z+n,false);tree(m,x+35,z+n,false);bench(m,CFrame.new(x+22,0,z+n));table.insert(walk,V(x,4,z+n));table.insert(activities,{position=V(x,4,z+n),kind="Watch"}) end
  elseif x==600 and z==-240 then landmarkQuarter(parent,x,z,walk,activities)
  elseif x>=360 and z==0 then oldTown(parent,x,z,index,walk,activities)
  elseif x>=120 and z==240 then waterfrontHomes(parent,x,z,index,walk,activities)
  else block(parent,x,z,index,(x<0 and z<0) and "Modernista" or (x>300 and z>0) and "Born" or "Eixample",walk,activities) end
 end end
 coast(parent,walk,activities)
 -- Continuous border markings stay flat; warning plaques are on pedestrian corners.
 local red=Color3.fromRGB(209,107,83)
 for _,x in ipairs({-480,480}) do part(parent,"PvPPavingBoundary",V(.45,.04,720),V(x,.19,0),red,nil,false) end
 for _,z in ipairs({-360,360}) do part(parent,"PvPPavingBoundary",V(960,.04,.45),V(0,.19,z),red,nil,false) end
 for _,x in ipairs({-448,448}) do for _,z in ipairs({-332,332}) do sign(parent,"ARENA DISTRICT • PvP",CFrame.new(x,5,z),24) end end
 local quests=Instance.new("Folder");quests.Name="QuestObjects";quests.Parent=parent
 local function marker(name,kind,pos,text)
  local p=part(quests,name,V(1,1.6,1),pos,kind=="Litter" and Color3.fromRGB(65,145,143) or Color3.fromRGB(226,181,83),Enum.Material.Glass,false);p:SetAttribute("QuestAction",kind)
  local prompt=Instance.new("ProximityPrompt");prompt.ActionText=text;prompt.ObjectText=name;prompt.KeyboardKeyCode=Enum.KeyCode.F;prompt.MaxActivationDistance=10;prompt.HoldDuration=.25;prompt.RequiresLineOfSight=false;prompt.Parent=p
 end
 for i=1,6 do marker("Bottle"..i,"Litter",V(-380+i*115,1.9,535+(i%2)*25),"Collect bottle") end
 marker("CoffeeOrder","Pickup",V(-480,2,414),"Pick up coffee")
 marker("StageDelivery","Dropoff",V(150,2,414),"Deliver coffee")
 marker("BoardwalkStart","RaceStart",V(-240,2,403),"Start 25s dash")
 marker("PierFinish","RaceFinish",V(240,2,403),"Finish dash")
 -- Boundaries sit outside street edges, never across an interior road.
 for _,x in ipairs({-725,725}) do part(parent,"MapEdge",V(2,140,1210),V(x,68,0),dark).Transparency=1 end
 for _,z in ipairs({-605,605}) do part(parent,"MapEdge",V(1450,140,2),V(0,68,z),dark).Transparency=1 end
 return {walk=walk,activities=activities,spawn=CFrame.new(-600,4,210)}
end
return City
]]></string>
      </Properties>
