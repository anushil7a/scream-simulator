      </Properties>
      <Item class="Script" referent="51">
        <Properties>
          <string name="Name">Health</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- This script intentionally replaces Roblox default health regeneration.
-- The server uses Shared.Healing: 20% after twelve seconds without dealing/taking damage.
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="52">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="53">
        <Properties>
          <string name="Name">Ambience</string>
          <string name="Source"><![CDATA[-- Location-bound scenery audio. Roblox handles live voice independently.
local Collection=game:GetService("CollectionService")
local Run=game:GetService("RunService")
local SoundService=game:GetService("SoundService")
local Content=game:GetService("ContentProvider")
local destroyed=false
-- Install terminal startup guard before dependency waits or a yielding require.
script.Destroying:Connect(function() destroyed=true end)
local replicated=game:GetService("ReplicatedStorage")
local shared=replicated:WaitForChild("Shared");if destroyed then return end
local configModule=shared:WaitForChild("Config");if destroyed then return end
local Config=require(configModule);if destroyed then return end
local assets={}
local group=Instance.new("SoundGroup");group.Name="CityAmbience";group.Volume=.55;group.Parent=SoundService
local folder=Instance.new("Folder");folder.Name="LocalCitySoundscape";folder.Parent=workspace
local function source(name,position,id,volume,near,far)
 local anchor=Instance.new("Part");anchor.Name=name;anchor.Size=Vector3.one;anchor.Position=position;anchor.Transparency=1;anchor.Anchored=true;anchor.CanCollide=false;anchor.CanQuery=false;anchor.CanTouch=false;anchor.CastShadow=false;anchor.Parent=folder
 local sound=Instance.new("Sound");sound.Name=name; sound.SoundId="rbxassetid://"..id;sound.Looped=true;sound.Volume=volume;sound.RollOffMode=Enum.RollOffMode.InverseTapered;sound.RollOffMinDistance=near;sound.RollOffMaxDistance=far;sound.SoundGroup=group;sound.Parent=anchor
 assets[id]=assets[id] or {};table.insert(assets[id],sound)
 return sound
end
local surfPositions=Config.CompactCity and Config.CityLayout.Ambience.surfPositions or {Vector3.new(-540,1,590),Vector3.new(-180,1,590),Vector3.new(180,1,590),Vector3.new(540,1,590)}
for _,position in ipairs(surfPositions) do source("CoastalSurf",position,"9119677305",.16,45,230) end
local stage=Config.CompactCity and Config.CityLayout.Ambience.buskerPosition or Vector3.new(150,5,426)
local guitar=source("BuskerGuitar",stage,"15675051846",0,8,70)
-- Load each shared asset once, then start its emitters together. A transient
-- CDN failure gets two retries; failed ambience never blocks gameplay or loops
-- requests forever. A pending load cannot restart audio after cleanup.
for _,sounds in pairs(assets) do
 task.spawn(function()
  local representative=sounds[1]
  for attempt=1,3 do
   if destroyed then return end
   representative:SetAttribute("LoadAttempts",attempt)
   pcall(function() Content:PreloadAsync({representative}) end)
   if destroyed then return end
   if representative.IsLoaded then
    for _,sound in sounds do sound:Play() end
    return
   end
   if attempt<3 then task.wait(attempt*2) end
  end
 end)
end
local performing=false;local elapsed=0
local heartbeat=Run.Heartbeat:Connect(function(dt)
 if destroyed then return end
 elapsed+=dt
 if elapsed>=.5 then
  elapsed=0;performing=false
  for _,model in Collection:GetTagged("CityResident") do
   local root=model:FindFirstChild("HumanoidRootPart");local humanoid=model:FindFirstChildOfClass("Humanoid")
   if model:IsDescendantOf(workspace) and model:GetAttribute("ResidentActive")~=false and model:GetAttribute("Role")=="Busker" and model:GetAttribute("Working") and root and humanoid and humanoid.Health>0 and (root.Position-stage).Magnitude<35 then performing=true;break end
  end
 end
 guitar.Volume+=((performing and .2 or 0)-guitar.Volume)*math.min(dt*3,1)
end)
local connection
script.Destroying:Connect(function() destroyed=true;heartbeat:Disconnect();if connection then connection:Disconnect() end;folder:Destroy();group:Destroy() end)
local remotes=game:GetService("ReplicatedStorage"):WaitForChild("ScreamRemotes")
if destroyed then return end
local state=remotes:WaitForChild("State")
if destroyed then return end
connection=state.OnClientEvent:Connect(function(data)
 if destroyed then return end
 local volume=type(data)=="table" and type(data.settings)=="table" and data.settings.volume
 if type(volume)=="number" and volume==volume then group.Volume=math.clamp(volume,0,1) end
end)
local action=remotes:WaitForChild("Action")
if destroyed then return end
action:FireServer("Sync")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">AttackAudio</string>
          <string name="Source"><![CDATA[local SoundService=game:GetService("SoundService")
local Settings=require(game:GetService("ReplicatedStorage").Shared.AttackAudioConfig)
local Mix=require(script.Parent:WaitForChild("BeamAudioMix"))
local Audio={}
function Audio.new()
 local group=Instance.new("SoundGroup");group.Name="QuietAttackEffects";group.Volume=Settings.GroupVolume;group.Parent=SoundService
 local eq=Instance.new("EqualizerSoundEffect");eq.LowGain=-3;eq.MidGain=-3;eq.HighGain=-4;eq.Parent=group
 local function create(position,tier)
  local asset=Settings.AssetForLevel(tier)
  if not asset then return nil end -- starter tier has no owner-selected SFX
  local anchor=Instance.new("Part");anchor.Name="LocalAttackAudio"
  anchor.Anchored=true;anchor.CanCollide=false;anchor.CanQuery=false;anchor.CanTouch=false
  anchor.Transparency=1;anchor.Size=Vector3.one;anchor.Position=position;anchor.Parent=workspace
  local sound=Instance.new("Sound");sound.Name="EnergyBeam";sound.SoundId=asset
  sound.Looped=false;sound.Volume=0;sound.PlaybackSpeed=1;sound.PlayOnRemove=false
  sound.RollOffMode=Enum.RollOffMode.InverseTapered
  sound.RollOffMinDistance=Settings.NearDistance;sound.RollOffMaxDistance=Settings.Range
  sound.SoundGroup=group;sound.Parent=anchor;sound:Play()
  return {anchor=anchor,sound=sound}
 end
 local mix=Mix.new(Settings,create,function(handle,position,volume,pitch)
  handle.anchor.Position=position;handle.sound.Volume=volume;handle.sound.PlaybackSpeed=pitch
 end,function(handle) handle.sound:Stop();handle.anchor:Destroy() end)
 local destroy=mix.Destroy
 function mix:Destroy() destroy(self);group:Destroy() end
 return mix
end
return Audio
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">BeamAudioMix</string>
          <string name="Source"><![CDATA[-- Cosmetic timing/mixing only. No voice recording, damage or server requests.
local Mix={};Mix.__index=Mix
function Mix.new(settings,create,update,destroy)
 return setmetatable({settings=settings,create=create,update=update,destroy=destroy,
  entries={},count=0,enabled=true,level="NORMAL",duck=1},Mix)
end
function Mix:Remove(id)
 local entry=self.entries[id];if not entry then return end
 self.entries[id]=nil;self.count-=1;self.destroy(entry.sound)
end
function Mix:Clear()
 for id in pairs(self.entries) do self:Remove(id) end
end
function Mix:SetLevel(level)
 if self.destroyed or (level~="NORMAL" and level~="LOW" and level~="OFF") then return false end
 self.level=level;self.enabled=level~="OFF"
 if not self.enabled then self:Clear() end
 return true
end
function Mix:SetEnabled(enabled)
 return self:SetLevel(enabled==true and "NORMAL" or "OFF")
end
function Mix:Pulse(id,now,position,isLocal,tier)
 if self.destroyed or not self.enabled then return false end
 local entry=self.entries[id]
 if entry and entry.stopped then return false end -- never revive a fading attack
 if not entry then
  if self.count>=self.settings.Limit then return false end
  local sound=self.create(position,tier);if not sound then return false end
  entry={sound=sound,started=now,isLocal=isLocal};self.entries[id]=entry;self.count+=1
 end
 entry.position=position;entry.lastPulse=now
 return true
end
function Mix:Stop(id,now)
 local entry=self.entries[id];if entry and not entry.stopped then entry.stopped=now end
end
function Mix:Step(now,dt,voiceActive,calibrating)
 if self.destroyed then return end
 dt=math.clamp(dt,0,.25)
 local target=voiceActive and self.settings.VoiceDuck or 1
 self.duck+=(target-self.duck)*(1-math.exp(-dt*(voiceActive and 30 or 5)))
 for id,entry in pairs(self.entries) do
  if not entry.stopped and (now-entry.lastPulse>=self.settings.Timeout or now-entry.started>=self.settings.MaxLifetime) then
   entry.stopped=math.min(entry.lastPulse+self.settings.Timeout,entry.started+self.settings.MaxLifetime)
  end
  if entry.stopped and now-entry.stopped>=self.settings.FadeOut then self:Remove(id) end
 end
 local budget=self.level=="LOW" and self.settings.LowVolume or self.settings.TotalVolume
 -- Louder listening must not raise the old voice-active feedback ceiling.
 if voiceActive then budget=math.min(budget,self.settings.LowVolume) end
 local gain=calibrating and 0 or budget/math.max(1,self.count)*self.duck
 for _,entry in pairs(self.entries) do
  local age=math.max(0,now-entry.started)
  local envelope=math.clamp(age/self.settings.FadeIn,0,1)
  local pitch=1 -- preserve the supplied recording's pitch and timing
  if entry.stopped then
   local release=math.clamp((now-entry.stopped)/self.settings.FadeOut,0,1)
   envelope*=1-release
  end
  self.update(entry.sound,entry.position,gain*envelope*(entry.isLocal and self.settings.LocalMultiplier or 1),pitch)
 end
end
function Mix:Destroy()
 if self.destroyed then return end
 self.destroyed=true;self:Clear()
end
return Mix
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">BeamScreenFeedback</string>
          <string name="Source"><![CDATA[-- Local presentation only; no camera, audio, input or gameplay ownership.
local Feedback={};Feedback.__index=Feedback
local LAUNCH_LAYOUT={{.08,.3,0},{.08,.7,0},{.92,.3,0},{.92,.7,0},{.3,.08,90},{.7,.08,90},{.3,.92,90},{.7,.92,90}}
local HIT_LAYOUT={{-1,-1,45},{1,-1,-45},{-1,1,-45},{1,1,45}}
local HIT_OFFSET=27
local HIT_TRAVEL=6
local HIT_MIN_LEN=8
local HIT_PULSE_LEN=4
local HIT_THICK=3
local RAY_MIN_LEN=18
local RAY_PULSE_LEN=8
local RAY_THICK=2
local HIT_ONSET_COLOR=Color3.fromRGB(255,250,224)
local function finite(n)return type(n)=="number" and n==n and math.abs(n)<math.huge end
local function frame(parent,name,size,position)
 local f=Instance.new("Frame");f.Name=name;f.AnchorPoint=Vector2.new(.5,.5)
 f.Size=size;f.Position=position;f.BorderSizePixel=0;f.BackgroundTransparency=1
 f.Active=false;f.Selectable=false;f.Interactable=false;f.ZIndex=0;f.Parent=parent
 return f
end
local function hitColor(hit)
 local glow=math.clamp((hit-.35)/.65,0,1)
 return Color3.fromRGB(255,math.floor(214+36*glow+.5),math.floor(96+128*glow+.5))
end
local function applyMarks(self,offset,length,color,alpha)
 local size=UDim2.fromOffset(length,HIT_THICK)
 for i,mark in ipairs(self.marks)do
  local p=HIT_LAYOUT[i]
  mark.Position=UDim2.new(.5,p[1]*offset,.5,p[2]*offset)
  mark.Size=size
  mark.BackgroundColor3=color
  mark.BackgroundTransparency=alpha
 end
end
local function applyRays(self,length,alpha)
 local size=UDim2.fromOffset(length,RAY_THICK)
 for _,ray in ipairs(self.rays)do
  ray.Size=size
  ray.BackgroundTransparency=alpha
 end
end
function Feedback.new(parent)
 local root=frame(parent,"BeamScreenFeedback",UDim2.fromScale(1,1),UDim2.fromScale(.5,.5));root.Visible=false
 local self=setmetatable({root=root,rays={},marks={},sequence=0,clock=0,launchEnds=0,hitEnds=0,nextHit=0,destroyed=false},Feedback)
 local raySize=UDim2.fromOffset(RAY_MIN_LEN+RAY_PULSE_LEN,RAY_THICK)
 for i,p in ipairs(LAUNCH_LAYOUT)do
  local ray=frame(root,"Launch"..i,raySize,UDim2.fromScale(p[1],p[2]));ray.Rotation=p[3];self.rays[i]=ray
 end
 local markSize=UDim2.fromOffset(HIT_MIN_LEN+HIT_PULSE_LEN,HIT_THICK)
 for i,p in ipairs(HIT_LAYOUT)do
  local mark=frame(root,"Hit"..i,markSize,UDim2.new(.5,p[1]*HIT_OFFSET,.5,p[2]*HIT_OFFSET));mark.Rotation=p[3]
  mark.BackgroundColor3=HIT_ONSET_COLOR;self.marks[i]=mark
 end
 return self
end
function Feedback:Time(now)
 if not finite(now) or now<self.clock then return false end
 self.clock=now;return true
end
function Feedback:Begin(sequence,now,color,allowed)
 if self.destroyed or not finite(sequence) or sequence%1~=0 or sequence<1 or sequence>9007199254740991 or sequence<=self.sequence then return false end
 -- Consume hidden starts too: they must never replay when a panel closes.
 self.sequence=sequence
 if not self:Time(now) or allowed~=true then return false end
 if typeof(color)~="Color3" or not finite(color.R) or not finite(color.G) or not finite(color.B) then color=Color3.fromRGB(255,220,90) end
 for _,ray in ipairs(self.rays)do ray.BackgroundColor3=color end
 self.launchEnds=now+.45;return true
end
function Feedback:Hit(now,allowed)
 if self.destroyed or not self:Time(now) or allowed~=true or now<self.nextHit then return false end
 -- No stacking or extending: sustained damage cannot maintain a bright marker.
 self.hitEnds=now+.25;self.nextHit=now+.35;return true
end
function Feedback:Clear()
 self.launchEnds=0;self.hitEnds=0
 if self.root then self.root.Visible=false end
 applyRays(self,RAY_MIN_LEN+RAY_PULSE_LEN,1)
 applyMarks(self,HIT_OFFSET,HIT_MIN_LEN+HIT_PULSE_LEN,HIT_ONSET_COLOR,1)
end
function Feedback:Step(now,visible,reduced)
 if self.destroyed then return end
 if not self:Time(now) or visible~=true or reduced==true then self:Clear();return end
 local launch=math.clamp((self.launchEnds-now)/.45,0,1)
 local hit=math.clamp((self.hitEnds-now)/.25,0,1)
 self.root.Visible=launch>0 or hit>0
 if launch>0 then
  applyRays(self,RAY_MIN_LEN+RAY_PULSE_LEN*launch,1-.12*launch)
 else
  applyRays(self,RAY_MIN_LEN+RAY_PULSE_LEN,1)
 end
 if hit>0 then
  applyMarks(self,HIT_OFFSET+HIT_TRAVEL*(1-hit),HIT_MIN_LEN+HIT_PULSE_LEN*hit,hitColor(hit),1-.4*hit)
 else
  applyMarks(self,HIT_OFFSET,HIT_MIN_LEN+HIT_PULSE_LEN,HIT_ONSET_COLOR,1)
 end
end
function Feedback:Destroy()
 if self.destroyed then return end
 self:Clear();self.destroyed=true;self.root:Destroy();self.root=nil
 self.rays={};self.marks={}
end
return Feedback
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">BeamVisuals</string>
          <string name="Source"><![CDATA[-- One animated rig per attacker. Parts are pooled across attacks, never per pulse.
local Style=require(game:GetService("ReplicatedStorage").Shared.BeamStyle)
local Visuals={}
local pool,live={},{}
local allocated=0
local detailCount=0
local decoration={}
local white=Color3.fromRGB(245,252,255)
local function take(detail)
 if detail and detailCount>=Style.MaxParts-24*5 then return end
 local part=table.remove(pool)
 if not part then
  if allocated>=Style.MaxParts then return end
  part=Instance.new("Part");allocated+=1
  part.Name="VoiceEnergy";part.Anchored=true;part.CanCollide=false
  part.CanTouch=false;part.CanQuery=false;part.CastShadow=false
  part.Material=Enum.Material.Neon;part.TopSurface=Enum.SurfaceType.Smooth;part.BottomSurface=Enum.SurfaceType.Smooth
 end
 if detail then decoration[part]=true;detailCount+=1 end
 return part
end
local function release(part)
 if decoration[part] then decoration[part]=nil;detailCount-=1 end
 part.Parent=nil;table.insert(pool,part)
end
function Visuals.Create()
 local rig={parts={},contact={parts={},used=0},born=os.clock(),used=0};live[rig]=true;return rig
end
function Visuals.Update(rig,origin,direction,length,width,color,level,reduced)
 if direction.Magnitude<.01 or length<.01 then return end
 rig.origin=origin;rig.direction=direction.Unit;rig.length=math.clamp(length,.01,110)
 rig.width=math.clamp(width,1,7);rig.color=color;rig.level=level;rig.reduced=reduced
end
-- Accepted damage supplies a target anchor; a beam endpoint alone is not a hit.
function Visuals.Contact(rig,position,now,sequence)
 if not live[rig] or not rig.origin or typeof(position)~="Vector3" or type(now)~="number" or now~=now or math.abs(now)==math.huge then return false end
 for _,n in ipairs({position.X,position.Y,position.Z})do if n~=n or math.abs(n)==math.huge then return false end end
 if (position-rig.origin).Magnitude>Style.DrawDistance or now<(rig.nextContact or -math.huge) then return false end
 rig.contactPosition=position;rig.contactBorn=now;rig.nextContact=now+.4;rig.contactSequence=sequence
 rig.contactDirection=rig.direction
 rig.contactBasis=CFrame.lookAt(position,position+rig.direction,math.abs(rig.direction.Y)>.98 and Vector3.zAxis or Vector3.yAxis)
 return true
end
local function draw(rig,shape,size,cf,color,alpha,material,detail)
 rig.used+=1
 local part=rig.parts[rig.used]
 if not part then part=take(detail or rig.used>5);if not part then return end;rig.parts[rig.used]=part end
 -- A pooled slot may previously have been a non-emissive shell or a Neon detail.
 part.Material=material or Enum.Material.Neon
 part.Shape=shape;part.Size=size;part.CFrame=cf;part.Color=color;part.Transparency=alpha;part.Parent=workspace
end
local function line(rig,a,b,thickness,color,alpha,material,detail)
 local delta=b-a;local length=delta.Magnitude;if length<.001 then return end
 local direction=delta/length
 draw(rig,Enum.PartType.Cylinder,Vector3.new(length,thickness,thickness),
  CFrame.lookAt((a+b)*.5,b,math.abs(direction.Y)>.98 and Vector3.zAxis or Vector3.yAxis)*CFrame.Angles(0,math.pi/2,0),color,alpha,material,detail)
end
function Visuals.Animate(rig,now,viewer,reduced,contactAllowed,contactReduced)
 if not rig.origin then return end
 local distance=(viewer-rig.origin).Magnitude
 rig.used=0
 rig.contact.used=0
 if contactAllowed==false or distance>Style.DrawDistance or rig.contactBorn and now>=rig.contactBorn+.28 then rig.contactPosition=nil end
 if distance<=Style.DrawDistance then
  local spec=Style.Detail(rig.level,reduced or rig.reduced,distance)
  local origin,dir,length,width,color=rig.origin,rig.direction,rig.length,rig.width,rig.color
  local basis=CFrame.lookAt(origin,origin+dir,math.abs(dir.Y)>.98 and Vector3.zAxis or Vector3.yAxis)
  local right,up=basis.RightVector,basis.UpVector
  local age=now-rig.born;local tier=spec.tier
  local quiet=reduced or rig.reduced
  local radius=width*(.24+tier*.012)*Style.LaunchScale(age,quiet)
  local finish=origin+dir*length
  -- Smooth low-amplitude breathing; no screen flash, camera shake or lights.
  local pulse=quiet and 1 or 1+.035*math.sin(age*9)
  local detailed=not quiet and distance<=Style.FarDistance
  local high=tier>=8
  -- Quiet mode retains its simple silhouette. Regular energy has a slim hot spine
  -- inside a non-emissive tinted body: Neon is reserved for the thin spine/details.
  line(rig,origin,finish,radius*(detailed and 1.35 or 1.65)*pulse,detailed and color:Lerp(Color3.fromRGB(0,0,0),.35) or color,quiet and .72 or detailed and (high and .78 or .55) or .68,detailed and Enum.Material.SmoothPlastic or nil)
  line(rig,origin,finish,radius*.85,color,quiet and .32 or detailed and (high and .7 or .18) or .12,detailed and Enum.Material.SmoothPlastic or nil)
  line(rig,origin,finish,radius*(detailed and .10 or .28),detailed and color:Lerp(white,.72) or white,quiet and .45 or .08)
  if quiet or distance>Style.FarDistance then
   draw(rig,Enum.PartType.Ball,Vector3.one*math.min(length,radius*1.5),CFrame.new(finish),color,.3)
  else
   -- An energy termination lens, not a hit-confirmation flash. Stay within range.
   local depth=math.min(length,radius*.22)
   line(rig,finish-dir*depth,finish,radius*1.25,color,.18,Enum.Material.SmoothPlastic)
  end
  if not quiet and distance<=Style.FarDistance then
   draw(rig,Enum.PartType.Ball,Vector3.one*radius*.72,CFrame.new(origin),color,.18,Enum.Material.SmoothPlastic)
   local function offset(angle,r) return (right*math.cos(angle)+up*math.sin(angle))*r end
   local function collarOffset(angle,r)
    if spec.collar=="diamond" then r/=math.abs(math.cos(angle))+math.abs(math.sin(angle))
    elseif spec.collar=="star" then r*=.72+.28*(.5+.5*math.cos(angle*5)) end
    local sweep=spec.collar=="diamond" and math.cos(angle)*r*.75 or 0
    return offset(angle,r)+dir*sweep
   end
   for ring=1,spec.rings do
    local travel=(age*(.6+tier*.025)+ring/spec.rings)%1
    local center=origin+dir*(travel*length)
    local r=radius*(.85+.2*math.sin(travel*math.pi))*(tier>=1 and 1.25 or 1)
    local offset=collarOffset
    for i=1,10 do
     local phase=age*.9+ring*.6
     -- Broken collars leave clear channels instead of stacking opaque hoops.
     -- One bright collar carries high tiers; supporting contours stay readable
     -- without stacking luminous hoops over the target and contact burst.
     local support=high and ring>1
     line(rig,center+offset((i-1)*math.pi/5+phase,r),center+offset((i-.28)*math.pi/5+phase,r),support and .1 or .16+tier*.012,support and color:Lerp(Color3.fromRGB(0,0,0),.2) or color,support and .6+travel*.25 or .26+travel*.32,support and Enum.Material.SmoothPlastic or nil)
    end
   end
   for strand=1,spec.strands do
    local previous=origin
    for i=1,12 do
     local t=i/12
     local winding=spec.ribbon=="braid" and (strand==1 and 1 or -1) or 1
     local phase=t*math.pi*2*spec.turns*winding-age*5+strand*math.pi
     local radial=radius*.95*math.sin(t*math.pi)
     if spec.ribbon=="zigzag" then phase=age*.35+strand*math.pi;radial*=i%2==0 and -1 or 1 end
     local point=origin+dir*(length*t)+offset(phase,radial)
     line(rig,previous,point,.065+tier*.006,color:Lerp(white,high and .12 or .4),high and .42 or .25,high and Enum.Material.SmoothPlastic or nil);previous=point
    end
   end
   for i=1,spec.sparks do
    local phase=i*math.pi*2/spec.sparks+age*(i%2==0 and .6 or -.6)
    -- Endpoint corona stays inside the authoritative beam width.
    local back=math.min(length*.15,radius*.8)
    line(rig,finish+offset(phase,radius*.25),finish-dir*back+offset(phase,width*.42),.08+tier*.006,color,high and .55 or .3,high and Enum.Material.SmoothPlastic or nil)
   end
  end
  if rig.contactPosition then
   local quietContact=quiet or contactReduced or distance>Style.FarDistance
   local progress=math.clamp((now-rig.contactBorn)/.28,0,1)
   local ease=1-(1-progress)^3
   local heat=(1-progress)^2
   local fade=progress*progress
   local extent=math.min(width*.48,quietContact and 1.8 or 1.65+ease*.75)
   local inner=extent*(quietContact and .72 or .52+ease*.24)
   local count=quietContact and 4 or 8
   local contactDir=rig.contactDirection
   local contactRight,contactUp=rig.contactBasis.RightVector,rig.contactBasis.UpVector
   local center=rig.contactPosition-contactDir*.7
   local backThickness=quietContact and .18 or .2-.08*progress
   local coreThickness=quietContact and .1 or .12-.07*progress
   local coreColor=color:Lerp(white,quietContact and .3 or .2+.55*heat)
   -- Short outward strokes differ from traveling collars. Offset them from the
   -- root's body depth; quiet strokes stay still without screen/camera effects.
   for i=1,count do
    local angle=(i-.5)*math.pi*2/count
    local radial=contactRight*math.cos(angle)+contactUp*math.sin(angle)
    local from=center+radial*inner;local to=center+radial*extent
    line(rig.contact,from,to,backThickness,color:Lerp(Color3.fromRGB(0,0,0),.8),quietContact and .15 or .1+fade*.82,Enum.Material.SmoothPlastic,true)
    line(rig.contact,from-contactDir*.12,to-contactDir*.12,coreThickness,coreColor,quietContact and .3 or .05+fade*.9,Enum.Material.Neon,true)
   end
  end
 end
 for i=#rig.parts,rig.used+1,-1 do release(rig.parts[i]);rig.parts[i]=nil end
 for i=#rig.contact.parts,rig.contact.used+1,-1 do release(rig.contact.parts[i]);rig.contact.parts[i]=nil end
end
function Visuals.Destroy(rig)
 if not live[rig] then return end
 live[rig]=nil
 for _,part in ipairs(rig.parts) do release(part) end
 for _,part in ipairs(rig.contact.parts) do release(part) end
 table.clear(rig.parts)
 table.clear(rig.contact.parts);rig.contactPosition=nil
end
function Visuals.Clear()
 for rig in pairs(live) do Visuals.Destroy(rig) end
 for _,part in ipairs(pool) do part:Destroy() end
 table.clear(pool);allocated=0
end
function Visuals.Budget() return allocated,#pool end
return Visuals
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">CityMap</string>
          <string name="Source"><![CDATA[-- North is -Z. Use the selected world's bounds; retain the archived-city projection when disabled.
local Config=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local CityMap={}
local gold=Color3.fromRGB(255,205,111)
local cream=Color3.fromRGB(239,244,240)
local function box(parent,name,x,z,w,h,color)
 local f=Instance.new('Frame');f.Name=name;f.BorderSizePixel=0;f.BackgroundColor3=color
 f.Position=UDim2.fromScale(x,z);f.Size=UDim2.fromScale(w,h);f.Parent=parent;return f
end
local function text(parent,value,size,color)
 local t=Instance.new('TextLabel');t.BackgroundTransparency=1;t.Size=UDim2.fromScale(1,1)
 t.Font=Enum.Font.GothamBold;t.Text=value;t.TextSize=size;t.TextColor3=color or cream;t.Parent=parent;return t
end
local function position(x,z)
 local minimum=Config.CompactCity and Config.MapMin
 local maximum=Config.CompactCity and Config.MapMax
 local minX,minZ=minimum and minimum.X or -720,minimum and minimum.Z or -600
 local width,depth=maximum and maximum.X-minX or 1440,maximum and maximum.Z-minZ or 1200
 return UDim2.fromScale(math.clamp((x-minX)/width,0,1),math.clamp((z-minZ)/depth,0,1))
end
CityMap.Project=position
CityMap.aspectRatio=Config.CompactCity and (Config.MapMax.X-Config.MapMin.X)/(Config.MapMax.Z-Config.MapMin.Z) or 1.2
local arenaStart=position(Config.ZoneMin.X,Config.ZoneMin.Z)
local arenaEnd=position(Config.ZoneMax.X,Config.ZoneMax.Z)
local arenaX,arenaZ=arenaStart.X.Scale,arenaStart.Y.Scale
local arenaWidth,arenaHeight=arenaEnd.X.Scale-arenaX,arenaEnd.Y.Scale-arenaZ
CityMap.arenaPercent=math.floor(arenaWidth*arenaHeight*100+.5)
local CompactLayout=Config.CompactCity and require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("CompactLayout"))
local landmarks=CompactLayout and CompactLayout.MapLandmarks or {
 {name='1 · Plaça del Sol / spawn',x=-600,z=240},
 {name='2 · Rambla gardens',x=-360,z=240},
 {name='3 · Basilica',x=120,z=-240},
 {name='4 · Market',x=120,z=0},
 {name='5 · Old town',x=600,z=0},
 {name='6 · Beach & promenade',x=0,z=515},
 {name='7 · Timber pier',x=525,z=537},
 {name='8 · Training fighters',x=-320,z=545},
}
-- Pad fills use authored world colors; badges echo the trainers' uniform accents.
local trainingBadges={
 TrainingPad1={label="L1",color=Color3.fromRGB(111,196,180)},
 TrainingPad2={label="L25",color=Color3.fromRGB(219,120,94)},
 TrainingPad3={label="L60",color=Color3.fromRGB(240,192,89)},
}
function CityMap.create(parent,compact)
 local map=box(parent,'CityMap',.5,.5,1,1,Color3.fromRGB(47,69,69));map.AnchorPoint=Vector2.new(.5,.5)
 local ratio=Instance.new('UIAspectRatioConstraint');ratio.AspectRatio=CityMap.aspectRatio;ratio.AspectType=Enum.AspectType.FitWithinMaxSize;ratio.Parent=map
 if CompactLayout then
  local mapCorner=Instance.new('UICorner');mapCorner.CornerRadius=UDim.new(0,4);mapCorner.Parent=map
  local mapBorder=Instance.new('UIStroke');mapBorder.Name='MapBorder';mapBorder.Color=Color3.fromRGB(115,148,148);mapBorder.Thickness=1;mapBorder.Transparency=.35;mapBorder.Parent=map
 end
 box(map,'Arena',arenaX,arenaZ,arenaWidth,arenaHeight,Color3.fromRGB(111,66,69))
 if CompactLayout then
  local width=Config.MapMax.X-Config.MapMin.X;local depth=Config.MapMax.Z-Config.MapMin.Z
  -- Match the actual shared beach/courtyard footprints and frame the southern surf edge.
  for _,part in ipairs(CompactLayout.PartSpecs) do
   if part.id=="HubPaving" or part.id=="Beach" then
    local start=position(part.position.X-part.size.X/2,part.position.Z-part.size.Z/2)
    local isBeach=part.id=="Beach"
    box(map,isBeach and 'Beach' or 'Courtyard',start.X.Scale,start.Y.Scale,part.size.X/width,part.size.Z/depth,isBeach and Color3.fromRGB(179,153,104) or Color3.fromRGB(61,86,85))
    if isBeach then
     local shore=position(part.position.X-part.size.X/2,Config.MapMax.Z-9)
     box(map,'Shoreline',shore.X.Scale,shore.Y.Scale,part.size.X/width,9/depth,Color3.fromRGB(64,134,152))
    end
   end
  end
  -- Static footprints share the world's source dimensions; no replicated enemy markers.
  -- Deliberately flat, quiet geometry keeps the tiny map cheaper than a second 3D world.
  for _,part in ipairs(CompactLayout.PartSpecs) do
   local architecture=part.id:match('^MarketHouse') or part.id:match('^OldTownHouse') or part.id:match('^Basilica') or part.id:match('^GardenBed')
   local training=part.id:match('^TrainingPad')
   local cover=part.kind=='cover'
   local court=part.id=='Court'
   if architecture or training or cover or court then
    local start=position(part.position.X-part.size.X/2,part.position.Z-part.size.Z/2)
    local color=architecture and Color3.fromRGB(173,181,167) or training and part.color or cover and Color3.fromRGB(166,131,111) or Color3.fromRGB(110,157,148)
    box(map,'Footprint_'..part.id,start.X.Scale,start.Y.Scale,part.size.X/width,part.size.Z/depth,color)
    local tier=trainingBadges[part.id]
    if tier and not compact then
     local badge=box(map,'TrainingTier_'..part.id,0,0,0,0,tier.color)
     badge.Size=UDim2.fromOffset(36,20);badge.AnchorPoint=Vector2.new(0,.5)
     badge.Position=position(part.position.X,part.position.Z);badge.ZIndex=3
     local edge=Instance.new('UIStroke');edge.Color=Color3.fromRGB(22,39,46);edge.Thickness=1;edge.Parent=badge
     local corner=Instance.new('UICorner');corner.CornerRadius=UDim.new(0,4);corner.Parent=badge
     local words=text(badge,tier.label,12,Color3.fromRGB(22,39,46));words.ZIndex=4
     words.Position=UDim2.fromOffset(8,0);words.Size=UDim2.new(1,-8,1,0)
    end
   end
  end
  for _,road in ipairs(CompactLayout.MapRoads) do
   local start=position(road.x-road.width/2,road.z-road.depth/2)
   box(map,road.name,start.X.Scale,start.Y.Scale,road.width/width,road.depth/depth,Color3.fromRGB(201,186,153))
  end
 else
 box(map,'Beach',0,1030/1200,1,170/1200,Color3.fromRGB(179,153,104))
 -- PasseigMaritim and TimberPier dimensions mirror the generated waterfront.
 box(map,'Promenade',0,(401-26+600)/1200,1,52/1200,Color3.fromRGB(201,186,153))
 box(map,'TimberPier',(525-14+720)/1440,(537-62.5+600)/1200,28/1440,125/1200,Color3.fromRGB(111,82,56))
 -- Street widths and extents are world-derived, not decorative subdivisions.
 for x=-720,720,240 do box(map,'Avenue',math.max(0,(x+720-14)/1440),0,(x==-720 or x==720) and 14/1440 or 28/1440,.8,Color3.fromRGB(34,47,54)) end
 for z=-600,360,240 do box(map,'Street',0,math.max(0,(z+600-14)/1200),1,z==-600 and 14/1200 or 28/1200,Color3.fromRGB(34,47,54)) end
 end
 if CompactLayout then
  for _,route in ipairs(CompactLayout.GuidanceSpecs) do
   if route.id:match('^Route') then
    local start=position(route.position.X-route.size.X/2,route.position.Z-route.size.Z/2)
    box(map,'Route_'..route.id,start.X.Scale,start.Y.Scale,route.size.X/(Config.MapMax.X-Config.MapMin.X),route.size.Z/(Config.MapMax.Z-Config.MapMin.Z),Color3.fromRGB(221,201,143))
   end
  end
 end
 local boundary=box(map,'ArenaBoundary',arenaX,arenaZ,arenaWidth,arenaHeight,cream);boundary.BackgroundTransparency=1
 local stroke=Instance.new('UIStroke');stroke.Color=Color3.fromRGB(247,139,120);stroke.Thickness=2;stroke.Parent=boundary
 for i,v in ipairs(compact and {} or landmarks) do
  if CompactLayout and v.name=="2 Training" then continue end
  local pin=box(map,'Landmark'..i,0,0,0,0,Color3.fromRGB(22,39,46));pin.Size=UDim2.fromOffset(23,23);pin.AnchorPoint=Vector2.new(.5,.5);pin.Position=position(v.x,v.z)
  if CompactLayout then
   -- Give nearby pins breathing room on narrow maps without shrinking their text.
   pin.Size=UDim2.fromScale(.08,.08*CityMap.aspectRatio)
   local size=Instance.new('UISizeConstraint');size.MinSize=Vector2.new(18,18);size.MaxSize=Vector2.new(23,23);size.Parent=pin
   local pinStroke=Instance.new('UIStroke');pinStroke.Color=Color3.fromRGB(168,186,184);pinStroke.Thickness=1;pinStroke.Transparency=.35;pinStroke.Parent=pin
  end
  local corner=Instance.new('UICorner');corner.CornerRadius=UDim.new(1,0);corner.Parent=pin;text(pin,tostring(i),13)
 end
 local dot=box(map,'Player',0,0,0,0,gold);dot.Size=UDim2.fromOffset(compact and 8 or 18,compact and 8 or 18);dot.AnchorPoint=Vector2.new(.5,.5);dot.ZIndex=5
 dot.Visible=false
 local corner=Instance.new('UICorner');corner.CornerRadius=UDim.new(1,0);corner.Parent=dot
 local markerStroke=Instance.new('UIStroke');markerStroke.Color=Color3.fromRGB(18,31,39);markerStroke.Thickness=compact and 2 or 1;markerStroke.Parent=dot
 local arrow
 if not compact then arrow=text(dot,'▲',14,Color3.fromRGB(19,32,40));arrow.ZIndex=6 end
 return {map=map,dot=dot,arrow=arrow}
end
function CityMap.update(view,root)
 if not view or not view.map.Parent then return end
 view.dot.Visible=root~=nil and root.Parent~=nil
 if not view.dot.Visible then return end
 view.dot.Position=position(root.Position.X,root.Position.Z)
 local look=root.CFrame.LookVector
 if view.arrow then view.arrow.Rotation=math.deg(math.atan2(look.X,-look.Z)) end
end
-- Reserve the compact HUD's left column and combat/talk controls below.
function CityMap.MiniLayout(viewport,touch,testTools)
 local available=viewport.X>=280 and viewport.Y>=(touch and 315 or 168)
 local width=math.min(160,viewport.X-278)
 -- The quest tracker is wider than the HUD. Stay above it or to its right.
 width=math.min(width,math.max(119,viewport.X-328))
 if touch then width=math.min(width,(viewport.Y-269-(testTools and 52 or 0))*CityMap.aspectRatio+16) end
 -- Reserve the notification's maximum bounded height before expanding.
 -- At extremely short heights even the 44px launcher can share a long toast's
 -- area; keep navigation available rather than hide or shrink urgent text.
 local notificationTop=math.min(viewport.Y*.72,viewport.Y-(touch and 203 or 110))-viewport.Y*.35
 local mapHeightBudget=notificationTop-14-8-(testTools and 52 or 0)
 width=math.min(width,(mapHeightBudget-52)*CityMap.aspectRatio+16)
 local expanded=width>=96 and viewport.Y>=(testTools and 412 or 360)
 if not expanded then return {width=math.min(90,math.max(44,viewport.X-220)),height=44,expanded=false,available=available} end
 return {width=width,height=52+(width-16)/CityMap.aspectRatio,expanded=true,available=available}
end
function CityMap.MiniUpdate(view,root,now,visible)
 if not view or not view.map.Parent then return end
 if not visible or not root or not root.Parent then
  view.dot.Visible=false;view.nextUpdate=nil;view.lastRoot=nil;return
 end
 if view.lastRoot==root and view.nextUpdate and now<view.nextUpdate then return end
 view.lastRoot=root;view.nextUpdate=now+.1
 CityMap.update(view,root)
end
CityMap.legend='1  Plaça del Sol / spawn     2  Rambla gardens\n3  Basilica     4  Market     5  Old town\n6  Beach & promenade     7  Timber pier\n8  Training fighters (west beach)'
CityMap.legendHeight=94
CityMap.mapHelp="Gold arrow: you and your facing direction. Red: PvP. Green and sand: safe. Pale coast path: promenade."
CityMap.activityHelp="Coffee: collect at the west café, then check your objective for the assigned stop. Race: lifeguard start to east promenade finish. PvP ends at the marked district boundary."
if CompactLayout then
 CityMap.mapHelp="Gold arrow: you and your facing direction. Red: PvP arena."
 CityMap.activityHelp="PvP ends at the marked arena boundary."
 CityMap.legendHeight=#landmarks*20+24
 local lines={}
 for _,landmark in ipairs(landmarks) do
  if landmark.name=="2 Training" then
   table.insert(lines,"Training: L1 Rookie / L25 Brawler / L60 Elite")
  else table.insert(lines,landmark.name) end
 end
 CityMap.legend=table.concat(lines,"\n")
end
return CityMap
]]></string>
