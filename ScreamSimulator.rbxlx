    nameLabel.Parent.Name="Nameplate"
    speech.Parent.Name="SpeechBubble";speech.Parent.Size=UDim2.fromOffset(200,48)
    -- Shared projected anchor plus size-relative offset keeps a six-pixel gap:
    -- speech bottom = -48*1.25+24 = -36; nameplate top = -60/2 = -30.
    -- https://create.roblox.com/docs/reference/engine/classes/BillboardGui#SizeOffset
    speech.Parent.StudsOffsetWorldSpace=Vector3.new(0,2.5,0)
    speech.Parent.SizeOffset=Vector2.new(0,1.25)
    nameLabel.Parent.MaxDistance = 18
    speech.Parent.MaxDistance = 24
    speech.Visible = false
    speech.BackgroundColor3 = Color3.fromRGB(244, 237, 211)
    speech.TextColor3 = C.dark
    local bot = {id = "Bot" .. index, name = displayName, role = role, model = model, root = root, humanoid = humanoid,
        training=training,credit={},maxHealth=maximum,health = maximum, alive = true, label = nameLabel, nameplateHealth=nameplateHealth,nameplateTrack=nameplateTrack,nameplateFill=nameplateFill,nameplatePanel=nameplatePanel, speech = speech, questIds=job and job.quests or (not Config.CompactCity and (index==4 and {"sprint"} or index==5 and {"crowd"} or index==6 and {"dodge","arena"})) or nil, job=job, jobTool=jobTool, water=water, carryParts=carryParts, cleaningParts=cleaningParts, repairParts=repairParts, jobStep=0,
        start = home, lastGrounded=home, roamRadius = role == "Commuter" and 200 or 125,
        joints = {ls, rs, lh, rh}, lastGreeting = -1000}
    for _, limb in ipairs(bot.joints) do limb:SetAttribute("RestPose", limb.C0) end
    table.insert(World.Bots, bot)
    model:SetAttribute("AnimationSeed",index);Collection:AddTag(model,"CityResident")
    if training then
        humanoid.WalkSpeed=TrainingRules.RoamSpeed
        bot.trainingRoamStep=index
        model:SetAttribute("TrainingTier",training.id)
        nameLabel.Parent.MaxDistance=65
        return bot
    end
    if RunService:IsRunning() then
        task.spawn(function()
            task.wait(index * 0.08)
            while model.Parent do
                if bot.alive then
                    if bot.restSeat then
                        task.wait(.2)
                    elseif (bot.reactionUntil or 0) > os.clock() then
                        task.wait(0.5)
                    elseif (bot.socialUntil or 0)>os.clock() then
                        task.wait(.2)
                    elseif job then
                        bot.jobStep=bot.jobStep%#job.stations+1
                        local station=role=="Sanitation" and World.FindMaintenance and World.FindMaintenance(bot) or job.stations[bot.jobStep]
                        model:SetAttribute("WorkStep",bot.jobStep)
                        for _,item in ipairs(bot.carryParts) do item.Transparency=bot.jobStep==2 and 0 or 1 end
                        bot.working=false;model:SetAttribute("Activity","Walking to work")
                        roamTo(bot,station.position,true)
                        if bot.alive and (Vector3.new(bot.root.Position.X,station.position.Y,bot.root.Position.Z)-station.position).Magnitude<.8 and (bot.reactionUntil or 0)<=os.clock() and (bot.socialUntil or 0)<=os.clock() then
                            bot.humanoid:MoveTo(bot.root.Position);faceToward(bot,station.lookAt)
                            if role=="Soccer" then
                                bot.practiceCycle=(bot.practiceCycle or 0)+1
                                model:SetAttribute("PracticeRoutine",({"Miss","Trip","OwnGoal"})[(bot.practiceCycle-1)%3+1])
                            end
                            bot.working=true;model:SetAttribute("Repairing",station.maintenanceModel~=nil);model:SetAttribute("WorkStarted",workspace:GetServerTimeNow());model:SetAttribute("Activity",station.action or role=="Soccer" and "Practicing missed kicks" or role=="Gardener" and "Watering flowers" or role=="Artist" and "Painting the coast" or "Arranging produce")
                            local workVersion=bot.pathVersion
                            local untilTime=os.clock()+(role=="Soccer" and 6.5 or rng:NextNumber(5,9))
                            while model.Parent and bot.alive and bot.working and bot.pathVersion==workVersion and os.clock()<untilTime and (bot.socialUntil or 0)<=os.clock() and (bot.reactionUntil or 0)<=os.clock() do task.wait(.2) end
                            if model.Parent and bot.working and bot.alive and bot.pathVersion==workVersion and (bot.socialUntil or 0)<=os.clock() and (bot.reactionUntil or 0)<=os.clock() and os.clock()>=untilTime and station.maintenanceModel and World.FinishMaintenance then
                                World.FinishMaintenance(bot,station)
                            end
                            bot.working=false;model:SetAttribute("Repairing",false)
                        end
                        task.wait(.3)
                    else
                        local choice = rng:NextNumber()
                        if choice < .2 and World.WatchPerformance(bot) then
                            task.wait(.3)
                        elseif choice < 0.23 then
                            bot.gestureUntil = os.clock() + rng:NextNumber(1.5, 3.5)
                            if role == "Busker" or role == "Vendor" or rng:NextNumber() < 0.45 then
                                World.Talk(bot)
                            end
                            task.wait(rng:NextNumber(2.5, 5.5))
                        elseif choice < 0.45 and socialize(bot) then
                            task.wait(rng:NextNumber(2.5, 4.5))
                        else
                            local destination, kind = chooseDestination(bot)
                            roamTo(bot, destination)
                            if bot.alive and (destination - bot.root.Position).Magnitude < 13 then
                                if kind=="Performance" then
                                    World.WatchPerformance(bot)
                                elseif kind=="Rest" and restNearby(bot,destination) then
                                    bot.model:SetAttribute("Activity","Exploring the neighborhood")
                                elseif kind == "Browse" or kind == "Watch" or kind == "Rest" then
                                    bot.gestureUntil = os.clock() + 2.5
                                    task.wait(rng:NextNumber(2, 4))
                                elseif rng:NextNumber() < 0.3 then
                                    task.wait(rng:NextNumber(0.7, 2))
                                end
                            end
                        end
                    end
                else task.wait(0.5) end
            end
        end)
        task.spawn(function()
            task.wait(3 + index % 9)
            while model.Parent do
                if bot.alive then noticePlayers(bot) end
                task.wait(2.5 + index % 4)
            end
        end)
    end
end

local function atmosphere()
    local lighting = game:GetService("Lighting")
    lighting.ClockTime = 16.5
    lighting.Brightness = 3
    lighting.EnvironmentDiffuseScale = 0.65
    lighting.EnvironmentSpecularScale = 0.65
    lighting.GlobalShadows = true
    lighting.ShadowSoftness = 0.35
    local grade = lighting:FindFirstChild("CityGrade") or Instance.new("ColorCorrectionEffect")
    grade.Name = "CityGrade"
    grade.Contrast = 0.08
    grade.Saturation = 0.08
    grade.TintColor = Color3.fromRGB(255, 248, 237)
    grade.Parent = lighting
    local haze = lighting:FindFirstChild("CityHaze")
    if not haze then
        haze = Instance.new("Atmosphere")
        haze.Name = "CityHaze"
        haze.Parent = lighting
    end
    haze.Density = 0.17
    haze.Haze = 0.3
    haze.Color = Color3.fromRGB(235, 210, 181)
end


function World.IsInWarZone(position) return Config.InArena(position) end

local function carAt(car,distance)
    local x=-690+distance*car.direction
    if car.direction<0 then x=690-distance end
    return CFrame.new(x,2.05,car.lane)*CFrame.Angles(0,car.direction>0 and 0 or math.pi,0)
end
-- Traffic yields to residents in its lane. Players remain subject to impact rules.
function World.StepTraffic(car,dt)
    dt=math.clamp(dt,0,.1)
    local previous=car.model:GetPivot()
    local clearance=math.huge
    for _,bot in ipairs(World.Bots) do
        if bot.alive and bot.root.Parent then
            local relative=previous:PointToObjectSpace(bot.root.Position)
            if relative.X>=-8 and math.abs(relative.Z)<5.5 and math.abs(relative.Y)<6 then
                clearance=math.min(clearance,math.max(0,relative.X-9))
            end
        end
    end
    local cruise=car.cruiseSpeed or car.speed
    local target=math.min(cruise,math.sqrt(2*30*clearance))
    car.speed=math.clamp(target,math.max(0,car.speed-30*dt),car.speed+8*dt)
    local travel=math.min(dt*car.speed,clearance)
    if dt>0 and travel<dt*car.speed then car.speed=travel/dt end
    car.distance+=travel
    local wrapped=car.distance>1380
    if wrapped then car.distance-=1380 end
    local nextFrame=carAt(car,car.distance)
    if travel>0 and not wrapped and World.OnVehicleSweep then World.OnVehicleSweep(car,previous,nextFrame) end
    car.model:PivotTo(nextFrame)
    car.model:SetAttribute("Speed",car.speed)
    car.model:SetAttribute("Yielding",target<cruise)
end
-- Three server-owned trainers stroll only inside their original sparring pads.
-- No city path coroutine or player pursuit: targets stay well inside the 32-stud
-- combat boundary, and a stuck MoveTo expires rather than teleporting through cover.
function World.StepTrainingRoam(bot,now)
    if not bot.training or not bot.alive or not bot.model.Parent or not bot.root.Parent or not bot.humanoid.Parent then return end
    local position=bot.root.Position
    local delta=position-bot.start
    if Vector3.new(delta.X,0,delta.Z).Magnitude>TrainingRules.RoamLeash then
        stopWalking(bot)
        bot.model:PivotTo(CFrame.new(bot.start));bot.lastGrounded=bot.start;bot.airSince=nil
        bot.root.AssemblyLinearVelocity=Vector3.zero;bot.root.AssemblyAngularVelocity=Vector3.zero
        bot.humanoid:MoveTo(bot.start);bot.trainingNextMove=now+1.25
        return
    end
    -- Stop on the first frame of a windup, conversation or immobilization, not
    -- only on the slower waypoint cadence. The strike's aim remains fixed.
    if bot.strike or (bot.socialUntil or 0)>now or (bot.reactionUntil or 0)>now
        or bot.root.Anchored or bot.humanoid.SeatPart or bot.humanoid.Sit or bot.humanoid.PlatformStand then
        if bot.trainingDestination then bot.humanoid:MoveTo(position) end
        bot.trainingDestination=nil;bot.trainingNextMove=now+.5
        return
    end
    if now<(bot.trainingStepAt or 0) then return end
    bot.trainingStepAt=now+.25
    if bot.trainingDestination then
        local remaining=bot.trainingDestination-position
        if Vector3.new(remaining.X,0,remaining.Z).Magnitude<=2 or now>=(bot.trainingMoveUntil or 0) then
            bot.humanoid:MoveTo(position);bot.trainingDestination=nil;bot.trainingNextMove=now+1.25
        end
        return
    end
    if now<(bot.trainingNextMove or 0) then return end
    bot.trainingRoamStep=(bot.trainingRoamStep or 0)+1
    local angle=bot.trainingRoamStep*2.399963229728653
    local radius=TrainingRules.RoamRadius*(.65+.175*(bot.trainingRoamStep%3))
    local destination=bot.start+Vector3.new(math.cos(angle)*radius,0,math.sin(angle)*radius)
    bot.trainingDestination=destination;bot.trainingMoveUntil=now+5
    bot.humanoid.WalkSpeed=TrainingRules.RoamSpeed
    bot.humanoid:MoveTo(destination)
end

function World.Build()
    local old=workspace:FindFirstChild("ScreamSimulatorWorld");if old then old:Destroy() end
    table.clear(World.Bots);table.clear(World.Cars);table.clear(seatReservations)
    pcall(function() PhysicsService:RegisterCollisionGroup("Residents") end)
    PhysicsService:CollisionGroupSetCollidable("Residents","Residents",false)
    atmosphere()
    local parent=Instance.new("Model");parent.Name="ScreamSimulatorWorld";parent.Parent=workspace
    local layout=City.Build(parent);World.WalkPoints=layout.walk;World.ActivityPoints=layout.activities;World.SafeSpawn=layout.spawn
    table.clear(World.Seats);for _,item in ipairs(parent:GetDescendants()) do if item:IsA("Seat") then table.insert(World.Seats,item) end end
    local spawn=Instance.new("SpawnLocation");spawn.Name="SafeSpawn";spawn.Size=Vector3.new(7,.2,7);spawn.CFrame=World.SafeSpawn-Vector3.new(0,3,0);spawn.Anchored=true;spawn.Neutral=true;spawn.Duration=0;spawn.Transparency=1;spawn.CanCollide=false;spawn.Parent=parent
    local roles={"Local","Tourist","Vendor","Commuter","Busker","Fighter"}
    -- Cluster residents at destinations; leave roads and building interiors clear.
    local seeds={{-625,205},{-575,205},{-600,185},{-610,265},{-360,180},{-360,260},{-120,-32},{-145,15},{-92,15},{85,-71},{155,-71},{85,7},{155,7},{-240,403},{0,403},{200,403},{420,403},{-540,403}}
    if layout.seeds then seeds=layout.seeds else
        for i=1,20 do local point=layout.walk[((i-1)*29+5)%#layout.walk+1];table.insert(seeds,{point.X,point.Z}) end
    end
    for i,spot in ipairs(seeds) do makeBot(parent,i,spot[1],spot[2],spot.role or roles[(i-1)%#roles+1]) end
    for i,job in ipairs(layout.jobs or {}) do local point=job.stations[1].position;makeBot(parent,#seeds+i,point.X,point.Z,job.role,job) end
    -- Dedicated sparring pads sit outside PvP and do not recruit city workers.
    for index,originalTier in ipairs(TrainingRules.Tiers) do
        local tier=originalTier;local padColor=C.green
        if Config.CompactCity then
            tier=table.clone(originalTier);local home=Config.CityLayout.TrainingHomes[index];tier.x=home.x;tier.z=home.z
            for _,spec in ipairs(Config.CityLayout.PartSpecs) do
                if spec.id=="TrainingPad"..index then padColor=spec.color;break end
            end
        end
        local pad=part(parent,"TrainingPad_"..tier.id,Vector3.new(64,.2,64),Vector3.new(tier.x,Config.CompactCity and .1 or 1.1,tier.z),padColor,Enum.Material.SmoothPlastic)
        local sign=part(parent,"TrainingSign_"..tier.id,Vector3.new(1,1,1),Vector3.new(tier.x,7,tier.z+30),C.gold,nil,false);sign.Transparency=1
        local words=billboard(sign,tier.name.." · recommended Lv "..tier.level.."\n"..tier.health.." HP · "..tier.xp.." base XP\nHit to spar · move out of red strikes",Vector3.zero,280)
        words.Parent.Size=UDim2.fromOffset(280,76);words.Parent.MaxDistance=100
        makeBot(parent,#World.Bots+1,tier.x,tier.z,"Fighter",nil,tier)
    end
    if layout.traffic~=false then
    for i,spec in ipairs({{-368,1,23},{-352,-1,21},{112,1,20},{128,-1,24},{352,1,18},{368,-1,22}}) do
        local m=vehicle(parent,i%2==0 and "Sedan" or "Taxi",i%2==0 and Color3.fromRGB(65+i*15,104,115) or Color3.fromRGB(226,177,64));m.Name="TrafficCar"..i
        local car={model=m,hull=m.CollisionHull,lane=spec[1],direction=spec[2],speed=spec[3],cruiseSpeed=spec[3],distance=(i-1)*210};m:PivotTo(carAt(car,car.distance));table.insert(World.Cars,car)
    end
    for i,pos in ipairs({{-490,-110},{490,105},{-490,130},{690,120}}) do taxi(parent,pos[1],pos[2],"Sedan",Color3.fromRGB(91+i*22,93,99)) end
    end -- compact replacement is pedestrian-only
    if RunService:IsRunning() then
        task.spawn(function()
            local grounding=0
            while parent.Parent do
                local dt=RunService.Heartbeat:Wait();local now=os.clock();grounding+=dt
                for _,car in ipairs(World.Cars) do
                    World.StepTraffic(car,dt)
                end
                local groundParams
                if grounding>=.25 then
                    groundParams=RaycastParams.new();groundParams.FilterType=Enum.RaycastFilterType.Exclude
                    local exclude={}
                    for _,bot in ipairs(World.Bots) do table.insert(exclude,bot.model) end
                    for _,player in ipairs(game.Players:GetPlayers()) do if player.Character then table.insert(exclude,player.Character) end end
                    groundParams.FilterDescendantsInstances=exclude;groundParams.RespectCanCollide=true
                end
                for _,bot in ipairs(World.Bots) do
                    if bot.water then bot.water.Enabled=bot.alive and bot.working==true end
                    local repairing=bot.alive and bot.working and bot.model:GetAttribute("Repairing")==true
                    for _,item in ipairs(bot.cleaningParts or {}) do item.Transparency=repairing and 1 or 0 end
                    for _,item in ipairs(bot.repairParts or {}) do item.Transparency=repairing and 0 or 1 end
                    if not bot.alive or not bot.root.Parent then continue end
                    World.StepTrainingRoam(bot,now)
                    local gesture=(bot.gestureUntil or 0)>now
                    if bot.model:GetAttribute("Gesturing")~=gesture then bot.model:SetAttribute("Gesturing",gesture) end
                    if bot.model:GetAttribute("Working")~=(bot.working==true) then bot.model:SetAttribute("Working",bot.working==true) end
                    if grounding>=.25 and not bot.humanoid.SeatPart then
                        local hit=workspace:Raycast(bot.root.Position+Vector3.new(0,2,0),Vector3.new(0,-20,0),groundParams)
                        local gap=hit and bot.root.Position.Y-hit.Position.Y or 99
                        if gap>5 or gap<1.5 or bot.root.Position.Y>8 or bot.root.Position.Y< -3 then
                            bot.airSince=bot.airSince or now
                            if now-bot.airSince>.45 then
                                -- Invalidate the old path/precision approach before moving
                                -- the resident back. Otherwise its sleeping route coroutine
                                -- can resume toward the waypoint that caused the fall.
                                stopWalking(bot)
                                bot.model:SetAttribute("Activity","Finding a safe route")
                                bot.model:PivotTo(CFrame.new(bot.lastGrounded or bot.start));bot.root.AssemblyLinearVelocity=Vector3.zero;bot.root.AssemblyAngularVelocity=Vector3.zero;bot.humanoid:MoveTo(bot.root.Position);bot.airSince=nil
                            end
                        else bot.airSince=nil;bot.lastGrounded=bot.root.Position end
                    end
                end
                if grounding>=.25 then grounding=0 end
            end
        end)
    end
    return parent
end
function World.UpdateBot(bot)
    bot.model:SetAttribute("ResidentActive",bot.alive==true)
    -- A normal hit already started its flee reaction. Do not cancel that MoveTo here.
    if not bot.alive or bot.health==(bot.maxHealth or Config.BotMaxHealth) then
        stopWalking(bot);bot.model:SetAttribute("Working",false)
        bot.socialUntil=0;bot.talkingTo=nil;bot.reactionUntil=0;bot.gestureUntil=0
        bot.speechToken=(bot.speechToken or 0)+1;bot.speech.Visible=false
    end
    bot.label.Text=bot.alive and bot.name or "RECOVERING"
    local nameplateMaximum=bot.maxHealth or Config.BotMaxHealth
    local showHealth=bot.alive==true and bot.health<nameplateMaximum
    if bot.nameplateHealth then
        bot.nameplateHealth.Text=tostring(bot.health).." / "..tostring(nameplateMaximum).." HP"
        bot.nameplateHealth.Visible=showHealth;bot.nameplateTrack.Visible=showHealth
        bot.nameplateFill.Size=UDim2.fromScale(nameplateMaximum>0 and math.clamp(bot.health/nameplateMaximum,0,1) or 0,1)
        bot.nameplatePanel.Size=UDim2.fromOffset(180,showHealth and 60 or 36)
    end
    if bot.alive then
        bot.humanoid.Health=bot.health
        if bot.health==(bot.maxHealth or Config.BotMaxHealth) then
            bot.root.Anchored=false;bot.model:PivotTo(CFrame.new(bot.start));bot.root.AssemblyLinearVelocity=Vector3.zero
            if bot.training then
                bot.lastGrounded=bot.start;bot.airSince=nil;bot.root.AssemblyAngularVelocity=Vector3.zero
                bot.humanoid.WalkSpeed=TrainingRules.RoamSpeed
            end
            bot.root:SetNetworkOwner(nil)
        end
    else
        bot.humanoid:MoveTo(bot.root.Position);bot.root.Anchored=true;bot.model:PivotTo(CFrame.new(bot.start-Vector3.new(0,100,0)));bot.speech.Visible=false
    end
end
return World
]]></string>
      </Properties>
    </Item>
  </Item>
