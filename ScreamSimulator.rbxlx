      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[local Healing=require(script.Parent:WaitForChild("Healing"))
local VoiceCombat=require(script.Parent:WaitForChild("VoiceCombat"))
local Progression=require(script.Parent:WaitForChild("Progression"))
local Config = {}
local CompactLayout=require(script.Parent:WaitForChild("CompactLayout"))
Config.CompactCity=true
Config.ObjectDestruction=false -- owner excludes object destruction from the compact replacement
Config.CityLayout=CompactLayout
Config.AutomaticVoice = true -- next local release; server owns the selected mode
Config.Progression=Progression
Config.VoiceCombat=VoiceCombat
Config.MaxLevel = VoiceCombat.MaxLevel
Config.MaxHealth = 100
Config.MapMin=Config.CompactCity and CompactLayout.BoundsMin or Vector3.new(-720,-20,-600)
Config.MapMax=Config.CompactCity and CompactLayout.BoundsMax or Vector3.new(720,200,600)
function Config.HealthForLevel(level) return VoiceCombat.Stats(level,1,false).health end
Config.HealQuietSeconds = Healing.QuietSeconds
Config.HealAmount = Healing.Fraction*100 -- percent of maximum health
Config.BotMaxHealth = 60
Config.BotRespawnSeconds = 6
Config.WalkSpeed = 16
Config.SprintSpeed = 25
Config.SprintDuration = 10
Config.SprintRecovery = 5
Config.SprintRegenDelay = 1 -- continuous time without granted sprint before partial refill
Config.SpawnProtection = 5
Config.MovementPassId = 0 -- Configure only after the owner creates the pass.
Config.MicroSpeakerPrice = 1500
Config.DodgeCooldown = 4
Config.DodgeDuration = 0.6
Config.DodgeDistance = 14
Config.DeliveryStops={
 {id="StageDelivery",name="boardwalk music stage",position=Vector3.new(150,2,403)},
 {id="LookoutDelivery",name="lifeguard lookout",position=Vector3.new(-240,2,427)},
 {id="PierDelivery",name="end of the timber pier",position=Vector3.new(525,3,580)},
}
if Config.CompactCity then Config.DeliveryStops=CompactLayout.DeliveryStops end
function Config.GetDeliveryStop(id) for _,stop in ipairs(Config.DeliveryStops) do if stop.id==id then return stop end end end
Config.ZoneMin = Vector3.new(-480,-20,-360)
Config.ZoneMax = Vector3.new(480,200,360)
if Config.CompactCity then Config.ZoneMin=CompactLayout.ZoneMin;Config.ZoneMax=CompactLayout.ZoneMax end
Config.Sounds = {
 {id="TinyAah",name="Tiny Aah",level=1,effect="Pulse",description="A clean pulse around your aimed voice beam.",assetId=""},
 {id="IyoPop",name="Echo Pop",level=10,effect="Echo",description="Three echo rings wrap your aimed voice beam.",assetId=""},
 {id="PanicChicken",name="Panic Chicken",level=20,effect="Feathers",description="Feather-shaped sparks follow your voice beam.",assetId=""},
 {id="Laughquake",name="Laughquake",level=30,effect="Quake",description="Jagged ribbons trace your aimed voice beam.",assetId=""},
 {id="MegaChaos",name="Storm Siren",level=40,effect="Storm",description="Electric strands trace your aimed voice beam.",assetId=""},
 {id="Supernova",name="Supernova",level=50,effect="Nova",description="A bright starburst marks the end of your beam.",assetId=""},
}
-- Reuse existing visuals at the new ten-level cadence; no cosmetic expansion.
local families={"Pulse","Echo","Feathers","Quake","Storm","Nova"}
local titles={"Resonance","Prism","Sunburst","Aftershock","Tempest","Aurora"}
local ranks={"Coastal","Mosaic","Moonlit","Radiant","Spectral","Celestial","Royal","Mythic","Astral","Legendary"}
for level=60,Config.MaxLevel,10 do
 local n=(level-60)/10
 local family=n%#families+1
 local rank=math.floor(n/#families)+1
 table.insert(Config.Sounds,{id="VoiceStyle"..level,name=ranks[rank].." "..titles[family],level=level,effect=families[family],description="Mic-powered "..string.lower(families[family]).." visuals. Power and reach scale with your level.",assetId="",variant=rank})
end
for _,style in ipairs(Config.Sounds) do style.cooldown=4 end
Config.Auras={Gold=Color3.fromRGB(255,203,99),Mint=Color3.fromRGB(98,244,187),Violet=Color3.fromRGB(188,137,255),Ice=Color3.fromRGB(110,207,255),Coral=Color3.fromRGB(255,128,128)}
Config.Quests={
 {id="nick",name="The Worst Striker’s Best Assist",hidden=true,giver="Nick Booty · hidden coastal court",description="Find Nick’s three lost balls (120s), steer through four cone-course gates (90s), then hit five targets (120s). Final targets move and Nick’s assist drifts right. Soft mic shots give control. Restart at his court.",goal=1,xp=1800,coins=1200,event="Soccer"},
 {id="garden",name="A Little More Color",description="Help Mar Soler water the three raised flowerbeds in Rambla Gardens. Use the interaction prompt beside each bed.",giver="Mar Soler · Rambla Gardens",goal=3,xp=130,coins=80,event="Garden"},
 {id="beach",name="Leave Only Footprints",description="Collect 6 washed-up bottles on the beach. Use the interaction prompt beside each bottle.",goal=6,xp=100,coins=50,event="Litter"},
 {id="delivery",name="Coffee on the Coast",description="Collect a café order, then deliver it to your assigned waterfront stop within 90 seconds. Check your objective for the recipient.",goal=1,xp=120,coins=60,event="Delivery"},
 {id="crowd",name="Three's a Crowd",description="Hit 3 different NPCs (residents or training fighters) during one beam. They do not need to be hit at the same instant.",goal=1,xp=100,coins=40,event="Crowd"},
 {id="sprint",name="Boardwalk Dash",description="Start beside the lifeguard tower and follow the promenade east to the finish in 25 seconds.",goal=1,xp=120,coins=50,event="Race"},
 {id="dodge",name="Can't Touch This",description="Dodge 3 enemy beams in the central arena.",goal=3,xp=160,coins=70,event="Evade"},
 {id="arena",name="Underdog",description="Knock out a player whose level is at least yours in the central arena.",goal=1,xp=180,coins=80,event="Underdog"},
}
-- Permanent identities: retired definitions preserve earned claims and dormant counters.
-- They are not offered or progressed, and their IDs/rewards must never be reused.
table.insert(Config.Quests,{id="practice_beams",name="Controlled Beams",retired=true,goal=3,xp=60,coins=25,event="PracticeBeam"})
table.insert(Config.Quests,{id="arena_assist",name="Team Effort",description="Help knock out an equal/higher-level player in the arena without landing the final hit. Deal at least 10% of their maximum health and earn KO credit. Your damage credit expires after 25 seconds without a hit; repeated opponents may not count.",goal=1,xp=120,coins=50,event="ArenaAssist",menuAvailable=true})
local questGivers={beach="Mar Soler · Rambla Gardens",delivery="Pau Vidal · Mercat del Mar",crowd="Busker · west gardens",sprint="Commuter · Plaça del Sol",dodge="Fighter · Rambla Gardens",arena="Fighter · Rambla Gardens"}
if Config.CompactCity then
 questGivers.crowd="Eric Sol · west courtyard"
 questGivers.sprint="Boardwalk runner · west promenade"
 questGivers.dodge="Arena coach · west arena gate";questGivers.arena=questGivers.dodge
end
for _,quest in ipairs(Config.Quests) do quest.giver=quest.giver or questGivers[quest.id] end
function Config.SoundForLevel(level)
 local chosen=Config.Sounds[1]
 for _,s in ipairs(Config.Sounds) do if s.level<=level then chosen=s end end
 return chosen
end
function Config.GetSound(id)
 for _,s in ipairs(Config.Sounds) do if s.id==id then return s end end
 -- Resolve retired save IDs; Profiles archives the original selection.
 local legacy=type(id)=="string" and tonumber(id:match("^VoiceStyle(%d+)$"))
 if legacy and legacy>=30 and legacy<=300 and legacy%5==0 then
  return Config.SoundForLevel(math.min(Config.MaxLevel,legacy))
 end
end
function Config.GetQuest(id) for _,q in ipairs(Config.Quests) do if q.id==id then return q end end end
function Config.XPToNext(level) return Progression.XPToNext(level) end
function Config.PlayerKOXP(level) return Progression.PlayerKOXP(level) end
function Config.InArena(p) return p.X>=Config.ZoneMin.X and p.X<=Config.ZoneMax.X and p.Z>=Config.ZoneMin.Z and p.Z<=Config.ZoneMax.Z and p.Y>=Config.ZoneMin.Y and p.Y<=Config.ZoneMax.Y end
return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">DestructionRules</string>
          <string name="Source"><![CDATA[local Rules={}
Rules.Types={
 Bench={name="Bench",level=1,health=50,repair=120},
 Bin={name="Trash bin",level=1,health=36,repair=120},
 SmallTree={name="Small tree",level=26,health=110,repair=180},
 Bike={name="Bicycle",level=35,health=145,repair=180},
 HouseFacade={name="House frontage",level=51,health=180,repair=300},
 ApartmentFacade={name="Apartment frontage",level=76,health=250,repair=300},
 TowerFacade={name="Tower frontage",level=100,health=340,repair=300},
}
function Rules.Hit(kind,level,health,damage)
 local spec=Rules.Types[kind]
 if not spec or type(level)~='number' or level~=level or math.abs(level)==math.huge or level<spec.level then return health,false,'level' end
 if type(damage)~='number' or damage~=damage or damage<=0 or damage>48 then return health,false,'damage' end
 if type(health)~='number' or health~=health or health<=0 or health>spec.health then return health,false,'health' end
 local nextHealth=math.max(0,health-damage)
 return nextHealth,nextHealth==0,nil
end
return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">FirstBeamGuide</string>
          <string name="Source"><![CDATA[-- Presentation only. Completion comes from a server-confirmed target hit.
local Guide = {}

function Guide.Text(data, armed, cooldown, active, touch)
    if data.activeQuest or (data.level or 1) > 1 or (data.achievements or {}).FirstBeam then
        return nil
    end
    if active then
        return "FIRST BEAM · 3/3\nKeep aiming at the practice target.\nGo quiet to stop."
    end
    if cooldown > 0 then
        return "FIRST BEAM · 2/3\nLet your voice rest during cooldown.\nAim at MIC PRACTICE beside spawn."
    end
    if not armed then
        local control = touch and "Tap BEAMS to turn attacks on" or "Press E to turn beams on"
        return "FIRST BEAM · 1/3\n" .. control .. ".\nFind MIC PRACTICE beside spawn."
    end
    return "FIRST BEAM · 2/3\nAim at MIC PRACTICE beside spawn.\nGo quiet, then speak to fire."
end

return Guide
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">GameplayAudioConfig</string>
          <string name="Source"><![CDATA[-- Original gameplay cues. Fill AssetId only after approved Roblox upload and
-- destination-experience permission checks. Empty IDs intentionally stay silent.
local Config = {
 GroupVolume = .5,
 TotalVolume = .12, -- separate quiet budget; at most .06 after the group
 VoiceDuck = .35,
 Limit = 6,
 Range = 50,
 NearDistance = 5,
 FadeOut = .035,
 Cues = {
  Hit = {AssetId = "", Cooldown = .16, Lifetime = .20, Spatial = false},
  Dodge = {AssetId = "", Cooldown = .15, Lifetime = .40, Spatial = true},
  Break = {AssetId = "", Cooldown = .12, Lifetime = .55, Spatial = true},
  LevelUp = {AssetId = "", Cooldown = 1, Lifetime = .80, Spatial = false},
 },
}
function Config.Asset(kind)
 local cue=Config.Cues[kind]
 local id=cue and cue.AssetId
 return type(id)=="string" and id:match("^[1-9]%d*$") and "rbxassetid://"..id or nil
end
function Config.Ready()
 for kind in pairs(Config.Cues) do if Config.Asset(kind) then return true end end
 return false
end
return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Healing</string>
          <string name="Source"><![CDATA[-- Shared by authoritative gameplay and deterministic balance scenarios.
local Healing={QuietSeconds=12,Fraction=.2}
function Healing.Step(health,maximum,nextHeal,now)
 -- One heal per observation: lag must not accumulate instant catch-up heals.
 if health<=0 or health>=maximum or now<nextHeal then return health,nextHeal end
 return math.min(maximum,health+maximum*Healing.Fraction),now+Healing.QuietSeconds
end
return Healing
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">InteractionRules</string>
          <string name="Source"><![CDATA[-- Shared targeting rule; the server repeats it before granting conversation access.
local Rules={}
function Rules.CanReachNpc(character,npc,maxDistance)
 local root=character and character:FindFirstChild("HumanoidRootPart")
 local target=npc and npc:FindFirstChild("HumanoidRootPart")
 local humanoid=character and character:FindFirstChildOfClass("Humanoid")
 local resident=npc and npc:FindFirstChildOfClass("Humanoid")
 if not root or not target or not humanoid or not resident or humanoid.Health<=0 or resident.Health<=0 or humanoid.PlatformStand or resident.PlatformStand
  or (root.Position-target.Position).Magnitude>maxDistance then return false end
 local origin=(character:FindFirstChild("Head") or root).Position
 local destination=(npc:FindFirstChild("Head") or target).Position
 local ray=RaycastParams.new();ray.FilterType=Enum.RaycastFilterType.Exclude
 ray.FilterDescendantsInstances={character,npc};ray.RespectCanCollide=true
 -- Residents do not collide with one another; a passing crowd should not
 -- prevent conversation, but walls, vehicles and other solid cover should.
 ray.CollisionGroup="Residents"
 return workspace:Raycast(origin,destination-origin,ray)==nil
end
return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">MicPower</string>
          <string name="Source"><![CDATA[-- Local normalized input energy; not physical dB and not proof of human speech.
local MicPower = {}
MicPower.__index = MicPower
local function finite(v) return type(v)=="number" and v==v and math.abs(v)<math.huge end
local function percentile(values, fraction)
 local copy=table.clone(values);table.sort(copy)
 return copy[math.clamp(math.ceil(#copy*fraction),1,#copy)] or 0
end
function MicPower.new()
 return setmetatable({floor=0.003,ceiling=0.06,smoothed=0,active=false,calibrated=false,samples={}},MicPower)
end
function MicPower:Calibrate(quiet,voice)
 self.calibrated=false;self:Reset()
 if #quiet<15 or #voice<15 then return false,"Not enough microphone samples" end
 for _,list in ipairs({quiet,voice}) do for _,v in ipairs(list) do if not finite(v) or v<0 then return false,"Invalid microphone samples" end end end
 local noise=percentile(quiet,.9)
 local loud=percentile(voice,.8)
 if loud < math.max(noise*2,noise+.006) then return false,"Voice too close to background noise; try again" end
 self.floor=math.max(.0001,noise*1.15)
 self.ceiling=math.max(self.floor+.006,loud)
 self.calibrated=true;self.smoothed=0;self.active=false
 return true
end
function MicPower:Step(rms,dt)
 if not finite(rms) or rms<0 or not finite(dt) or dt<=0 then self:Reset();return 0 end
 dt=math.min(dt,.1)
 local normalized=math.clamp((rms-self.floor)/(self.ceiling-self.floor),0,1)
 self.smoothed += (normalized-self.smoothed)*(1-math.exp(-dt/0.09))
 if self.active then self.active=self.smoothed>.05 else self.active=self.smoothed>.12 end
 return self.active and self.smoothed or 0
end
function MicPower:Reset()
 self.smoothed=0;self.active=false;self.samples={}
end
function MicPower:BeginCapture()
 -- A new attack cannot inherit energy from speech before the button press.
 self:Reset()
end
function MicPower:Capture(power)
 if finite(power) then table.insert(self.samples,math.clamp(power,0,1)) end
end
function MicPower:CapturePower()
 local samples=self.samples
 if #samples<5 then return 0 end
 local voiced=0;for _,v in ipairs(samples) do if v>=.08 then voiced+=1 end end
 if voiced<5 or voiced/#samples<.35 then return 0 end
 -- A short pop cannot determine attack strength; use sustained energy.
 return percentile(samples,.65)
end
function MicPower:Release()
 local power=self:CapturePower();self.samples={}
 return power
end
return MicPower
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">ProfileLease</string>
          <string name="Source"><![CDATA[-- Pure lease checks used inside atomic UpdateAsync callbacks.
local Lease={Duration=180}
function Lease.CanAcquire(record,owner,now,token)
 if type(record)~="table" or type(record._lease)~="table" then return true end
 local lease=record._lease
 if lease.owner==owner and (token==nil or lease.token==token) then return true end
 return type(lease.expires)~="number" or lease.expires~=lease.expires or lease.expires<=now
end
function Lease.Owns(record,owner,token)
 return type(record)=="table" and type(record._lease)=="table" and record._lease.owner==owner and (token==nil or record._lease.token==token)
end
function Lease.Stamp(record,owner,now,token)
 record._lease={owner=owner,token=token,expires=now+Lease.Duration}
 return record
end
return Lease
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Progression</string>
          <string name="Source"><![CDATA[-- Candidate economy; pacing assumptions live in tests/ProgressionPacing.luau.
local Progression={MaxLevel=100}
function Progression.Level(level)
 if type(level)~="number" or level~=level or math.abs(level)==math.huge then return 1 end
 return math.clamp(math.floor(level),1,Progression.MaxLevel)
end
function Progression.XPToNext(level)
 local l=Progression.Level(level)
 return math.floor(65+6*l+.6*l*l+.009*l*l*l)
end
function Progression.PlayerKOXP(level)
 return math.floor(90+6*Progression.Level(level))
end
function Progression.RewardFactor(attackerLevel,targetLevel)
 local gap=Progression.Level(attackerLevel)-Progression.Level(targetLevel)
 if gap<=-10 then return 1.25 end
 if gap<=10 then return 1 end
 if gap<=20 then return .5 end
 if gap<=30 then return .2 end
 return .05
end
Progression.Challenges={
 {id="fighters",name="Help defeat 3 eligible training fighters",goal=3},
}
-- Preserve old partial counters without displaying, progressing or paying them.
-- Retired IDs must not be reused for a different objective.
Progression.RetiredChallenges={
 {id="cover",goal=5},
 {id="elite",goal=2},
}
function Progression.ChallengeXP(level)
 return math.min(200,30+2*Progression.Level(level))
end
function Progression.Advance(challenges,id,level)
 for _,spec in ipairs(Progression.Challenges) do
  if spec.id==id then
   local count=math.clamp(math.floor(challenges[id] or 0),0,spec.goal-1)+1
   challenges[id]=count==spec.goal and 0 or count
   return count==spec.goal and Progression.ChallengeXP(level) or 0,spec.name
  end
 end
 return 0
end
function Progression.Normalize(level,xp)
 local l=Progression.Level(level)
 local value=type(xp)=="number" and xp==xp and math.abs(xp)<math.huge and math.clamp(math.floor(xp),0,1e9) or 0
 while l<Progression.MaxLevel and value>=Progression.XPToNext(l) do value-=Progression.XPToNext(l);l+=1 end
 return l,l==Progression.MaxLevel and 0 or value
end
return Progression
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">QuestGuide</string>
          <string name="Source"><![CDATA[-- Short current-step directions for the HUD; never grants progress or rewards.
local Guide={}
function Guide.Step(quest,progress,carrying,racing,soccerDetail,deliveryName)
 if not quest then return nil end
 if progress>=quest.goal then return "Complete · claim in Quests" end
 if quest.id=="nick" then return soccerDetail or "Return to Nick's coastal court" end
 if quest.id=="delivery" then return carrying and "Deliver to the "..(deliveryName or "boardwalk music stage") or "Pick up coffee at the market" end
 if quest.id=="sprint" then return racing and "Run east along the promenade!" or "Start beside the lifeguard tower" end
 local directions={
  garden="Water flowerbeds in Rambla Gardens",
  beach="Collect bottles along the beach",
  crowd="Hit 3 different NPCs during one beam",
  arena_assist="Assist an equal/higher-level arena KO",
  dodge="Dodge enemy beams in the arena",
  arena="KO an equal/higher-level arena player",
 }
 return directions[quest.id] or quest.description
end
return Guide
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">QuestLifecycle</string>
          <string name="Source"><![CDATA[-- Reset an abandoned/switched attempt without discarding an earned, unclaimed reward.
local QuestLifecycle={}
function QuestLifecycle.Clear(session,getQuest)
 local id=session.activeQuest
 local definition=id and getQuest(id)
 local progress=id and session.data.quests[id]
 if definition and progress and not progress.claimed and progress.progress<definition.goal then progress.progress=0 end
 session.activeQuest=nil;session.questDeadline=nil;session.carrying=false;session.deliveryStop=nil;session.raceStart=nil;session.collected={}
end
return QuestLifecycle
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">ShopCatalog</string>
          <string name="Source"><![CDATA[-- Set IDs only after the owner creates and approves the matching Roblox products.
local Catalog={Duration=30*60}
Catalog.Items={
 {key="Spectrum",name="SPECTRUM",tag="PERMANENT PASS",description="Choose your beam hue. Your signature.",kind="pass",id=0},
 {key="XP",name="DOUBLE XP",tag="30-MINUTE BOOST",description="Earn twice the XP from combat and quests.",kind="product",id=0,boost="xp"},
 {key="Coins",name="DOUBLE COINS",tag="30-MINUTE BOOST",description="Earn twice the coins from gameplay rewards.",kind="product",id=0,boost="coins"},
 {key="Movement",name="FREERUNNER",tag="PERMANENT PASS",description="Extra jumps and consecutive rolls in safe areas.",kind="pass",id=0},
}
function Catalog.Get(key) for _,item in ipairs(Catalog.Items) do if item.key==key then return item end end end
function Catalog.Product(id)
 if type(id)~="number" or id<=0 then return end
 local found
 for _,item in ipairs(Catalog.Items) do
  if item.kind=="product" and item.id==id then if found then return end;found=item end
 end
 return found
end
function Catalog.Hex(value)
 if type(value)~="string" or #value>7 then return end
 local hex=value:gsub("^#",""):upper()
 if #hex==6 and hex:match("^%x+$") then return hex end
end
return Catalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">SustainedAttack</string>
          <string name="Source"><![CDATA[-- Pure server-side protocol used by the automatic voice adapter.
-- now is the server clock, maxDps is server-derived, targets are server-resolved
-- IDs after geometry/PvP checks. None may come directly from client payloads.
local Attack={MaxDuration=4,Cooldown=5,TickInterval=.2,InputTimeout=.5,
 MinPulseInterval=.1,MinimumPower=.08,MaxDps=110,MaxTargets=128,MaxStep=.25}
local EPS=1e-7
local function finite(n) return type(n)=="number" and n==n and math.abs(n)<math.huge end
local function observe(s,now)
 if not finite(now) or now<0 or now<s.time then return false end
 s.time=now;return true
end
local function deadline(a) return math.min(a.started+Attack.MaxDuration,a.lastPulse+Attack.InputTimeout) end
local function finish(s,now,reason)
 local a=s.active;if not a then return nil end
 local ended=math.min(now,deadline(a))
 s.active=nil;s.nextStart=ended+Attack.Cooldown
 return {sequence=a.sequence,endedAt=ended,nextStart=s.nextStart,reason=reason}
end
local function expire(s,now)
 local a=s.active
 if a and now+EPS>=deadline(a) then
  return finish(s,now,a.started+Attack.MaxDuration<=a.lastPulse+Attack.InputTimeout and "duration" or "timeout")
 end
end
function Attack.New() return {time=0,lastSequence=0,nextStart=0,active=nil} end
function Attack.Begin(s,now,sequence,maxDps,power,allowed)
 if not observe(s,now) then return false,"clock" end
 local ended=expire(s,now)
 if not finite(sequence) or sequence%1~=0 or sequence<1 or sequence>2^31 then return false,"sequence",ended end
 if sequence<=s.lastSequence then return false,"replay",ended end
 s.lastSequence=sequence
 -- A duplicate/new begin cannot cancel or refresh a running attack.
 if s.active then return false,"active",ended end
 if allowed~=true then return false,"state",ended end
 if now+EPS<s.nextStart then return false,"cooldown",ended end
 if not finite(maxDps) or maxDps<=0 or maxDps>Attack.MaxDps then return false,"budget",ended end
 if not finite(power) or power<Attack.MinimumPower or power>1 then return false,"power",ended end
 s.active={sequence=sequence,started=now,lastPulse=now,lastTick=now,power=power,
  maxDps=maxDps,targets={},targetCount=0}
 return true,nil,ended
end
function Attack.Pulse(s,now,sequence,power,allowed)
 if not observe(s,now) then return false,"clock" end
 local ended=expire(s,now);if ended then return false,ended.reason,ended end
 local a=s.active;if not a or sequence~=a.sequence then return false,"sequence" end
 if allowed~=true then return false,"state",finish(s,now,"state") end
 if not finite(power) or power<0 or power>1 then return false,"power",finish(s,now,"power") end
 if power<Attack.MinimumPower then return false,"quiet",finish(s,now,"quiet") end
 if now-a.lastPulse+EPS<Attack.MinPulseInterval then return false,"rate" end
 a.lastPulse=now;a.power=power
 return true
end
function Attack.Stop(s,now,sequence)
 if not observe(s,now) then return nil,"clock" end
 local ended=expire(s,now);if ended then return ended end
 if not s.active or sequence~=s.active.sequence then return nil,"sequence" end
 return finish(s,now,"stop")
end
function Attack.Cancel(s,now)
 if not observe(s,now) then return nil,"clock" end
 return finish(s,now,"state")
end
local function validId(id)
 return (type(id)=="string" and #id>0 and #id<=128)
  or (finite(id) and id%1==0 and id>=0)
end
function Attack.NeedsTargets(s,now)
 local a=s.active
 return a~=nil and finite(now) and now>=s.time and now+EPS<a.lastPulse+Attack.InputTimeout
  and math.min(now,a.started+Attack.MaxDuration)-a.lastTick+EPS>=Attack.TickInterval
end
function Attack.Step(s,now,allowed,targets)
 if not observe(s,now) then return {},nil,"clock" end
 local a=s.active;if not a then return {} end
 if allowed~=true then return {},finish(s,now,"state") end
 -- Missing input ends damage immediately when observed; never backfill hits
 -- against geometry we did not check. A regular final duration tick is allowed.
 if now+EPS>=a.lastPulse+Attack.InputTimeout then
  local reason=a.started+Attack.MaxDuration<=a.lastPulse+Attack.InputTimeout and "duration" or "timeout"
  return {},finish(s,now,reason)
 end
 local untilTime=math.min(now,a.started+Attack.MaxDuration)
 local elapsed=untilTime-a.lastTick
 local hits={}
 if elapsed+EPS>=Attack.TickInterval then
  local dt=math.min(elapsed,Attack.MaxStep)
  a.lastTick=untilTime
  local seen={};local visited=0
  for _,id in ipairs(type(targets)=="table" and targets or {}) do
   visited+=1;if visited>Attack.MaxTargets then break end
   if not validId(id) or seen[id] then continue end
   seen[id]=true
   local target=a.targets[id]
   if not target then
    if a.targetCount>=Attack.MaxTargets then continue end
    target={accumulated=0,applied=0};a.targets[id]=target;a.targetCount+=1
   end
   target.accumulated=math.min(a.maxDps*Attack.MaxDuration,
    target.accumulated+a.maxDps*(.45+.55*a.power)*dt)
   local whole=math.floor(target.accumulated+EPS)
   local damage=whole-target.applied
   if damage>0 then
    table.insert(hits,{id=id,damage=damage,firstHit=target.applied==0})
    target.applied=whole
   end
  end
 end
 local ended=now+EPS>=a.started+Attack.MaxDuration and finish(s,now,"duration") or nil
 return hits,ended
end
return Attack
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">SustainedRewards</string>
          <string name="Source"><![CDATA[-- Server-owned NPC reward budget for one sustained scream. A later KO tops up
-- the initial hit reward; repeated damage/KO observations never pay twice.
local Rewards={Limit=5,Cooldown=10,HitCoins=2,HitXP=1,KOCoins=5,KOXP=3}
function Rewards.Hit(intent,cooldowns,id,now,firstHit,knockedOut)
 intent.rewardedBots=intent.rewardedBots or {}
 local paid=intent.rewardedBots[id]
 local coins,xp=0,0
 if not paid and firstHit and (intent.paid or 0)<Rewards.Limit and now>=(cooldowns[id] or 0) then
  paid={knockedOut=false};intent.rewardedBots[id]=paid
  intent.paid=(intent.paid or 0)+1;cooldowns[id]=now+Rewards.Cooldown
  coins,xp=Rewards.HitCoins,Rewards.HitXP
 end
 if paid and knockedOut and not paid.knockedOut then
  paid.knockedOut=true
  coins+=Rewards.KOCoins-Rewards.HitCoins;xp+=Rewards.KOXP-Rewards.HitXP
 end
 return coins,xp
end
return Rewards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">TrainingRules</string>
          <string name="Source"><![CDATA[local Training={Radius=32,Windup=1.1,AttackInterval=4,ResetAfter=25,RoamRadius=18,RoamSpeed=7,RoamLeash=22}
Training.Tiers={
 {id="rookie",name="Rookie",level=1,maxLevel=24,health=80,damage=8,xp=48,x=-440,z=545},
 {id="brawler",name="Brawler",level=25,maxLevel=59,health=220,damage=18,xp=180,x=-320,z=545},
 {id="elite",name="Elite",level=60,maxLevel=100,health=420,damage=32,xp=420,x=-200,z=545},
}
function Training.RewardLevel(tier,level)
 return math.clamp(level,tier.level,tier.maxLevel)
end
function Training.Recommended(level)
 local tier=Training.Tiers[1]
 for _,candidate in ipairs(Training.Tiers) do if level>=candidate.level then tier=candidate end end
 return tier
end
-- A telegraphed strike lands at a fixed point; moving four studs or dodging avoids it.
function Training.Hits(distanceFromAim,protected,dodging)
 return distanceFromAim<=4 and not protected and not dodging
end
return Training
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">VoiceActivation</string>
          <string name="Source"><![CDATA[-- Pure local onset gate. Input is calibrated power, never proof of human speech.
-- The caller supplies armed/allowed/ready and handles server acknowledgement.
local Gate={}
Gate.__index=Gate
Gate.OnPower=.35
Gate.OffPower=.18
Gate.OnSeconds=.25
Gate.QuietSeconds=.2
local function finite(n) return type(n)=="number" and n==n and math.abs(n)<math.huge end
function Gate.new()
 return setmetatable({active=false,quiet=0,onset=0,needsQuiet=true},Gate)
end
function Gate:Cancel()
 local wasActive=self.active
 self.active=false;self.quiet=0;self.onset=0;self.needsQuiet=true
 return wasActive and "stop" or nil
end
function Gate:Step(dt,power,armed,allowed,ready)
 if not finite(dt) or dt<=0 or not finite(power) or power<0 or power>1
  or armed~=true or allowed~=true or ready~=true then return self:Cancel() end
 -- A frame hitch cannot turn a one-frame sound into sustained voice/quiet.
 dt=math.min(dt,.1)
 if self.active then
  self.quiet=power<=Gate.OffPower and self.quiet+dt or 0
  if self.quiet+1e-7>=Gate.QuietSeconds then
   self.active=false;self.quiet=0;self.onset=0;self.needsQuiet=false
   return "stop"
  end
 elseif self.needsQuiet then
  self.quiet=power<=Gate.OffPower and self.quiet+dt or 0
  if self.quiet+1e-7>=Gate.QuietSeconds then self.needsQuiet=false;self.quiet=0 end
 else
  self.onset=power>=Gate.OnPower and self.onset+dt or 0
  if self.onset+1e-7>=Gate.OnSeconds then
   self.active=true;self.onset=0;self.quiet=0
   return "start"
  end
 end
 return nil
end
return Gate
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">VoiceCombat</string>
          <string name="Source"><![CDATA[-- Pure rules: no client-selected damage, range, victim, or reward is authoritative.
local VoiceCombat = {}
VoiceCombat.MaxLevel = 100
VoiceCombat.Cooldown = 4
VoiceCombat.MinCapture = 0.25
VoiceCombat.MaxCapture = 1.25
VoiceCombat.CaptureExpiry = 8
VoiceCombat.MinimumPower = 0.08

function VoiceCombat.IsFinite(value)
 return type(value) == "number" and value == value and math.abs(value) < math.huge
end
function VoiceCombat.Level(value)
 if not VoiceCombat.IsFinite(value) then return 1 end
 return math.clamp(math.floor(value), 1, VoiceCombat.MaxLevel)
end
-- Approved progression anchors; interpolate each level without widening reach.
local tiers = {
 {level=1,health=100,dps=15}, {level=25,health=150,dps=23},
 {level=50,health=225,dps=34}, {level=75,health=325,dps=49},
 {level=100,health=450,dps=110},
}
local function progression(level)
 for i=2,#tiers do
  local lower,upper=tiers[i-1],tiers[i]
  if level<=upper.level then
   local t=(level-lower.level)/(upper.level-lower.level)
   return math.floor(lower.health+(upper.health-lower.health)*t+.5),
    lower.dps+(upper.dps-lower.dps)*t
  end
 end
end
function VoiceCombat.Stats(level, power, amplifier)
 local l = VoiceCombat.Level(level)
 local health,maxDps = progression(l)
 local p = VoiceCombat.IsFinite(power) and math.clamp(power, 0, 1) or 0
 if amplifier then p = math.min(1, p * 1.12) end
 local maximum = 30 + 0.25 * (l - 1)
 return {
  maxRange = maximum,
  range = math.min(110, maximum * (0.4 + 0.6 * p)),
  damage = math.min(48, math.floor((18 + 0.1 * (l - 1)) * (0.45 + 0.55 * p) + 0.5)),
  width = 4 + 3 * (l - 1) / (VoiceCombat.MaxLevel - 1),
  health = health,
  maxDps = maxDps, -- sustained full-power budget; legacy burst damage stays separate
  power = p,
  cooldown = VoiceCombat.Cooldown,
 }
end
function VoiceCombat.New()
 return {lastSequence = 0, nextCast = 0, capture = nil}
end
function VoiceCombat.Cancel(state)
 state.capture = nil
end
function VoiceCombat.Begin(state, now, sequence, allowed)
 if not VoiceCombat.IsFinite(sequence) or sequence % 1 ~= 0 or sequence < 1 or sequence > 2^31 then return false, "sequence" end
 if sequence <= state.lastSequence then return false, "replay" end
 state.lastSequence = sequence
 -- Every begin invalidates an older capture, including a rejected one.
 state.capture = nil
 if not allowed then return false, "state" end
 if now < state.nextCast then return false, "cooldown" end
 state.capture = {started = now, sequence = sequence}
 return true
end
function VoiceCombat.Release(state, now, sequence, power, allowed)
 local capture = state.capture
 state.capture = nil -- consume even invalid releases; never queue a shot
 if not capture or sequence ~= capture.sequence then return false, "capture" end
 if not allowed then return false, "state" end
 if now < state.nextCast then return false, "cooldown" end
 local elapsed = now - capture.started
 if elapsed < VoiceCombat.MinCapture or elapsed > VoiceCombat.CaptureExpiry then return false, "duration" end
 if not VoiceCombat.IsFinite(power) or power < VoiceCombat.MinimumPower or power > 1 then return false, "power" end
 state.nextCast = now + VoiceCombat.Cooldown
 return true
end
return VoiceCombat
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="24">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="25">
      <Properties>
        <string name="Name">BeachVolley</string>
        <string name="Source"><![CDATA[-- Shared, server-simulated beach activity. Hits arrive only after normal mic-cast
-- validation; this module never creates attacks, rewards, or client-owned physics.
local Run=game:GetService("RunService")
local Rules=require(script.Parent.CombatRules)
local Config=require(game:GetService("ReplicatedStorage").Shared.Config)
local compact=Config.CompactCity and Config.CityLayout.Volley
local Volley={}
local V=Vector3.new
local serve=compact and compact.serve or V(-50,4,489)
local boardPosition=compact and compact.board or V(-75,5,484)
local minimum=compact and compact.min or V(-70,0,479)
local maximum=compact and compact.max or V(-30,0,531)
local playerMinimum=compact and compact.playerMin or V(-77,0,472)
local playerMaximum=compact and compact.playerMax or V(-23,0,538)
local netZ=compact and compact.netZ or 505
local netMinX=compact and compact.netMinX or -70
local netMaxX=compact and compact.netMaxX or -30
local minimumCrossingHeight=compact and compact.minimumCrossingHeight or 10.2
local floorBallY=compact and compact.floorBallY or 2.1
local gameState
local function label(state,text)
 state.label.Text=text
 state.model:SetAttribute("Rally",state.rally)
 state.model:SetAttribute("BestRally",state.best)
 state.model:SetAttribute("Phase",state.phase)
end
local function reset(state)
 state.position=serve;state.velocity=V(0,0,0);state.phase="Ready";state.rally=0;state.crossed=false
 state.ball.Position=serve
 label(state,"MIC VOLLEY · BEST "..state.best.."\nAim a beam at the ball to serve\nTrade returns across the net")
end
local function fault(state,reason)
 state.phase="Resetting";state.resetAt=os.clock()+3;state.velocity=V(0,0,0)
 label(state,reason.." · RALLY "..state.rally.."\nBest "..state.best.." · next serve in 3s")
end
function Volley.Start(parent)
 if gameState then
  if gameState.connection then gameState.connection:Disconnect() end
  gameState.model:Destroy()
 end
 local model=Instance.new("Model");model.Name="BeachVolley";model.Parent=parent
 local ball=Instance.new("Part");ball.Name="VolleyBall";ball.Shape=Enum.PartType.Ball;ball.Size=V(2.2,2.2,2.2);ball.Color=Color3.fromRGB(250,205,84);ball.Material=Enum.Material.SmoothPlastic;ball.Anchored=true;ball.CanCollide=false;ball.CanTouch=false;ball.CanQuery=false;ball.Parent=model
 local board=Instance.new("Part");board.Name="CourtReadout";board.Size=V(.1,.1,.1);board.Position=boardPosition;board.Anchored=true;board.Transparency=1;board.CanCollide=false;board.CanTouch=false;board.CanQuery=false;board.Parent=model
 local gui=Instance.new("BillboardGui");gui.Size=UDim2.fromOffset(230,66);gui.MaxDistance=48;gui.AlwaysOnTop=false;gui.Parent=board
 local text=Instance.new("TextLabel");text.Size=UDim2.fromScale(1,1);text.BackgroundColor3=Color3.fromRGB(25,48,51);text.BackgroundTransparency=.12;text.TextColor3=Color3.fromRGB(255,239,205);text.TextSize=13;text.Font=Enum.Font.GothamMedium;text.TextWrapped=true;text.Parent=gui
 local corner=Instance.new("UICorner");corner.CornerRadius=UDim.new(0,8);corner.Parent=text
 local stroke=Instance.new("UIStroke");stroke.Name="ReadoutStroke";stroke.ApplyStrokeMode=Enum.ApplyStrokeMode.Border;stroke.Color=Color3.fromRGB(235,190,105);stroke.Thickness=1;stroke.Transparency=.4;stroke.Parent=text
 local state={model=model,ball=ball,label=text,best=0};gameState=state;reset(state)
 state.connection=Run.Heartbeat:Connect(function(dt)
  if not model.Parent then state.connection:Disconnect();return end
  if state.phase=="Resetting" then if os.clock()>=state.resetAt then reset(state) end;return end
  if state.phase~="Playing" then return end
  dt=math.min(dt,.1)
  local old=state.position
  local position=old+state.velocity*dt+V(0,-6*dt*dt,0)
  state.velocity+=V(0,-12*dt,0)
  local crossed=(old.Z<netZ and position.Z>=netZ) or (old.Z>netZ and position.Z<=netZ)
  if crossed then
   local alpha=(netZ-old.Z)/(position.Z-old.Z)
   local crossingX=old.X+(position.X-old.X)*alpha
   if crossingX<netMinX or crossingX>netMaxX then
    fault(state,"Out of bounds")
   elseif old.Y+(position.Y-old.Y)*alpha<minimumCrossingHeight then
    fault(state,"Net hit")
   elseif not state.crossed then
    state.crossed=true;state.rally+=1;state.best=math.max(state.best,state.rally)
    label(state,"MIC VOLLEY · RALLY "..state.rally.."\nReturn the ball with an aimed beam\nSofter shots are easier to control")
   end
  end
  if state.phase=="Playing" then
   if position.X<minimum.X or position.X>maximum.X or position.Z<minimum.Z or position.Z>maximum.Z then fault(state,"Out of bounds")
   elseif position.Y<=floorBallY then position=V(position.X,floorBallY,position.Z);fault(state,"Ball landed") end
  end
  state.position=position
  ball.CFrame=CFrame.new(position)*CFrame.Angles(os.clock()*2,0,os.clock())
 end)
 return model
end
function Volley.Hit(player,origin,direction,length,width,power)
 local state=gameState
 if not state or not state.model.Parent or state.phase=="Resetting" then return false end
 local character=player.Character
 local root=character and character:FindFirstChild("HumanoidRootPart")
 local humanoid=character and character:FindFirstChildOfClass("Humanoid")
 if not root or not humanoid or humanoid.Health<=0 or root.Position.X<playerMinimum.X or root.Position.X>playerMaximum.X
  or root.Position.Z<playerMinimum.Z or root.Position.Z>playerMaximum.Z or (root.Position-state.position).Magnitude>35 then return false end
 if not Rules.InBeam(origin,direction,state.position,length,width,1.1) then return false end
 local flat=V(direction.X,0,direction.Z)
 if flat.Magnitude<.05 then return false end
 state.velocity=flat.Unit*(9+math.clamp(power,0,1)*6)+V(0,22,0)
 state.phase="Playing";state.crossed=false
 label(state,"MIC VOLLEY · RALLY "..state.rally.."\nGet across the net for the return\nSofter shots are easier to control")
 return true
end
return Volley
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="26">
      <Properties>
        <string name="Name">Bootstrap</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local Credit=require(game:GetService("ReplicatedStorage").Shared.CombatCredit)
local TrainingRules=require(game:GetService("ReplicatedStorage").Shared.TrainingRules)
local Healing=require(game:GetService("ReplicatedStorage").Shared.Healing)
local SustainedRewards=require(game:GetService("ReplicatedStorage").Shared.SustainedRewards)
local InteractionRules=require(game:GetService("ReplicatedStorage").Shared.InteractionRules)
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local VoiceChatService=game:GetService("VoiceChatService")
local VoiceEligibility=require(script.Parent.VoiceEligibility)
local Config=require(ReplicatedStorage.Shared.Config)
local World=require(script.Parent.World)
local Profiles=require(script.Parent.Profiles)
local Access=require(script.Parent.DeveloperAccess)
local Rules=require(script.Parent.CombatRules)
local VoiceCombat=require(ReplicatedStorage.Shared.VoiceCombat)
local Entitlements=require(script.Parent.Entitlements)
local Commerce=require(script.Parent.Commerce)
local ShopCatalog=require(ReplicatedStorage.Shared.ShopCatalog)
local Soccer=require(script.Parent.SoccerChallenge)
local BeachVolley=require(script.Parent.BeachVolley)
local QuestLifecycle=require(ReplicatedStorage.Shared.QuestLifecycle)
local QuestGuide=require(ReplicatedStorage.Shared.QuestGuide)
local Equipment=require(script.Parent.Equipment)
-- Only disposable local fixtures bypass persistent profiles. Attack mode is independent.
local localFixture=RunService:IsStudio() and game.PlaceId==0 and workspace:GetAttribute("LocalSustainedPrototype")==true
local sustainedEnabled=Config.AutomaticVoice==true or localFixture
local sustained
if sustainedEnabled then
 sustained=require(script.Parent.SustainedAttackAdapter).new(require(ReplicatedStorage.Shared.SustainedAttack),
  VoiceCombat,require(script.Parent.SustainedAim))
end
World.Build()
BeachVolley.Start(workspace.ScreamSimulatorWorld)
local Destruction=require(script.Parent.Destruction)
if Config.ObjectDestruction==true then Destruction.Start(workspace.ScreamSimulatorWorld) end
World.FindMaintenance=function(bot)
 if Config.ObjectDestruction~=true then return nil end
 if os.clock()<(bot.nextMaintenance or 0) then return nil end
 local station=Destruction.MaintenanceTarget(bot.root.Position,80)
 if station then bot.nextMaintenance=os.clock()+30 end
 return station
end
World.FinishMaintenance=function(bot,station)
 if Config.ObjectDestruction~=true then return false end
 if bot.alive and bot.working and (bot.reactionUntil or 0)<=os.clock() and (bot.socialUntil or 0)<=os.clock() then
  return Destruction.FinishMaintenance(station,bot.root.Position)
 end
 return false
end
local old=ReplicatedStorage:FindFirstChild("ScreamRemotes");if old then old:Destroy() end
local remotes=Instance.new("Folder");remotes.Name="ScreamRemotes"
remotes:SetAttribute("AutomaticVoice",sustainedEnabled)
remotes.Parent=ReplicatedStorage
local function remote(name) local r=Instance.new("RemoteEvent");r.Name=name;r.Parent=remotes;return r end
local action=remote("Action");local stateRemote=remote("State");local effect=remote("Effect")
local sessions={}
local closing=false
local joinsInFlight=0
local rewardHistory={pairs={}} -- survives reconnects in this server
local testRewardHistory={pairs={}} -- temporary fights never consume normal-play anti-farm history
local function parts(p)
 local c=p.Character;local r=c and c:FindFirstChild("HumanoidRootPart");local h=c and c:FindFirstChildOfClass("Humanoid")
 if r and h and h.Health>0 then return c,r,h end
end
local function sustainedEnd(p,ended,now)
 if not ended then return end
 effect:FireAllClients("SustainedBeamEnd",nil,p.UserId)
 p:SetAttribute("SustainedActive",false)
 p:SetAttribute("SustainedEndsAt",0)
 p:SetAttribute("SustainedReadyAt",workspace:GetServerTimeNow()+math.max(0,ended.nextStart-now))
end
local function cancelSustained(p,s,now)
 if s.sustained then sustainedEnd(p,sustained.Cancel(s.sustained,now),now) end
end
-- Do not rely on automatic Player destruction to release session closures.
-- Disconnect before any departure/shutdown save yields; running callbacks still
-- use their existing session/character guards and may finish independently.
local function disconnectSessionSignals(s)
 local added,removing=s.characterAddedConnection,s.characterRemovingConnection
 s.characterAddedConnection=nil;s.characterRemovingConnection=nil
 if added then added:Disconnect() end
 if removing then removing:Disconnect() end
end
local function beamColor(p,s)
 if s.data.useCustomColor and s.data.customColor and Entitlements.HasSpectrum(p) then return Color3.fromHex(s.data.customColor) end
 return s.data.aura
end
local function state(p,message,conversation,messageUrgent,messageKey)
 local s=sessions[p];if not s or not p.Parent then return end
 if p:GetAttribute("ScreamLevel")~=s.data.level then p:SetAttribute("ScreamLevel",s.data.level) end
 local _,r,h=parts(p)
 local soccer=Soccer.Status(p)
 local quest=Config.GetQuest(s.activeQuest);local progress=quest and s.data.quests[quest.id]
 local deliveryStop=Config.GetDeliveryStop(s.deliveryStop)
 local step=QuestGuide.Step(quest,progress and progress.progress or 0,s.carrying,s.raceStart~=nil,soccer and soccer.detail,deliveryStop and deliveryStop.name)
 Equipment.Sync(p,s.data.amplifierEquipped)
 stateRemote:FireClient(p,{coins=s.data.coins,level=s.data.level,xp=s.data.xp,xpNext=Config.XPToNext(s.data.level),sound=s.data.sound,aura=s.data.aura,
 shop=Commerce.Status(p),spectrumPass=Entitlements.HasSpectrum(p),customColor=s.data.customColor,useCustomColor=s.data.useCustomColor,
 combatChallenges=s.data.combatChallenges,training=TrainingRules.Recommended(s.data.level).name,milestone=s.milestone,
 amplifierOwned=s.data.amplifierOwned,amplifierEquipped=s.data.amplifierEquipped,movementPass=Entitlements.HasMovement(p),achievements=s.data.achievements,
 availableQuests=s.data.availableQuests,quests=s.data.quests,collected=s.collected,activeQuest=s.activeQuest,questStep=step,questTime=soccer and soccer.remaining or s.questDeadline and math.max(0,math.ceil(s.questDeadline-os.clock())) or 0,
 health=h and math.ceil(h.Health) or Config.HealthForLevel(s.data.level),maxHealth=Config.HealthForLevel(s.data.level),inWarZone=r and Config.InArena(r.Position) or false,
 voiceEligible=VoiceEligibility.Allowed(s.voiceEligibility,os.clock()),voiceStatus=VoiceEligibility.Status(s.voiceEligibility,os.clock()),
 castCooldown=math.max(0,(s.sustained and s.sustained.protocol.nextStart or s.voice.nextCast)-os.clock()),micReady=s.micReady,protection=math.max(0,s.protectedUntil-os.clock()),dodgeCooldown=math.max(0,s.nextDodge-os.clock()),
 conversation=conversation,settings=s.data.settings,devAccess=Access.IsAuthorized(p,game.CreatorType,game.CreatorId,RunService:IsStudio(),game.GameId),savingAvailable=s.canSave and not s.testBaseline,savingDelayed=s.saveDelayed==true,recoveryWarning=s.recoveryWarning==true,testSession=s.testBaseline~=nil,message=message,messageUrgent=messageUrgent==true,messageKey=messageKey=="save" and "save" or nil})
end
-- No remote can enqueue voice checks. Retry state belongs only to live sessions;
-- at most eight actual API calls exist, with one new start per quarter-second.
local voiceRequestBudget={inFlight=0,nextStart=0}
local function stepVoiceEligibility(p,s,now)
 if closing or sessions[p]~=s or not p.Parent then return end
 VoiceEligibility.MarkWaiting(s.voiceEligibility,now)
 local status=VoiceEligibility.Status(s.voiceEligibility,now)
 if not VoiceEligibility.Allowed(s.voiceEligibility,now) then
  if s.sustained and s.sustained.protocol.active then cancelSustained(p,s,now) end
  if s.voice.capture then VoiceCombat.Cancel(s.voice);p:SetAttribute("CaptureStarted",0) end
 end
 if status~=s.voiceEligibilityStatus then s.voiceEligibilityStatus=status;state(p) end
end
local function voiceRequestCurrent(p,identity,token,now)
 local s=sessions[p];local eligibility=s and s.voiceEligibility
 return not closing and p.Parent~=nil and eligibility~=nil and eligibility.identity==identity
  and eligibility.pending~=nil and eligibility.pending.token==token and now<eligibility.pending.deadline
end
local function runVoiceRequest(p,identity,token)
 -- No session/profile local or closure is retained across the engine yield.
 local ok,result=false,nil
 if voiceRequestCurrent(p,identity,token,os.clock()) then
  ok,result=pcall(VoiceChatService.IsVoiceEnabledForUserIdAsync,VoiceChatService,p.UserId)
 end
 -- Deadline/departure never releases an in-flight call prematurely.
 voiceRequestBudget.inFlight-=1
 local s=sessions[p]
 if closing or not p.Parent or not s or s.voiceEligibility.identity~=identity then return end
 VoiceEligibility.Complete(s.voiceEligibility,token,os.clock(),ok,result)
 stepVoiceEligibility(p,s,os.clock())
end
local function dispatchVoiceEligibility(now)
 if closing or voiceRequestBudget.inFlight>=VoiceEligibility.MaxConcurrent or now<voiceRequestBudget.nextStart then return end
 -- Oldest due first; new joins use their arrival time, not zero. No persistent
 -- roster/queue retains departed sessions, and retrying users cannot jump ahead.
 local chosen,dueAt
 for p,s in pairs(sessions) do
  local due=VoiceEligibility.DueAt(s.voiceEligibility)
  if p.Parent and due and due<=now and (not dueAt or due<dueAt or (due==dueAt and p.UserId<chosen.UserId)) then chosen=p;dueAt=due end
 end
 if not chosen then return end
 local eligibility=sessions[chosen].voiceEligibility
 voiceRequestBudget.inFlight+=1;voiceRequestBudget.nextStart=now+VoiceEligibility.StartInterval
 local token=VoiceEligibility.Poll(eligibility,now)
 if not token then voiceRequestBudget.inFlight-=1;return end
 task.spawn(runVoiceRequest,chosen,eligibility.identity,token)
end
Commerce.Start(function(p)
 local s=sessions[p]
 return s~=nil and s.canSave and not s.testBaseline and not localFixture and not RunService:IsStudio()
end,state)
local function coins(p,amount)
 local s=sessions[p];if not s then return 0 end
 local reward=math.max(0,math.floor(amount*Commerce.Multiplier(p,"coins")))
 local before=s.data.coins
 s.data.coins=math.min(1000000000,s.data.coins+reward);return s.data.coins-before
end
local function syncHealth(p,full)
 local s=sessions[p];local _,_,h=parts(p);if not s or not h then return end
 local maximum=Config.HealthForLevel(s.data.level);local gain=maximum-h.MaxHealth
 h.MaxHealth=maximum;h.Health=full and maximum or math.clamp(h.Health+gain,1,maximum)
end
local function xp(p,amount)
 local s=sessions[p];if not s then return 0 end
 amount=amount*Commerce.Multiplier(p,"xp")
 local d=s.data;if d.level>=Config.MaxLevel then return 0 end
 local credited=math.max(0,math.floor(amount))
 d.xp+=credited;local before=d.level
 while d.level<Config.MaxLevel and d.xp>=Config.XPToNext(d.level) do d.xp-=Config.XPToNext(d.level);d.level+=1 end
 if d.level==Config.MaxLevel then credited-=d.xp;d.xp=0 end
 if d.level>before then
  syncHealth(p,false)
  local unlock="";for _,v in ipairs(Config.Sounds) do if v.level>before and v.level<=d.level then unlock=" · Unlocked "..v.name end end
  local stats=VoiceCombat.Stats(d.level,1,false)
  if math.floor(before/10)<math.floor(d.level/10) then
   s.milestone=string.format("LEVEL %d%s · %d HP · %.1f max DPS · Train: %s",d.level,unlock,stats.health,stats.maxDps,TrainingRules.Recommended(d.level).name)
  end
  state(p,string.format("Level %d%s · %d HP · %.1f max DPS",d.level,unlock,stats.health,stats.maxDps))
 end
 return credited
end
local function questProgress(p,event,amount)
 local s=sessions[p];if not s or not s.activeQuest then return end
 local q=Config.GetQuest(s.activeQuest);if not q or q.retired==true or q.event~=event then return end
 local v=s.data.quests[q.id];if not v or v.claimed or v.progress>=q.goal then return end
 v.progress=math.min(q.goal,v.progress+(amount or 1));state(p,v.progress==q.goal and "Quest complete! Claim your reward in Quests." or nil)
end
local function combatChallenge(p,id,quiet)
 local s=sessions[p];if not s then return 0,0 end
 local reward,name=Config.Progression.Advance(s.data.combatChallenges,id,s.data.level)
 local credited=0
 if reward>0 then
  credited=xp(p,reward)
  if not quiet then state(p,name.." · +"..credited.." XP · challenge renewed") end
 end
 return reward,credited
end
local function sameCombatMode(a,b)
 return a~=nil and b~=nil and (a.testBaseline~=nil)==(b.testBaseline~=nil)
end
local function canDamageBots(s)
 -- Only the guarded local fixture makes every participant's profile temporary.
 return s~=nil and (s.testBaseline==nil or localFixture==true)
end
-- Ledger ownership uses an opaque session token, never a profile/session table.
local function recordCredit(ledger,p,damage,maximum,now)
 local s=sessions[p];if not s or type(s.rewardIdentity)~="table" or damage<=0 then return end
 local previous=ledger[p.UserId]
 Credit.Add(ledger,p.UserId,damage,now,maximum)
 local entry=ledger[p.UserId]
 if entry and entry~=previous then
  entry.rewardIdentity=s.rewardIdentity;entry.rewardTest=s.testBaseline~=nil
 elseif entry and (entry.rewardIdentity~=s.rewardIdentity or entry.rewardTest~=(s.testBaseline~=nil)) then
  -- Keep damage in the denominator, but never inherit another session/mode's credit.
  entry.rewardIdentity=false
 end
end
local function awardCombatKO(ledger,finisher,targetLevel,maximum,pool,now,victim,tier)
 local fs=sessions[finisher]
 if not fs or (victim and not sameCombatMode(fs,sessions[victim])) or (not victim and not canDamageBots(fs)) then table.clear(ledger);return end
 local attribution=table.clone(ledger)
 local shares,meaningful=Credit.Split(ledger,finisher.UserId,now,maximum)
 for id,share in pairs(shares) do
  local recipient=Players:GetPlayerByUserId(id);local rs=recipient and sessions[recipient]
  local entry=attribution[id]
  if not rs or type(rs.rewardIdentity)~="table" or not entry or entry.rewardIdentity~=rs.rewardIdentity or entry.rewardTest~=(rs.testBaseline~=nil) or not sameCombatMode(rs,fs) then continue end
  local factor=Config.Progression.RewardFactor(rs.data.level,tier and TrainingRules.RewardLevel(tier,rs.data.level) or targetLevel)
  local repeatFactor=victim and Credit.RepeatFactor(rs.testBaseline and testRewardHistory or rewardHistory,id,victim.UserId,now) or 1
  local reward=math.floor(pool*share*factor*repeatFactor)
  if reward>0 then
   local underdog=targetLevel>=rs.data.level
   local credited=xp(recipient,reward);coins(recipient,math.floor((victim and 20 or 5)*share*factor*repeatFactor))
   if victim and recipient==finisher and underdog then questProgress(recipient,"Underdog") end
   if victim and recipient~=finisher and underdog and meaningful[id] then questProgress(recipient,"ArenaAssist") end
   local bonus,bonusXP=0,0
   if tier and factor>=.5 and meaningful[id] then
    bonus,bonusXP=combatChallenge(recipient,"fighters",true)
   end
   state(recipient,(recipient==finisher and "KO" or "Assist").." · +"..(credited+bonusXP).." XP"..(bonus>0 and " · challenge completed & renewed" or "")..(factor<1 and " · weaker opponent" or ""))
  elseif recipient==finisher then state(recipient,"KO · no reward awarded") end
 end
end
local function stopQuest(p)
 local s=sessions[p];if not s then return end
 Soccer.Cancel(p);QuestLifecycle.Clear(s,Config.GetQuest)
end
local function protect(p,s)
 s.credit={}
 cancelSustained(p,s,os.clock())
 VoiceCombat.Cancel(s.voice);p:SetAttribute("CaptureStarted",0)
 s.protectedUntil=os.clock()+Config.SpawnProtection
 p:SetAttribute("ProtectionEnds",workspace:GetServerTimeNow()+Config.SpawnProtection)
 local c=p.Character;if c then local oldField=c:FindFirstChild("SpawnProtection");if oldField then oldField:Destroy() end
  local f=Instance.new("ForceField");f.Name="SpawnProtection";f.Parent=c
  task.delay(Config.SpawnProtection,function() if f.Parent then f:Destroy() end end)
 end
end
local function resetMovement(p,s,h,root)
 -- Detach only this avatar before relocating; a seat weld can otherwise keep
 -- the rescued character attached to anchored furniture.
 local seat=h.SeatPart
 if seat and p.Character then
  for _,weld in ipairs(seat:GetChildren()) do
   if weld:IsA("Weld") and weld.Name=="SeatWeld" and weld.Part1 and weld.Part1:IsDescendantOf(p.Character) then weld:Destroy() end
  end
 end
 h.Sit=false
 s.dodgingUntil=0;s.knockedUntil=0;s.premiumRoll=false;s.sprintRequested=false
 p:SetAttribute("DodgeEnds",0);p:SetAttribute("DodgeStarted",0);p:SetAttribute("KnockdownEnds",0);p:SetAttribute("Sprinting",false)
 h.PlatformStand=false;h.AutoRotate=true
 if root then
  root.AssemblyLinearVelocity=Vector3.zero;root.AssemblyAngularVelocity=Vector3.zero
  if not root.Anchored then root:SetNetworkOwnershipAuto() end
 end
end
local function eject(p,h)
 local s=sessions[p];local character=p.Character;local root=character and character:FindFirstChild("HumanoidRootPart")
 h.Health=Config.HealthForLevel(s.data.level)
 resetMovement(p,s,h,root)
 character:PivotTo(World.SafeSpawn);protect(p,s)
 s.nextHeal=os.clock()+Config.HealQuietSeconds;state(p,"Knocked out · back at the safe hub")
end
local function audible(c,origin,target,targetModel)
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={c,targetModel};params.RespectCanCollide=true
 return workspace:Raycast(origin,target-origin,params)==nil
end
local function canCapture(p,s,now)
 local _,r,h=parts(p)
 local bot=s.conversationBot
 if r and bot and bot.alive and bot.root.Parent and bot.talkingTo==p and (bot.socialUntil or 0)>now
  and (bot.root.Position-r.Position).Magnitude<=14 then return false end
 return r~=nil and h~=nil and not h.PlatformStand and s.micReady and VoiceEligibility.Allowed(s.voiceEligibility,now) and now>=s.protectedUntil and now>=s.dodgingUntil and now>=(s.knockedUntil or 0)
end
local function attackOrigin(c,r)
 local head=c:FindFirstChild("Head")
 if head and head:IsA("BasePart") and (head.Position-r.Position).Magnitude<5 then return head.Position end
 return r.Position+Vector3.new(0,1,0)
end
local function beamObstruction(c,origin,direction,range,players)
 local exclude={c};for _,bot in ipairs(World.Bots) do table.insert(exclude,bot.model) end
 for _,other in ipairs(players) do if other.Character then table.insert(exclude,other.Character) end end
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances=exclude;params.RespectCanCollide=true
 return workspace:Raycast(origin,direction*range,params)
end
local function sustainedContext(p,s,now)
 if not canCapture(p,s,now) then return nil end
 local c,r=parts(p)
 local style=Config.GetSound(s.data.sound)
 if not style or style.level>s.data.level then return nil end
 return {player=p,character=c,origin=attackOrigin(c,r),position=r.Position,
  level=s.data.level,amplifier=s.data.amplifierEquipped}
end
local function resolveSustained(ctx,direction,stats,now)
 local ids,details,dodged={},{},{}
 local function add(id,detail)
  if not details[id] then table.insert(ids,id);details[id]=detail end
 end
 local players=Players:GetPlayers()
 local obstruction=beamObstruction(ctx.character,ctx.origin,direction,stats.range,players)
 local length=obstruction and obstruction.Distance or stats.range
 if Config.InArena(ctx.position) then
  for _,p in ipairs(players) do
   local ts=sessions[p];local c,r,h=parts(p)
   if p~=ctx.player and sameCombatMode(sessions[ctx.player],ts) and r and Rules.CanTarget(ctx.position,r.Position,ts.protectedUntil,now,stats.range+2)
    and Rules.InBeam(ctx.origin,direction,r.Position,length,stats.width,1) and audible(ctx.character,ctx.origin,r.Position,c) then
    if now<ts.dodgingUntil and not ts.premiumRoll then table.insert(dodged,p)
    else add("player:"..p.UserId,{player=p,session=ts,humanoid=h}) end
   end
  end
 end
 if Config.ObjectDestruction==true and obstruction then
  local model=obstruction.Instance
  while model and not Destruction.objects[model] do model=model.Parent end
  local id=model and model:GetAttribute("ObjectId")
  if type(id)=="string" and not model:GetAttribute("Destroyed") then add("object:"..id,{object=model}) end
 end
 for _,bot in ipairs(World.Bots) do
  if canDamageBots(sessions[ctx.player]) and bot.alive and bot.root.Parent and (not bot.training or (ctx.position-bot.start).Magnitude<=TrainingRules.Radius) and Rules.InBeam(ctx.origin,direction,bot.root.Position,length,stats.width,1)
   and audible(ctx.character,ctx.origin,bot.root.Position,bot.model) then
   add("bot:"..tostring(bot.id),{bot=bot})
  end
 end
 return ids,details,{origin=ctx.origin,direction=direction,length=length,width=stats.width,power=stats.power,obstruction=obstruction,dodged=dodged}
end
local function restoreBot(bot)
 if not bot.model.Parent then return end
 bot.recoveryVersion=(bot.recoveryVersion or 0)+1
 bot.health=bot.maxHealth or Config.BotMaxHealth;bot.alive=true;bot.credit={};bot.trainingTarget=nil;bot.strike=nil;World.UpdateBot(bot)
end
local function knockOutBot(bot)
 if not bot.alive then return end
 bot.trainingTarget=nil;bot.strike=nil;bot.alive=false;bot.recoveryVersion=(bot.recoveryVersion or 0)+1
 local version=bot.recoveryVersion
 task.delay(Config.BotRespawnSeconds,function()
  if bot.model.Parent and not bot.alive and bot.recoveryVersion==version then restoreBot(bot) end
 end)
end
local function destructionHint(intent,result)
 if not result then return nil end
 if result.reason=="level" and not intent.destructionHintShown then
  intent.destructionHintShown=true
  return "This object needs beam level "..tostring(result.required).." to damage"
 end
 if not result.reason and result.destroyed and not intent.destructionBreakShown then
  intent.destructionBreakShown=true
  local name=result.model:GetAttribute("ObjectName") or result.kind or "Object"
  return name.." destroyed · repairs automatically"
 end
 return nil
end
local function stepSustained(p,s,now)
 local intent=s.sustained.intent
 local context=sustainedContext(p,s,now)
 local hits,ended,details,beam=sustained.Step(s.sustained,now,context,resolveSustained)
 sustainedEnd(p,ended,now)
 if beam and not ended then
  intent.evaded=intent.evaded or {}
  for _,target in ipairs(beam.dodged) do
   if not intent.evaded[target.UserId] then intent.evaded[target.UserId]=true;questProgress(target,"Evade") end
  end
  -- One successful impulse per activity per scream, not five impulses per second.
  if not intent.soccerHit then intent.soccerHit=Soccer.Hit(p,beam.origin,beam.direction,beam.length,beam.width,beam.power)==true end
  if not intent.volleyHit then intent.volleyHit=BeachVolley.Hit(p,beam.origin,beam.direction,beam.length,beam.width,beam.power)==true end
  for _,viewer in ipairs(Players:GetPlayers()) do
   local _,root=parts(viewer)
   if root and (root.Position-beam.origin).Magnitude<=180 then
    effect:FireClient(viewer,"SustainedBeam",beam.origin,p.UserId,beamColor(p,s),beam.direction,beam.length,beam.width,intent.audioStyleId,intent.level)
   end
  end
 end
 local dealt=0
 local contactPosition,contactChosen
 for _,hit in ipairs(hits) do
  local target=details[hit.id]
  local dealtBefore=dealt
  local targetRoot=target.bot and target.bot.root
  if target.player then
   local character=target.player.Character
   targetRoot=typeof(character)=="Instance" and character:IsA("Model") and character:FindFirstChild("HumanoidRootPart") or nil
  end
  local position=typeof(targetRoot)=="Instance" and targetRoot:IsA("BasePart") and targetRoot.Parent and targetRoot.Position
  if typeof(position)~="Vector3" or not VoiceCombat.IsFinite(position.X) or not VoiceCombat.IsFinite(position.Y) or not VoiceCombat.IsFinite(position.Z) then position=nil end
  if target.player then
   local ts,h=target.session,target.humanoid
   local actual=math.min(hit.damage,h.Health);dealt+=actual
   ts.credit=ts.credit or {};recordCredit(ts.credit,p,actual,h.MaxHealth,now)
   ts.nextHeal=now+Config.HealQuietSeconds
   if h.Health<=hit.damage then
    awardCombatKO(ts.credit,p,ts.data.level,h.MaxHealth,Config.PlayerKOXP(ts.data.level),now,target.player)
    eject(target.player,h)
   else h.Health-=hit.damage end
  elseif target.object then
   local previous=target.object:GetAttribute("ObjectHealth") or 0
   local result=Destruction.Damage(target.object,intent.level,hit.damage)
   local hint=destructionHint(intent,result);if hint then state(p,hint) end
   if result and not result.reason then dealt+=math.max(0,previous-result.health) end
   if result and result.destroyed then
    effect:FireAllClients("Break",result.position,beamColor(p,s))
   end
  else
   local bot=target.bot
   dealt+=math.min(hit.damage,bot.health)
   if hit.firstHit then
    intent.crowdHits=(intent.crowdHits or 0)+1
    if intent.crowdHits==3 then questProgress(p,"Crowd") end
   end
   if bot.training then
    recordCredit(bot.credit,p,math.min(hit.damage,bot.health),bot.maxHealth,now)
    bot.trainingTarget=p;bot.lastTrainingHit=now
   end
   bot.health=math.max(0,bot.health-hit.damage)
   local ko=bot.health==0
   if ko then
    if bot.training then awardCombatKO(bot.credit,p,bot.training.level,bot.maxHealth,bot.training.xp,now,nil,bot.training) end
    knockOutBot(bot)
   elseif hit.firstHit then World.ReactToScream(bot,context.position) end
   World.UpdateBot(bot)
   if not bot.training then
    local rewardCoins,rewardXP=SustainedRewards.Hit(intent,s.botRewards,bot.id,now,hit.firstHit,ko)
    if rewardCoins>0 or rewardXP>0 then coins(p,rewardCoins);xp(p,rewardXP) end
   end
  end
  if dealt>dealtBefore and not contactChosen then contactChosen=true;contactPosition=position end
 end
 if dealt>0 then
  s.nextHeal=now+Config.HealQuietSeconds
  intent.damageTotal=(intent.damageTotal or 0)+dealt
  effect:FireClient(p,"SustainedHit",contactPosition,p:GetAttribute("SustainedSequence"),math.floor(intent.damageTotal+.5))
 end
end
local function cast(p,request)
 local s=sessions[p];local c,r=parts(p);if not s or not r or type(request)~="table" then return end
 p:SetAttribute("CaptureStarted",0)
 local now=os.clock();local style=Config.GetSound(s.data.sound)
 local aim=request.aim
 if typeof(aim)~="Vector3" or not VoiceCombat.IsFinite(aim.X) or not VoiceCombat.IsFinite(aim.Y) or not VoiceCombat.IsFinite(aim.Z) then VoiceCombat.Cancel(s.voice);return end
 local origin=attackOrigin(c,r)
 local delta=aim-origin
 if delta.Magnitude<.01 or delta.Magnitude>2048 then VoiceCombat.Cancel(s.voice);return end
 if not VoiceCombat.Release(s.voice,now,request.sequence,request.power,style~=nil and style.level<=s.data.level and canCapture(p,s,now)) then return end
 local sound=VoiceCombat.Stats(s.data.level,request.power,s.data.amplifierEquipped==true)
 local direction=delta.Unit
 s.nextCast=s.voice.nextCast;p:SetAttribute("ScreamReleased",workspace:GetServerTimeNow());p:SetAttribute("CaptureStarted",0)
 local obstruction=beamObstruction(c,origin,direction,sound.range,Players:GetPlayers())
 local length=obstruction and obstruction.Distance or sound.range
 effect:FireAllClients("Scream",origin,style.id,beamColor(p,s),direction,length,sound.width)
 Soccer.Hit(p,origin,direction,length,sound.width,sound.power)
 BeachVolley.Hit(p,origin,direction,length,sound.width,sound.power)
 local castMessage
 if obstruction then
  local result=Config.ObjectDestruction==true and Destruction.Damage(obstruction.Instance,s.data.level,sound.damage) or nil
  if result then
   if result.reason=="level" then castMessage="Requires level "..result.required
   elseif not result.reason then
    s.nextHeal=now+Config.HealQuietSeconds
    local name=result.model:GetAttribute("ObjectName") or result.kind
    castMessage=result.destroyed and name.." destroyed" or string.format("%s hit · %d durability left",name,result.health)
    if result.destroyed then effect:FireAllClients("Break",result.position,beamColor(p,s)) end
   end
  end
 end
 local hits=0;local paid=0;local playerHits=0;local evades=0;local knockoutMessage
 for _,bot in ipairs(World.Bots) do
  if canDamageBots(s) and bot.alive and bot.root.Parent and (not bot.training or (r.Position-bot.start).Magnitude<=TrainingRules.Radius) and Rules.InBeam(origin,direction,bot.root.Position,length,sound.width,1) and audible(c,origin,bot.root.Position,bot.model) then
   hits+=1
   if bot.training then recordCredit(bot.credit,p,math.min(sound.damage,bot.health),bot.maxHealth,now);bot.trainingTarget=p;bot.lastTrainingHit=now end
   bot.health=math.max(0,bot.health-sound.damage);local ko=bot.health==0
   if ko then
    if bot.training then awardCombatKO(bot.credit,p,bot.training.level,bot.maxHealth,bot.training.xp,now,nil,bot.training) end
    knockOutBot(bot)
   else World.ReactToScream(bot,r.Position) end
   World.UpdateBot(bot)
   if not bot.training and now>=(s.botRewards[bot.id] or 0) and paid<5 then
    s.botRewards[bot.id]=now+VoiceCombat.Cooldown;paid+=1;coins(p,ko and 5 or 2);xp(p,ko and SustainedRewards.KOXP or SustainedRewards.HitXP)
   end
  end
 end
 if hits>=3 then questProgress(p,"Crowd") end
 if Config.InArena(r.Position) then
  for _,target in ipairs(Players:GetPlayers()) do
   local ts=sessions[target];local tc,tr,th=parts(target)
   if target~=p and sameCombatMode(s,ts) and tr and Rules.CanTarget(r.Position,tr.Position,ts.protectedUntil,now,sound.range+2) and Rules.InBeam(origin,direction,tr.Position,length,sound.width,1) and audible(c,origin,tr.Position,tc) then
    if now<ts.dodgingUntil and not ts.premiumRoll then evades+=1;questProgress(target,"Evade")
    else
     playerHits+=1
     ts.nextHeal=now+Config.HealQuietSeconds
     ts.credit=ts.credit or {};recordCredit(ts.credit,p,math.min(sound.damage,th.Health),th.MaxHealth,now)
     if th.Health<=sound.damage then
      awardCombatKO(ts.credit,p,ts.data.level,th.MaxHealth,Config.PlayerKOXP(ts.data.level),now,target)
      eject(target,th);knockoutMessage="Player knockout"
     else th.Health-=sound.damage;state(target) end
    end
   end
  end
 end
 local totalHits=hits+playerHits
 if totalHits>0 then s.nextHeal=now+Config.HealQuietSeconds end
 if knockoutMessage then castMessage=knockoutMessage
 elseif totalHits>0 then castMessage=string.format("Hit %d %s · %d damage each",totalHits,totalHits==1 and "target" or "targets",sound.damage)
 elseif not castMessage then castMessage=evades>0 and "Beam dodged" or obstruction and "Beam stopped by cover" or "Beam missed" end
 state(p,castMessage)
end
local function finishDodge(p,s,c,r,h,started,now)
 if sessions[p]~=s or p.Character~=c or s.lastDodge~=started or not h.Parent or h.Health<=0
  or now<(s.knockedUntil or 0) or h.PlatformStand then return end
 h.AutoRotate=true
 if r.Parent and not r.Anchored then r:SetNetworkOwnershipAuto() end
end
local function dodge(p)
 local s=sessions[p];local c,r,h=parts(p);local now=os.clock()
 if s then cancelSustained(p,s,now);VoiceCombat.Cancel(s.voice);p:SetAttribute("CaptureStarted",0) end
 if not s or not r or r.Anchored or h.Sit or h.SeatPart or h.PlatformStand or now<s.nextDodge or now<(s.knockedUntil or 0) or h.FloorMaterial==Enum.Material.Air then return end
 local cooldown=Entitlements.CanUseMovement(p,r.Position) and Config.DodgeDuration or Config.DodgeCooldown
 s.nextDodge=now+cooldown;s.dodgingUntil=now+Config.DodgeDuration
 s.lastDodge=now;s.premiumRoll=cooldown<Config.DodgeCooldown
 p:SetAttribute("DodgeEnds",workspace:GetServerTimeNow()+Config.DodgeDuration)
 p:SetAttribute("DodgeReady",workspace:GetServerTimeNow()+cooldown)
 local direction=h.MoveDirection;if direction.Magnitude<0.1 then direction=r.CFrame.LookVector end
 direction=Vector3.new(direction.X,0,direction.Z).Unit
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={c}
 local hit=workspace:Blockcast(r.CFrame,Vector3.new(2,3,2),direction*Config.DodgeDistance,params)
 local distance=hit and math.max(0,hit.Distance-1) or Config.DodgeDistance
 local start=r.CFrame;r:SetNetworkOwner(nil);h.AutoRotate=false
 r.CFrame=CFrame.lookAt(r.Position,r.Position+direction)
 p:SetAttribute("DodgeStarted",workspace:GetServerTimeNow());p:SetAttribute("DodgeDirection",direction)
 effect:FireAllClients("Dodge",r.Position,beamColor(p,s))
 task.spawn(function()
  local previousDistance=0
  while sessions[p]==s and s.lastDodge==now and c.Parent and p.Character==c and h.Health>0 and s.dodgingUntil>os.clock() and os.clock()-now<Config.DodgeDuration do
   local t=math.clamp((os.clock()-now)/Config.DodgeDuration,0,1)
   local desired=distance*(t*t*(3-2*t));local step=desired-previousDistance
   local blocked=step>0 and workspace:Blockcast(r.CFrame,Vector3.new(2,2.5,2),direction*step,params)
   if blocked then break end
   r.CFrame=CFrame.lookAt(r.Position+direction*step,r.Position+direction*(step+1));previousDistance=desired
   r.AssemblyLinearVelocity=Vector3.zero;RunService.Heartbeat:Wait()
  end
  finishDodge(p,s,c,r,h,now,os.clock())
 end)
 state(p)
end
local function closeConversation(p)
 local s=sessions[p];local bot=s and s.conversationBot
 if bot and bot.talkingTo==p then bot.talkingTo=nil;bot.socialUntil=0 end
 if s then s.conversationBot=nil end
end
local function microSpeaker(p,s,toggleOwned)
 if s.data.amplifierOwned then
  if toggleOwned then s.data.amplifierEquipped=not s.data.amplifierEquipped
  else state(p,"You already own a micro-speaker. Equip it from Style.");return end
 else
  if s.data.coins<Config.MicroSpeakerPrice then state(p,"Micro-speaker costs "..Config.MicroSpeakerPrice.." coins. You need "..(Config.MicroSpeakerPrice-s.data.coins).." more.",nil,true);return end
  s.data.coins-=Config.MicroSpeakerPrice;s.data.amplifierOwned=true;s.data.amplifierEquipped=true
 end
 state(p,s.data.amplifierEquipped and "Micro-speaker equipped · +12% normalized power, capped at 100%" or "Micro-speaker unequipped")
end
local function vendorPurchase(p,s,arg)
 local bot=s.conversationBot;local _,root=parts(p)
 if type(arg)~="table" or arg.product~="MicroSpeaker" or not bot or arg.npc~=bot.id or bot.role~="Vendor" or not bot.alive or not bot.root.Parent or bot.talkingTo~=p or (bot.socialUntil or 0)<=os.clock() or not root or not InteractionRules.CanReachNpc(p.Character,bot.model,14) then
  state(p,"Speak with the market vendor nearby before buying.",nil,true);return
 end
 -- No yielding between ownership check and debit: duplicate requests never charge twice.
 microSpeaker(p,s,false)
end
local function talk(p,id)
 local s=sessions[p];local _,r=parts(p);if not s or not r or type(id)~="string" or os.clock()<(s.nextTalk or 0) then return end
 for _,b in ipairs(World.Bots) do if b.id==id and b.alive and b.root.Parent and InteractionRules.CanReachNpc(p.Character,b.model,14) then
  if b.training then state(p,"Stand on the pad and hit to spar. Move out of red strikes or dodge.");return end
  if b.talkingTo and b.talkingTo~=p and (b.socialUntil or 0)>os.clock() then state(p,b.name.." is speaking with someone. Try again shortly.");return end
  -- Dialogue cancellation is authoritative, even if the client stop packet
  -- is delayed or omitted. The availability gate keeps subsequent pulses out.
  cancelSustained(p,s,os.clock());VoiceCombat.Cancel(s.voice);p:SetAttribute("CaptureStarted",0)
  closeConversation(p);s.conversationBot=b;b.talkingTo=p
  s.nextTalk=os.clock()+2
  local contextLine
  for _,questId in ipairs(b.questIds or {}) do
   local q=Config.GetQuest(questId);local progress=s.data.quests[questId]
   if q and progress and not progress.claimed then
    if progress.progress>=q.goal then contextLine="You finished my task! Your reward is waiting in Quests.";break
    elseif s.activeQuest==questId then
     local soccer=Soccer.Status(p)
     local deliveryStop=Config.GetDeliveryStop(s.deliveryStop)
     contextLine="For our task: "..QuestGuide.Step(q,progress.progress,s.carrying,s.raceStart~=nil,soccer and soccer.detail,deliveryStop and deliveryStop.name)
    end
   end
  end
  if not contextLine and b.name=="Nick Booty" and s.data.achievements.NickChampion then contextLine="My champion is back! I have practiced. The goal is still winning." end
  local message=b.name..": "..World.Talk(b,p,contextLine)
  if b.name=="Nick Booty" and not s.data.achievements.FoundNick then
   s.data.achievements.FoundNick=true;local foundCoins=coins(p,50);message="Hidden achievement: Found Nick Booty! +"..foundCoins.." coins. "..message
  end
  if b.questIds then
   for _,questId in ipairs(b.questIds) do s.data.availableQuests[questId]=true end
   message..=" · Tasks available in Quests"
  end
  b.socialUntil=os.clock()+20
  local choices={}
  for _,id in ipairs(b.questIds or {}) do
   local q=Config.GetQuest(id);local progress=s.data.quests[id]
   if q then table.insert(choices,{id=id,name=q.name,description=q.description,claimed=progress and progress.claimed==true,complete=progress and progress.progress>=q.goal}) end
  end
  local hints={Gardener="The raised flowerbeds in Rambla Gardens need water. Use the interaction prompt beside each bed after accepting my task.",Vendor="The café sends orders along the waterfront. Collect one, then check your objective for its destination.",Soccer="I call it an assist when I miss. Your microphone can steer a training ball; softer shots give you more control.",BeachWorker="Please keep the sand clear. You can follow the promenade to the pier and the hidden courts beyond it.",Busker="Come for the music, stay for the beach. The central arena is the only place where players can damage each other."}
  state(p,message,{npc=b.model,name=b.name,line=message,hint=hints[b.role] or "Explore the courtyards, shops and waterfront. Some residents offer tasks; player combat stays inside the central arena.",quests=choices,products=b.role=="Vendor" and {{id="MicroSpeaker",name="Micro-speaker",price=Config.MicroSpeakerPrice,owned=s.data.amplifierOwned,description="Handheld amplifier · +12% normalized power, capped at 100%. Buy once with earned coins."}} or nil});return
 end end
end
local function dev(p,command)
 if Commerce.Busy(p) then state(p,"Wait for your purchase to finish saving.");return end
 local s=sessions[p];if not s or not Access.IsAuthorized(p,game.CreatorType,game.CreatorId,RunService:IsStudio(),game.GameId) then return end
 local valid={Coins=true,XP=true,AddLevels=true,MaxLevel=true,LevelOne=true,Heal=true,Hub=true,Arena=true,Beach=true,ResetQuests=true,ResetBots=true,StudioMovement=true}
 if type(command)~="string" or not valid[command] then return end
 if command=="StudioMovement" and not game:GetService("RunService"):IsStudio() then return end
 if command=="ResetBots" and not localFixture then state(p,"Reset bots requires the isolated local Studio fixture; shared fights are unchanged.");return end
 -- Freeze legitimate progress before any test mutation. Keep renewing/releasing its lease.
 if not s.testBaseline then
  cancelSustained(p,s,os.clock());VoiceCombat.Cancel(s.voice);p:SetAttribute("CaptureStarted",0);s.credit={}
  s.testBaseline=Profiles.Sanitize(s.data);s.data=Profiles.Sanitize(s.data)
 end
 local c,_,h=parts(p)
 local positions={Hub=World.SafeSpawn,Arena=Config.CompactCity and CFrame.new(Config.CityLayout.Teleports.Arena) or CFrame.new(0,6,0),Beach=Config.CompactCity and CFrame.new(Config.CityLayout.Teleports.Beach) or CFrame.new(0,4,403)}
 if command=="Coins" then s.data.coins+=1000
 elseif command=="XP" then xp(p,500)
 elseif command=="AddLevels" then
  s.data.level=math.min(Config.MaxLevel,s.data.level+10)
  if s.data.level==Config.MaxLevel then s.data.xp=0 end
 elseif command=="MaxLevel" then s.data.level=Config.MaxLevel;s.data.xp=0
 elseif command=="LevelOne" then s.data.level=1;s.data.xp=0;s.data.sound="TinyAah"
 elseif command=="Heal" and h then h.Health=h.MaxHealth
 elseif positions[command] and c then c:PivotTo(positions[command]);protect(p,s)
 elseif command=="ResetQuests" then stopQuest(p);s.data.quests={}
 elseif command=="StudioMovement" then Entitlements.SetStudioMovement(p,not Entitlements.HasStudioMovement(p))
 elseif command=="ResetBots" then for _,b in ipairs(World.Bots) do restoreBot(b) end
 else return end
 syncHealth(p,command=="Heal");state(p,command=="StudioMovement" and ("Studio movement test "..(Entitlements.HasStudioMovement(p) and "ON" or "OFF").." · safe areas only · not saved") or "Test applied · progress is temporary. PvP is test-to-test only; NPC damage/reset requires the isolated local Studio fixture.")
end
World.OnVehicleSweep=function(car,previous,nextFrame)
 for player,s in pairs(sessions) do
  local character,root,humanoid=parts(player);local now=os.clock()
  if root and now>=s.protectedUntil and now>=(s.nextCarHit or 0) and Rules.VehicleSweep(previous*CFrame.new(0,.55,0),nextFrame*CFrame.new(0,.55,0),root.Position,Vector3.new(8,4,4.5)) then
   cancelSustained(player,s,now);VoiceCombat.Cancel(s.voice);player:SetAttribute("CaptureStarted",0)
   s.nextCarHit=now+4;s.knockedUntil=now+1.3;s.dodgingUntil=0;s.sprintRequested=false;s.nextHeal=now+Config.HealQuietSeconds
   player:SetAttribute("DodgeEnds",0);player:SetAttribute("KnockdownEnds",workspace:GetServerTimeNow()+1.3)
   local damage=math.clamp(math.floor(car.speed*1.1),15,35)
   if humanoid.Health<=damage then eject(player,humanoid);s.knockedUntil=0
   else
    humanoid.Health-=damage;humanoid.PlatformStand=true;humanoid.AutoRotate=false;root:SetNetworkOwner(nil)
    local direction=(nextFrame.Position-previous.Position).Unit
    local sideways=Vector3.new(0,0,car.lane%240<120 and -1 or 1)
    root.AssemblyLinearVelocity=direction*8+sideways*28+Vector3.new(0,12,0);root.AssemblyAngularVelocity=Vector3.new(0,0,4)*car.direction
    local recoveryEnds=s.knockedUntil
    task.delay(1.3,function()
     if sessions[player]==s and s.knockedUntil==recoveryEnds and player.Character==character and humanoid.Parent and humanoid.Health>0 then
      s.knockedUntil=0;player:SetAttribute("KnockdownEnds",0)
      humanoid.PlatformStand=false;humanoid.AutoRotate=true;root.AssemblyAngularVelocity=Vector3.zero
      local look=root.CFrame.LookVector;look=Vector3.new(look.X,0,look.Z);if look.Magnitude<.01 then look=Vector3.new(0,0,-1) end
      local recovered=root.Position+Vector3.new(0,2,0)
      root.AssemblyLinearVelocity=Vector3.zero
      root.CFrame=CFrame.lookAt(recovered,recovered+look)
      humanoid:ChangeState(Enum.HumanoidStateType.GettingUp);root:SetNetworkOwnershipAuto()
     end
    end)
   end
   state(player,"Traffic hit · -"..damage.." HP")
  end
 end
end
local function interactQuest(p,obj)
  if not obj.Enabled or not obj:IsDescendantOf(workspace.ScreamSimulatorWorld) then return end
  local s=sessions[p];local _,r=parts(p);local marker=obj.Parent
  if not s or not r or not marker or not marker:IsA("BasePart") or (r.Position-marker.Position).Magnitude>12 then return end
  local active=Config.GetQuest(s.activeQuest)
  local progress=active and s.data.quests[active.id]
  if progress and (progress.claimed or progress.progress>=active.goal) then state(p,"Task complete · claim your reward in Quests.");return end
  local kind=marker:GetAttribute("QuestAction")
  if kind=="Garden" and s.activeQuest=="garden" then
   if s.collected[marker.Name] then state(p,"This bed is already watered.");return end
   s.collected[marker.Name]=true;questProgress(p,"Garden");state(p,"Flowers watered · thanks for helping the neighborhood!")
  elseif kind=="Litter" and s.activeQuest=="beach" then
   if s.collected[marker.Name] then state(p,"Already collected this bottle.");return end
   s.collected[marker.Name]=true;questProgress(p,"Litter")
  elseif kind=="Pickup" and s.activeQuest=="delivery" then
   if s.carrying then state(p,"You already have an order. Check your objective for its destination.");return end
   local stop=Config.DeliveryStops[math.random(1,#Config.DeliveryStops)]
   s.deliveryStop=stop.id;s.questDeadline=os.clock()+90;s.carrying=true;state(p,"Order collected · "..stop.name.." · 90s")
  elseif kind=="Dropoff" and s.activeQuest=="delivery" then
   if s.carrying and s.questDeadline and os.clock()<=s.questDeadline then
    if marker:GetAttribute("DeliveryStop")~=s.deliveryStop then local stop=Config.GetDeliveryStop(s.deliveryStop);state(p,"This order is for the "..(stop and stop.name or "assigned stop")..".");return end
    s.carrying=false;s.questDeadline=nil;s.deliveryStop=nil;questProgress(p,"Delivery")
   else state(p,"Pick up a fresh order from the café first.") end
  elseif kind=="RaceStart" and s.activeQuest=="sprint" then
   if s.raceStart then state(p,"Your race is already running. Follow the boardwalk to the finish.");return end
   s.raceStart=os.clock();s.questDeadline=s.raceStart+25;state(p,"Go! Follow the promenade east to the finish · 25s")
  elseif kind=="RaceFinish" and s.activeQuest=="sprint" then
   if s.raceStart and os.clock()-s.raceStart>=3 and s.questDeadline and os.clock()<=s.questDeadline then s.questDeadline=nil;s.raceStart=nil;questProgress(p,"Race")
   else state(p,"Start at the lifeguard tower and beat 25 seconds.") end
  else state(p,"Accept the matching quest from the Quests menu first.") end
end
for _,obj in ipairs(workspace.ScreamSimulatorWorld:GetDescendants()) do
 if obj:IsA("ProximityPrompt") and obj.Parent:GetAttribute("QuestAction") then obj.Triggered:Connect(function(p) interactQuest(p,obj) end) end
end
action.OnServerEvent:Connect(function(p,verb,arg)
 local s=sessions[p];if not s or type(verb)~="string" then return end
 -- Validated idempotent stops must survive saturation; they grant no new action.
 if verb=="Sprint" and arg==false then s.sprintRequested=false;return end
 if verb=="EndConversation" and arg==nil then
  if s.conversationBot then closeConversation(p) end
  return
 end
 local now=os.clock()
 if verb=="SustainedStop" and s.sustained then
  local active=s.sustained.protocol.active
  -- Stop can expire state before validating; only the current sequence bypasses quota.
  if active and arg==active.sequence then sustainedEnd(p,sustained.Stop(s.sustained,now,arg),now);return end
 elseif verb=="CancelCast" and not s.sustained and arg==nil then
  if s.voice.capture then VoiceCombat.Cancel(s.voice);p:SetAttribute("CaptureStarted",0) end
  return
 elseif verb=="MicReady" and arg==false then
  -- Clean leftover attacks too, but do not amplify repeated idle false packets.
  if s.micReady~=false or (s.sustained and s.sustained.protocol.active) or s.voice.capture then
   s.micReady=false;cancelSustained(p,s,now);VoiceCombat.Cancel(s.voice);p:SetAttribute("CaptureStarted",0)
  end
  return
 end
 s.requestWindow=s.requestWindow or now;s.requestCount=s.requestCount or 0
 if now-s.requestWindow>=1 then s.requestWindow=now;s.requestCount=0 end
 s.requestCount+=1;if s.requestCount>30 then return end
 if s.sustained then
  if verb=="BeginCast" or verb=="Cast" or verb=="CancelCast" then return end
  if verb=="SustainedBegin" then
   local ok,_,ended=sustained.Begin(s.sustained,now,arg,sustainedContext(p,s,now))
   sustainedEnd(p,ended,now)
   if ok then
    s.sustained.intent.audioStyleId=s.data.sound
    p:SetAttribute("SustainedSequence",arg.sequence)
    p:SetAttribute("SustainedEndsAt",workspace:GetServerTimeNow()+require(ReplicatedStorage.Shared.SustainedAttack).MaxDuration)
    p:SetAttribute("SustainedActive",true)
   end
   return
  elseif verb=="SustainedPulse" then
   local _,_,ended=sustained.Pulse(s.sustained,now,arg,sustainedContext(p,s,now))
   sustainedEnd(p,ended,now);return
  elseif verb=="SustainedStop" then sustainedEnd(p,sustained.Stop(s.sustained,now,arg),now);return end
 end
 if verb=="BeginCast" then
  p:SetAttribute("CaptureStarted",0)
  if VoiceCombat.Begin(s.voice,now,arg,canCapture(p,s,now)) then p:SetAttribute("CaptureStarted",workspace:GetServerTimeNow()) end;return
 elseif verb=="CancelCast" then VoiceCombat.Cancel(s.voice);p:SetAttribute("CaptureStarted",0);return
 elseif verb=="MicReady" then s.micReady=arg==true;if not s.micReady then cancelSustained(p,s,now);VoiceCombat.Cancel(s.voice);p:SetAttribute("CaptureStarted",0) end;return
 elseif verb=="Cast" then cast(p,arg);return elseif verb=="Dodge" then dodge(p);return
 elseif verb=="ExtraJump" then
  local _,root,h=parts(p)
  if root and not root.Anchored and not h.Sit and not h.SeatPart and not h.PlatformStand and Entitlements.CanUseMovement(p,root.Position) and now>=(s.nextExtraJump or 0) and now>=s.dodgingUntil and now>=(s.knockedUntil or 0) and h.FloorMaterial==Enum.Material.Air and s.jumpOriginY and root.Position.Y<s.jumpOriginY+24 then
   s.nextExtraJump=now+.25
   local v=root.AssemblyLinearVelocity
   local remaining=math.max(0,s.jumpOriginY+24-root.Position.Y)
   local impulse=math.min(45,math.sqrt(2*workspace.Gravity*remaining))
   root.AssemblyLinearVelocity=Vector3.new(v.X,impulse,v.Z)
  end
  return
 elseif verb=="Sprint" then if type(arg)=="boolean" then s.sprintRequested=arg end;return end
 local now=os.clock();if now<s.nextAction then return end;s.nextAction=now+0.15
 if verb=="Sync" then state(p)
 elseif verb=="Talk" then talk(p,arg)
 elseif verb=="DevCommand" then dev(p,arg)
 elseif verb=="EquipSound" then local sound=type(arg)=="string" and Config.GetSound(arg);if sound and sound.level<=s.data.level then s.data.sound=sound.id;state(p,sound.name.." equipped") end
 elseif verb=="MicroSpeaker" then microSpeaker(p,s,true)
 elseif verb=="VendorPurchase" then vendorPurchase(p,s,arg)
 elseif verb=="ShopPurchase" then Commerce.Prompt(p,arg)
 elseif verb=="ActivateBoost" then Commerce.Activate(p,arg)
 elseif verb=="ShopRefresh" then task.spawn(Commerce.Load,p)
 elseif verb=="SetCustomColor" then
  local hex=ShopCatalog.Hex(arg)
  if hex and Entitlements.HasSpectrum(p) then s.data.customColor=hex;s.data.useCustomColor=true;state(p,"Signature color equipped") end
 elseif verb=="SetAura" and arg=="Gold" then s.data.aura=arg;s.data.useCustomColor=false;state(p)
 elseif verb=="AcceptQuest" then
  local q=type(arg)=="string" and Config.GetQuest(arg)
  if q and q.retired==true then return end
  if q and q.menuAvailable~=true and not s.data.availableQuests[q.id] then state(p,"Meet "..(q.giver or "the quest giver").." to unlock this task.");return end
  if q and q.id=="nick" then
   local _,root=parts(p)
   if not root or (root.Position-(Config.CompactCity and Config.CityLayout.Soccer.center or Vector3.new(647,4,547))).Magnitude>90 then state(p,"Return to Nick's coastal court to start.");return end
  end
  if q then local v=s.data.quests[q.id];if not v then v={progress=0,claimed=false};s.data.quests[q.id]=v end
   if not v.claimed and v.progress>=q.goal then state(p,"Task complete · claim your reward.");return end
   if s.activeQuest==q.id then state(p,"Task already active · continue your current attempt.");return end
   if not v.claimed then stopQuest(p);v.progress=0;s.activeQuest=q.id;state(p,q.name.." accepted")
    if q.id=="nick" then Soccer.Start(p,function(message) state(p,message) end,function()
     if sessions[p]==s and s.activeQuest=="nick" then s.questDeadline=nil;questProgress(p,"Soccer");state(p,"Nick: WE DID IT! Claim your reward in Quests.") end
    end,function() if sessions[p]==s and s.activeQuest=="nick" then stopQuest(p);state(p,"Nick: Attempt ended. Return to the court and accept my task to try again.") end end) end
   end end
 elseif verb=="AbandonQuest" then stopQuest(p);state(p,"Task abandoned. Unfinished progress was reset; earned rewards remain claimable.")
 elseif verb=="ClaimQuest" then
  local q=type(arg)=="string" and Config.GetQuest(arg);local v=q and s.data.quests[q.id]
  if v and not v.claimed and v.progress>=q.goal then v.claimed=true;if q.id=="nick" then s.data.achievements.NickChampion=true end;local coinCredit=coins(p,q.coins);local xpCredit=xp(p,q.xp);if s.activeQuest==q.id then stopQuest(p) end;state(p,"Quest reward · +"..xpCredit.." XP · +"..coinCredit.." coins") end
 elseif verb=="SetSettings" and type(arg)=="table" then
  if type(arg.volume)=="number" and arg.volume==arg.volume then s.data.settings.volume=math.clamp(arg.volume,0,1) end
  if type(arg.reducedShake)=="boolean" then s.data.settings.reducedShake=arg.reducedShake end;state(p)
 end
end)
local function joined(p)
 if closing then return end
 task.spawn(Entitlements.Refresh,p)
 local data,save,loadMessage,recoveryWarning
 if localFixture then data,save,loadMessage=Profiles.Default(),false,"Local sustained prototype · saving disabled"
 else data,save,loadMessage,recoveryWarning=Profiles.Load(p.UserId) end
 if closing or not p.Parent then
  if save then
   local completed,ok,reason=pcall(Profiles.Save,p.UserId,data,true)
   if not completed or not ok then
    warn("ScreamSimulator late profile release failed",p.UserId,completed and reason or ok)
   end
  end
  return
 end
 local s={data=data,canSave=save,recoveryWarning=recoveryWarning,rewardIdentity={},voice=VoiceCombat.New(),voiceEligibility=VoiceEligibility.New(localFixture,os.clock(),p.UserId),micReady=false,protectedUntil=0,nextCast=0,nextDodge=0,dodgingUntil=0,nextAction=0,nextHeal=os.clock()+Config.HealQuietSeconds,
 botRewards={},credit={},collected={},sprintRequested=false,sprintRunning=false,sprintRegenAt=0,sprintCharge=Config.SprintDuration,sprintLockedUntil=0,lastStep=os.clock()};sessions[p]=s
 task.spawn(Commerce.Load,p)
 if sustainedEnabled then
  s.sustained=sustained.New()
  p:SetAttribute("SustainedActive",false);p:SetAttribute("SustainedReadyAt",0);p:SetAttribute("SustainedEndsAt",0)
 end
 local function spawn(c)
  local h=c:WaitForChild("Humanoid",10)
  if not h or not p.Parent or sessions[p]~=s or p.Character~=c or s.character==c then return end
  s.character=c;closeConversation(p)
  s.jumpPower=h.JumpPower;s.jumpHeight=h.JumpHeight
  h.MaxHealth=Config.HealthForLevel(s.data.level);h.Health=h.MaxHealth;h.WalkSpeed=16
  s.sprintCharge=Config.SprintDuration;s.sprintRequested=false;s.sprintRunning=false;s.sprintRegenAt=0;s.lastStep=os.clock();s.sprintLockedUntil=0;s.dodgingUntil=0;s.knockedUntil=0;s.premiumRoll=false
  s.nextHeal=os.clock()+Config.HealQuietSeconds
  p:SetAttribute("DodgeEnds",0);p:SetAttribute("DodgeStarted",0);p:SetAttribute("KnockdownEnds",0)
  p:SetAttribute("Sprinting",false);p:SetAttribute("SprintCooldown",0);p:SetAttribute("SprintCharge",Config.SprintDuration)
  protect(p,s);state(p)
 end
 s.characterRemovingConnection=p.CharacterRemoving:Connect(function(c)
  if sessions[p]~=s or s.character~=c then return end
  closeConversation(p);cancelSustained(p,s,os.clock());VoiceCombat.Cancel(s.voice)
  p:SetAttribute("CaptureStarted",0);s.sprintRequested=false;s.character=nil
 end)
 s.characterAddedConnection=p.CharacterAdded:Connect(spawn);if p.Character then task.spawn(spawn,p.Character) end
 stepVoiceEligibility(p,s,os.clock());dispatchVoiceEligibility(os.clock())
 state(p,loadMessage or "Welcome · train for XP, unlock beam styles, and explore the coast")
end
local function joinTracked(p)
 if closing then return end
 joinsInFlight+=1
 local ok,err=pcall(joined,p)
 joinsInFlight-=1
 if not ok then warn("ScreamSimulator profile join failed",err) end
end
Players.PlayerAdded:Connect(joinTracked);for _,p in ipairs(Players:GetPlayers()) do task.spawn(joinTracked,p) end
local departuresInFlight=0
local function leaving(p)
 closeConversation(p)
 local s=sessions[p]
 if not s then return end
 disconnectSessionSignals(s)
 cancelSustained(p,s,os.clock());VoiceCombat.Cancel(s.voice)
 -- Release gameplay ownership before Save yields. Delayed gameplay callbacks
 -- must not mutate a departing profile or clear a replacement session later.
 sessions[p]=nil
 if s.canSave then
  departuresInFlight+=1
  local completed,ok,reason=pcall(Profiles.Save,p.UserId,s.testBaseline or s.data,true)
  departuresInFlight-=1
  if not completed or not ok then warn("ScreamSimulator departure save failed",p.UserId,completed and reason or ok) end
 end
end
Players.PlayerRemoving:Connect(leaving)
local function stepTraining(now)
 for _,bot in ipairs(World.Bots) do
  if not bot.training or not bot.alive then continue end
  if now-(bot.lastTrainingHit or now)>TrainingRules.ResetAfter and bot.health<bot.maxHealth then restoreBot(bot) end
  local p=bot.trainingTarget;local s=p and sessions[p];local c,r,h
  if p then c,r,h=parts(p) end
  local valid=s and r and s.micReady and not Config.InArena(r.Position) and (r.Position-bot.start).Magnitude<=TrainingRules.Radius
   and now>=s.protectedUntil and now>=(s.knockedUntil or 0) and audible(bot.model,bot.root.Position,r.Position,c)
  if not valid then bot.strike=nil;bot.trainingTarget=nil;continue end
  if bot.strike then
   if now>=bot.strike.at then
    local strike=bot.strike;bot.strike=nil
    local delta=r.Position-strike.position
    if TrainingRules.Hits(Vector3.new(delta.X,0,delta.Z).Magnitude,now<s.protectedUntil,now<s.dodgingUntil) then
     s.nextHeal=now+Config.HealQuietSeconds
     if h.Health<=bot.training.damage then eject(p,h) else h.Health-=bot.training.damage;state(p) end
    end
   end
  elseif now>=(bot.nextStrike or 0) then
   bot.nextStrike=now+TrainingRules.AttackInterval
   bot.strike={at=now+TrainingRules.Windup,position=r.Position}
   -- Replicated, bounded warning disc; never collides or blocks the player's beam.
   local disc=Instance.new("Part");disc.Name="TrainingStrikeWarning";disc.Anchored=true
   disc.CanCollide=false;disc.CanTouch=false;disc.CanQuery=false;disc.Shape=Enum.PartType.Cylinder
   disc.Size=Vector3.new(.1,8,8);disc.CFrame=CFrame.new(r.Position.X,1.4,r.Position.Z)*CFrame.Angles(0,0,math.pi/2)
   disc.Color=Color3.fromRGB(255,90,70);disc.Material=Enum.Material.Neon;disc.Transparency=.45;disc.Parent=workspace
   game:GetService("Debris"):AddItem(disc,TrainingRules.Windup)
  end
 end
end
local function stepSprint(s,root,humanoid,now,dt)
 -- Charge the interval for which the server granted sprint speed. A release
 -- received just before this tick must not turn that interval into regeneration.
 if s.sprintRunning then
  s.sprintCharge=math.max(0,s.sprintCharge-dt)
  s.sprintRegenAt=now+Config.SprintRegenDelay
  if s.sprintCharge<=1e-6 then s.sprintCharge=0;s.sprintLockedUntil=now+Config.SprintRecovery end
 end
 if s.sprintLockedUntil>0 and now>=s.sprintLockedUntil then
  s.sprintLockedUntil=0;s.sprintCharge=Config.SprintDuration
 elseif not s.sprintRunning and now>=s.sprintLockedUntil then
  local recoveryDt=math.clamp(now-(s.sprintRegenAt or 0),0,dt)
  s.sprintCharge=math.min(Config.SprintDuration,s.sprintCharge+recoveryDt*2)
 end
 local velocity=root and root.AssemblyLinearVelocity
 local moving=velocity and velocity.X*velocity.X+velocity.Z*velocity.Z>2.25
 local running=root~=nil and not root.Anchored and humanoid~=nil and not humanoid.Sit and not humanoid.SeatPart and not humanoid.PlatformStand and s.sprintRequested and moving==true
  and now>=s.dodgingUntil and now>=(s.knockedUntil or 0) and s.sprintCharge>0 and now>=s.sprintLockedUntil
 s.sprintRunning=running==true
 return running
end
task.spawn(function()
 local tick=0
 while true do task.wait(0.1);tick+=1;local now=os.clock()
  dispatchVoiceEligibility(now)
  stepTraining(now)
  for p,s in pairs(sessions) do
   stepVoiceEligibility(p,s,now)
   local dt=math.max(0,now-s.lastStep);s.lastStep=now;local _,r,h=parts(p)
   -- Crossing into PvP immediately restores the full dodge cooldown.
   if r and Config.InArena(r.Position) and s.lastDodge then
    if s.premiumRoll then s.premiumRoll=false;s.dodgingUntil=0;p:SetAttribute("DodgeEnds",0) end
    s.nextDodge=math.max(s.nextDodge,s.lastDodge+Config.DodgeCooldown);p:SetAttribute("DodgeReady",workspace:GetServerTimeNow()+math.max(0,s.nextDodge-now)) end
   if s.sustained and s.sustained.protocol.active then stepSustained(p,s,os.clock()) end
   if s.voice.capture and now-s.voice.capture.started>VoiceCombat.CaptureExpiry then VoiceCombat.Cancel(s.voice);p:SetAttribute("CaptureStarted",0) end
   local running=stepSprint(s,r,h,now,dt)
   if h then
    if h.FloorMaterial~=Enum.Material.Air then s.jumpOriginY=r.Position.Y end
    h.WalkSpeed=now<(s.knockedUntil or 0) and 0 or now<s.dodgingUntil and 0 or running and 25 or 16
    h.JumpPower=s.jumpPower or 50;h.JumpHeight=s.jumpHeight or 7.2
    local healed,nextHeal=Healing.Step(h.Health,h.MaxHealth,s.nextHeal,now)
    if healed~=h.Health then h.Health=healed end;s.nextHeal=nextHeal
    if Config.CompactCity and (r.Position.X<Config.MapMin.X-10 or r.Position.X>Config.MapMax.X+10 or r.Position.Z<Config.MapMin.Z-10 or r.Position.Z>Config.MapMax.Z+10 or r.Position.Y< -15) then
     resetMovement(p,s,h,r);running=false
     p.Character:PivotTo(World.SafeSpawn);protect(p,s)
     r.AssemblyLinearVelocity=Vector3.zero;r.AssemblyAngularVelocity=Vector3.zero
     state(p,"Returned to the safe courtyard")
    elseif not Config.CompactCity and r.Position.Z>600 and (r.Position.Z>780 or math.abs(r.Position.X)>700) then
     resetMovement(p,s,h,r);running=false
     p.Character:PivotTo(CFrame.new(math.clamp(r.Position.X,-670,670),5,594));protect(p,s)
     state(p,"Lifeguard rescue · stay inside the gold buoys.")
    elseif r.Position.Y< -20 then
     resetMovement(p,s,h,r);running=false;p.Character:PivotTo(World.SafeSpawn);protect(p,s)
     state(p,"Rescued · back at the safe hub")
    end
   end
   if s.questDeadline and now>s.questDeadline then stopQuest(p);state(p,"Time's up · accept the task again to restart.") end
   p:SetAttribute("SprintCharge",s.sprintCharge);p:SetAttribute("SprintCooldown",math.max(0,s.sprintLockedUntil-now));p:SetAttribute("Sprinting",running==true)
   if tick%5==0 then state(p) end
  end
 end
end)
local function autosave(p,s)
 local completed,ok,reason=pcall(Profiles.Save,p.UserId,s.testBaseline or s.data)
 if not completed then ok=false;reason="exception" end
 -- A leave/rejoin can finish while UpdateAsync is yielding.
 if sessions[p]~=s or not p.Parent then return end
 if ok then s.saveDelayed=false
 elseif reason=="ownership" or reason=="unavailable" then
  s.canSave=false;s.saveDelayed=false;state(p,"Saving is unavailable. Progress from here is temporary; rejoin before continuing progression.",nil,true,"save")
 else
  local first=not s.saveDelayed;s.saveDelayed=true
  if first then state(p,"Save delayed. Your progress is still in this server; saving will retry automatically.",nil,true,"save") end
 end
end
task.spawn(function() while true do task.wait(60);for p,s in pairs(sessions) do if s.canSave then task.spawn(autosave,p,s) end end end end)
local function shutdown()
 closing=true
 local pending=0
 local deadline=os.clock()+25
 local finalSaves={}
 -- Freeze gameplay before any final save can yield or release its lease.
 -- In-flight joins see closing and release their acquired profile instead.
 for p,s in pairs(sessions) do
  disconnectSessionSignals(s)
  closeConversation(p);cancelSustained(p,s,os.clock());VoiceCombat.Cancel(s.voice)
  sessions[p]=nil
  if s.canSave then table.insert(finalSaves,{player=p,session=s}) end
 end
 for _,entry in ipairs(finalSaves) do
  local p,s=entry.player,entry.session
  if s.canSave then
   pending+=1
   task.spawn(function()
    local completed,ok,reason=pcall(Profiles.Save,p.UserId,s.testBaseline or s.data,true)
    pending-=1
    if not completed or not ok then warn("ScreamSimulator shutdown save failed",completed and reason or ok) end
   end)
  end
 end
 while (pending>0 or departuresInFlight>0 or joinsInFlight>0) and os.clock()<deadline do task.wait(.1) end
end
game:BindToClose(shutdown)
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="27">
      <Properties>
        <string name="Name">City</string>
        <string name="Source"><![CDATA[-- Original Barcelona-inspired city geometry; reviewed fountain mesh has a built-in fallback.
local City={}
local Config=require(game:GetService("ReplicatedStorage").Shared.Config)
local CompactCity=require(script.Parent.CompactCity)
local V=Vector3.new
local Collection=game:GetService("CollectionService")
local palette={Color3.fromRGB(219,192,151),Color3.fromRGB(227,206,171),Color3.fromRGB(195,151,117),Color3.fromRGB(234,214,180),Color3.fromRGB(191,169,135),Color3.fromRGB(220,174,143)}
local stone=Color3.fromRGB(207,191,159)
local dark=Color3.fromRGB(48,62,61)
local iron=Color3.fromRGB(39,53,53)
local glass=Color3.fromRGB(66,104,112)
local leaf=Color3.fromRGB(80,120,72)
local terra=Color3.fromRGB(168,89,60)
local cream=Color3.fromRGB(245,224,180)
local rng=Random.new(230926)
local function part(parent,name,size,cf,color,material,solid)
 local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=typeof(cf)=="CFrame" and cf or CFrame.new(cf);p.Color=color;p.Material=material or Enum.Material.SmoothPlastic
 p.CastShadow=solid~=false
 p.Anchored=true;p.CanCollide=solid~=false;p.CanQuery=solid~=false;p.CanTouch=false;p.Parent=parent;return p
end
local function model(parent,name) local m=Instance.new("Model");m.Name=name;m.Parent=parent;return m end
local function ellipsoid(parent,name,size,position,color,material)
 local p=part(parent,name,size,position,color,material,false);local mesh=Instance.new("SpecialMesh");mesh.MeshType=Enum.MeshType.Sphere;mesh.Parent=p;return p
end
local function cylinder(parent,name,radius,height,pos,color,material)
 local p=part(parent,name,V(height,radius*2,radius*2),CFrame.new(pos)*CFrame.Angles(0,0,math.pi/2),color,material);p.Shape=Enum.PartType.Cylinder;return p
end
local function sign(parent,text,cf,width)
 local p=part(parent,"FacadeSign",V(width,2,.25),cf,dark,nil,false)
 local g=Instance.new("SurfaceGui");g.Face=Enum.NormalId.Front;g.PixelsPerStud=28;g.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud;g.Parent=p
 local t=Instance.new("TextLabel");t.Size=UDim2.fromScale(1,1);t.BackgroundTransparency=1;t.Font=Enum.Font.GothamBold;t.TextColor3=cream;t.TextScaled=true;t.Text=text;t.Parent=g;return p
end
local function destructible(m,kind)
 m:SetAttribute("DestructibleType",kind);Collection:AddTag(m,"CityDestructible")
end
local function tree(parent,x,z,palm)
 local group=model(parent,palm and "Palm" or "SmallTree");parent=group
 if not palm and (V(x,0,z)-V(-600,0,210)).Magnitude>85 then destructible(group,"SmallTree") end
 local h=palm and rng:NextNumber(14,20) or rng:NextNumber(10,15)
 cylinder(parent,"TreeTrunk",.65,h,V(x,h/2+1,z),Color3.fromRGB(116,96,69),Enum.Material.Wood)
 if palm then
  for j=1,7 do
   local cf=CFrame.new(x,h+1,z)*CFrame.Angles(0,j*math.pi*2/7,0)
   for k=1,3 do part(parent,"PalmFrond",V(2.4,.22,3.5),cf*CFrame.new(0,-(k-1)^2*.35,k*2.2)*CFrame.Angles((k-2)*.23,0,0),leaf,Enum.Material.Grass,false) end
  end
 else
  -- Branches and separate crown clusters avoid the old stacked mushroom silhouette.
  for j=0,3 do
   local angle=j*math.pi/2+.45
   local direction=V(math.cos(angle),0,math.sin(angle))
   local start=V(x,h-2,z);local finish=V(x,h+1.5,z)+direction*3.2
   part(parent,"PlaneTreeBranch",V(.55,.55,(finish-start).Magnitude),CFrame.lookAt((start+finish)/2,finish),Color3.fromRGB(116,96,69),Enum.Material.Wood,false)
   ellipsoid(parent,"PlaneTreeCrown",V(7.4,5.8,7.4),finish+V(0,1,0),Color3.fromRGB(78+j*5,116+j*5,68+j*3),Enum.Material.Grass)
  end
  ellipsoid(parent,"PlaneTreeCrown",V(8.5,7,8.5),V(x,h+4,z),Color3.fromRGB(93,137,79),Enum.Material.Grass)
 end
 return group,h
end
local function lamp(parent,x,z)
 cylinder(parent,"StreetLamp",.22,12,V(x,7,z),iron,Enum.Material.Metal)
 local top=part(parent,"Lantern",V(1.4,2,1.4),V(x,13,z),cream,Enum.Material.Neon,false)
 part(parent,"LanternCap",V(2,.3,2),V(x,14.2,z),iron,Enum.Material.Metal,false)
 -- Limit dynamic lights: bright lantern geometry reads well without hundreds of shadow maps.
 if math.abs(x)<100 and math.abs(z)<100 then local l=Instance.new("PointLight");l.Range=16;l.Brightness=.3;l.Color=cream;l.Parent=top end
end
local function bench(parent,cf)
 local group=model(parent,"Bench");parent=group
 if (cf.Position-V(-600,0,210)).Magnitude>85 then destructible(group,"Bench") end
 local seat=part(parent,"BenchSeat",V(8,.5,2.5),cf*CFrame.new(0,2,0),Color3.fromRGB(139,100,66),Enum.Material.WoodPlanks)
 part(parent,"BenchBack",V(8,2.2,.35),cf*CFrame.new(0,3.2,1.1),Color3.fromRGB(139,100,66),Enum.Material.WoodPlanks)
 local usable=Instance.new("Seat");usable.Name="UsableSeat";usable.Size=V(3,.25,2);usable.CFrame=cf*CFrame.new(0,2.4,0);usable.Transparency=1;usable.Anchored=true;usable.CanCollide=false;usable.Parent=parent
 local sit=Instance.new("ProximityPrompt");sit.ActionText="Sit";sit.ObjectText="City bench";sit.KeyboardKeyCode=Enum.KeyCode.F;sit.MaxActivationDistance=7;sit.Parent=seat
 sit.Triggered:Connect(function(player) local h=player.Character and player.Character:FindFirstChildOfClass("Humanoid");local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart");if h and root and (root.Position-seat.Position).Magnitude<9 and not group:GetAttribute("Destroyed") then usable:Sit(h) end end)
 for _,x in ipairs({-3,3}) do part(parent,"BenchLeg",V(.35,2,.9),cf*CFrame.new(x,1,0),iron,Enum.Material.Metal) end
end
local function cafe(parent,x,z,color)
 cylinder(parent,"CafeTable",2,.25,V(x,3,z),stone,Enum.Material.Marble)
 cylinder(parent,"TableLeg",.2,2,V(x,2,z),iron,Enum.Material.Metal)
 for _,dx in ipairs({-3.2,3.2}) do
  part(parent,"CafeChair",V(2,.4,2),V(x+dx,2,z),color,Enum.Material.Wood)
  part(parent,"CafeChairBack",V(.4,2.7,2),V(x+dx+(dx>0 and .9 or -.9),3,z),color,Enum.Material.Wood)
 end
 cylinder(parent,"Cup",.3,.55,V(x,3.45,z),cream,Enum.Material.CeramicTiles)
end
local shops={"FORN DEL SOL","CAFÈ MARINA","FLORS I FULLES","LLIBRERIA","GELATS","MERCAT LOCAL","TAPES DEL BARRI","ESTUDI D'ART","PANADERIA","MÚSICA","FRUITA FRESCA","CASA DE TE"}
local function building(parent,cf,w,d,floors,index,style)
 local m=model(parent,"Casa_"..index)
 local h=floors*8+7;local color=palette[Random.new(index*7919):NextInteger(1,#palette)]
 local refined=parent:GetAttribute("RefinedFrontages")==true
 local district=parent:GetAttribute("ColorDistrict") or style or "Eixample"
 local frontage=index%4
 local accents={Color3.fromRGB(57,112,105),Color3.fromRGB(130,72,65),Color3.fromRGB(69,94,121),Color3.fromRGB(136,116,64)}
 local accent=accents[frontage+1]
 if refined then
  -- District-specific plaster and shutters keep the coast, old lanes and
  -- boulevard blocks readable without adding geometry or blocking routes.
  local schemes={
   Maritime={{235,218,177},{157,194,190},{226,168,137},{173,193,211}},
   Born={{218,167,126},{231,190,151},{198,143,115},{225,202,165}},
   Modernista={{203,212,179},{232,199,155},{208,178,185},{186,207,199}},
   Eixample={{232,207,164},{216,161,132},{183,202,178},{236,221,191}},
  }
  local paints=schemes[district] or schemes.Eixample
  local choice=paints[(frontage+math.floor(index/7))%#paints+1]
  local shade=Random.new(index*7919):NextInteger(-6,6)
  color=Color3.fromRGB(choice[1]+shade,choice[2]+shade,choice[3]+shade)
  if district=="Maritime" then
   accent=({Color3.fromRGB(49,121,137),Color3.fromRGB(61,135,121),Color3.fromRGB(164,99,71),Color3.fromRGB(80,115,155)})[frontage+1]
  end
  m:SetAttribute("ColorDistrict",district)
  m:SetAttribute("FrontageStyle",({"Gallery","Terracotta","TileHouse","Atelier"})[frontage+1])
 end
 local function b(name,size,pos,c,mat,solid) return part(m,name,size,cf*CFrame.new(pos),c,mat,solid) end
 local shopIndex=index==501 and 2 or index==266 and 3 or (index-1)%#shops+1
 local shopKind=({"Bakery","Cafe","Florist","Books","Gelato","Market","Cafe","Art","Bakery","Music","Market","Cafe"})[shopIndex]
 m:SetAttribute("ShopName",shops[shopIndex]);m:SetAttribute("ShopKind",shopKind)
 local doorWidth=8
 local interior=(index%7==0 or index==501) and w>=24 and d>=20
 if interior then
  m:SetAttribute("WalkableInterior",true);m:SetAttribute("Entrance",cf*CFrame.new(0,3.8,-d/2))
  b("UpperMasonry",V(w,h-8,d),V(0,9+(h-8)/2,0),color,Enum.Material.Plaster)
  b("InteriorFloor",V(w,.3,d),V(0,1.1,0),cream,Enum.Material.WoodPlanks)
  b("RearWall",V(w,8,1),V(0,5,d/2-.5),stone,Enum.Material.Limestone)
  for _,side in ipairs({-1,1}) do
   b("SideWall",V(1,8,d),V(side*(w/2-.5),5,0),color,Enum.Material.Plaster)
   b("ShopfrontWall",V((w-doorWidth)/2,8,1),V(side*(w+doorWidth)/4,5,-d/2+.5),stone,Enum.Material.Limestone)
   b("DoorJamb",V(.4,7,.6),V(side*(doorWidth/2+.2),4.5,-d/2-.1),cream,Enum.Material.Limestone)
  end
  b("DoorLintel",V(doorWidth+.8,1,.7),V(0,8.5,-d/2-.1),cream,Enum.Material.Limestone)
  if math.abs(cf.LookVector.X)>.1 and math.abs(cf.LookVector.Z)>.1 then
   -- Chamfered corner paving ends at the threshold. Bridge its 1.35-stud drop
   -- with a shallow apron so non-jumping pedestrians can enter from the street.
   local ramp=b("EntranceRamp",V(doorWidth+2,.3,12),V(0,.55,-d/2-6),stone,Enum.Material.Pavement)
   ramp.CFrame*=CFrame.Angles(-math.atan(1.3/12),0,0)
  end
  -- Furniture stays outside the central four-stud aisle, including in narrow shops.
  m:SetAttribute("InteriorAisle",cf*CFrame.new(0,4,0));m:SetAttribute("InteriorAisleSize",V(4,4.5,d-3))
  b("ServiceCounter",V(6,3,2),V(w/2-4,2.6,0),terra,Enum.Material.Wood)
  local left=-w/2+2
  if shopKind=="Books" then
   for shelf=1,3 do
    b("BookShelf",V(1.5,.25,d*.55),V(left,1.5+shelf*1.5,1),terra,Enum.Material.Wood)
    for book=1,6 do
     b("Book",V(.7,.7+(book%3)*.15,.6),V(left,2.1+shelf*1.5,-d*.2+book*d*.07),palette[(book+index)%#palette+1],Enum.Material.Fabric,false)
    end
   end
  elseif shopKind=="Cafe" then
   b("EspressoMachine",V(2.6,1.7,1.5),V(w/2-4,4.95,0),iron,Enum.Material.Metal,false)
   b("EspressoTrim",V(2.7,.15,1.6),V(w/2-4,5.55,0),cream,Enum.Material.Metal,false)
   for dx=-.7,.7,.7 do b("CoffeeCup",V(.4,.55,.4),V(w/2-4+dx,5.9,0),cream,Enum.Material.CeramicTiles,false) end
   local tx=-w/2+4
   b("CafeInteriorTable",V(3.4,.3,3.4),V(tx,3.4,2),stone,Enum.Material.Marble)
   b("CafeInteriorTableLeg",V(.35,2.1,.35),V(tx,2.2,2),iron,Enum.Material.Metal)
   for _,side in ipairs({-1,1}) do
    local seat=Instance.new("Seat");seat.Name="CafeSeat";seat.Size=V(2,.4,2)
    seat.CFrame=cf*CFrame.new(tx,2.5,2+side*3)*CFrame.Angles(0,side==1 and 0 or math.pi,0)
    seat.Color=accent;seat.Material=Enum.Material.Wood;seat.Anchored=true;seat.Parent=m
    for _,dx in ipairs({-.7,.7}) do for _,dz in ipairs({-.7,.7}) do b("CafeSeatLeg",V(.15,1.1,.15),V(tx+dx,1.75,2+side*3+dz),iron,Enum.Material.Metal,false) end end
    b("CafeSeatBack",V(2,2,.25),V(tx,3.3,2+side*3.85),accent,Enum.Material.Wood)
    local prompt=Instance.new("ProximityPrompt");prompt.ActionText="Sit";prompt.ObjectText=shops[shopIndex];prompt.KeyboardKeyCode=Enum.KeyCode.F;prompt.MaxActivationDistance=6;prompt.Parent=seat
    prompt.Triggered:Connect(function(player)
     local c=player.Character;local root=c and c:FindFirstChild("HumanoidRootPart");local h=c and c:FindFirstChildOfClass("Humanoid")
     if root and h and h.Health>0 and not seat.Occupant and (root.Position-seat.Position).Magnitude<=8 then seat:Sit(h) end
    end)
   end
  elseif shopKind=="Florist" then
   for i=1,4 do
    local z=-d*.25+i*d*.12
    b("FlowerStand",V(2.4,1.4,2.4),V(left,1.95,z),terra,Enum.Material.CeramicTiles)
    for j=-1,1 do
     b("CutFlowerStem",V(.08,2,.08),V(left+j*.45,3.5,z),leaf,Enum.Material.Grass,false)
     local flower=b("CutFlower",V(.8,.5,.8),V(left+j*.45,4.5,z),j==0 and cream or Color3.fromRGB(212,109,133),Enum.Material.SmoothPlastic,false);flower.Shape=Enum.PartType.Ball
    end
   end
  elseif shopKind=="Art" then
   for i=1,3 do
    local z=-d*.3+i*d*.18
    b("GalleryFrame",V(.3,3.8,3),V(left-1,4.8,z),terra,Enum.Material.Wood,false)
    b("GalleryCanvas",V(.1,3.3,2.5),V(left-.78,4.8,z),Color3.fromRGB(106,165,178),Enum.Material.Fabric,false)
    b("PaintedHorizon",V(.12,1.3,2.5),V(left-.7,3.85,z),i%2==0 and leaf or stone,nil,false)
   end
   b("GalleryBench",V(1.8,1.4,d*.45),V(left+1.3,1.95,0),terra,Enum.Material.Wood)
  elseif shopKind=="Music" then
   b("InstrumentRack",V(1.8,.4,d*.6),V(left,2.1,0),terra,Enum.Material.Wood)
   for i=1,3 do
    local z=-d*.3+i*d*.15
    local body=b("DisplayGuitar",V(.6,1.7,1.2),V(left,3.2,z),i%2==0 and terra or cream,Enum.Material.Wood,false);body.Shape=Enum.PartType.Ball
    b("GuitarNeck",V(.3,2,.3),V(left,4.7,z),dark,Enum.Material.Wood,false)
   end
  else
   for shelf=1,2 do
    b("FoodDisplayShelf",V(2.4,.25,d*.6),V(left,1.9+shelf*1.5,0),stone,Enum.Material.Marble)
    for item=1,5 do
     local z=-d*.3+item*d*.1
     local foodColor=shopKind=="Bakery" and Color3.fromRGB(211,159,91) or shopKind=="Gelato" and palette[(item%#palette)+1] or item%2==0 and Color3.fromRGB(177,74,65) or Color3.fromRGB(113,155,83)
     local food=b(shopKind=="Bakery" and "BreadLoaf" or shopKind=="Gelato" and "GelatoTub" or "ProduceBasket",V(1.6,.65,1),V(left,2.35+shelf*1.5,z),foodColor,Enum.Material.SmoothPlastic,false)
     if shopKind=="Bakery" then food.Shape=Enum.PartType.Ball end
    end
   end
  end
  b("PendantStem",V(.1,1.2,.1),V(0,7.7,0),iron,Enum.Material.Metal,false)
  b("WarmPendant",V(2,.6,2),V(0,7,0),cream,Enum.Material.Neon,false)
 else
  b("Masonry",V(w,h,d),V(0,h/2+1,0),color,Enum.Material.Plaster)
  b("StonePlinth",V(w+.3,5,d+.3),V(0,3.5,0),stone,Enum.Material.Limestone)
 end
 b("Cornice",V(w+1.7,.8,d+1.7),V(0,h+1,0),cream,Enum.Material.Limestone)
 b("TerracottaRoof",V(w+1.1,.5,d+1.1),V(0,h+1.7,0),terra,Enum.Material.RoofShingles)
 b("RoofParapet",V(w,.9,.5),V(0,h+2,-d/2),stone,Enum.Material.Limestone)
 b("Chimney",V(2,4,2),V(w*.25,h+3,0),stone,Enum.Material.Brick)
 if not interior then
  b("EntranceDoor",V(3.5,5.8,.3),V(0,4,-d/2-.35),Color3.fromRGB(84,66,49),Enum.Material.Wood,false)
  b("DoorTransom",V(3.4,1.1,.4),V(0,7,-d/2-.35),glass,Enum.Material.Glass,false)
 end
 for _,dx in ipairs({-w/2+.6,w/2-.6}) do b("CornerPilaster",V(1.2,h,.6),V(dx,h/2+1,-d/2-.4),stone,Enum.Material.Limestone,false) end
 if index%3==0 then
  local facade=model(m,"BreakableFrontage")
  part(facade,"DecorativeStonePanel",V(w*.35,3.2,.5),cf*CFrame.new(0,10.5,-d/2-.5),color,Enum.Material.Limestone)
  part(facade,"PanelCornice",V(w*.38,.4,.8),cf*CFrame.new(0,12.2,-d/2-.6),cream,Enum.Material.Limestone)
  destructible(facade,floors<=2 and "HouseFacade" or floors<=4 and "ApartmentFacade" or "TowerFacade")
 end
 local cols=math.max(2,math.floor(w/9));local spacing=(w-7)/cols
 for floor=1,floors do
  local y=4+floor*8
  for col=1,cols do
   local x=(col-(cols+1)/2)*spacing
   b("WindowRecess",V(3.1,4.6,.2),V(x,y,-d/2-.16),iron,nil,false)
   local paneColor=refined and (floor+col+index)%7==0 and Color3.fromRGB(193,168,109) or glass
   b("WindowGlass",V(2.6,4.1,.22),V(x,y,-d/2-.3),paneColor,Enum.Material.Glass,false)
   if refined and floor<=2 then
    b("WindowMullion",V(.12,4.1,.08),V(x,y,-d/2-.45),cream,nil,false)
    b("WindowTransom",V(2.6,.12,.08),V(x,y+.55,-d/2-.45),cream,nil,false)
   end
   b("WindowLintel",V(3.8,.4,.6),V(x,y+2.5,-d/2-.35),cream,Enum.Material.Limestone,false)
   if style=="Born" or (refined and frontage==1) or col%2==0 then
    b("Shutter",V(.8,4.4,.35),V(x-2,y,-d/2-.35),(refined and accent or Color3.fromRGB(73,101,83)),Enum.Material.Wood,false)
    b("Shutter",V(.8,4.4,.35),V(x+2,y,-d/2-.35),(refined and accent or Color3.fromRGB(73,101,83)),Enum.Material.Wood,false)
   end
   if (floor+col+index)%2==0 and not (refined and frontage==0 and floor==1) then
    b("BalconySlab",V(4.7,.3,2.1),V(x,y-2.2,-d/2-1),stone,Enum.Material.Limestone,false)
    b("IronBalconyRail",V(4.7,1,.15),V(x,y-1.25,-d/2-2),iron,Enum.Material.Metal,false)
    -- Broad upper rails read at distance; fine ironwork is reserved for street-level floors.
    if not refined or floor<=2 then for _,dx in ipairs({-1.7,0,1.7}) do b("Baluster",V(.12,1.6,.15),V(x+dx,y-1.4,-d/2-2),iron,Enum.Material.Metal,false) end end
    if col==1 then b("WindowFlowers",V(3,.55,.55),V(x,y-.9,-d/2-2),Color3.fromRGB(174,79,100),Enum.Material.Grass,false) end
   end
  end
  for col=1,cols do
   local x=(col-(cols+1)/2)*spacing
   -- Courtyard elevations receive simpler, quieter detail than the retail fronts.
   local rearColor=refined and (floor*3+col+index)%11==0 and Color3.fromRGB(190,160,104) or glass
   if refined and floor<=2 then
    b("RearWindowSurround",V(3.3,4.5,.14),V(x,y,d/2+.1),stone,Enum.Material.Limestone,false)
    b("RearWindowSill",V(3.7,.22,.55),V(x,y-2.25,d/2+.28),cream,Enum.Material.Limestone,false)
    if (col+index)%2==0 then
     for _,side in ipairs({-1,1}) do
      local shutter=b("CourtyardShutter",V(.85,4.2,.16),V(x+side*2,y,d/2+.3),accent,Enum.Material.Wood,false)
      shutter.CFrame*=CFrame.Angles(0,side*.22,0)
     end
    end
    if floor==1 and col==math.ceil(cols/2) and index%3==0 then
     b("CourtyardBalcony",V(4.7,.25,1.8),V(x,y-2.2,d/2+.85),stone,Enum.Material.Limestone,false)
     b("CourtyardBalconyRail",V(4.7,.16,.16),V(x,y-.6,d/2+1.65),iron,Enum.Material.Metal,false)
     for _,dx in ipairs({-2.2,0,2.2}) do b("CourtyardBaluster",V(.12,1.6,.12),V(x+dx,y-1.4,d/2+1.65),iron,Enum.Material.Metal,false) end
     b("CourtyardFlowerBox",V(2.3,.5,.6),V(x,y-1.75,d/2+1.25),terra,Enum.Material.CeramicTiles,false)
     b("CourtyardFlowers",V(2.1,.35,.5),V(x,y-1.35,d/2+1.25),Color3.fromRGB(198,130,135),Enum.Material.Grass,false)
    end
   end
   b("CourtyardWindow",V(2.8,4,.15),V(x,y,d/2+.2),rearColor,Enum.Material.Glass,false)
  end
  for _,side in ipairs({-1,1}) do for k=-1,1 do
   b("SideWindow",V(.15,4,2.7),V(side*(w/2+.1),y,k*d/4),glass,Enum.Material.Glass,false)
  end end
 end
 if refined then
  b("RearDrainpipe",V(.18,h-.8,.18),V(w/2-1,h/2+1,d/2+.3),accent,Enum.Material.Metal,false)
  b("CourtyardCornice",V(w+.4,.3,.6),V(0,h+.75,d/2+.15),cream,Enum.Material.Limestone,false)
  -- Four frontage compositions share a collision shell and a clear central entrance.
  if frontage==0 then
   b("GalleryBalcony",V(w-5,.35,2.8),V(0,9.8,-d/2-1.3),stone,Enum.Material.Limestone,false)
   b("GalleryRail",V(w-5,1.1,.18),V(0,10.7,-d/2-2.6),iron,Enum.Material.Metal,false)
   for x=-w/2+4,w/2-4,4 do b("GallerySpindle",V(.14,1.8,.14),V(x,10.6,-d/2-2.6),iron,Enum.Material.Metal,false) end
   b("UpperTerrace",V(w*.64,1.8,d*.5),V(0,h+2.5,d*.12),stone,Enum.Material.Limestone,false)
  elseif frontage==1 then
   for _,side in ipairs({-1,1}) do
    b("SteppedGable",V(w*.22,2.6,.9),V(side*w*.23,h+2.7,-d/2),cream,Enum.Material.Limestone,false)
   end
   b("GableCrown",V(w*.22,4.1,.9),V(0,h+3.45,-d/2),cream,Enum.Material.Limestone,false)
  elseif frontage==2 then
   for floor=1,floors do
    b("CeramicBelt",V(w-.8,.65,.35),V(0,7.5+floor*8,-d/2-.4),accent,Enum.Material.CeramicTiles,false)
   end
   for _,side in ipairs({-1,1}) do b("CeramicPier",V(.55,h-8,.4),V(side*(w/2-2),h/2+5,-d/2-.45),accent,Enum.Material.CeramicTiles,false) end
  else
   for _,side in ipairs({-1,1}) do
    b("AtelierBay",V(4.8,h-12,1),V(side*w*.27,(h+12)/2,-d/2-.55),stone,Enum.Material.Limestone,false)
    for floor=2,floors do b("BayGlazing",V(3.5,5,.16),V(side*w*.27,4+floor*8,-d/2-1.1),glass,Enum.Material.Glass,false) end
   end
   b("AtelierRoofLight",V(w*.38,2,d*.34),V(0,h+2.8,0),accent,Enum.Material.Metal,false)
  end
  b("ShopFascia",V(w-.8,1.4,.55),V(0,8.3,-d/2-.4),accent,Enum.Material.Wood,false)
 end
 local shopOffset=(w+doorWidth)/4;local windowWidth=(w-doorWidth)/2-1.6
 for _,x in ipairs({-shopOffset,shopOffset}) do
  b("ShopGlazing",V(windowWidth,5.3,.25),V(x,4,-d/2-.25),glass,Enum.Material.Glass,false)
  local awningColor=refined and accent or index%2==0 and Color3.fromRGB(118,67,57) or Color3.fromRGB(61,111,99)
  local canopy=b("ShopAwning",V(windowWidth+.7,.35,3),V(x,7,-d/2-1),awningColor,Enum.Material.Fabric,false)
  if refined then
   canopy.CFrame*=CFrame.Angles(-.14,0,0)
   b("AwningValance",V(windowWidth+.7,.55,.12),V(x,6.5,-d/2-2.5),awningColor,Enum.Material.Fabric,false)
   b("ShopWindowFrame",V(windowWidth+.5,5.8,.13),V(x,4,-d/2-.39),accent,Enum.Material.Wood,false)
   b("ShopWindowInset",V(windowWidth-.4,4.9,.1),V(x,4,-d/2-.48),glass,Enum.Material.Glass,false)
   b("ShopTransom",V(windowWidth-.4,.14,.1),V(x,5.55,-d/2-.55),cream,nil,false)
   for _,side in ipairs({-1,1}) do b("DisplayMullion",V(.13,4.9,.12),V(x+side*windowWidth*.22,4,-d/2-.57),cream,nil,false) end
   b("DisplayShelf",V(windowWidth*.9,.18,.15),V(x,2.6,-d/2-.57),cream,nil,false)
  end
 end
 sign(m,shops[shopIndex],cf*CFrame.new(0,8.7,-d/2-(refined and .85 or .5)),math.min(w-3,26))
 -- A few authored courtyard landmarks, placed against rear ground-floor walls.
 -- These never cover shop entrances, windows, roads or pathfinding surfaces.
 if refined and ({[28]=true,[88]=true,[1690]=true,[1790]=true,[2210]=true,[2310]=true,[2410]=true})[index] then
  require(script.Parent.StreetArt).create(m,cf*CFrame.new(0,4.8,d/2+.07)*CFrame.Angles(0,math.pi,0),math.min(w-4,18),district=="Maritime")
 end
 if style=="Modernista" then
  for i=-2,2 do
   local ornament=b("CeramicCrown",V(3,2.8+math.abs(i),2),V(i*w/6,h+2.5,-d/2),i%2==0 and Color3.fromRGB(78,146,145) or cream,Enum.Material.CeramicTiles,false)
   ornament.Shape=Enum.PartType.Ball
  end
 end
 return m
end
local function octagon(parent,x,z)
 part(parent,"ChamferedPaving",V(208,1,152),V(x,.3,z),stone,Enum.Material.Pavement)
 part(parent,"ChamferedPaving",V(152,1,208),V(x,.3,z),stone,Enum.Material.Pavement)
 -- Four diamond infills turn the square cutouts into 45-degree corners.
 for _,sx in ipairs({-1,1}) do for _,sz in ipairs({-1,1}) do
  part(parent,"Chamfer",V(39.6,1,39.6),CFrame.new(x+sx*76,.3,z+sz*76)*CFrame.Angles(0,math.pi/4,0),stone,Enum.Material.Pavement)
 end end
end
local function garden(parent,x,z,index,activities)
 -- Every court keeps two unobstructed twelve-stud public passages. Details stay
 -- inside quadrants so the entrances never terminate at a fence or a tree.
 local theme=({"ReadingGarden","OrangeCourt","SculptureCourt","PergolaCourt"})[(index-1)%4+1]
 local m=model(parent,theme);m:SetAttribute("CourtyardTheme",theme)
 m:SetAttribute("CourtCenter",V(x,1.3,z))
 part(m,"CourtyardGarden",V(110,.3,110),V(x,1,z),Color3.fromRGB(112,138,79),Enum.Material.Grass)
 for _,size in ipairs({V(12,.12,110),V(110,.12,12)}) do part(m,"GardenPath",size,V(x,1.2,z),Color3.fromRGB(209,192,153),Enum.Material.Pavement) end
 local function pad(dx,dz)
  part(m,"CourtTerrace",V(36,.12,36),V(x+dx,1.22,z+dz),Color3.fromRGB(222,206,175),Enum.Material.Cobblestone)
 end
 local function planter(dx,dz)
  part(m,"LimestonePlanter",V(15,1.1,7),V(x+dx,1.7,z+dz),stone,Enum.Material.Limestone)
  part(m,"PlanterSoil",V(14.4,.12,6.4),V(x+dx,2.3,z+dz),Color3.fromRGB(90,73,54),Enum.Material.Ground,false)
  for k=-2,2 do
   ellipsoid(m,"Lavender",V(2.3,1.5,3.5),V(x+dx+k*2.6,2.8,z+dz),Color3.fromRGB(116+k*3,116,150),Enum.Material.Grass)
  end
 end
 local function seat(dx,dz,yaw)
  bench(m,CFrame.new(x+dx,0,z+dz)*CFrame.Angles(0,yaw or 0,0))
 end
 if theme=="ReadingGarden" then
  for _,side in ipairs({-1,1}) do
   pad(side*29,-29);tree(m,x+side*39,z-39,false)
   seat(side*27,-17,math.pi);planter(side*28,-47)
  end
  -- A pair of sheltered reading rooms, open toward the crossing paths.
  for _,side in ipairs({-1,1}) do
   pad(side*29,29)
   for _,dx in ipairs({-11,11}) do for _,dz in ipairs({-10,10}) do
    local top=11.3+math.sin(side*.06)*dx
    part(m,"ReadingCanopyPost",V(.65,top-1.3,.65),V(x+side*29+dx,(top+1.3)/2,z+29+dz),iron,Enum.Material.Metal)
   end end
   part(m,"ReadingCanopy",V(26,.4,24),CFrame.new(x+side*29,11.5,z+29)*CFrame.Angles(0,0,side*.06),Color3.fromRGB(132,86,65),Enum.Material.WoodPlanks,false)
   seat(side*29,33);seat(side*29,23,math.pi)
  end
 elseif theme=="OrangeCourt" then
  for _,dx in ipairs({-29,29}) do for _,dz in ipairs({-29,29}) do
   pad(dx,dz);local orangeTree,height=tree(m,x+dx,z+dz,false)
   for k=0,7 do
    local angle=math.floor(k/2)*math.pi/2+.45+(k%2-.5)*.35
    ellipsoid(orangeTree,"OrangeFruit",V(.9,.9,.9),V(x+dx+math.cos(angle)*5.3,height+.05,z+dz+math.sin(angle)*5.3),Color3.fromRGB(230,143,49))
   end
   seat(dx,dz+(dz<0 and 12 or -12),dz<0 and math.pi or 0)
  end end
 elseif theme=="SculptureCourt" then
  pad(-29,-29);pad(29,29)
  for _,side in ipairs({-1,1}) do
   local center=V(x+side*29,2,z+side*29)
   part(m,"SculpturePlinth",V(8,1.5,8),center,stone,Enum.Material.Limestone)
   -- Interlocking tilted blades give each end a recognizable silhouette.
   for blade=0,2 do
    part(m,"SculptureBlade",V(1.4,9,3.3),CFrame.new(center+V((blade-1)*2,5.5,0))*CFrame.Angles(.15,blade*.5,(blade-1)*.32),({Color3.fromRGB(63,132,138),Color3.fromRGB(203,123,79),Color3.fromRGB(222,185,99)})[blade+1],Enum.Material.Metal)
   end
   seat(side*29,side*29-side*12,side<0 and math.pi or 0)
   planter(side*29,-side*31);tree(m,x+side*40,z-side*43,false)
  end
 else
  for _,side in ipairs({-1,1}) do
   pad(side*29,-29);pad(side*29,29)
   for _,dx in ipairs({-12,12}) do for _,dz in ipairs({-12,12}) do
    part(m,"PergolaColumn",V(1.2,10,1.2),V(x+side*29+dx,6.3,z-29+dz),cream,Enum.Material.Limestone)
   end end
   for dx=-14,14,4 do
    part(m,"PergolaRafter",V(.65,.7,29),V(x+side*29+dx,11.5,z-29),Color3.fromRGB(136,101,71),Enum.Material.Wood,false)
   end
   for _,dz in ipairs({-11,11}) do part(m,"PergolaBeam",V(30,.8,.8),V(x+side*29,10.8,z-29+dz),Color3.fromRGB(136,101,71),Enum.Material.Wood,false) end
   for k=-2,2 do
    ellipsoid(m,"PergolaVine",V(7,2.5,7),V(x+side*29+k*4,12,z-35+(k%2)*2),leaf,Enum.Material.Grass)
   end
   for k=0,3 do
    ellipsoid(m,"ClimbingVine",V(2.3,3,2.3),V(x+side*29-12,3+k*2.3,z-41),leaf,Enum.Material.Grass)
   end
   seat(side*29,-24);cafe(m,x+side*29,z+29,Color3.fromRGB(89,126,111));planter(side*29,47)
  end
 end
 for _,side in ipairs({-1,1}) do
  table.insert(activities,{position=V(x+side*29,4,z-9),kind=theme=="SculptureCourt" and "Watch" or "Rest"})
 end
end
local function block(parent,x,z,index,style,walk,activities)
 local m=model(parent,style.."Block_"..index);m:SetAttribute("RefinedFrontages",true);octagon(m,x,z);garden(m,x,z,index,activities)
 for _,side in ipairs({-1,1}) do
  for j,offset in ipairs({-40,40}) do
   building(m,CFrame.lookAt(V(x+offset,0,z+side*82),V(x+offset,0,z+side*150)),52,28,3+(index+j)%3,index*20+j+(side+1)*2,style)
   building(m,CFrame.lookAt(V(x+side*82,0,z+offset),V(x+side*150,0,z+offset)),52,28,3+(index+j+1)%3,index*20+7+j+(side+1)*2,style)
  end
 end
 for _,sx in ipairs({-1,1}) do for _,sz in ipairs({-1,1}) do
  building(m,CFrame.lookAt(V(x+sx*82.5,0,z+sz*82.5),V(x+sx*150,0,z+sz*150)),24,20,4+index%2,index*20+14+(sx+1)+(sz+1)*2,style)
 end end
 -- Perimeter paths never cross the buildings; courtyard entrances are between facades.
 for _,side in ipairs({-1,1}) do for _,n in ipairs({-70,0,70}) do
  table.insert(walk,V(x+n,4,z+side*101));table.insert(walk,V(x+side*101,4,z+n))
 end end
 table.insert(activities,{position=V(x,4,z),kind="Rest"})
 for _,dx in ipairs({-102,102}) do lamp(m,x+dx,z-60);tree(m,x+dx,z+42,false) end
 if index%2==0 then cafe(m,x+18,z+40,Color3.fromRGB(103,129,108)) end
end
local function oldTown(parent,x,z,index,walk,activities)
 local m=model(parent,"BornLanes_"..index);m:SetAttribute("RefinedFrontages",true);octagon(m,x,z)
 part(m,"OldTownPaving",V(185,.12,185),V(x,.88,z),Color3.fromRGB(179,163,139),Enum.Material.Cobblestone)
 -- Staggered, narrow houses create small lanes and a sheltered café court.
 for row=-1,1 do for col=-2,2 do
  if row==0 and math.abs(col)<2 then continue end
  local px=x+col*37+(row%2)*5;local pz=z+row*65
  local yaw=(row==1 and math.pi or 0)+(col%2==0 and .035 or -.035)
  building(m,CFrame.new(px,0,pz)*CFrame.Angles(0,yaw,0),29,32,2+(index+col+row)%3,index*100+row*10+col,"Born")
 end end
 for n=-2,2 do table.insert(walk,V(x+n*28,4,z+29));table.insert(walk,V(x+n*28,4,z-29)) end
 for _,dx in ipairs({-22,22}) do cafe(m,x+dx,z,Color3.fromRGB(132,77,61));tree(m,x+dx,z+12,false) end
 table.insert(activities,{position=V(x,4,z),kind="Browse"})
 for j=-2,2 do
  local cf=CFrame.new(x+j*25,17,z+27)
  part(m,"FestivalPennant",V(5,3,.12),cf,({cream,terra,Color3.fromRGB(81,144,147)})[(j+2)%3+1],Enum.Material.Fabric,false)
 end
 part(m,"FestivalString",V(120,.08,.08),V(x,18.5,z+27),iron,nil,false)
 sign(m,"CARRER DEL SOL",CFrame.new(x-60,6,z-48),19)
end
local function waterfrontHomes(parent,x,z,index,walk,activities)
 local m=model(parent,"MaritimeQuarter_"..index);m:SetAttribute("RefinedFrontages",true);m:SetAttribute("ColorDistrict","Maritime");octagon(m,x,z)
 for row=-1,1,2 do for j=-2,2 do
  building(m,CFrame.new(x+j*37,0,z+row*59)*CFrame.Angles(0,row==1 and math.pi or 0,0),31,32,2+(j+index)%2,index*100+j+row*10,"Born")
 end end
 for i=-3,3 do
  tree(m,x+i*26,z,true);table.insert(walk,V(x+i*26,4,z+14))
 end
 for _,dx in ipairs({-45,45}) do cafe(m,x+dx,z+26,Color3.fromRGB(74,132,154));table.insert(activities,{position=V(x+dx,4,z+20),kind="Rest"}) end
end
local function landmarkQuarter(parent,x,z,walk,activities)
 local m=model(parent,"TorreLlumQuarter");octagon(m,x,z)
 part(m,"InnovationGarden",V(185,.15,185),V(x,.9,z),Color3.fromRGB(106,135,83),Enum.Material.Grass)
 for _,dx in ipairs({-52,52}) do part(m,"PedestrianWalk",V(15,.1,185),V(x+dx,1,z),stone,Enum.Material.Pavement);table.insert(walk,V(x+dx,4,z)) end
 -- Original tapered glass landmark, a visible orientation point for the east district.
 for level=0,17 do
  local taper=level>12 and (level-12)*2.4 or 0
  cylinder(m,"TowerGlass",23-taper,7.7,V(x,5+level*8,z),Color3.fromRGB(64+level*2,112+level,130+level),Enum.Material.Glass)
  cylinder(m,"TowerSunshade",23.5-taper,.35,V(x,8.6+level*8,z),Color3.fromRGB(159,185,182),Enum.Material.Metal)
 end
 ellipsoid(m,"TowerCrown",V(23,17,23),V(x,146,z),Color3.fromRGB(100,154,170),Enum.Material.Glass)
 for _,dx in ipairs({-75,75}) do for _,dz in ipairs({-70,0,70}) do tree(m,x+dx,z+dz,false) end end
 for _,dz in ipairs({-65,65}) do building(m,CFrame.new(x,0,z+dz)*CFrame.Angles(0,dz>0 and math.pi or 0,0),70,24,2,700+dz,"Modernista") end
 for _,dx in ipairs({-50,50}) do bench(m,CFrame.new(x+dx,0,z+34));table.insert(activities,{position=V(x+dx,4,z+26),kind="Watch"}) end
end
local function fountain(parent,x,z)
 local avoid=part(parent,"FountainNavigation",V(32,9,32),V(x,4,z),stone,nil,false);avoid.Transparency=1;avoid.CanQuery=true
 local modifier=Instance.new("PathfindingModifier");modifier.Label="Fountain";modifier.Parent=avoid
 cylinder(parent,"FountainBasin",15,1,V(x,1.5,z),stone,Enum.Material.Marble)
 cylinder(parent,"FountainWater",13,.2,V(x,2.1,z),Color3.fromRGB(75,166,177),Enum.Material.Glass)
 cylinder(parent,"FountainPedestal",2,5,V(x,4,z),cream,Enum.Material.Marble)
 cylinder(parent,"FountainBowl",6,.7,V(x,6.4,z),stone,Enum.Material.Marble)
 for i=1,8 do local a=i*math.pi/4;local f=part(parent,"WaterJet",V(.15,3,.15),V(x+math.cos(a)*4,4.5,z+math.sin(a)*4),Color3.fromRGB(153,216,218),Enum.Material.Glass,false);f.Transparency=.35 end
end
-- Authored arrival corners keep the fountain approaches open and give the
-- safe spawn its own identity rather than repeating another city block.
local function arrivalPlaza(parent,x,z,walk,activities)
 local m=model(parent,"SolArrivalCorners")
 local teal=Color3.fromRGB(48,119,115)
 local flowerColors={Color3.fromRGB(227,119,145),Color3.fromRGB(245,197,87),Color3.fromRGB(175,147,216),cream}
 -- Flush ceramic bands guide the eye toward the fountain without collision.
 for _,side in ipairs({-1,1}) do
  part(m,"TileBorder",V(1.2,.035,126),V(x+side*67,.925,z),teal,Enum.Material.CeramicTiles,false)
  part(m,"TileBorder",V(126,.035,1.2),V(x,.925,z+side*67),teal,Enum.Material.CeramicTiles,false)
 end
 for i=0,15 do
  local a=i*math.pi/8
  part(m,"SunMosaic",V(2.2,.04,5),CFrame.new(x+math.cos(a)*23,.93,z+math.sin(a)*23)*CFrame.Angles(0,-a+math.pi/2,0),i%2==0 and teal or terra,Enum.Material.CeramicTiles,false)
 end
 local kx,kz=x-64,z-65
 local kiosk=model(m,"FlowerKiosk")
 part(kiosk,"Counter",V(17,3.2,5),V(kx,2.5,kz),teal,Enum.Material.WoodPlanks)
 part(kiosk,"CounterTop",V(18,.3,5.6),V(kx,4.25,kz),cream,Enum.Material.Marble)
 for _,dx in ipairs({-8,8}) do part(kiosk,"CanopyPost",V(.45,7.6,.45),V(kx+dx,4.8,kz+2),iron,Enum.Material.Metal) end
 for stripe=-4,4 do
  part(kiosk,"StripedAwning",V(2.1,.2,9),CFrame.new(kx+stripe*2.1,8.7,kz)*CFrame.Angles(.1,0,0),stripe%2==0 and terra or cream,Enum.Material.Fabric,false).CastShadow=true
  part(kiosk,"AwningValance",V(2.1,1,.15),V(kx+stripe*2.1,7.75,kz+4.5),stripe%2==0 and terra or cream,Enum.Material.Fabric,false)
 end
 sign(kiosk,"FLORS DEL SOL",CFrame.new(kx,2.7,kz+2.9)*CFrame.Angles(0,math.pi,0),14)
 local blossoms={}
 for i=-2,2 do
  cylinder(kiosk,"BouquetPot",.8,1.2,V(kx+i*3,5,kz),terra,Enum.Material.CeramicTiles)
  for j=-1,1 do
   local px=kx+i*3+j*.42
   part(kiosk,"FlowerStem",V(.08,1.2,.08),V(px,6,kz),leaf,nil,false)
   local blossom=ellipsoid(kiosk,"BouquetBlossom",V(.9,.65,.9),V(px,6.6,kz),flowerColors[(i+2)%4+1],Enum.Material.SmoothPlastic)
   table.insert(blossoms,blossom)
  end
 end
 local prompt=Instance.new("ProximityPrompt");prompt.ActionText="Arrange bouquet colors";prompt.ObjectText="Flors del Sol";prompt.KeyboardKeyCode=Enum.KeyCode.F;prompt.MaxActivationDistance=8;prompt.HoldDuration=.4;prompt.Parent=kiosk.Counter
 local arrangement,lastChange=0,0
 prompt.Triggered:Connect(function(player)
  local character=player.Character;local root=character and character:FindFirstChild("HumanoidRootPart");local h=character and character:FindFirstChildOfClass("Humanoid")
  if not root or not h or h.Health<=0 or (root.Position-kiosk.Counter.Position).Magnitude>10 or os.clock()-lastChange<2 then return end
  lastChange=os.clock();arrangement=arrangement%4+1
  for i,blossom in ipairs(blossoms) do blossom.Color=flowerColors[(i+arrangement)%4+1] end
 end)
 local px,pz=x+64,z-65
 local pergola=model(m,"ShadedReadingCorner")
 for _,dx in ipairs({-10,10}) do for _,dz in ipairs({-8,8}) do part(pergola,"PergolaPost",V(.7,10,.7),V(px+dx,5.9,pz+dz),iron,Enum.Material.Metal) end end
 for dx=-10,10,2 do part(pergola,"ShadeSlat",V(.8,.35,18),V(px+dx,11,pz),Color3.fromRGB(144,113,77),Enum.Material.Wood,false).CastShadow=true end
 for _,dz in ipairs({-8,8}) do part(pergola,"ShadeBeam",V(22,.7,.6),V(px,10.6,pz+dz),iron,Enum.Material.Metal,false) end
 bench(pergola,CFrame.new(px,0,pz+5))
 bench(pergola,CFrame.new(px,0,pz-5)*CFrame.Angles(0,math.pi,0))
 for _,point in ipairs({V(kx,4,kz-8),V(kx,4,kz+8),V(px,4,pz)}) do
  table.insert(walk,point);table.insert(activities,{position=point,kind="Watch"})
 end
end
local function square(parent,x,z,name,walk,activities)
 local m=model(parent,name);octagon(m,x,z)
 part(m,"SquareInlay",V(130,.08,130),CFrame.new(x,.86,z)*CFrame.Angles(0,math.pi/4,0),Color3.fromRGB(162,137,113),Enum.Material.Cobblestone)
 local template=name=="Plaça del Sol" and game.ServerStorage:FindFirstChild("MosaicFountainTemplate")
 if template then
  local avoid=part(m,"FountainNavigation",V(32,9,32),V(x,4,z),stone,nil,false);avoid.Transparency=1;avoid.CanQuery=true
  local modifier=Instance.new("PathfindingModifier");modifier.Label="Fountain";modifier.Parent=avoid
  require(script.Parent.Fountain).create(template,m,V(x,1,z))
 else fountain(m,x,z) end
 for i=1,8 do local a=i*math.pi/4;local px,pz=x+math.cos(a)*58,z+math.sin(a)*58
  tree(m,px,pz,false);bench(m,CFrame.lookAt(V(x+math.cos(a)*43,0,z+math.sin(a)*43),V(x,0,z)))
  table.insert(walk,V(x+math.cos(a)*32,4,z+math.sin(a)*32));table.insert(activities,{position=V(x+math.cos(a)*32,4,z+math.sin(a)*32),kind="Watch"})
 end
 for i=1,4 do cafe(m,x-75+i*30,z+81,Color3.fromRGB(116,93,70)) end
 sign(m,name:upper(),CFrame.new(x,7,z+98),34)
 if name=="Plaça del Sol" then arrivalPlaza(m,x,z,walk,activities) end
 return m
end
local function basilica(parent,x,z)
 local m=model(parent,"BasilicaDelSol")
 part(m,"BasilicaNave",V(70,50,112),V(x,26,z),Color3.fromRGB(191,165,123),Enum.Material.Limestone)
 for _,dx in ipairs({-30,-10,10,30}) do
  
  for tier=0,4 do cylinder(m,"CarvedSpire",6-tier*.9,18,V(x+dx,57+tier*18,z+49),stone,Enum.Material.Limestone) end
  ellipsoid(m,"MosaicFinial",V(5,12,5),V(x+dx,145,z+49),Color3.fromRGB(222,175,74),Enum.Material.CeramicTiles)
 end
 for _,side in ipairs({-1,1}) do for j=-3,3 do
