 part(m,"PaintedSky",V(3.6,1.4,.04),V(-647,5.6,171.15),Color3.fromRGB(128,202,220),nil,false)
 part(m,"PaintedSea",V(3.6,1,.04),V(-647,4.45,171.15),Color3.fromRGB(62,143,166),nil,false)
 part(m,"PaintedSun",V(.55,.55,.05),V(-648,5.9,171.19),Color3.fromRGB(247,197,95),nil,false).Shape=Enum.PartType.Ball
 for i=1,4 do part(m,"PaintedHomes",V(.55,.6+i*.08,.05),V(-648.4+i*.65,4.95,171.2),palette[i],nil,false) end
 return {
  {role="CafeWorker",name="Júlia Ferrer",stations={{position=V(-480,4,399),lookAt=V(-460,3,399),action="Preparing coffee"},{position=V(-491,4,435),lookAt=V(-488,3,439),action="Serving the terrace"}}},
  {role="Sanitation",name="Biel Roca",stations={{position=V(262,4,406),lookAt=V(262,3,412),action="Sweeping the promenade"},{position=V(182,4,406),lookAt=V(182,3,412),action="Restocking the bins"},{position=V(22,4,406),lookAt=V(22,3,412),action="Checking the street furniture"}}},
  {role="BeachWorker",name="Nora Marín",stations={{position=V(-577,4,521),lookAt=V(-579,2,525),action="Checking beach loungers"},{position=V(-500,4,471),lookAt=V(-502,2,475),action="Tidying the beach"}}},
  {role="Busker",name="Èric Sol",stations={{position=V(150,5.5,426),lookAt=V(150,4,409),action="Playing for the promenade"}}},
  {role="Soccer",name="Nick Booty",quests={"nick"},stations={{position=V(602,4,580),lookAt=V(628,3,585)}}},
  {role="Gardener",name="Mar Soler",quests={"garden","beach"},stations=beds},
  {role="Artist",name="Laia Costa",stations={{position=artist,lookAt=V(-647,5,171)}}},
  {role="Vendor",name="Pau Vidal",quests={"delivery"},stations={{position=V(85,4,-52),lookAt=V(85,4,-60)},{position=V(91,4,-52),lookAt=V(91,4,-60)}}},
 }
end
function City.Build(parent)
 if Config.CompactCity then return CompactCity.Build(parent) end
 rng=Random.new(230926)
 local walk,activities={},{}
 local ground=part(parent,"CityLand",V(1440,3,1200),V(0,-1.6,0),Color3.fromRGB(126,139,108),Enum.Material.Ground)
 ground:SetAttribute("GroundSurface",true)
 local backdrop=model(parent,"CoastalBackdrop")
 backdrop.ModelStreamingMode=Enum.ModelStreamingMode.Persistent
 -- Distant scenery is deliberately low-detail and outside the playable city.
 -- Tiles stay below the engine's part-size limit; a single giant slab was clamped.
 for x=-2000,2000,2000 do for z=-1600,-3600,-2000 do
  part(backdrop,"Mainland",V(2000,10,2000),V(x,-7,z),Color3.fromRGB(105,127,91),Enum.Material.Grass,false)
 end end
 for _,side in ipairs({-1,1}) do
  part(backdrop,"OuterCityVerge",V(496,4,1000),V(side*982,-2,-100),Color3.fromRGB(126,139,108),Enum.Material.Ground,false)
  for i=0,4 do
   ellipsoid(backdrop,"CoastalFoothill",V(540,130+i*24,540),V(side*(1040+i%2*100),-40,-460+i*200),Color3.fromRGB(109+i*3,133+i*2,94),Enum.Material.Grass)
  end
  ellipsoid(backdrop,"CoastalSandSpit",V(220,12,310),V(side*810,-5,495),Color3.fromRGB(227,208,156),Enum.Material.Sand)
  -- Rocky headlands frame the beach without covering its swimming entrance.
  for i=0,6 do
   local z=410+i*43;local x=side*(789+i*17)
   local rock=ellipsoid(backdrop,"CoastalLimestone",V(74-i*3,34-i*2,82),V(x,-6,z),Color3.fromRGB(161+i*3,154+i*2,130+i*2),Enum.Material.Rock)
   rock.CFrame*=CFrame.Angles(.07*i,side*(.2+i*.17),.05*i)
   ellipsoid(backdrop,"LimestoneOutcrop",V(28,18+i%3*5,32),V(x-side*22,-2,z+18),Color3.fromRGB(175,168,147),Enum.Material.Rock)
   rock:SetAttribute("BackdropOnly",true)
  end
 end
 for i=-5,5 do
  ellipsoid(backdrop,"CollserolaRidge",V(1300,480+(i%3)*80,1400),V(i*490,-175,-2350-math.abs(i)*70),Color3.fromRGB(105,129,106),Enum.Material.Grass)
 end
 local roads=model(parent,"Boulevards")
 for x=-720,720,240 do part(roads,"TrafficAvenue",V(28,.2,960),V(x,0,-120),Color3.fromRGB(64,65,61),Enum.Material.Asphalt) end
 for z=-600,360,240 do part(roads,"TrafficStreet",V(1440,.2,28),V(0,.01,z),Color3.fromRGB(64,65,61),Enum.Material.Asphalt) end
 for x=-700,700,24 do for _,z in ipairs({-360,120,360}) do part(roads,"LaneMark",V(10,.03,.16),V(x,.14,z),cream,nil,false) end end
 for x=-480,480,240 do for z=-360,360,240 do
  for d=-8,8,4 do part(roads,"Crosswalk",V(2,.03,7),V(x+d,.15,z+21),cream,nil,false);part(roads,"Crosswalk",V(7,.03,2),V(x+21,.15,z+d),cream,nil,false) end
 end end
 local index=0
 for z=-480,240,240 do for x=-600,600,240 do
  index+=1
  if x==-600 and z==240 then square(parent,x,z,"Plaça del Sol",walk,activities)
  elseif x==-120 and z==0 then square(parent,x,z,"Plaça Central",walk,activities)
  elseif x==120 and z==0 then market(parent,x,z,walk,activities)
  elseif x==120 and z==-240 then
   local m=model(parent,"BasilicaSquare");octagon(m,x,z);basilica(m,x,z)
   for _,dx in ipairs({-93,93}) do table.insert(walk,V(x+dx,4,z));tree(m,x+dx,z+60,false) end
  elseif x==-360 and z==240 then
   local m=model(parent,"RamblaGardens");octagon(m,x,z)
   part(m,"RamblaWalk",V(50,.15,200),V(x,1,z),Color3.fromRGB(221,202,164),Enum.Material.Cobblestone)
   for n=-80,80,32 do tree(m,x-35,z+n,false);tree(m,x+35,z+n,false);bench(m,CFrame.new(x+22,0,z+n));table.insert(walk,V(x,4,z+n));table.insert(activities,{position=V(x,4,z+n),kind="Watch"}) end
  elseif x==600 and z==-240 then landmarkQuarter(parent,x,z,walk,activities)
  elseif x>=360 and z==0 then oldTown(parent,x,z,index,walk,activities)
  elseif x>=120 and z==240 then waterfrontHomes(parent,x,z,index,walk,activities)
  else block(parent,x,z,index,(x<0 and z<0) and "Modernista" or (x>300 and z>0) and "Born" or "Eixample",walk,activities) end
 end end
 coast(parent,walk,activities)
 -- Continuous border markings stay flat; warning plaques are on pedestrian corners.
 local red=Color3.fromRGB(209,107,83)
 for _,x in ipairs({-480,480}) do part(parent,"PvPPavingBoundary",V(.45,.04,720),V(x,.19,0),red,nil,false) end
 for _,z in ipairs({-360,360}) do part(parent,"PvPPavingBoundary",V(960,.04,.45),V(0,.19,z),red,nil,false) end
 for _,x in ipairs({-448,448}) do for _,z in ipairs({-332,332}) do sign(parent,"ARENA DISTRICT • PvP",CFrame.new(x,5,z),24) end end
 local quests=Instance.new("Folder");quests.Name="QuestObjects";quests.Parent=parent
 local function marker(name,kind,pos,text)
  local p=part(quests,name,V(1,1.6,1),pos,kind=="Litter" and Color3.fromRGB(65,145,143) or Color3.fromRGB(226,181,83),Enum.Material.Glass,false);p:SetAttribute("QuestAction",kind)
  local prompt=Instance.new("ProximityPrompt");prompt.ActionText=text;prompt.ObjectText=name;prompt.KeyboardKeyCode=Enum.KeyCode.F;prompt.MaxActivationDistance=10;prompt.HoldDuration=.25;prompt.RequiresLineOfSight=false;prompt.Parent=p
  return p
 end
 for i=1,6 do marker("Bottle"..i,"Litter",V(-380+i*115,1.9,535+(i%2)*25),"Collect bottle") end
 marker("CoffeeOrder","Pickup",V(-480,2,414),"Pick up coffee")
 for _,stop in ipairs(require(game.ReplicatedStorage.Shared.Config).DeliveryStops) do
  local destination=marker(stop.id,"Dropoff",stop.position,"Deliver coffee")
  destination:SetAttribute("DeliveryStop",stop.id);destination.ProximityPrompt.ObjectText=stop.name
 end
 marker("BoardwalkStart","RaceStart",V(-240,2,403),"Start 25s dash")
 marker("PierFinish","RaceFinish",V(240,2,403),"Finish dash")
 -- Boundaries sit outside street edges, never across an interior road.
 for _,x in ipairs({-725,725}) do part(parent,"MapEdge",V(2,140,1210),V(x,68,0),dark).Transparency=1 end
 -- The southern shore opens into the lifeguard-bounded swimming area.
 part(parent,"MapEdge",V(1450,140,2),V(0,68,-605),dark).Transparency=1
 return {jobs=workplaces(parent),walk=walk,activities=activities,spawn=CFrame.new(-600,4,210)}
end
-- Small review scene; never called by gameplay world generation.
function City.BuildFrontageSample(parent)
 parent:SetAttribute("RefinedFrontages",true)
 part(parent,"ReviewSidewalk",V(170,1,65),V(0,0,0),stone,Enum.Material.Pavement)
 for i=0,3 do building(parent,CFrame.new(-60+i*40,0,8),34,25,3+i%2,800+i,"Eixample") end
 for _,x in ipairs({-78,78}) do tree(parent,x,-15,false);lamp(parent,x,-22) end
end
return City
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="28">
      <Properties>
        <string name="Name">CombatRules</string>
        <string name="Source"><![CDATA[local Config=require(game:GetService("ReplicatedStorage").Shared.Config)
local Rules={}
function Rules.CanCast(session,sound,now)
 return sound~=nil and sound.level<=session.data.level and now>=session.protectedUntil and now>=session.dodgingUntil and now>=session.nextCast and now>=(session.knockedUntil or 0)
end
function Rules.CanTarget(attackerPosition,targetPosition,targetProtectedUntil,now,radius)
 return Config.InArena(attackerPosition) and Config.InArena(targetPosition) and now>=targetProtectedUntil and (targetPosition-attackerPosition).Magnitude<=radius
end
function Rules.InBeam(origin,direction,target,length,width,targetRadius)
 local delta=target-origin;local along=delta:Dot(direction)
 if along<0 or along>length then return false end
 return (delta-direction*along).Magnitude<=width/2+(targetRadius or 0)
end
function Rules.VehicleSweep(previous,nextFrame,target,halfSize)
 local a=previous:PointToObjectSpace(target);local b=nextFrame:PointToObjectSpace(target)
 local delta=b-a;local enter,leave=0,1
 for _,axis in ipairs({"X","Y","Z"}) do
  local origin,speed,extent=a[axis],delta[axis],halfSize[axis]
  if math.abs(speed)<.00001 then if math.abs(origin)>extent then return false end
  else
   local near,far=(-extent-origin)/speed,(extent-origin)/speed
   if near>far then near,far=far,near end
   enter=math.max(enter,near);leave=math.min(leave,far);if enter>leave then return false end
  end
 end
 return true
end
return Rules
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="29">
      <Properties>
        <string name="Name">Commerce</string>
        <string name="Source"><![CDATA[-- Separate atomic purchase ledger: gameplay profile snapshots never write it.
local Marketplace=game:GetService("MarketplaceService")
local Players=game:GetService("Players")
local Run=game:GetService("RunService")
local Http=game:GetService("HttpService")
local Catalog=require(game:GetService("ReplicatedStorage").Shared.ShopCatalog)
local Ledger=require(game:GetService("ReplicatedStorage").Shared.BoostLedger)
local Config=require(game:GetService("ReplicatedStorage").Shared.Config)
local Entitlements=require(script.Parent.Entitlements)
local Commerce={}
local cache,locks,promptAt={},{},{}
local loadAt,activateAt={},{}
-- PlayerRemoving can precede Parent clearing; never admit that same object again.
local departed=setmetatable({},{__mode="k"})
local function live(player) return player.Parent~=nil and not departed[player] end
local allowed,changed,store
local function database()
 if Run:IsStudio() then return end
 if not store then
  local ok,value=pcall(function() return game:GetService("DataStoreService"):GetDataStore("ScreamSimulator_Purchases_v1") end)
  if ok then store=value end
 end
 return store
end
local function transact(player,transform)
 if not live(player) then return false end
 local db=database();if not db then return false end
 local id=player.UserId
 while locks[id] do
  if not live(player) or not allowed(player) then return false end
  task.wait(.05)
 end
 -- A leave, unavailable profile or test command may have happened while waiting.
 if not live(player) or not allowed(player) then return false end
 locks[id]=true
 local success,result
 for attempt=1,3 do
  success,result=pcall(function() return db:UpdateAsync("Player_"..id,transform) end)
  if success then break end
  task.wait(attempt)
 end
 if success and result then
  if live(player) then cache[player]=Ledger.Normalize(result) end
 elseif not success then cache[player]=nil end -- never grant from an ambiguous write
 locks[id]=nil
 return success and result~=nil
end
function Commerce.Load(player)
 if not live(player) or not database() or not allowed(player) then return end
 if os.clock()<(loadAt[player] or 0) or locks[player.UserId] then return end
 loadAt[player]=os.clock()+15
 local ok=transact(player,Ledger.Normalize)
 if ok and live(player) then changed(player) end
end
function Commerce.Status(player)
 local d=live(player) and cache[player] or nil
 return {ready=d~=nil and allowed(player),inventory=d and d.inventory or {xp=0,coins=0},ends=d and d.ends or {xp=0,coins=0},serverNow=os.time()}
end
function Commerce.Multiplier(player,kind) return Ledger.Multiplier(live(player) and cache[player] or nil,kind,os.time()) end
function Commerce.Busy(player) return locks[player.UserId]==true end
function Commerce.Activate(player,kind)
 if not live(player) or (kind~="xp" and kind~="coins") or not allowed(player) or not cache[player] then return end
 if os.clock()<(activateAt[player] or 0) or locks[player.UserId] then return end
 activateAt[player]=os.clock()+2
 local operation=Http:GenerateGUID(false);local started=os.time()
 local ok=transact(player,function(raw)
  local data=Ledger.Activate(raw,kind,operation,started,os.time())
  return data -- UpdateAsync's second return is user IDs, not a status string.
 end)
 if live(player) then changed(player,ok and "Boost activated · 30 minutes added" or "Boost not activated. Check your inventory and try again.",nil,not ok) end
end
function Commerce.Prompt(player,key)
 if not live(player) then return end
 local item=Catalog.Get(key)
 if not item or Run:IsStudio() or not allowed(player) then changed(player,"Purchases are unavailable in this session.",nil,true);return end
 local id=item.key=="Movement" and Config.MovementPassId or item.id
 if type(id)~="number" or id<=0 then changed(player,"This unlock is coming soon.",nil,true);return end
 if os.clock()<(promptAt[player] or 0) then return end
 promptAt[player]=os.clock()+3
 if item.kind=="product" and not cache[player] then changed(player,"Loading your purchases. Please try again.",nil,true);task.spawn(Commerce.Load,player);return end
 if item.kind=="product" then
  local count=0;for _ in pairs(cache[player].receipts) do count+=1 end
  if Catalog.Product(id)~=item or count>=Ledger.ReceiptLimit or math.max(os.time(),cache[player].ends[item.boost])>Ledger.MaxExpiry-Ledger.Duration then
   changed(player,"This purchase is currently unavailable.",nil,true);return
  end
 end
 if item.key=="Spectrum" and Entitlements.HasSpectrum(player) or item.key=="Movement" and Entitlements.HasMovement(player) then return end
 local ok=pcall(function()
  if item.kind=="pass" then Marketplace:PromptGamePassPurchase(player,id)
  else Marketplace:PromptProductPurchase(player,id) end
 end)
 if not ok and live(player) then changed(player,"Roblox could not open this purchase. Please try again.",nil,true) end
end
function Commerce.Start(canPurchase,onChanged)
 assert(not allowed,"Commerce already started")
 allowed=canPurchase;changed=onChanged
 Marketplace.ProcessReceipt=function(receipt)
  local item=Catalog.Product(receipt.ProductId)
  local player=Players:GetPlayerByUserId(receipt.PlayerId)
  if not item or not player or not live(player) or Run:IsStudio() or not allowed(player) then return Enum.ProductPurchaseDecision.NotProcessedYet end
  local ok=transact(player,function(raw)
   local data=Ledger.GrantActive(raw,receipt.PurchaseId,item.boost,os.time())
   return data
  end)
  if not ok then return Enum.ProductPurchaseDecision.NotProcessedYet end
  if live(player) then changed(player,"Boost purchase processed. Check the shop for your current boost status.") end
  return Enum.ProductPurchaseDecision.PurchaseGranted
 end
 Players.PlayerRemoving:Connect(function(player) departed[player]=true;cache[player]=nil;promptAt[player]=nil;loadAt[player]=nil;activateAt[player]=nil end)
end
return Commerce
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="30">
      <Properties>
        <string name="Name">CompactCity</string>
        <string name="Source"><![CDATA[-- Compact runtime city; source draft and preserved original remain separate.
local Layout=require(game:GetService("ReplicatedStorage").Shared.CompactLayout)
local City={}
local V=Vector3.new
local function part(parent,name,size,position,color,collidable)
 local p=Instance.new("Part");p.Name=name;p.Size=size;p.Position=position;p.Color=color
 p.Material=Enum.Material.SmoothPlastic;p.Anchored=true;p.CanCollide=collidable;p.CanTouch=false;p.CanQuery=true;p.Parent=parent
 return p
end
local function prompt(p,kind,text,object)
 p:SetAttribute("QuestAction",kind)
 local pr=Instance.new("ProximityPrompt");pr.ActionText=text;pr.ObjectText=object or p.Name;pr.KeyboardKeyCode=Enum.KeyCode.F
 pr.MaxActivationDistance=10;pr.HoldDuration=kind=="Garden" and 1.5 or .25;pr.RequiresLineOfSight=false;pr.Parent=p
end
local function wayfinding(parent,name,position,text)
 local anchor=part(parent,name,V(.2,.2,.2),position,Color3.fromRGB(255,203,99),false)
 anchor.Transparency=1;anchor.CanQuery=false
 -- Only the arena's meaningful PvP boundary label remains; no mic tutorial signs.
 anchor.Size=V(.2,3,39)
 local gui=Instance.new("SurfaceGui");gui.Face=Enum.NormalId.Left
 gui.SizingMode=Enum.SurfaceGuiSizingMode.FixedSize;gui.CanvasSize=Vector2.new(600,100)
 gui.LightInfluence=0;gui.MaxDistance=65;gui.AlwaysOnTop=false
 gui.Name="Wayfinding";gui.Parent=anchor
 local label=Instance.new("TextLabel");label.Name="Text";label.Size=UDim2.fromScale(1,1)
 label.BackgroundColor3=Color3.fromRGB(30,48,54);label.BackgroundTransparency=1;label.TextColor3=Color3.fromRGB(255,243,214)
 label.TextSize=36;label.TextWrapped=true;label.Font=Enum.Font.GothamBold;label.Text=text;label.Parent=gui
end
-- Original, static coastal-academy art. None of these pieces participate in hits,
-- navigation, touch events or quest state. Existing solid silhouettes remain opaque.
local function academyArt(parent,byId)
 local art=Instance.new("Folder");art.Name="CoastalAcademyArt";art.Parent=parent
 local ivory=Color3.fromRGB(239,224,190)
 local slate=Color3.fromRGB(42,65,72)
 local gold=Color3.fromRGB(244,188,75)
 local terracotta=Color3.fromRGB(166,91,69)
 local seam=Color3.fromRGB(197,187,159)
 local count=0
 local function detail(name,size,position,color,shape)
  count+=1
  local p=part(art,name,size,position,color,false)
  p.CanQuery=false
  p.CastShadow=false
  if shape then p.Shape=shape end
  return p
 end
 -- The original full solid tree crowns remain: rounded lobes dress, not replace,
 -- their collision silhouette. All canopy additions are above walking/head height.
 for i=0,7 do
  local crown=byId["TreeCrown"..i];local pos=crown.Position
  crown.Color=Color3.fromRGB(77,116,92)
  detail("CanopyCrown"..i,V(18,12,18),V(pos.X,pos.Y+1,pos.Z),Color3.fromRGB(91,133,101),Enum.PartType.Ball)
  detail("CanopyLight"..i,V(12,10,12),V(pos.X-4,pos.Y+4,pos.Z-2),Color3.fromRGB(120,151,109),Enum.PartType.Ball)
  detail("CanopyShade"..i,V(13,10,13),V(pos.X+4,pos.Y,pos.Z+3),Color3.fromRGB(66,104,85),Enum.PartType.Ball)
  local base=byId["Planter"..i].Position
  detail("PlanterRimN"..i,V(10.5,.45,.5),V(base.X,3.1,base.Z-5),ivory)
  detail("PlanterRimS"..i,V(10.5,.45,.5),V(base.X,3.1,base.Z+5),ivory)
  detail("PlanterRimW"..i,V(.5,.45,9.5),V(base.X-5,3.1,base.Z),ivory)
  detail("PlanterRimE"..i,V(.5,.45,9.5),V(base.X+5,3.1,base.Z),ivory)
 end
 -- Architecture is dressed within its existing footprint: deeper cornices,
 -- recessed-looking dark windows, warm sills and facade pilasters.
 for i=0,4 do
  local x=-90+i*60
  detail("MarketCornice"..i,V(44,.8,1),V(x,21,-250.8),ivory)
  detail("MarketBase"..i,V(44,2,.35),V(x,1,-250.7),ivory)
  for _,dx in ipairs({-20,20})do
   detail("MarketPilaster"..i.."_"..dx,V(1.4,20,.4),V(x+dx,11,-250.6),ivory)
  end
  for j=0,2 do
   local wx=x-12+j*12
   detail("MarketSill"..i.."_"..j,V(7,.6,.8),V(wx,10.8,-250.3),ivory)
   detail("MarketLintel"..i.."_"..j,V(7,.6,.55),V(wx,17.3,-250.4),ivory)
   detail("MarketMullion"..i.."_"..j,V(.3,6,.4),V(wx,14,-250.5),ivory)
  end
  -- Awning stripes sit on its top, leaving the existing underside/headroom alone.
  for j=0,5 do
   detail("AwningStripe"..i.."_"..j,V(3,.035,8),V(x-15+j*6,8.52,-247),ivory)
  end
  detail("MarketRoofLip"..i,V(47,.5,.45),V(x,23.15,-249.1),terracotta)
 end
 for i=0,3 do
  local z=-135+i*70
  detail("OldTownCornice"..i,V(.7,1,44),V(257.8,24.5,z),ivory)
  detail("OldTownBase"..i,V(.4,2,44),V(257.7,1,z),ivory)
  for _,dz in ipairs({-20,20})do
   detail("OldTownPilaster"..i.."_"..dz,V(.4,23,1.4),V(257.6,13,z+dz),ivory)
  end
  for j=0,2 do
   local wz=z-12+j*12
   detail("OldTownSill"..i.."_"..j,V(.8,.6,8),V(257.3,12.2,wz),ivory)
   detail("OldTownLintel"..i.."_"..j,V(.6,.6,8),V(257.4,19.8,wz),ivory)
   detail("OldTownMullion"..i.."_"..j,V(.4,7,.3),V(257.5,16,wz),ivory)
  end
 end
 -- A distinctive twin-spire skyline on the existing basilica mass, never in a lane.
 for _,x in ipairs({256,294})do
  detail("TowerBelt"..x,V(10.6,1.5,12.6),V(x,48,-262),ivory)
  detail("TowerCrown"..x,V(9,5,11),V(x,62.5,-262),ivory)
  detail("TowerCap"..x,V(6,5,8),V(x,67.5,-262),terracotta)
  detail("TowerLantern"..x,V(3,3,3),V(x,71.5,-262),gold,Enum.PartType.Ball)
 end
 detail("BasilicaFacadeBand",V(48,1,.4),V(275,27,-237.7),ivory)
 -- Portal dressing follows existing gate posts/beam, retaining the 36-stud opening.
 for _,z in ipairs({30,70})do
  detail("ArenaPostFace"..z,V(.35,11,3.5),V(-122.2,6,z),slate)
  detail("ArenaPostAccent"..z,V(.4,7,.6),V(-122.4,7,z),gold)
  detail("ArenaPostCrown"..z,V(4.8,2,4.8),V(-120,15,z),ivory)
 end
 detail("ArenaFascia",V(.35,3,39),V(-122.2,13.5,50),slate)
 detail("ArenaFasciaBand",V(.4,.5,39),V(-122.4,15.3,50),gold)
 -- An overhead voice crest gives the entrance an identity without false cover.
 for _,z in ipairs({34,66})do
  detail("AcademySignSupport"..z,V(.7,3,1),V(-120,15.5,z),slate)
 end
 local academySign=detail("AcademyNameplate",V(.8,4,37),V(-120,19,50),slate)
 detail("AcademySignTop",V(.95,.35,37.5),V(-120,21.15,50),gold)
 detail("AcademySignBottom",V(.95,.35,37.5),V(-120,16.85,50),gold)
 detail("AcademyCrestRim",V(.6,10,10),V(-120,26,50),gold,Enum.PartType.Cylinder)
 for _,side in ipairs({-1,1})do
  detail("AcademyCrestFace"..side,V(.1,8.5,8.5),V(-120+side*.36,26,50),slate,Enum.PartType.Cylinder)
  for i,height in ipairs({2.4,4.5,6.4,4.5,2.4})do
   detail("AcademyVoiceBar"..side.."_"..i,V(.16,height,.85),V(-120+side*.49,26,50+(i-3)*1.5),i==3 and gold or ivory)
  end
  local gui=Instance.new("SurfaceGui");gui.Name="AcademySign"..side
  gui.Face=side<0 and Enum.NormalId.Left or Enum.NormalId.Right
  gui.SizingMode=Enum.SurfaceGuiSizingMode.FixedSize;gui.CanvasSize=Vector2.new(600,72)
  gui.LightInfluence=0;gui.MaxDistance=140;gui.AlwaysOnTop=false;gui.Parent=academySign
  local text=Instance.new("TextLabel");text.Name="AcademyName";text.Size=UDim2.fromScale(1,1)
  text.BackgroundTransparency=1;text.Text="SCREAM ACADEMY";text.TextColor3=ivory
  text.Font=Enum.Font.GothamBold;text.TextSize=50;text.TextWrapped=false;text.Parent=gui
 end
 -- Calm ground articulation: small cross-joints, never new borders resembling
 -- a damage or collision boundary. Route strips remain above.
 for z=-140,140,20 do
  detail("CourtyardJoint"..z,V(178,.012,.18),V(-260,.087,z),seam)
 end
 for x=-340,340,20 do
  detail("PromenadeJoint"..x,V(.18,.012,39),V(x,.097,200),seam)
 end
 -- Existing cover gets a clearly solid plinth/top and restrained paneling, wholly
 -- within 0.08 studs of its solid silhouette, without widening useful cover.
 for i=0,7 do
  local c=byId["CoverCore"..i];local pos=c.Position
  c.Color=slate
  detail("CoverTop"..i,V(11.8,.06,11.8),V(pos.X,6.04,pos.Z),ivory)
  detail("CoverFront"..i,V(10,.5,.08),V(pos.X,4.8,pos.Z-6.02),gold)
 end
 -- Foreground courtyard, spawn plaza, and promenade dressing (41 static cosmetic parts).
 -- Positioned outside route strips, pads, NPC stations, and overhead sign sightlines.
 for i,pos in ipairs({
  V(-280,0,114),V(-260,0,114),V(-280,0,74),V(-260,0,74),
  V(-255,0,28),V(-235,0,28),V(-156,0,40),V(-156,0,60),
 }) do
  detail("ForegroundBollardPost"..i,V(1.1,4.2,1.1),V(pos.X,2.18,pos.Z),slate)
  detail("ForegroundBollardLantern"..i,V(1.5,.85,1.5),V(pos.X,4.705,pos.Z),gold)
 end
 detail("ForegroundPlazaTrimW",V(1.2,.015,26),V(-288,.088,135),terracotta)
 detail("ForegroundPlazaTrimE",V(1.2,.015,26),V(-252,.088,135),terracotta)
 detail("ForegroundPlazaTrimS",V(37.2,.015,1.2),V(-270,.088,148),terracotta)
 detail("ForegroundPlazaAccentS",V(32,.016,.5),V(-270,.089,146.5),ivory)
 detail("ForegroundPromenadeCurb1",V(68,.28,1),V(-270,.22,179.4),terracotta)
 detail("ForegroundPromenadeCurb2",V(114,.28,1),V(-107,.22,179.4),terracotta)
 detail("ForegroundPromenadeCurb3",V(160,.28,1),V(40,.22,179.4),terracotta)
 detail("ForegroundPromenadeCurb4",V(80,.28,1),V(170,.22,179.4),terracotta)
 detail("ForegroundPromenadeInlay1",V(68,.014,.5),V(-270,.089,178.4),ivory)
 detail("ForegroundPromenadeInlay2",V(114,.014,.5),V(-107,.089,178.4),ivory)
 for i,cx in ipairs({-304,-230}) do
  detail("ForegroundPlanterBase"..i,V(13,1.4,7),V(cx,.78,92),terracotta)
  detail("ForegroundPlanterRim"..i,V(13.8,.35,7.8),V(cx,1.655,92),ivory)
  detail("ForegroundPlanterFoliage"..i,V(11.4,1.1,5.4),V(cx,2.0,92),Color3.fromRGB(77,116,92))
  detail("ForegroundPlanterAccent"..i,V(7.6,.6,2.8),V(cx,2.75,92),i==1 and Color3.fromRGB(221,131,142) or gold)
 end
 detail("ForegroundGatewayPillarN",V(2.4,8.5,2.4),V(-196,4.33,34),ivory)
 detail("ForegroundGatewayPillarS",V(2.4,8.5,2.4),V(-196,4.33,66),ivory)
 detail("ForegroundGatewayCapN",V(3,.9,3),V(-196,9.03,34),terracotta)
 detail("ForegroundGatewayCapS",V(3,.9,3),V(-196,9.03,66),terracotta)
 for i,x in ipairs({-325,-165,165}) do
  detail("ForegroundCoastalRock"..i,V(6.4,2.6,5.2),V(x,1.4,278),Color3.fromRGB(104,112,122))
 end
 -- Clear value hierarchy without lighting/post-effect changes.
 byId.ArenaFloor.Color=Color3.fromRGB(126,147,145)
 byId.HubPaving.Color=Color3.fromRGB(224,214,188)
 byId.Promenade.Color=Color3.fromRGB(220,204,174)
 assert(count<=350,"Coastal art budget exceeded")
end
function City.Build(parent)
 local byId={}
 for _,spec in ipairs(Layout.PartSpecs) do
  local p=part(parent,spec.id,spec.size,spec.position,spec.color,spec.collidable);byId[spec.id]=p
  if spec.id=="Ground" then p:SetAttribute("GroundSurface",true) end
 end
 local guidance=Instance.new("Folder");guidance.Name="FirstMinuteGuidance";guidance.Parent=parent
 for _,spec in ipairs(Layout.GuidanceSpecs) do
  local p=part(guidance,spec.id,spec.size,spec.position,spec.color,false)
  p.CanQuery=false;p.CastShadow=false;p.Transparency=0
 end
 wayfinding(parent,"ArenaWayfinding",V(-122.6,13.5,50),"BEAM ARENA\nPVP INSIDE RED LINES")
 local quests=Instance.new("Folder");quests.Name="QuestObjects";quests.Parent=parent
 for _,spec in ipairs(Layout.QuestMarkers) do
  local p=part(quests,spec.id,V(1,1.6,1),spec.position,Color3.fromRGB(226,181,83),false)
  prompt(p,spec.action,spec.text,spec.action=="Garden" and "Community garden" or nil)
 end
 for _,stop in ipairs(Layout.DeliveryStops) do
  local p=part(quests,stop.id,V(1,1.6,1),stop.position,Color3.fromRGB(226,181,83),false)
  p:SetAttribute("DeliveryStop",stop.id);prompt(p,"Dropoff","Deliver coffee",stop.name)
 end
 -- Net is cosmetic and non-colliding; authoritative ball rules live in BeachVolley.
 local net=part(parent,"VolleyNet",V(40,4,.2),V(-20,6,250),Color3.fromRGB(235,235,220),false);net.Transparency=.6
 for _,x in ipairs({-41,1}) do part(parent,"VolleyPost",V(.5,9,.5),V(x,4.5,250),Color3.fromRGB(235,235,220),true) end
 -- Decorative practice goal only; local resident animation never scores or collides.
 local practiceGoal=Layout.Soccer.practiceGoal
 for _,spec in ipairs({
  {name="NickPracticeGoalLeft",size=V(.35,7,.35),position=V(practiceGoal.X-8,3.5,practiceGoal.Z-1)},
  {name="NickPracticeGoalRight",size=V(.35,7,.35),position=V(practiceGoal.X+8,3.5,practiceGoal.Z-1)},
  {name="NickPracticeGoalCrossbar",size=V(16,.35,.35),position=V(practiceGoal.X,7,practiceGoal.Z-1)},
 }) do
  local goal=part(parent,spec.name,spec.size,spec.position,Color3.fromRGB(235,235,220),false)
  goal.CanQuery=false;goal.CanTouch=false;goal.CastShadow=false
 end
 academyArt(parent,byId)
 local walk,activities={},{}
 for _,point in ipairs(Layout.Walk) do table.insert(walk,point);table.insert(activities,{position=point,kind="Stroll"}) end
 local function station(x,z,lookX,lookZ,action)return {position=V(x,3,z),lookAt=V(lookX or x,3,lookZ or z-5),action=action} end
 local jobs={
  {role="Gardener",name="Mar Soler",quests={"garden","beach"},stations={station(-325,-250,-325,-270,"Watering flowers"),station(-295,-250,-295,-270,"Watering flowers"),station(-265,-250,-265,-270,"Watering flowers")}},
  {role="Vendor",name="Pau Vidal",quests={"delivery"},stations={station(30,-225,30,-247,"Arranging produce")}},
  {role="CafeWorker",name="Julia Ferrer",stations={station(42,-225,30,-225,"Preparing coffee")}},
  {role="Soccer",name="Nick Booty",quests={"nick"},stations={station(239,281,practiceGoal.X,practiceGoal.Z-1,"Practicing missed kicks")}},
  {role="Busker",name="Eric Sol",quests={"crowd"},stations={station(Layout.Ambience.buskerPosition.X,Layout.Ambience.buskerPosition.Z,-310,140,"Playing for the courtyard")}},
  {role="Commuter",name="Boardwalk runner",quests={"sprint"},stations={station(-220,190,-220,200,"Waiting by the promenade")}},
  {role="Fighter",name="Arena coach",quests={"dodge","arena"},stations={station(-137,40,-100,50,"Watching the arena")}},
 }
 return {walk=walk,activities=activities,spawn=CFrame.new(Layout.Spawn),jobs=jobs,
  seeds={{-310,130,role="Local"},{-310,140,role="Local"},{-310,150,role="Local"},{110,-225,role="Tourist"}},traffic=false,compact=true}
end
return City
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="31">
      <Properties>
        <string name="Name">Destruction</string>
        <string name="Source"><![CDATA[local Players=game:GetService('Players')
local Collection=game:GetService('CollectionService')
local Rules=require(game.ReplicatedStorage.Shared.DestructionRules)
local RepairTimer=require(script.Parent.RepairTimer)
local Service={objects={},ids={}}
function Service.Register(model)
 if Service.objects[model] then return end
 local kind=model:GetAttribute('DestructibleType');local spec=Rules.Types[kind]
 if not spec then return end
 local parts={}
 for _,part in ipairs(model:GetDescendants()) do
  if part:IsA('BasePart') then parts[part]={color=part.Color,transparency=part.Transparency,collide=part.CanCollide,query=part.CanQuery,touch=part.CanTouch,seatDisabled=part:IsA("Seat") and part.Disabled or false} end
 end
 if next(parts)==nil then return end
 local cf,size=model:GetBoundingBox()
 local id=string.format("%s:%.3f:%.3f:%.3f",kind,cf.Position.X,cf.Position.Y,cf.Position.Z)
 if Service.ids[id] and Service.ids[id]~=model then warn("Duplicate destructible position",id);return end
 Service.ids[id]=model;model:SetAttribute("ObjectId",id)
 Service.objects[model]={parts=parts,kind=kind,health=spec.health,box=cf,size=size,version=0,prompts={}}
 for _,item in ipairs(model:GetDescendants()) do if item:IsA("ProximityPrompt") then Service.objects[model].prompts[item]=item.Enabled end end
 model:SetAttribute('ObjectName',spec.name);model:SetAttribute('ObjectHealth',spec.health);model:SetAttribute('ObjectMaxHealth',spec.health);model:SetAttribute('RequiredLevel',spec.level);model:SetAttribute('Destroyed',false);model:SetAttribute('RepairBlocked',false)
end
local function occupied(object)
 local characters={};for _,p in ipairs(Players:GetPlayers()) do if p.Character then table.insert(characters,p.Character) end end
 local world=Service.world
 if world then for _,model in ipairs(game:GetService("CollectionService"):GetTagged("CityResident")) do if model:IsDescendantOf(world) then table.insert(characters,model) end end end
 if #characters==0 then return false end
 local params=OverlapParams.new();params.FilterType=Enum.RaycastFilterType.Include;params.FilterDescendantsInstances=characters;params.MaxParts=1;params.RespectCanCollide=false
 return #workspace:GetPartBoundsInBox(object.box,object.size+Vector3.new(2,3,2),params)>0
end
local function restore(model,object,version)
 if not model.Parent or Service.objects[model]~=object or object.version~=version then return true end
 if occupied(object) then return false end
 local spec=Rules.Types[object.kind];object.health=spec.health
 for part,original in pairs(object.parts) do if part.Parent then part.Transparency=original.transparency;part.CanCollide=original.collide;part.CanQuery=original.query;part.CanTouch=original.touch;part.Color=original.color;if part:IsA("Seat") then part.Disabled=original.seatDisabled end end end
 for prompt,enabled in pairs(object.prompts) do if prompt.Parent then prompt.Enabled=enabled end end
 model:SetAttribute('ObjectHealth',spec.health);model:SetAttribute('Destroyed',false);model:SetAttribute('RepairBlocked',false);model:SetAttribute('RepairAt',0);model:SetAttribute('DamageStage',0)
 return true
end
function Service.Damage(instance,level,damage)
 local model=instance
 while model and not Service.objects[model] do model=model.Parent end
 local object=model and Service.objects[model]
 if not object then return nil end
 local health,destroyed,reason=Rules.Hit(object.kind,level,object.health,damage)
 if reason then return {model=model,reason=reason,required=Rules.Types[object.kind].level} end
 object.health=health;object.lastDamaged=os.clock();model:SetAttribute('ObjectHealth',health)
 local ratio=health/Rules.Types[object.kind].health;model:SetAttribute('DamageStage',destroyed and 3 or ratio<.35 and 2 or ratio<.7 and 1 or 0)
 for part,original in pairs(object.parts) do if part.Parent then
  if destroyed then part.Transparency=1;part.CanCollide=false;part.CanQuery=false;part.CanTouch=false;if part:IsA("Seat") then if part.Occupant then part.Occupant.Sit=false end;part.Disabled=true end
  else part.Color=original.color:Lerp(Color3.fromRGB(90,76,67),(1-ratio)*.45) end
 end end
 if destroyed then
  for prompt in pairs(object.prompts) do if prompt.Parent then prompt.Enabled=false end end
  model:SetAttribute('Destroyed',true)
 end
 -- Every accepted hit restarts repair, including damage that leaves the object standing.
 -- A single pending callback follows the latest deadline instead of accumulating per-hit tasks.
 object.version+=1;local duration=Rules.Types[object.kind].repair
 model:SetAttribute('RepairBlocked',false);model:SetAttribute('RepairAt',workspace:GetServerTimeNow()+duration)
 if not object.timer then
  object.timer=RepairTimer.new(os.clock,task.delay,
   function() return model.Parent~=nil and Service.objects[model]==object end,
   function()
    -- A maintenance worker may have repaired it while this timer was waiting.
    if object.health>=Rules.Types[object.kind].health then return true end
    return restore(model,object,object.version)
   end,
   function(delay) model:SetAttribute("RepairBlocked",true);model:SetAttribute("RepairAt",workspace:GetServerTimeNow()+delay) end)
 end
 object.timer:Touch(duration)
 return {model=model,destroyed=destroyed,health=health,kind=object.kind,position=object.box.Position}
end
-- Local maintenance complements the automatic repair timer. A worker must
-- physically reach the object and finish its work after a quiet interval.
function Service.MaintenanceTarget(origin,radius)
 local candidates={}
 for model,object in pairs(Service.objects) do
  if model.Parent and (object.kind=="Bench" or object.kind=="Bin")
   and object.health<Rules.Types[object.kind].health and os.clock()-(object.lastDamaged or os.clock())>=45
   and (object.box.Position-origin).Magnitude<=radius then
   table.insert(candidates,{model=model,object=object,distance=(object.box.Position-origin).Magnitude})
  end
 end
 table.sort(candidates,function(a,b) return a.distance<b.distance end)
 for _,candidate in ipairs(candidates) do
  local object=candidate.object
  if not occupied(object) then
   local approach
   for _,offset in ipairs({Vector3.new(object.size.X/2+2.4,0,0),Vector3.new(-object.size.X/2-2.4,0,0),Vector3.new(0,0,object.size.Z/2+2.4),Vector3.new(0,0,-object.size.Z/2-2.4)}) do
    local p=object.box:PointToWorldSpace(offset);p=Vector3.new(p.X,origin.Y,p.Z)
    if not approach or (p-origin).Magnitude<(approach-origin).Magnitude then approach=p end
   end
   return {position=approach,lookAt=object.box.Position,action="Repairing "..Rules.Types[object.kind].name:lower(),maintenanceModel=candidate.model,maintenanceVersion=object.version}
  end
 end
end
function Service.FinishMaintenance(station,workerPosition)
 local model=station.maintenanceModel;local object=Service.objects[model]
 if not object or not model.Parent or object.version~=station.maintenanceVersion
  or (object.kind~="Bench" and object.kind~="Bin") or object.health>=Rules.Types[object.kind].health
  or os.clock()-(object.lastDamaged or os.clock())<45 or (workerPosition-station.position).Magnitude>2
  or (workerPosition-object.box.Position).Magnitude>12 or occupied(object) then return false end
 -- Invalidate the old timer only after all safety checks pass.
 object.version+=1;restore(model,object,object.version)
 return true
end
function Service.Start(world)
 Service.generation=(Service.generation or 0)+1;local generation=Service.generation
 Service.objects={};Service.ids={};Service.world=world
 for _,model in ipairs(Collection:GetTagged('CityDestructible')) do if model:IsDescendantOf(world) then Service.Register(model) end end
 if Service.added then Service.added:Disconnect() end
 Service.added=Collection:GetInstanceAddedSignal('CityDestructible'):Connect(function(model) if Service.generation==generation and model:IsDescendantOf(world) then task.defer(function() if Service.generation==generation and model:IsDescendantOf(world) and Collection:HasTag(model,"CityDestructible") then Service.Register(model) end end) end end)
 if Service.removed then Service.removed:Disconnect() end
 Service.removed=Collection:GetInstanceRemovedSignal("CityDestructible"):Connect(function(model) if Service.generation~=generation then return end;local id=model:GetAttribute("ObjectId");if id and Service.ids[id]==model then Service.ids[id]=nil end;Service.objects[model]=nil end)
end
return Service
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="32">
      <Properties>
        <string name="Name">DeveloperAccess</string>
        <string name="Source"><![CDATA[local Access = {}

-- This is the account that owns the published Scream Simulator experience.
-- Studio is supplied by server RunService, never by a client argument.
-- The client only receives visibility; every test command is checked again here.
Access.OwnerUserId = 11499795799
-- Temporary owner-approved tester access. Disable before any public release.
-- Server-owned only: City Preview place 90337242377543 / universe 10769005350.
-- Verified cloud-reopen evidence: tests/evidence/city-preview-version14-2026-11-06.json.
Access.PrelaunchAllTesters = true
Access.PrelaunchUniverseIds = {[10769005350] = true}

function Access.IsAuthorized(player, creatorType, creatorId, isStudio, universeId)
    return player ~= nil and (isStudio == true or (creatorType == Enum.CreatorType.User
        and creatorId == Access.OwnerUserId
        and (player.UserId == Access.OwnerUserId or (Access.PrelaunchAllTesters == true
            and type(universeId) == "number" and universeId > 0 and universeId < math.huge
            and universeId % 1 == 0 and Access.PrelaunchUniverseIds[universeId] == true))))
end

return Access
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="33">
      <Properties>
        <string name="Name">Entitlements</string>
        <string name="Source"><![CDATA[-- Server-owned entitlement cache. A zero ID disables purchases and paid benefits.
local Marketplace=game:GetService("MarketplaceService")
local Players=game:GetService("Players")
local Config=require(game.ReplicatedStorage.Shared.Config)
local Catalog=require(game.ReplicatedStorage.Shared.ShopCatalog)
local Entitlements={}
local spectrum={}
local owned={}
local testOwned={}
local refreshIdentity={}
-- Removal may precede Parent becoming nil; queued refreshes must stay invalid.
local departed=setmetatable({},{__mode="k"})
function Entitlements.SetStudioMovement(player,enabled)
 if not game:GetService("RunService"):IsStudio() then return false end
 testOwned[player]=enabled==true
 return true
end
function Entitlements.HasStudioMovement(player)
 return game:GetService("RunService"):IsStudio() and testOwned[player]==true
end
function Entitlements.Refresh(player)
 if not player.Parent or departed[player] then return false end
 -- Each request supersedes older yielding work without permanently latching ownership.
 local identity={};refreshIdentity[player]=identity
 local function current() return player.Parent~=nil and refreshIdentity[player]==identity end
 local spectrumId=Catalog.Get("Spectrum").id
 if spectrumId>0 then
  local success,result=pcall(Marketplace.UserOwnsGamePassAsync,Marketplace,player.UserId,spectrumId)
  if not current() then return false end
  if success then spectrum[player]=result==true end
 else spectrum[player]=false end
 local id=Config.MovementPassId
 if type(id)~="number" or id<=0 then owned[player]=false;return false end
 local success,result=pcall(Marketplace.UserOwnsGamePassAsync,Marketplace,player.UserId,id)
 if not current() then return false end
 if success then owned[player]=result==true end
 return owned[player]==true
end
function Entitlements.HasSpectrum(player) return spectrum[player]==true end
function Entitlements.HasMovement(player)
 return owned[player]==true or Entitlements.HasStudioMovement(player)
end
function Entitlements.CanUseMovement(player,position)
 return Entitlements.HasMovement(player) and not Config.InArena(position)
end
Marketplace.PromptGamePassPurchaseFinished:Connect(function(player,id,purchased)
 if (id==Config.MovementPassId or id==Catalog.Get("Spectrum").id) and purchased then task.spawn(Entitlements.Refresh,player) end
end)
Players.PlayerRemoving:Connect(function(player) departed[player]=true;refreshIdentity[player]=nil;owned[player]=nil;testOwned[player]=nil;spectrum[player]=nil end)
return Entitlements
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="34">
      <Properties>
        <string name="Name">Equipment</string>
        <string name="Source"><![CDATA[-- Original handheld amplifier geometry; gameplay power remains server-calculated in VoiceCombat.
local Equipment={}
local function piece(model,torso,name,size,offset,color,shape)
 local part=Instance.new("Part");part.Name=name;part.Size=size;part.Color=color;part.Material=Enum.Material.SmoothPlastic
 part.CanCollide=false;part.CanTouch=false;part.CanQuery=false;part.Massless=true;part.CFrame=torso.CFrame*offset
 if shape then part.Shape=shape end
 part.Parent=model
 local weld=Instance.new("WeldConstraint");weld.Part0=torso;weld.Part1=part;weld.Parent=part
 return part
end
function Equipment.Sync(player,equipped)
 local character=player.Character;if not character then return end
 local existing=character:FindFirstChild("MicroSpeakerAccessory")
 if not equipped then if existing then existing:Destroy() end;return end
 if existing then return end
 local hand=character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm");if not hand then return end
 local model=Instance.new("Model");model.Name="MicroSpeakerAccessory"
 -- R15 grips at the palm; R6 grips at the end of its full-length arm.
 local grip=CFrame.new(0,-hand.Size.Y/2+.15,-.25)
 local function add(name,size,offset,color,shape) return piece(model,hand,name,size,grip*offset,color,shape) end
 add("Grip",Vector3.new(.25,.6,.25),CFrame.new(0,0,0),Color3.fromRGB(46,57,64))
 add("Enclosure",Vector3.new(.72,.78,.5),CFrame.new(0,.42,-.28),Color3.fromRGB(38,56,62))
 add("GoldTrim",Vector3.new(.64,.7,.06),CFrame.new(0,.42,-.56),Color3.fromRGB(232,186,92))
 add("SpeakerGrille",Vector3.new(.54,.58,.06),CFrame.new(0,.42,-.6),Color3.fromRGB(36,42,47))
 for i=-2,2 do add("GrilleSlot",Vector3.new(.43,.025,.02),CFrame.new(0,.42+i*.1,-.64),Color3.fromRGB(98,117,120)) end
 add("StatusLight",Vector3.new(.08,.08,.04),CFrame.new(.23,.7,-.65),Color3.fromRGB(119,233,182),Enum.PartType.Ball).Material=Enum.Material.Neon
 add("PommelCap",Vector3.new(.29,.08,.29),CFrame.new(0,-.32,0),Color3.fromRGB(232,186,92))
 add("GuardCollar",Vector3.new(.34,.08,.32),CFrame.new(0,.22,-.08),Color3.fromRGB(238,230,207))
 add("AcousticCone",Vector3.new(.18,.18,.05),CFrame.new(0,.42,-.64),Color3.fromRGB(232,186,92),Enum.PartType.Ball)
 add("TelemetrySpine",Vector3.new(.22,.56,.06),CFrame.new(0,.42,-.02),Color3.fromRGB(238,230,207))
 model.Parent=character
end
return Equipment
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="35">
      <Properties>
        <string name="Name">Fountain</string>
        <string name="Source"><![CDATA[-- Shared collision and water with a client-selected mesh or built-in fallback.
local Install={}
function Install.create(template,parent,origin)
 local m=Instance.new("Model");m.Name="MosaicFountain";m.ModelStreamingMode=Enum.ModelStreamingMode.Atomic
 local visual=template:Clone();visual.Name="DetailedVisual";visual.Parent=m
 for _,item in visual:GetDescendants() do
  if item:IsA("LuaSourceContainer") or item:IsA("PackageLink") then item:Destroy()
  elseif item:IsA("BasePart") then
   item.Anchored=true;item.CanCollide=false;item.CanTouch=false;item.CanQuery=false
  end
 end
 visual:ScaleTo(2)
 local box,size=visual:GetBoundingBox()
 visual:PivotTo(CFrame.new(origin+Vector3.new(0,size.Y/2,0))*box:ToObjectSpace(visual:GetPivot()))
 local fallback=Instance.new("Model");fallback.Name="FallbackVisual";fallback.Parent=m
 local function disk(name,radius,height,y,color,solid)
  local p=Instance.new("Part")
  p.Name=name;p.Shape=Enum.PartType.Cylinder
  p.Size=Vector3.new(height,radius*2,radius*2)
  p.CFrame=CFrame.new(origin+Vector3.new(0,y,0))*CFrame.Angles(0,0,math.pi/2)
  p.Anchored=true;p.CanCollide=solid;p.CanTouch=false;p.CanQuery=solid
  p.Color=color;p.CastShadow=false;p.Parent=m
  return p
 end
 -- One stable obstacle inside the original 32-stud navigation exclusion.
 -- Render meshes never use generated convex-hull collisions.
 local collider=disk("FountainCollision",14,5,2.5,Color3.new(),true)
 collider.Transparency=1
 local column=disk("ColumnCollision",2.5,14,10,Color3.new(),true);column.Transparency=1
 local bowl=disk("BowlCollision",5.5,1,18,Color3.new(),true);bowl.Transparency=1
 local stone=Color3.fromRGB(207,191,159)
 local function fallbackDisk(name,radius,height,y,color)
  local p=disk(name,radius,height,y,color,false);p.Material=Enum.Material.Limestone;p.CastShadow=true;p.Parent=fallback
 end
 fallbackDisk("BasinBase",14,.8,.4,stone)
 fallbackDisk("PedestalFoot",3.2,1.2,1.4,stone)
 fallbackDisk("Pedestal",2.2,14.7,9.3,stone)
 fallbackDisk("Bowl",5.5,1.1,17.9,stone)
 -- Separate rim segments leave the shared water visible in the fallback.
 for i=0,11 do
  local a=i*math.pi/6
  local rim=Instance.new("Part");rim.Name="StoneRim";rim.Size=Vector3.new(7.2,4.2,1.4)
  rim.CFrame=CFrame.new(origin+Vector3.new(math.sin(a)*12.9,2.8,math.cos(a)*12.9))*CFrame.Angles(0,a,0)
  rim.Anchored=true;rim.CanCollide=false;rim.CanTouch=false;rim.CanQuery=false;rim.Material=Enum.Material.Limestone;rim.Color=stone;rim.Parent=fallback
  local tile=rim:Clone();tile.Name="MosaicBand";tile.Size=Vector3.new(6.7,1.6,.05)
  tile.CFrame=rim.CFrame*CFrame.new(0,0,.73);tile.Color=i%2==0 and Color3.fromRGB(40,125,150) or Color3.fromRGB(53,85,143);tile.Material=Enum.Material.CeramicTiles;tile.Parent=fallback
 end
 local water=disk("BasinWater",11.35,.12,3.45,Color3.fromRGB(63,169,184),false)
 water.Material=Enum.Material.Glass;water.Transparency=.25;water.Reflectance=.12
 local upper=disk("BowlWater",2.3,.1,18.4,Color3.fromRGB(91,189,204),false)
 upper.Material=Enum.Material.Glass;upper.Transparency=.25
 -- Curved continuous streams; no physics droplets or per-frame script.
 for i=0,3 do
  local a=i*math.pi/2
  local radial=Vector3.new(math.cos(a),0,math.sin(a))
  local start=Instance.new("Attachment");start.Name="Spout"..i
  start.Parent=collider
  start.WorldCFrame=CFrame.fromMatrix(origin+radial*5+Vector3.new(0,18.2,0),radial,Vector3.yAxis)
  local finish=Instance.new("Attachment");finish.Name="Splash"..i;finish.Parent=collider
  finish.WorldCFrame=CFrame.fromMatrix(origin+radial*9+Vector3.new(0,3.5,0),-Vector3.yAxis,radial)
  local stream=Instance.new("Beam");stream.Name="WaterStream"..i
  stream.Attachment0=start;stream.Attachment1=finish
  stream.Width0=.16;stream.Width1=.24;stream.CurveSize0=2;stream.CurveSize1=7
  stream.Segments=12;stream.FaceCamera=true
  stream.Color=ColorSequence.new(Color3.fromRGB(220,248,252),Color3.fromRGB(132,216,228))
  stream.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.15),NumberSequenceKeypoint.new(.7,.28),NumberSequenceKeypoint.new(1,.55)});stream.LightInfluence=.7;stream.Parent=collider
  local core=Instance.new("Beam");core.Name="WaterCore"..i
  core.Attachment0=start;core.Attachment1=finish
  core.Width0=.06;core.Width1=.1;core.CurveSize0=2;core.CurveSize1=7
  core.Segments=12;core.FaceCamera=true
  core.Color=ColorSequence.new(Color3.fromRGB(245,253,255))
  core.Transparency=NumberSequence.new(.2);core.LightInfluence=.4;core.Parent=collider
 end
 m.Parent=parent
 game:GetService("CollectionService"):AddTag(m,"OptionalLandmarkVisual")
 return m
end
return Install
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="36">
      <Properties>
        <string name="Name">Profiles</string>
        <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local Lease=require(ReplicatedStorage.Shared.ProfileLease)
local RunService=game:GetService("RunService")
local HttpService=game:GetService("HttpService")
local owner=game.JobId~="" and game.JobId or HttpService:GenerateGUID(false)
local locks,owned,admissions={},{},{}
local bindings=setmetatable({},{__mode="k"})
local acquisition=0
local incarnation=HttpService:GenerateGUID(false)
local RECOVERY_WINDOW=12
-- Two normal 60-second autosave intervals of headroom at admission.
local MIN_ADMISSION_LIFETIME=120
local RECOVERY_NOTICE="Loaded the last confirmed save. Recent progress may be missing."
local Profiles = {}
local store
local storeReady, storeResult = pcall(function()
    return DataStoreService:GetDataStore(RunService:IsStudio() and "ScreamSimulator_Studio_v2" or "ScreamSimulator_v1")
end)
if storeReady then
    store = storeResult
else
    warn("ScreamSimulator save data unavailable; using temporary test profiles.")
end

local function wholeNumber(value, fallback, minimum, maximum)
    if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
        return fallback
    end
    return math.clamp(math.floor(value), minimum, maximum)
end

function Profiles.Default()
    return {schemaVersion=4,amplifierOwned=false,amplifierEquipped=false,achievements={},availableQuests={},coins=0,level=1,xp=0,sound="TinyAah",aura="Gold",quests={},combatChallenges={},settings={volume=0.55,reducedShake=false}}
end
function Profiles.Sanitize(raw)
    local data=Profiles.Default()
    if type(raw)~="table" then return data end
    -- Archive pre-cap progress once; never apply it to active level-100 combat.
    local legacy=type(raw.legacyProgress)=="table" and raw.legacyProgress or raw.schemaVersion~=4 and raw or nil
    if legacy then
        data.legacyProgress={level=wholeNumber(legacy.level,1,1,300),xp=wholeNumber(legacy.xp,0,0,1000000000)}
        if Config.GetSound(legacy.sound) then data.legacyProgress.sound=legacy.sound end
    end
    data.amplifierOwned=raw.amplifierOwned==true
    data.amplifierEquipped=data.amplifierOwned and raw.amplifierEquipped==true
    if type(raw.achievements)=="table" then
        for _,id in ipairs({"FoundNick","NickChampion","FirstBeam"}) do if raw.achievements[id]==true then data.achievements[id]=true end end
    end
    data.coins=wholeNumber(raw.coins,0,0,1000000000)
    data.level,data.xp=Config.Progression.Normalize(raw.level,raw.xp)
    if type(raw.combatChallenges)=="table" then
        -- Keep retired counters dormant under their original IDs. No conversion
        -- into another objective or reward; repeated save/load preserves history.
        for _,specs in ipairs({Config.Progression.Challenges,Config.Progression.RetiredChallenges or {}}) do
            for _,spec in ipairs(specs) do
                data.combatChallenges[spec.id]=wholeNumber(raw.combatChallenges[spec.id],0,0,spec.goal-1)
            end
        end
    end
    local sound=Config.GetSound(raw.sound)
    if sound then data.sound=(sound.level<=data.level and sound or Config.SoundForLevel(data.level)).id end
    if type(raw.customColor)=="string" and #raw.customColor==6 and raw.customColor:match("^%x+$") then data.customColor=raw.customColor:upper();data.useCustomColor=raw.useCustomColor==true end
    if type(raw.aura)=="string" and Config.Auras[raw.aura] then data.aura=raw.aura end
    if type(raw.availableQuests)=="table" then
        for _,q in ipairs(Config.Quests) do if raw.availableQuests[q.id]==true then data.availableQuests[q.id]=true end end
    end
    if type(raw.quests)=="table" then
        for _,q in ipairs(Config.Quests) do
            local old=raw.quests[q.id]
            if type(old)=="table" then data.availableQuests[q.id]=true;data.quests[q.id]={progress=wholeNumber(old.progress,0,0,q.goal),claimed=old.claimed==true} end
        end
    end
    if type(raw.settings)=="table" then
        local v=raw.settings.volume
        if type(v)=="number" and v==v then data.settings.volume=math.clamp(v,0,1) end
        data.settings.reducedShake=raw.settings.reducedShake==true
    end
    -- Preserve only the in-memory acquisition binding for legitimate baseline
    -- copies. No token is accepted from player data or persisted by Sanitize.
    bindings[data]=bindings[raw]
    -- Legacy shield and purchased-track fields are deliberately discarded.
    return data
end

-- Every retry uses the same immutable snapshot and (acquisition, revision).
-- An already committed operation is acknowledged without restamping its lease.
-- Callback retries must recheck the current record, not a cached ownership flag.
local function commit(userId,session,operation,deadline)
    for attempt=1,3 do
        if deadline and os.clock()>=deadline then break end
        local success,result=pcall(function()
            return store:UpdateAsync("Player_"..userId,function(raw)
                local saved=type(raw)=="table" and raw._save
                if type(saved)=="table" and saved.token==session.token and saved.revision==operation.revision then return raw end
                if not Lease.Owns(raw,owner,session.token) then return nil end
                if type(saved)=="table" and saved.token==session.token and type(saved.revision)=="number" and saved.revision>=operation.revision then return nil end
                local record=Profiles.Sanitize(operation.snapshot)
                record._save={token=session.token,revision=operation.revision}
                if operation.release then return record end
                return Lease.Stamp(record,owner,os.time(),session.token)
            end)
        end)
        if success then
            if result==nil then return false,"ownership" end
            session.confirmed=Profiles.Sanitize(result)
            return true
        end
        warn("ScreamSimulator profile save failed",userId,attempt)
        if deadline then
            if attempt<3 then task.wait(math.max(0,math.min(attempt,deadline-os.clock()))) end
        else task.wait(attempt) end
    end
    return false,"retry"
end

-- A matching token alone is not enough to start writable gameplay. Slow
-- responses can consume the lease after the atomic callback has completed.
local function usableAcquisition(record,token)
    if not Lease.Owns(record,owner,token) then return false end
    local expires=record._lease.expires
    return type(expires)=="number" and expires<math.huge and expires-os.time()>=MIN_ADMISSION_LIFETIME
end

function Profiles.Load(userId)
    if not store then return Profiles.Default(),false,"Saving is unavailable. This session uses temporary progress." end
    while locks[userId] do task.wait(.05) end
    local previous=owned[userId]
    if previous and not previous.pending then
        return Profiles.Default(),false,"Your previous session is still saving. Rejoin shortly."
    end
    locks[userId]=true
    local admission=admissions[userId]
    local fallback=admission and admission.fallback or false
    local confirmed=previous and previous.confirmed or admission and admission.confirmed
    if previous then
        -- Recovery only runs on rejoin, within the same lock as acquisition.
        -- A slow engine request cannot be cancelled; the deadline bounds new
        -- attempts/backoff, not the duration of an already in-flight request.
        local recovered=commit(userId,previous,previous.pending,os.clock()+RECOVERY_WINDOW)
        fallback=not recovered
        confirmed=previous.confirmed
        owned[userId]=nil
    end
    if not admission then
        acquisition+=1
        -- Keep admission identity across unavailable/ambiguous acquisitions, but
        -- never retain the abandoned save operation or grant a writable handle.
        admission={token=owner..":"..incarnation..":"..acquisition,
            terminalToken=previous and previous.token,fallback=fallback,confirmed=confirmed}
        admissions[userId]=admission
    end
    local token=admission.token
    local observed,hadLease
    for attempt=1,3 do
        local success,result=pcall(function()
            return store:UpdateAsync("Player_"..userId,function(raw)
                observed=type(raw)=="table" and Profiles.Sanitize(raw) or nil
                hadLease=type(raw)=="table" and type(raw._lease)=="table" and not Lease.Owns(raw,owner,token)
                if not Lease.CanAcquire(raw,owner,os.time(),token) then
                    -- A terminal local release has finished its bounded retry.
                    -- Only its exact token may be replaced before expiry.
                    if not (admission.terminalToken and Lease.Owns(raw,owner,admission.terminalToken)) then return nil end
                end
                if Lease.Owns(raw,owner,token) then
                    if usableAcquisition(raw,token) then return raw end
                    -- Refresh only this exact, unconfirmed acquisition. Preserve
                    -- current stored data/markers, never an old local snapshot.
                    return Lease.Stamp(raw,owner,os.time(),token)
                end
                local record=Profiles.Sanitize(raw)
                record._save=type(raw)=="table" and raw._save or nil
                -- Retain a warning across a lost acquisition response.
                record._recovered=fallback or hadLease or false
                return Lease.Stamp(record,owner,os.time(),token)
            end)
        end)
        if success then
            if Lease.Owns(result,owner,token) then
                if usableAcquisition(result,token) then
                    admissions[userId]=nil;locks[userId]=nil
                    local data=Profiles.Sanitize(result)
                    local session={token=token,revision=0,confirmed=Profiles.Sanitize(result)}
                    owned[userId]=session;bindings[data]=session
                    local notice=result._recovered==true
                    return data,true,notice and RECOVERY_NOTICE or nil,notice
                end
                -- The response arrived too late. Recheck/renew atomically on
                -- the next bounded attempt; no writable handle exists yet.
                observed=Profiles.Sanitize(result)
                warn("ScreamSimulator profile acquisition lifetime too short",userId,attempt)
            else
                admissions[userId]=nil;locks[userId]=nil
                return observed or confirmed or Profiles.Default(),false,
                    RECOVERY_NOTICE.." Another session owns this profile; progress here is temporary. Rejoin shortly.",true
            end
        else
            warn("ScreamSimulator profile load failed",userId,attempt)
        end
        -- A callback may have read a durable checkpoint before the write or
        -- response failed. It is safe to display, never to grant ownership.
        confirmed=observed or confirmed
        admission.confirmed=confirmed
        task.wait(attempt)
    end
    locks[userId]=nil
    -- Never enable saving or overwrite storage with a default/cached fallback.
    return confirmed and Profiles.Sanitize(confirmed) or Profiles.Default(),false,
        (confirmed and RECOVERY_NOTICE.." " or "Could not confirm a saved profile. ").."Saving is unavailable; progress here is temporary.",confirmed~=nil
end

function Profiles.Save(userId,data,release)
    if not store then return false,"unavailable" end
    local session=owned[userId]
    if not session or bindings[data]~=session then return false,"ownership" end
    while locks[userId] do task.wait(.05) end
    if owned[userId]~=session or session.pending then return false,"ownership" end
    locks[userId]=true
    session.revision+=1
    local operation={snapshot=Profiles.Sanitize(data),release=release==true,revision=session.revision}
    local ok,reason=commit(userId,session,operation)
    if release and not ok then
        -- Keep only one frozen final snapshot. Caller tables may change later.
        session.pending=operation
    elseif reason=="ownership" or release then owned[userId]=nil end
    locks[userId]=nil
    return ok,reason
end

return Profiles
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="37">
      <Properties>
        <string name="Name">RepairTimer</string>
        <string name="Source"><![CDATA[-- One pending callback per object; clock/scheduler injected for deterministic tests.
local Timer={};Timer.__index=Timer
function Timer.new(clock,schedule,valid,repair,retry)
 return setmetatable({clock=clock,schedule=schedule,valid=valid,repair=repair,retry=retry,pending=false,due=0},Timer)
end
function Timer:Queue(delay)
 self.pending=true
 self.schedule(delay,function() self:Wake() end)
end
function Timer:Touch(duration)
 self.due=self.clock()+duration
 if not self.pending then self:Queue(duration) end
end
function Timer:Wake()
 if not self.valid() then self.pending=false;return end
 local remaining=self.due-self.clock()
 if remaining>1e-6 then self:Queue(remaining);return end
 if self.repair() then self.pending=false;return end
 self.due=self.clock()+5
 self.retry(5)
 self:Queue(5)
end
return Timer
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="38">
      <Properties>
        <string name="Name">SoccerChallenge</string>
        <string name="Source"><![CDATA[-- Personal server-owned challenge state; other players cannot collect or shoot your balls.
local Players=game:GetService("Players")
local Run=game:GetService("RunService")
local Rules=require(script.Parent.CombatRules)
local Config=require(game:GetService("ReplicatedStorage").Shared.Config)
local compact=Config.CompactCity and Config.CityLayout.Soccer
local Soccer={}
local runs={}
local V=Vector3.new
local origin=V(615,2.2,550)
local lost={V(590,2.2,460),V(552,2.2,563),V(683,2.2,482)}
local gates={V(638,2.2,530),V(653,2.2,555),V(633,2.2,578),V(676,2.2,559)}
local obstacles={V(625,2.2,540),V(645,2.2,541),V(643,2.2,568),V(655,2.2,571)}
local goals={V(664,2.2,550),V(606,2.2,518),V(690,2.2,517),V(617,2.2,576),V(686,2.2,575)}
local center=V(647,4,547);local minimum=V(592,0,502);local maximum=V(704,0,587)
if compact then
 origin=compact.origin;lost=compact.lost;gates=compact.gates;obstacles=compact.obstacles;goals=compact.goals
 center=compact.center;minimum=compact.min;maximum=compact.max
end
local lostClue=Config.CompactCity and "the north court approach, west beach and east promenade" or "the north beach loungers, east of the pier, and the path north of this court"
local function sphere(parent,name,size,color)
 local p=Instance.new("Part");p.Name=name;p.Shape=Enum.PartType.Ball;p.Size=V(size,size,size);p.Color=color;p.Material=Enum.Material.SmoothPlastic;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Parent=parent;return p
end
local function caption(part,text)
 local gui=Instance.new("BillboardGui");gui.Name="ChallengeCaption";gui.Size=UDim2.fromOffset(190,38);gui.StudsOffset=V(0,3,0);gui.MaxDistance=35;gui.Parent=part
 local label=Instance.new("TextLabel");label.BackgroundColor3=Color3.fromRGB(25,48,51);label.BackgroundTransparency=.12;label.Size=UDim2.fromScale(1,1);label.Font=Enum.Font.GothamBold;label.TextSize=13;label.TextColor3=Color3.fromRGB(255,239,205);label.TextStrokeTransparency=.3;label.TextWrapped=true;label.Text=text;label.Parent=gui
 local corner=Instance.new("UICorner");corner.CornerRadius=UDim.new(0,8);corner.Parent=label
 local stroke=Instance.new("UIStroke");stroke.Name="CaptionStroke";stroke.ApplyStrokeMode=Enum.ApplyStrokeMode.Border;stroke.Color=Color3.fromRGB(235,190,105);stroke.Thickness=1;stroke.Transparency=.4;stroke.Parent=label
end
local function target(run,now)
 if run.phase=="Dribble" then return gates[run.stage] end
 local p=goals[run.stage]
 return p+(run.stage>=4 and V(math.sin((now-run.phaseStarted)*1.5)*5,0,0) or Vector3.zero)
end
function Soccer.Cancel(player)
 local run=runs[player];if run then runs[player]=nil;run.model:Destroy() end
end
function Soccer.Status(player)
 local run=runs[player];if not run then return nil end
 local detail=run.phase=="Find" and ("Find balls "..run.found.."/3") or run.phase=="Dribble" and ("Dribble gates "..(run.stage-1).."/4") or ("Moving targets "..(run.stage-1).."/5")
 return {phase=run.phase,detail=detail,remaining=math.max(0,math.ceil(run.deadline-os.clock()))}
end
local function setPhase(run,phase,seconds)
 run.phase=phase;run.phaseStarted=os.clock();run.deadline=run.phaseStarted+seconds;run.stage=1;run.position=origin;run.velocity=Vector3.zero
 run.model:SetAttribute("Phase",phase);run.ball.Position=origin;run.goal.Position=origin
 if phase~="Find" then
  run.ball.Transparency=0;run.goal.Transparency=.65;run.ball.Position=origin;run.goal.Position=target(run,os.clock())
 end
end
function Soccer.Collect(player,index)
 local run=runs[player];local point=type(index)=="number" and lost[index]
 local h=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
 local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 if not run or run.phase~="Find" or not point or run.collected[index] or not root or not h or h.Health<=0 or os.clock()>run.deadline or (root.Position-point).Magnitude>10 then return false end
 run.collected[index]=true;run.found+=1;run.lostParts[index]:Destroy()
 if run.found==3 then
  setPhase(run,"Dribble",90)
  for _,position in ipairs(obstacles) do
   for tier=1,3 do
    local cone=sphere(run.cones,"TrainingCone",2-tier*.4,Color3.fromRGB(238,141,63));cone.Shape=Enum.PartType.Cylinder;cone.Size=V(.7,2-tier*.4,2-tier*.4);cone.CFrame=CFrame.new(position.X,(compact and .35 or 1.35)+tier*.6,position.Z)*CFrame.Angles(0,0,math.pi/2)
   end
  end
  run.notify("Nick: Found them! Return to the court. Four dribble gates in 90 seconds—steer around the orange cones. Soft mic shots help!")
 else run.notify("Training ball "..run.found.."/3. Clues: "..lostClue..".") end
 return true
end
function Soccer.Start(player,notify,complete,failed)
 Soccer.Cancel(player)
 local model=Instance.new("Model");model.Name="SoccerAttempt_"..player.UserId;model:SetAttribute("OwnerUserId",player.UserId);model.Parent=workspace.ScreamSimulatorWorld
 local cones=Instance.new("Folder");cones.Name="CourseCones";cones.Parent=model
 local run={model=model,cones=cones,ball=sphere(model,"ChallengeBall",2.2,Color3.fromRGB(242,233,211)),goal=sphere(model,"Target",7,Color3.fromRGB(96,224,176)),found=0,collected={},lostParts={},notify=notify,complete=complete,failed=failed}
 run.ball.Transparency=1;run.goal.Transparency=1;run.goal.Material=Enum.Material.Neon
 caption(run.ball,player.DisplayName.." · Nick's challenge")
 setPhase(run,"Find",120);runs[player]=run
 for i,pos in ipairs(lost) do
  local part=sphere(model,"LostTrainingBall"..i,2.2,Color3.fromRGB(239,213,140));part.Position=pos;run.lostParts[i]=part
  caption(part,player.DisplayName.." · training ball")
  local prompt=Instance.new("ProximityPrompt");prompt.ActionText="Recover ball";prompt.ObjectText="Nick's lost training ball";prompt.KeyboardKeyCode=Enum.KeyCode.F;prompt.HoldDuration=.5;prompt.MaxActivationDistance=8;prompt.Parent=part
  prompt.Triggered:Connect(function(actor) if actor==player and runs[player]==run then Soccer.Collect(player,i) end end)
 end
 notify("Nick: I lost THREE balls. You have 120 seconds! Check "..lostClue..". Hold F nearby.")
end
function Soccer.Hit(player,beamOrigin,direction,length,width,power)
 local run=runs[player];if not run or run.phase=="Find" then return end
 if (run.position-beamOrigin).Magnitude>35 or not Rules.InBeam(beamOrigin,direction,run.position,length,width,1.1) then return end
 local flat=V(direction.X,0,direction.Z);if flat.Magnitude<.05 then return end
 run.velocity=flat.Unit*(12+math.clamp(power,0,1)*34)
 return true
end
local function segmentDistance(a,step,point)
 local denominator=step:Dot(step);local alpha=denominator>.000001 and math.clamp((point-a):Dot(step)/denominator,0,1) or 0
 return (a+step*alpha-point).Magnitude
end
Players.PlayerRemoving:Connect(Soccer.Cancel)
Run.Heartbeat:Connect(function(dt)
 dt=math.min(dt,.1);local now=os.clock()
 for player,run in pairs(runs) do
  local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
  local h=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
  if not root or not h or h.Health<=0 or now>run.deadline or (root.Position-center).Magnitude>150 then
   local failed=run.failed;Soccer.Cancel(player)
   if failed then failed() else run.notify("Nick: Let's retry at the court!") end
   continue
  end
  if run.phase=="Find" then continue end
  local goal=target(run,now);run.goal.Position=goal
  local old=run.position;local step=run.velocity*dt;local nextPosition=old+step
  local blocked=false
  if run.phase=="Dribble" and run.velocity.Magnitude>1 then
   for _,cone in ipairs(obstacles) do if segmentDistance(old,step,cone)<2 then
    run.velocity=-run.velocity*.25;blocked=true
    if now>(run.nextConePenalty or 0) then run.deadline-=3;run.nextConePenalty=now+2;run.notify("Cone clipped! -3 seconds. Use softer shots around it.") end
    break
   end end
  end
  if nextPosition.X<minimum.X or nextPosition.X>maximum.X or nextPosition.Z<minimum.Z or nextPosition.Z>maximum.Z then
   run.position=origin;run.velocity=Vector3.zero;run.notify("Out of bounds! Ball reset; your completed gates remain, but the timer keeps running.")
  elseif not blocked then
   run.position=nextPosition;run.velocity*=math.exp(-1.05*dt)
   local radius=run.phase=="Dribble" and 4.5 or run.stage>=4 and 3.5 or 4.5
   if run.velocity.Magnitude>1 and segmentDistance(old,step,goal)<radius then
    run.stage+=1
    if run.phase=="Dribble" and run.stage>#gates then
     run.cones:ClearAllChildren();setPhase(run,"Targets",120)
     run.notify("Checkpoint! Five shots in 120 seconds. The last two targets move—and watch out for my terrible assist!")
    elseif run.phase=="Targets" and run.stage>#goals then
     local complete=run.complete;Soccer.Cancel(player);complete();continue
    else
     run.velocity*=.3
     if run.phase=="Targets" and run.stage==4 then run.velocity+=V(6,0,0);run.notify("Nick: My assist drifts RIGHT! Compensate before the moving target.")
     else run.notify((run.phase=="Dribble" and "Gate " or "Target ")..(run.stage-1).." cleared · "..math.ceil(run.deadline-now).."s left") end
    end
   end
  end
  run.ball.CFrame=CFrame.new(run.position)*CFrame.Angles(0,0,now*run.velocity.Magnitude*.25)
 end
end)
return Soccer
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="39">
      <Properties>
        <string name="Name">StreetArt</string>
        <string name="Source"><![CDATA[-- Original, asset-free courtyard murals. Decorative only: no navigation or combat geometry.
local Art={}
local colors={sand=Color3.fromRGB(243,213,162),sun=Color3.fromRGB(242,166,75),
 teal=Color3.fromRGB(55,133,137),coral=Color3.fromRGB(209,107,90),ink=Color3.fromRGB(39,71,78),
 leaf=Color3.fromRGB(98,144,103),cream=Color3.fromRGB(250,235,205)}
function Art.create(parent,cf,width,coastal)
 local wall=Instance.new("Part");wall.Name="CourtyardMural";wall.Size=Vector3.new(width,5.5,.06);wall.CFrame=cf
 wall.Anchored=true;wall.CanCollide=false;wall.CanTouch=false;wall.CanQuery=false;wall.CastShadow=false;wall.Color=colors.sand;wall.Parent=parent
 local canvas=Instance.new("SurfaceGui");canvas.Name="OriginalStreetArt";canvas.Face=Enum.NormalId.Front
 canvas.SizingMode=Enum.SurfaceGuiSizingMode.FixedSize;canvas.CanvasSize=Vector2.new(512,160)
 canvas.AlwaysOnTop=false;canvas.LightInfluence=1;canvas.MaxDistance=100;canvas.Parent=wall
 local function shape(name,x,y,w,h,color,round)
  local f=Instance.new("Frame");f.Name=name;f.BorderSizePixel=0;f.BackgroundColor3=color
  f.Position=UDim2.fromOffset(x,y);f.Size=UDim2.fromOffset(w,h);f.Parent=canvas
  if round then local corner=Instance.new("UICorner");corner.CornerRadius=UDim.new(.5,0);corner.Parent=f end
  return f
 end
 local paper=shape("Paper",0,0,512,160,colors.sand)
 local border=Instance.new("UIStroke");border.Name="MuralBorder";border.ApplyStrokeMode=Enum.ApplyStrokeMode.Border;border.Color=colors.ink;border.Thickness=3;border.Transparency=.25;border.Parent=paper
 shape("Sun",34,22,94,94,colors.sun,true)
 if coastal then
  shape("Horizon",0,94,512,66,colors.teal)
  for i=0,4 do
   local x=math.max(0,i*112-28)
   shape("SeaLight",x,110+(i%2)*17,math.min(84,512-x),8,colors.cream,true)
   shape("SeaShadow",i*112+10,139,math.min(60,502-i*112),7,colors.ink,true)
  end
  shape("Sail",151,32,8,62,colors.ink)
  local sail=shape("Sailcloth",163,40,42,42,colors.coral);sail.Rotation=12
 else
  for i=0,2 do
   local x=154+i*58;local y=39+(i%2)*20
   shape("Stem",x+13,y+23,5,97-y,colors.ink)
   local leaf=shape("Leaf",x-9,y+58,30,13,colors.leaf,true);leaf.Rotation=-25
   shape("Petal",x,y,32,32,i%2==0 and colors.coral or colors.teal,true)
   shape("FlowerCenter",x+10,y+10,12,12,colors.sun,true)
  end
  shape("Garden",0,143,512,17,colors.leaf)
 end
 local title=Instance.new("TextLabel");title.Name="MuralTitle";title.BackgroundTransparency=1
 title.Position=UDim2.fromOffset(335,24);title.Size=UDim2.fromOffset(157,64)
 title.Font=Enum.Font.GothamBold;title.TextColor3=colors.ink;title.TextSize=26;title.TextWrapped=true
 title.Text=coastal and "SOL I MAR" or "VIU EL BARRI";title.Parent=canvas
 shape("MuralAccent",335,92,132,4,colors.sun,true)
 return wall
end
return Art
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="40">
      <Properties>
        <string name="Name">SustainedAim</string>
        <string name="Source"><![CDATA[-- Reconstruct aim from a trusted server origin. Cover and target eligibility
-- must still be resolved from that origin by the server on each damage tick.
local function finite(n) return n==n and math.abs(n)<math.huge end
return function(origin,aim)
 if typeof(aim)~="Vector3" or not finite(aim.X) or not finite(aim.Y) or not finite(aim.Z) then return nil end
 local delta=aim-origin
 local distance=delta.Magnitude
 if not finite(distance) or distance<.01 or distance>2048 then return nil end
 return delta.Unit
end
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="41">
      <Properties>
        <string name="Name">SustainedAttackAdapter</string>
        <string name="Source"><![CDATA[-- Automatic voice server adapter. Context (including origin and character identity)
-- must come from the server; only aim, power and sequence fields come from remotes.
local Adapter={}
function Adapter.new(Attack, Combat, directionFor)
 local api={}
 local function validPower(power)
  return Combat.IsFinite(power) and power>=0 and power<=1
 end
 local function sampleIndex(n)
  return Combat.IsFinite(n) and n%1==0 and n>=1 and n<=2^31
 end
 function api.New()
  return {protocol=Attack.New()}
 end
 local function clear(s)
  s.intent=nil
 end
 function api.Begin(s,now,request,context)
  if type(request)~="table" then return false,"request" end
  local direction=context and directionFor(context.origin,request.aim)
  local power=validPower(request.power) and request.power or nil
  local level=context and Combat.Level(context.level) or 1
  local amplifier=context~=nil and context.amplifier==true
  local stats=power and Combat.Stats(level,power,amplifier)
  local ok,reason,ended=Attack.Begin(s.protocol,now,request.sequence,
   Combat.Stats(level,1,false).maxDps,stats and stats.power,
   context~=nil and context.character~=nil and direction~=nil)
  if not s.protocol.active then clear(s) end
  if ok then
   s.intent={character=context.character,level=level,amplifier=amplifier,aim=request.aim,sample=0}
  end
  return ok,reason,ended
 end
 function api.Pulse(s,now,request,context)
  local intent=s.intent;local active=s.protocol.active
  if type(request)~="table" or not intent or not active or request.sequence~=active.sequence then return false,"sequence" end
  if not sampleIndex(request.sample) or request.sample<=intent.sample then return false,"sample" end
  -- Consume even rate-rejected samples so delayed/replayed packets cannot revive input.
  intent.sample=request.sample
  local allowed=context~=nil and context.character==intent.character
   and directionFor(context.origin,request.aim)~=nil
  local power=validPower(request.power) and Combat.Stats(intent.level,request.power,intent.amplifier).power or nil
  local ok,reason,ended=Attack.Pulse(s.protocol,now,request.sequence,power,allowed)
  if ok then intent.aim=request.aim end
  if not s.protocol.active then clear(s) end
  return ok,reason,ended
 end
 function api.Stop(s,now,sequence)
  local ended,reason=Attack.Stop(s.protocol,now,sequence)
  if not s.protocol.active then clear(s) end
  return ended,reason
 end
 function api.Cancel(s,now)
  local ended,reason=Attack.Cancel(s.protocol,now)
  if not s.protocol.active then clear(s) end
  return ended,reason
 end
 function api.Step(s,now,context,resolve)
  local a=s.protocol.active;local intent=s.intent
  if not a then return {} end
  local allowed=intent~=nil and context~=nil and context.character==intent.character
  local direction=allowed and directionFor(context.origin,intent.aim)
  local ids,details,beam
  if direction and Attack.NeedsTargets(s.protocol,now) then
   -- Power was already amplified when accepted; do not amplify a second time.
   local stats=Combat.Stats(intent.level,a.power,false)
   ids,details,beam=resolve(context,direction,stats,now)
  end
  local hits,ended,reason=Attack.Step(s.protocol,now,direction~=nil and direction~=false,ids)
  if not s.protocol.active then clear(s) end
  return hits,ended,details,beam,reason
 end
 return api
end
return Adapter
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="42">
      <Properties>
        <string name="Name">VoiceEligibility</string>
        <string name="Source"><![CDATA[-- Account voice eligibility only; client speech/power is not authenticated.
-- Pure bounded retry state. Bootstrap owns a globally capped, paced scheduler.
local Eligibility={RequestTimeout=8,CacheLifetime=120,RefreshAfter=60,MaxAttempts=3,
 MaxConcurrent=8,StartInterval=.25,RecoveryBase=30,RecoveryMax=120,DeniedRetry=120}
local delays={2,5}
function Eligibility.New(fixture,now,userId)
 return {fixture=fixture==true,identity={},attempts=0,serial=0,nextCheck=now or 0,expires=0,
  bursts=0,jitter=(userId or 0)%11}
end
function Eligibility.Allowed(s,now)
 return s~=nil and (s.fixture==true or (s.expires or 0)>now)
end
function Eligibility.DueAt(s)
 if not s or s.fixture or s.pending then return nil end
 return s.nextCheck
end
function Eligibility.MarkWaiting(s,now)
 local due=Eligibility.DueAt(s)
 if due and due<=now then s.waitingSince=s.waitingSince or now end
end
function Eligibility.Status(s,now)
 if not s then return "checking" end
 if s.fixture then return "fixture" end
 if Eligibility.Allowed(s,now) then return "eligible" end
 if s.denied then return "denied" end
 if s.failed or (s.pending and now>=s.pending.deadline)
  or (s.waitingSince and now>=s.waitingSince+Eligibility.RequestTimeout) then return "unavailable" end
 return "checking"
end
function Eligibility.Poll(s,now)
 local due=Eligibility.DueAt(s)
 if not due or now<due then return nil end
 s.waitingSince=nil;s.attempts+=1;s.serial+=1
 s.pending={token=s.serial,deadline=now+Eligibility.RequestTimeout}
 return s.serial
end
function Eligibility.Complete(s,token,now,ok,result)
 local request=s and s.pending
 if not request or token~=request.token then return false end
 s.pending=nil
 -- Result deadlines do not cancel engine calls. The global scheduler keeps a
 -- slot occupied until actual return, even after departure or this deadline.
 if now<request.deadline and ok==true and type(result)=="boolean" then
  s.attempts=0;s.bursts=0;s.failed=nil
  if result then
   s.denied=nil;s.expires=now+Eligibility.CacheLifetime;s.nextCheck=now+Eligibility.RefreshAfter
  else
   s.expires=0;s.denied=true;s.nextCheck=now+Eligibility.DeniedRetry+s.jitter
  end
 else
  s.failed=true
  if s.attempts>=Eligibility.MaxAttempts then
   s.attempts=0;s.bursts=math.min(3,s.bursts+1)
   s.nextCheck=now+math.min(Eligibility.RecoveryMax,Eligibility.RecoveryBase*2^(s.bursts-1))+s.jitter
  else s.nextCheck=now+delays[s.attempts] end
 end
 return true
end
return Eligibility
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="43">
      <Properties>
        <string name="Name">World</string>
        <string name="Source"><![CDATA[local Config = require(game:GetService("ReplicatedStorage").Shared.Config)
local TrainingRules=require(game:GetService("ReplicatedStorage").Shared.TrainingRules)
local InteractionRules=require(game:GetService("ReplicatedStorage").Shared.InteractionRules)
local RunService = game:GetService("RunService")
local PathfindingService = game:GetService("PathfindingService")
local Collection=game:GetService("CollectionService")

local World = {}
World.ZoneMin = Config.ZoneMin
World.ZoneMax = Config.ZoneMax
World.SafeSpawn = Config.CompactCity and CFrame.new(Config.CityLayout.Spawn) or CFrame.new(-600, 4, 210)
World.Cars = {}
local PhysicsService=game:GetService("PhysicsService")
local City=require(script.Parent.City)
World.Bots = {}
World.WalkPoints = {}
World.ActivityPoints = {}
World.Seats = {}

local rng = Random.new(8044)
local C = {
    road = Color3.fromRGB(43, 48, 54), concrete = Color3.fromRGB(184, 183, 171),
    gold = Color3.fromRGB(247, 192, 59), glass = Color3.fromRGB(76, 139, 159),
    dark = Color3.fromRGB(30, 50, 52), green = Color3.fromRGB(60, 126, 79),
}

local function part(parent, name, size, cf, color, material, solid)
    local p = Instance.new("Part")
    p.Name, p.Size = name, size
    p.CFrame = typeof(cf) == "CFrame" and cf or CFrame.new(cf)
    p.Anchored = true
    p.Color = color
    p.Material = material or Enum.Material.SmoothPlastic
    p.CanCollide = solid ~= false
    p.CanQuery = solid ~= false
    p.Parent = parent
    return p
end

local function billboard(parent, words, offset, width)
    local gui = Instance.new("BillboardGui")
    gui.Name = "Label"
    gui.Size = UDim2.fromOffset(math.min(width or 150, 180), 30)
    gui.StudsOffsetWorldSpace = offset
    gui.AlwaysOnTop = false
    gui.MaxDistance = 24
    gui.Parent = parent
    local text = Instance.new("TextLabel")
    text.Size = UDim2.fromScale(1, 1)
    text.BackgroundColor3 = C.dark
    text.BackgroundTransparency = 0.12
    text.TextColor3 = Color3.fromRGB(255, 247, 218)
    text.Font = Enum.Font.GothamBold
    text.TextSize = 12
    text.TextWrapped = true
    text.Text = words
    text.Parent = gui
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = text
    return text
end

-- Identity and damaged health have separate lanes; speech keeps its original helper.
local function nameplate(parent, words)
    local gui=Instance.new("BillboardGui")
    gui.Name="Nameplate";gui.Size=UDim2.fromOffset(180,60)
    gui.StudsOffsetWorldSpace=Vector3.new(0,2.5,0)
    gui.AlwaysOnTop=false;gui.MaxDistance=18;gui.LightInfluence=0;gui.Parent=parent
    local panel=Instance.new("Frame")
    panel.Name="Plate";panel.Size=UDim2.fromOffset(180,36)
    panel.BackgroundColor3=Color3.fromRGB(20,32,48);panel.BackgroundTransparency=.08
    panel.BorderSizePixel=0;panel.Parent=gui
    local corner=Instance.new("UICorner");corner.CornerRadius=UDim.new(0,8);corner.Parent=panel
    local edge=Instance.new("UIStroke");edge.Color=Color3.fromRGB(217,180,108)
    edge.Thickness=1;edge.Transparency=.35;edge.Parent=panel
    local text=Instance.new("TextLabel")
    text.Name="Identity";text.Size=UDim2.fromOffset(164,32);text.Position=UDim2.fromOffset(8,2)
    text.BackgroundTransparency=1;text.TextColor3=Color3.fromRGB(255,247,218)
    text.Font=Enum.Font.GothamBold;text.TextSize=15;text.TextWrapped=true;text.Text=words;text.Parent=gui
    local health=Instance.new("TextLabel")
    health.Name="Health";health.Size=UDim2.fromOffset(164,18);health.Position=UDim2.fromOffset(8,34)
    health.BackgroundTransparency=1;health.TextColor3=Color3.fromRGB(235,224,197)
    health.Font=Enum.Font.GothamMedium;health.TextSize=14;health.Text="";health.Visible=false;health.Parent=gui
    local track=Instance.new("Frame")
    track.Name="HealthTrack";track.Size=UDim2.fromOffset(164,3);track.Position=UDim2.fromOffset(8,54)
    track.BackgroundColor3=Color3.fromRGB(55,68,82);track.BorderSizePixel=0;track.Visible=false;track.Parent=gui
    local fill=Instance.new("Frame")
    fill.Name="HealthFill";fill.Size=UDim2.fromScale(1,1);fill.BackgroundColor3=Color3.fromRGB(245,202,111)
    fill.BorderSizePixel=0;fill.Parent=track
    return text,health,track,fill,panel
end

local function vehicle(parent, kind, paint)
    local model = Instance.new("Model")
    model.Name = kind .. "Car"
    model.Parent = parent
    local body = part(model, "PaintedBody", Vector3.new(12, 1.8, 5.7), CFrame.new(), paint, Enum.Material.SmoothPlastic, false)
    model.PrimaryPart = body
    local hull=part(model,"CollisionHull",Vector3.new(12.6,4.2,6.2),CFrame.new(0,.55,0),paint,Enum.Material.SmoothPlastic,true)
    hull.Transparency=1;hull.CanTouch=true
    hull.CustomPhysicalProperties=PhysicalProperties.new(1,.35,0)
    model:SetAttribute("Vehicle",true)
    part(model, "LowerChassis", Vector3.new(12.5, 0.65, 5.9), CFrame.new(0, -0.85, 0),
        Color3.fromRGB(37, 43, 47), Enum.Material.Metal, false)
    part(model, "Hood", Vector3.new(3.1, 0.45, 5.35), CFrame.new(4.3, 1.03, 0), paint, Enum.Material.SmoothPlastic, false)
    part(model, "Trunk", Vector3.new(2.3, 0.35, 5.35), CFrame.new(-4.65, 1, 0), paint, Enum.Material.SmoothPlastic, false)
    part(model, "Cabin", Vector3.new(5.8, 1.8, 4.9), CFrame.new(-0.2, 1.8, 0),
        Color3.fromRGB(47, 72, 78), Enum.Material.Metal, false)
    part(model, "CabinRoof", Vector3.new(5.4, 0.25, 4.8), CFrame.new(-0.2, 2.78, 0), paint, Enum.Material.SmoothPlastic, false)
    for _, side in ipairs({-1, 1}) do
        local z = side * 2.52
        for _, x in ipairs({-1.45, 1.05}) do
            part(model, "SideGlass", Vector3.new(2, 1.25, 0.12), CFrame.new(x, 1.85, z),
                Color3.fromRGB(95, 150, 169), Enum.Material.Glass, false)
        end
        for _, x in ipairs({-4.2, 0.2}) do
            part(model, "DoorHandle", Vector3.new(0.85, 0.13, 0.15), CFrame.new(x, 0.38, side * 2.93),
                Color3.fromRGB(210, 218, 216), Enum.Material.Metal, false)
        end
        part(model, "SideMirror", Vector3.new(0.7, 0.35, 0.7), CFrame.new(2.65, 1.25, side * 3),
            Color3.fromRGB(42, 50, 54), Enum.Material.Metal, false)
        for _, x in ipairs({-3.85, 3.85}) do
            local tire = part(model, "RubberTire", Vector3.new(0.8, 2.1, 2.1),
                CFrame.new(x, -1.05, side * 2.83) * CFrame.Angles(0, math.pi / 2, 0),
                Color3.fromRGB(26, 29, 32), Enum.Material.Rubber, false)
            tire.Shape = Enum.PartType.Cylinder
            local hub = part(model, "WheelHub", Vector3.new(0.84, 1.05, 1.05),
                CFrame.new(x, -1.05, side * 3.27) * CFrame.Angles(0, math.pi / 2, 0),
                Color3.fromRGB(156, 165, 163), Enum.Material.Metal, false)
            hub.Shape = Enum.PartType.Cylinder
        end
        part(model, "Headlight", Vector3.new(0.2, 0.55, 1.1), CFrame.new(6.08, 0.3, side * 1.7),
            Color3.fromRGB(255, 239, 194), Enum.Material.Neon, false)
        part(model, "Taillight", Vector3.new(0.2, 0.58, 1.1), CFrame.new(-6.08, 0.3, side * 1.7),
            Color3.fromRGB(197, 58, 54), Enum.Material.Neon, false)
    end
    part(model, "Windshield", Vector3.new(0.18, 1.62, 4.55),
        CFrame.new(2.78, 1.8, 0) * CFrame.Angles(0, 0, math.rad(-23)),
        Color3.fromRGB(106, 162, 177), Enum.Material.Glass, false)
    part(model, "RearGlass", Vector3.new(0.18, 1.55, 4.55),
        CFrame.new(-3.15, 1.78, 0) * CFrame.Angles(0, 0, math.rad(22)),
        Color3.fromRGB(86, 139, 158), Enum.Material.Glass, false)
    part(model, "FrontGrille", Vector3.new(0.2, 0.65, 3), CFrame.new(6.12, -0.28, 0),
        Color3.fromRGB(45, 54, 59), Enum.Material.Metal, false)
    for _, x in ipairs({-6.2, 6.2}) do
        part(model, "Bumper", Vector3.new(0.35, 0.35, 5.75), CFrame.new(x, -0.75, 0),
            Color3.fromRGB(65, 73, 74), Enum.Material.Metal, false)
    end
    if kind == "Taxi" then
        part(model, "TaxiRoofSign", Vector3.new(2.8, 0.8, 1.35), CFrame.new(-0.2, 3.36, 0),
            Color3.fromRGB(252, 227, 161), Enum.Material.Neon, false)
        part(model, "TaxiChecker", Vector3.new(8, 0.25, 0.12), CFrame.new(0, -0.12, -2.94),
            Color3.fromRGB(44, 50, 52), Enum.Material.Metal, false)
    elseif kind == "Delivery" then
        part(model, "CargoRoof", Vector3.new(5.8, 0.7, 4.8), CFrame.new(-0.4, 3.17, 0),
            Color3.fromRGB(214, 212, 198), Enum.Material.Metal, false)
    end
    return model
end

local function taxi(parent, x, z, kind, paint)
    local car = vehicle(parent, kind or "Taxi", paint or Color3.fromRGB(244, 184, 42))
    car:PivotTo(CFrame.new(x, 2, z))
end

local names = {
