      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">AttackAudioConfig</string>
          <string name="Source"><![CDATA[-- Owner-selected Roblox audio, keyed by equipped scream unlock level.
local Settings = {
 AssetsByLevel = {
  [10] = "112589551277234", [20] = "71125574109613",
  [30] = "72820033812084", [40] = "116444869617367",
  [50] = "110531388862916", [60] = "72657289722275",
  [70] = "8899285496", [80] = "102380291908556",
  [90] = "80523108386394", [100] = "79853512837585",
 },
 GroupVolume = .65,
 TotalVolume = .40, -- NORMAL budget shared across all active/fading sounds
 LowVolume = .24, -- original quiet mix; also the ceiling while local voice is detected
 LocalMultiplier = .7,
 VoiceDuck = .4,
 Limit = 4,
 Range = 70,
 NearDistance = 6,
 Timeout = .5,
 FadeIn = .12,
 FadeOut = .16,
 MaxLifetime = 4.5, -- independent cleanup if an end packet is lost
 StarterFallback = {
  Name = "se_battle_90",
  SourceFile = "vault/Audio/SFX/SciFi_Magic_Abilities/se_battle_90.ogg",
  AssetId = "",
  MinLevel = 1,
  MaxLevel = 9,
  Duration = 3.154,
 },
}
function Settings.AssetForLevel(level)
 if type(level)~="number" or level%1~=0 then return nil end
 local id=Settings.AssetsByLevel[level]
 if id~=nil then return "rbxassetid://"..id end
 local fb=Settings.StarterFallback
 if fb and level>=fb.MinLevel and level<=fb.MaxLevel and type(fb.AssetId)=="string" and fb.AssetId:match("^%d+$") then
  return "rbxassetid://"..fb.AssetId
 end
 return nil
end
function Settings.FallbackForLevel(level)
 if type(level)~="number" or level%1~=0 then return nil end
 local asset=Settings.AssetForLevel(level)
 if asset~=nil then return asset end
 local fb=Settings.StarterFallback
 if fb and level>=fb.MinLevel and level<=fb.MaxLevel then return fb.Name end
 return nil
end
return Settings
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">BeamStyle</string>
          <string name="Source"><![CDATA[-- Cosmetic complexity only; never used to calculate damage or hitboxes.
local Style={MaxParts=512,FarDistance=110,DrawDistance=180,Step=1/30}
-- A short launch expansion keeps the hit visible immediately and settles smoothly.
function Style.LaunchScale(age, reduced)
 if reduced then return 1 end
 local progress=math.clamp(age/.12,0,1)
 return .55+.45*(1-(1-progress)^3)
end
function Style.Tier(level)
 if type(level)~="number" or level~=level then return 0 end
 return math.floor(math.clamp(level,1,100)/10)
end
-- Authored silhouettes, not damage tiers. Counts stay within the existing budget.
local profiles={
 [0]={collar="round",ribbon="helix",turns=1.5},
 [1]={collar="diamond",ribbon="helix",turns=1.5},
 [2]={collar="diamond",ribbon="helix",turns=1.5},
 [3]={collar="round",ribbon="helix",turns=1.5},
 [4]={collar="round",ribbon="helix",turns=1.5},
 [5]={collar="round",ribbon="zigzag",turns=1.5},
 [6]={collar="round",ribbon="helix",turns=1.5},
 [7]={collar="round",ribbon="helix",turns=1.5},
 [8]={collar="round",ribbon="helix",turns=1.5},
 [9]={collar="star",ribbon="helix",turns=2.5},
 [10]={collar="star",ribbon="braid",turns=3.5},
}
Style.Styles={
 starter={
  id="starter",
  minLevel=1,
  maxLevel=39,
  primary={255,220,90},
  secondary={245,252,255},
 },
 firebeam={
  id="firebeam",
  sourceAsset="FIREBEAM.rbxm",
  minLevel=40,
  maxLevel=79,
  primary={93,171,255},
  secondary={130,195,255},
  sheath={59,163,255},
  ember={78,134,255},
 },
 hollow_purple={
  id="hollow_purple",
  sourceAsset="hollow purple beam ig.rbxm",
  minLevel=80,
  maxLevel=100,
  primary={164,6,255},
  secondary={70,46,255},
  amplified={33,102,185},
  reversal={255,38,42},
  arc={156,75,255},
 },
}
Style.SpecialBeams={
 ChargingBeam={
  id="charging_beam",
  name="Charging Beam",
  status="reserved",
  sourceAsset="Charging Beam.rbxm",
  primaryColor={82,143,255},
  emitterCount=48,
 },
}
function Style.StyleForLevel(level)
 local tier=Style.Tier(level)
 if tier>=8 then
  return Style.Styles.hollow_purple
 elseif tier>=4 then
  return Style.Styles.firebeam
 end
 return Style.Styles.starter
end
function Style.Detail(level,reduced,distance)
 local tier=Style.Tier(level)
 local styleId=Style.StyleForLevel(level).id
 if reduced or distance>Style.FarDistance then return {tier=tier,rings=0,strands=0,sparks=0,style=styleId} end
 local profile=profiles[tier]
 return {tier=tier,rings=1+math.floor(tier/3),strands=tier>=4 and (tier>=8 and 2 or 1) or 0,sparks=tier>=2 and (tier>=7 and 8 or 4) or 0,collar=profile.collar,ribbon=profile.ribbon,turns=profile.turns,style=styleId}
end
return Style
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">BoostLedger</string>
          <string name="Source"><![CDATA[-- Pure purchase transactions; receipt IDs are never evicted. Fail closed at cap.
local Ledger={Duration=1800,ReceiptLimit=8000,MaxExpiry=100000000000}
local function integer(n,maximum)
 return type(n)=="number" and n==n and math.clamp(math.floor(n),0,maximum) or 0
end
function Ledger.Normalize(raw)
 raw=type(raw)=="table" and raw or {}
 local d={inventory={},ends={},receipts={},operations={}}
 for _,kind in ipairs({"xp","coins"}) do
  d.inventory[kind]=integer(type(raw.inventory)=="table" and raw.inventory[kind],1000000)
  d.ends[kind]=integer(type(raw.ends)=="table" and raw.ends[kind],100000000000)
 end
 for id,value in pairs(type(raw.receipts)=="table" and raw.receipts or {}) do
  if type(id)=="string" and #id<=128 and value==true then d.receipts[id]=true end
 end
 for id,expires in pairs(type(raw.operations)=="table" and raw.operations or {}) do
  if type(id)=="string" and #id<=128 and type(expires)=="number" then d.operations[id]=expires end
 end
 return d
end
function Ledger.Grant(raw,receipt,kind)
 local d=Ledger.Normalize(raw)
 if type(receipt)~="string" or #receipt==0 or #receipt>128 or d.inventory[kind]==nil then return nil,"invalid" end
 if d.receipts[receipt] then return d,"duplicate" end
 local count=0;for _ in pairs(d.receipts) do count+=1 end
 if count>=Ledger.ReceiptLimit or d.inventory[kind]>=1000000 then return nil,"capacity" end
 d.receipts[receipt]=true;d.inventory[kind]+=1
 return d,"granted"
end
-- New purchases activate in the same atomic write that records their receipt.
-- Legacy inventory/receipts remain untouched; replay never restarts an expired boost.
function Ledger.GrantActive(raw,receipt,kind,now)
 local d=Ledger.Normalize(raw)
 if type(receipt)~="string" or #receipt==0 or #receipt>128 or d.inventory[kind]==nil then return nil,"invalid" end
 if d.receipts[receipt] then return d,"duplicate" end
 if type(now)~="number" or now~=now or now<0 or now>Ledger.MaxExpiry-Ledger.Duration then return nil,"invalid" end
 local count=0;for _ in pairs(d.receipts) do count+=1 end
 local ends=math.max(math.floor(now),d.ends[kind])+Ledger.Duration
 if count>=Ledger.ReceiptLimit or ends>Ledger.MaxExpiry then return nil,"capacity" end
 d.receipts[receipt]=true;d.ends[kind]=ends
 return d,"activated"
end
function Ledger.Activate(raw,kind,operation,started,now)
 local d=Ledger.Normalize(raw)
 if d.inventory[kind]==nil or now-started>60 or now<started then return nil,"invalid" end
 if d.operations[operation] then return d,"duplicate" end
 for id,expires in pairs(d.operations) do if now>=expires then d.operations[id]=nil end end
 if d.inventory[kind]<1 then return nil,"empty" end
 d.inventory[kind]-=1;d.ends[kind]=math.max(now,d.ends[kind])+Ledger.Duration
 d.operations[operation]=now+120
 return d,"activated"
end
function Ledger.Multiplier(d,kind,now)
 return d and d.ends and type(d.ends[kind])=="number" and now<d.ends[kind] and 2 or 1
end
return Ledger
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">CombatCredit</string>
          <string name="Source"><![CDATA[-- Server-only callers supply actual damage and a monotonic clock. No remote claims.
local Credit={Window=25,RepeatWindow=600,RepeatCooldown=60,MaxPairs=4096}
function Credit.Add(ledger,id,damage,now,maximum)
 if damage<=0 then return end
 for key,entry in pairs(ledger) do if now-entry.at>Credit.Window then ledger[key]=nil end end
 local old=ledger[id]
 if not old or now-old.at>Credit.Window then old={damage=0};ledger[id]=old end
 old.damage=math.min(maximum,old.damage+damage);old.at=now
end
function Credit.Split(ledger,finisher,now,maximum)
 local total=0;local shares={};local meaningful={}
 for id,entry in pairs(ledger) do
  if now-entry.at<=Credit.Window and entry.damage>0 and (entry.damage>=maximum*.1 or id==finisher) then
   shares[id]=entry.damage;total+=entry.damage;meaningful[id]=entry.damage>=maximum*.1
  end
 end
 -- Expired, excluded or otherwise missing damage must not become a last-hit bonus.
 -- Healing can create more than one health bar of damage; still cap the whole pool.
 local denominator=math.max(total,maximum)
 for id,damage in pairs(shares) do shares[id]=damage/denominator end
 table.clear(ledger) -- a KO consumes this life even if its reward is suppressed
 return shares,meaningful
end
function Credit.RepeatFactor(history,attacker,victim,now)
 if now>=(history.nextCleanup or 0) then
  for key,entry in pairs(history.pairs) do if now-entry.started>=Credit.RepeatWindow then history.pairs[key]=nil end end
  history.nextCleanup=now+30
 end
 local key=tostring(attacker)..":"..tostring(victim);local entry=history.pairs[key]
 if entry and now-entry.started>=Credit.RepeatWindow then history.pairs[key]=nil;entry=nil end
 if not entry then
  local count=0;for _ in pairs(history.pairs) do count+=1 end
  if count>=Credit.MaxPairs then return 0 end
  entry={started=now,last=-math.huge,count=0};history.pairs[key]=entry
 end
 if now-entry.last<Credit.RepeatCooldown then return 0 end
 entry.last=now;entry.count+=1
 return ({1,.5,.25})[entry.count] or 0
end
return Credit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">CompactLayout</string>
          <string name="Source"><![CDATA[-- Compact runtime layout derived from the preserved geometry draft. Original archive unchanged.
