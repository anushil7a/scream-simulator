    <Item class="StarterPlayerScripts" referent="49">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="50">
        <Properties>
          <string name="Name">Ambience</string>
          <string name="Source"><![CDATA[-- Location-bound scenery audio. Roblox handles live voice independently.
local Collection=game:GetService("CollectionService")
local Run=game:GetService("RunService")
local SoundService=game:GetService("SoundService")
local Content=game:GetService("ContentProvider")
local destroyed=false
local assets={}
local group=Instance.new("SoundGroup");group.Name="CityAmbience";group.Volume=.55;group.Parent=SoundService
local folder=Instance.new("Folder");folder.Name="LocalCitySoundscape";folder.Parent=workspace
local function source(name,position,id,volume,near,far)
 local anchor=Instance.new("Part");anchor.Name=name;anchor.Size=Vector3.one;anchor.Position=position;anchor.Transparency=1;anchor.Anchored=true;anchor.CanCollide=false;anchor.CanQuery=false;anchor.CanTouch=false;anchor.CastShadow=false;anchor.Parent=folder
 local sound=Instance.new("Sound");sound.Name=name; sound.SoundId="rbxassetid://"..id;sound.Looped=true;sound.Volume=volume;sound.RollOffMode=Enum.RollOffMode.InverseTapered;sound.RollOffMinDistance=near;sound.RollOffMaxDistance=far;sound.SoundGroup=group;sound.Parent=anchor
 assets[id]=assets[id] or {};table.insert(assets[id],sound)
 return sound
end
for _,x in ipairs({-540,-180,180,540}) do source("CoastalSurf",Vector3.new(x,1,590),"9119677305",.16,45,230) end
local stage=Vector3.new(150,5,426)
local guitar=source("BuskerGuitar",stage,"15675051846",0,8,70)
-- Load each shared asset once, then start its emitters together. A transient
-- CDN failure gets two retries; failed ambience never blocks gameplay or loops
-- requests forever. A pending load cannot restart audio after cleanup.
for _,sounds in pairs(assets) do
 task.spawn(function()
  local representative=sounds[1]
  for attempt=1,3 do
   if destroyed then return end
   representative:SetAttribute("LoadAttempts",attempt)
   pcall(function() Content:PreloadAsync({representative}) end)
   if destroyed then return end
   if representative.IsLoaded then
    for _,sound in sounds do sound:Play() end
    return
   end
   if attempt<3 then task.wait(attempt*2) end
  end
 end)
end
local performing=false;local elapsed=0
local heartbeat=Run.Heartbeat:Connect(function(dt)
 if destroyed then return end
 elapsed+=dt
 if elapsed>=.5 then
  elapsed=0;performing=false
  for _,model in Collection:GetTagged("CityResident") do
   local root=model:FindFirstChild("HumanoidRootPart");local humanoid=model:FindFirstChildOfClass("Humanoid")
   if model:IsDescendantOf(workspace) and model:GetAttribute("ResidentActive")~=false and model:GetAttribute("Role")=="Busker" and model:GetAttribute("Working") and root and humanoid and humanoid.Health>0 and (root.Position-stage).Magnitude<35 then performing=true;break end
  end
 end
 guitar.Volume+=((performing and .2 or 0)-guitar.Volume)*math.min(dt*3,1)
end)
local connection
script.Destroying:Connect(function() destroyed=true;heartbeat:Disconnect();if connection then connection:Disconnect() end;folder:Destroy();group:Destroy() end)
local remotes=game:GetService("ReplicatedStorage"):WaitForChild("ScreamRemotes")
if destroyed then return end
local state=remotes:WaitForChild("State")
if destroyed then return end
connection=state.OnClientEvent:Connect(function(data)
 if destroyed then return end
 local volume=type(data)=="table" and type(data.settings)=="table" and data.settings.volume
 if type(volume)=="number" and volume==volume then group.Volume=math.clamp(volume,0,1) end
end)
local action=remotes:WaitForChild("Action")
if destroyed then return end
action:FireServer("Sync")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">AttackAudio</string>
          <string name="Source"><![CDATA[local SoundService=game:GetService("SoundService")
local Settings=require(game:GetService("ReplicatedStorage").Shared.AttackAudioConfig)
local Mix=require(script.Parent:WaitForChild("BeamAudioMix"))
local Audio={}
function Audio.new()
 local group=Instance.new("SoundGroup");group.Name="QuietAttackEffects";group.Volume=Settings.GroupVolume;group.Parent=SoundService
 local eq=Instance.new("EqualizerSoundEffect");eq.LowGain=-3;eq.MidGain=-3;eq.HighGain=-4;eq.Parent=group
 local function create(position,tier)
  local asset=Settings.AssetForLevel(tier)
  if not asset then return nil end -- starter tier has no owner-selected SFX
  local anchor=Instance.new("Part");anchor.Name="LocalAttackAudio"
  anchor.Anchored=true;anchor.CanCollide=false;anchor.CanQuery=false;anchor.CanTouch=false
  anchor.Transparency=1;anchor.Size=Vector3.one;anchor.Position=position;anchor.Parent=workspace
  local sound=Instance.new("Sound");sound.Name="EnergyBeam";sound.SoundId=asset
  sound.Looped=false;sound.Volume=0;sound.PlaybackSpeed=1;sound.PlayOnRemove=false
  sound.RollOffMode=Enum.RollOffMode.InverseTapered
  sound.RollOffMinDistance=Settings.NearDistance;sound.RollOffMaxDistance=Settings.Range
  sound.SoundGroup=group;sound.Parent=anchor;sound:Play()
  return {anchor=anchor,sound=sound}
 end
 local mix=Mix.new(Settings,create,function(handle,position,volume,pitch)
  handle.anchor.Position=position;handle.sound.Volume=volume;handle.sound.PlaybackSpeed=pitch
 end,function(handle) handle.sound:Stop();handle.anchor:Destroy() end)
 local destroy=mix.Destroy
 function mix:Destroy() destroy(self);group:Destroy() end
 return mix
end
return Audio
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">BeamAudioMix</string>
          <string name="Source"><![CDATA[-- Cosmetic timing/mixing only. No voice recording, damage or server requests.
local Mix={};Mix.__index=Mix
function Mix.new(settings,create,update,destroy)
 return setmetatable({settings=settings,create=create,update=update,destroy=destroy,
  entries={},count=0,enabled=true,level="NORMAL",duck=1},Mix)
end
function Mix:Remove(id)
 local entry=self.entries[id];if not entry then return end
 self.entries[id]=nil;self.count-=1;self.destroy(entry.sound)
end
function Mix:Clear()
 for id in pairs(self.entries) do self:Remove(id) end
end
function Mix:SetLevel(level)
 if self.destroyed or (level~="NORMAL" and level~="LOW" and level~="OFF") then return false end
 self.level=level;self.enabled=level~="OFF"
 if not self.enabled then self:Clear() end
 return true
end
function Mix:SetEnabled(enabled)
 return self:SetLevel(enabled==true and "NORMAL" or "OFF")
end
function Mix:Pulse(id,now,position,isLocal,tier)
 if self.destroyed or not self.enabled then return false end
 local entry=self.entries[id]
 if entry and entry.stopped then return false end -- never revive a fading attack
 if not entry then
  if self.count>=self.settings.Limit then return false end
  local sound=self.create(position,tier);if not sound then return false end
  entry={sound=sound,started=now,isLocal=isLocal};self.entries[id]=entry;self.count+=1
 end
 entry.position=position;entry.lastPulse=now
 return true
end
function Mix:Stop(id,now)
 local entry=self.entries[id];if entry and not entry.stopped then entry.stopped=now end
end
function Mix:Step(now,dt,voiceActive,calibrating)
 if self.destroyed then return end
 dt=math.clamp(dt,0,.25)
 local target=voiceActive and self.settings.VoiceDuck or 1
 self.duck+=(target-self.duck)*(1-math.exp(-dt*(voiceActive and 30 or 5)))
 for id,entry in pairs(self.entries) do
  if not entry.stopped and (now-entry.lastPulse>=self.settings.Timeout or now-entry.started>=self.settings.MaxLifetime) then
   entry.stopped=math.min(entry.lastPulse+self.settings.Timeout,entry.started+self.settings.MaxLifetime)
  end
  if entry.stopped and now-entry.stopped>=self.settings.FadeOut then self:Remove(id) end
 end
 local budget=self.level=="LOW" and self.settings.LowVolume or self.settings.TotalVolume
 -- Louder listening must not raise the old voice-active feedback ceiling.
 if voiceActive then budget=math.min(budget,self.settings.LowVolume) end
 local gain=calibrating and 0 or budget/math.max(1,self.count)*self.duck
 for _,entry in pairs(self.entries) do
  local age=math.max(0,now-entry.started)
  local envelope=math.clamp(age/self.settings.FadeIn,0,1)
  local pitch=1 -- preserve the supplied recording's pitch and timing
  if entry.stopped then
   local release=math.clamp((now-entry.stopped)/self.settings.FadeOut,0,1)
   envelope*=1-release
  end
  self.update(entry.sound,entry.position,gain*envelope*(entry.isLocal and self.settings.LocalMultiplier or 1),pitch)
 end
end
function Mix:Destroy()
 if self.destroyed then return end
 self.destroyed=true;self:Clear()
end
return Mix
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">BeamVisuals</string>
          <string name="Source"><![CDATA[-- One animated rig per attacker. Parts are pooled across attacks, never per pulse.
local Style=require(game:GetService("ReplicatedStorage").Shared.BeamStyle)
local Visuals={}
local pool,live={},{}
local allocated=0
local detailCount=0
local decoration={}
local white=Color3.fromRGB(245,252,255)
local function take(detail)
 if detail and detailCount>=Style.MaxParts-24*5 then return end
 local part=table.remove(pool)
 if not part then
  if allocated>=Style.MaxParts then return end
  part=Instance.new("Part");allocated+=1
  part.Name="VoiceEnergy";part.Anchored=true;part.CanCollide=false
  part.CanTouch=false;part.CanQuery=false;part.CastShadow=false
  part.Material=Enum.Material.Neon;part.TopSurface=Enum.SurfaceType.Smooth;part.BottomSurface=Enum.SurfaceType.Smooth
 end
 if detail then decoration[part]=true;detailCount+=1 end
 return part
end
local function release(part)
 if decoration[part] then decoration[part]=nil;detailCount-=1 end
 part.Parent=nil;table.insert(pool,part)
end
function Visuals.Create()
 local rig={parts={},born=os.clock(),used=0};live[rig]=true;return rig
end
function Visuals.Update(rig,origin,direction,length,width,color,level,reduced)
 if direction.Magnitude<.01 or length<.01 then return end
 rig.origin=origin;rig.direction=direction.Unit;rig.length=math.clamp(length,.01,110)
 rig.width=math.clamp(width,1,7);rig.color=color;rig.level=level;rig.reduced=reduced
end
local function draw(rig,shape,size,cf,color,alpha)
 rig.used+=1
 local part=rig.parts[rig.used]
 if not part then part=take(rig.used>5);if not part then return end;rig.parts[rig.used]=part end
 part.Shape=shape;part.Size=size;part.CFrame=cf;part.Color=color;part.Transparency=alpha;part.Parent=workspace
end
local function line(rig,a,b,thickness,color,alpha)
 local delta=b-a;local length=delta.Magnitude;if length<.001 then return end
 local direction=delta/length
 draw(rig,Enum.PartType.Cylinder,Vector3.new(length,thickness,thickness),
  CFrame.lookAt((a+b)*.5,b,math.abs(direction.Y)>.98 and Vector3.zAxis or Vector3.yAxis)*CFrame.Angles(0,math.pi/2,0),color,alpha)
end
function Visuals.Animate(rig,now,viewer,reduced)
 if not rig.origin then return end
 local distance=(viewer-rig.origin).Magnitude
 rig.used=0
 if distance<=Style.DrawDistance then
  local spec=Style.Detail(rig.level,reduced or rig.reduced,distance)
  local origin,dir,length,width,color=rig.origin,rig.direction,rig.length,rig.width,rig.color
  local basis=CFrame.lookAt(origin,origin+dir,math.abs(dir.Y)>.98 and Vector3.zAxis or Vector3.yAxis)
  local right,up=basis.RightVector,basis.UpVector
  local age=now-rig.born;local tier=spec.tier
  local quiet=reduced or rig.reduced
  local radius=width*(.24+tier*.012)*Style.LaunchScale(age,quiet)
  local finish=origin+dir*length
  -- Smooth low-amplitude breathing; no screen flash, camera shake or lights.
  local pulse=quiet and 1 or 1+.035*math.sin(age*9)
  line(rig,origin,finish,radius*1.65*pulse,color,quiet and .72 or .68)
  line(rig,origin,finish,radius*.85,color,quiet and .32 or .12)
  line(rig,origin,finish,radius*.28,white,quiet and .45 or .08)
  draw(rig,Enum.PartType.Ball,Vector3.one*math.min(length,radius*1.5),CFrame.new(finish),color,.3)
  if not quiet and distance<=Style.FarDistance then
   draw(rig,Enum.PartType.Ball,Vector3.one*radius*1.15,CFrame.new(origin),white,.18)
   local function offset(angle,r) return (right*math.cos(angle)+up*math.sin(angle))*r end
   for ring=1,spec.rings do
    local travel=(age*(.6+tier*.025)+ring/spec.rings)%1
    local center=origin+dir*(travel*length)
    local r=radius*(.85+.2*math.sin(travel*math.pi))
    for i=1,10 do
     local phase=age*.9+ring*.6
     line(rig,center+offset((i-1)*math.pi/5+phase,r),center+offset(i*math.pi/5+phase,r),.055+tier*.008,color,.22+travel*.28)
    end
   end
   for strand=1,spec.strands do
    local previous=origin
    for i=1,12 do
     local t=i/12;local phase=t*math.pi*(tier>=9 and 5 or 3)-age*5+strand*math.pi
     local point=origin+dir*(length*t)+offset(phase,radius*.95*math.sin(t*math.pi))
     line(rig,previous,point,.065+tier*.006,color:Lerp(white,.4),.25);previous=point
    end
   end
   for i=1,spec.sparks do
    local phase=i*math.pi*2/spec.sparks+age*(i%2==0 and .6 or -.6)
    -- Endpoint corona stays inside the authoritative beam width.
    line(rig,finish+offset(phase,radius*.35),finish+offset(phase,width*.47),.08+tier*.006,color,.3)
   end
  end
 end
 for i=#rig.parts,rig.used+1,-1 do release(rig.parts[i]);rig.parts[i]=nil end
end
function Visuals.Destroy(rig)
 if not live[rig] then return end
 live[rig]=nil
 for _,part in ipairs(rig.parts) do release(part) end
 table.clear(rig.parts)
end
function Visuals.Clear()
 for rig in pairs(live) do Visuals.Destroy(rig) end
 for _,part in ipairs(pool) do part:Destroy() end
 table.clear(pool);allocated=0
end
function Visuals.Budget() return allocated,#pool end
return Visuals
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">CityMap</string>
          <string name="Source"><![CDATA[-- North is -Z. Coordinates match City's 1440-by-1200 playable land.
local Config=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local CityMap={}
local gold=Color3.fromRGB(255,205,111)
local cream=Color3.fromRGB(239,244,240)
local function box(parent,name,x,z,w,h,color)
 local f=Instance.new('Frame');f.Name=name;f.BorderSizePixel=0;f.BackgroundColor3=color
 f.Position=UDim2.fromScale(x,z);f.Size=UDim2.fromScale(w,h);f.Parent=parent;return f
end
local function text(parent,value,size,color)
 local t=Instance.new('TextLabel');t.BackgroundTransparency=1;t.Size=UDim2.fromScale(1,1)
 t.Font=Enum.Font.GothamBold;t.Text=value;t.TextSize=size;t.TextColor3=color or cream;t.Parent=parent;return t
end
local function position(x,z) return UDim2.fromScale(math.clamp((x+720)/1440,0,1),math.clamp((z+600)/1200,0,1)) end
local arenaStart=position(Config.ZoneMin.X,Config.ZoneMin.Z)
local arenaEnd=position(Config.ZoneMax.X,Config.ZoneMax.Z)
local arenaX,arenaZ=arenaStart.X.Scale,arenaStart.Y.Scale
local arenaWidth,arenaHeight=arenaEnd.X.Scale-arenaX,arenaEnd.Y.Scale-arenaZ
CityMap.arenaPercent=math.floor(arenaWidth*arenaHeight*100+.5)
local landmarks={
 {name='1 · Plaça del Sol / spawn',x=-600,z=240},
 {name='2 · Rambla gardens',x=-360,z=240},
 {name='3 · Basilica',x=120,z=-240},
 {name='4 · Market',x=120,z=0},
 {name='5 · Old town',x=600,z=0},
 {name='6 · Beach & promenade',x=0,z=515},
 {name='7 · Timber pier',x=525,z=537},
 {name='8 · Training fighters',x=-320,z=545},
}
function CityMap.create(parent,compact)
 local map=box(parent,'CityMap',.5,.5,1,1,Color3.fromRGB(50,93,82));map.AnchorPoint=Vector2.new(.5,.5)
 local ratio=Instance.new('UIAspectRatioConstraint');ratio.AspectRatio=1.2;ratio.AspectType=Enum.AspectType.FitWithinMaxSize;ratio.Parent=map
 box(map,'Arena',arenaX,arenaZ,arenaWidth,arenaHeight,Color3.fromRGB(136,65,70))
 box(map,'Beach',0,1030/1200,1,170/1200,Color3.fromRGB(179,153,104))
 -- PasseigMaritim and TimberPier dimensions mirror the generated waterfront.
 box(map,'Promenade',0,(401-26+600)/1200,1,52/1200,Color3.fromRGB(197,176,141))
 box(map,'TimberPier',(525-14+720)/1440,(537-62.5+600)/1200,28/1440,125/1200,Color3.fromRGB(111,82,56))
 -- Street widths and extents are world-derived, not decorative subdivisions.
 for x=-720,720,240 do box(map,'Avenue',math.max(0,(x+720-14)/1440),0,(x==-720 or x==720) and 14/1440 or 28/1440,.8,Color3.fromRGB(34,47,54)) end
 for z=-600,360,240 do box(map,'Street',0,math.max(0,(z+600-14)/1200),1,z==-600 and 14/1200 or 28/1200,Color3.fromRGB(34,47,54)) end
 local boundary=box(map,'ArenaBoundary',arenaX,arenaZ,arenaWidth,arenaHeight,cream);boundary.BackgroundTransparency=1
 local stroke=Instance.new('UIStroke');stroke.Color=Color3.fromRGB(247,139,120);stroke.Thickness=2;stroke.Parent=boundary
 local north=box(map,'North',.04,.025,.25,.075,cream);north.BackgroundTransparency=1;text(north,'N ↑',13)
 for i,v in ipairs(compact and {} or landmarks) do
  local pin=box(map,'Landmark'..i,0,0,0,0,Color3.fromRGB(22,39,46));pin.Size=UDim2.fromOffset(23,23);pin.AnchorPoint=Vector2.new(.5,.5);pin.Position=position(v.x,v.z)
  local corner=Instance.new('UICorner');corner.CornerRadius=UDim.new(1,0);corner.Parent=pin;text(pin,tostring(i),13)
 end
 local dot=box(map,'Player',0,0,0,0,gold);dot.Size=UDim2.fromOffset(18,18);dot.AnchorPoint=Vector2.new(.5,.5);dot.ZIndex=5
 dot.Visible=false
 local corner=Instance.new('UICorner');corner.CornerRadius=UDim.new(1,0);corner.Parent=dot
 local arrow=text(dot,'▲',14,Color3.fromRGB(19,32,40));arrow.ZIndex=6
 return {map=map,dot=dot,arrow=arrow}
end
function CityMap.update(view,root)
 if not view or not view.map.Parent then return end
 view.dot.Visible=root~=nil and root.Parent~=nil
 if not view.dot.Visible then return end
 view.dot.Position=position(root.Position.X,root.Position.Z)
 local look=root.CFrame.LookVector
 view.arrow.Rotation=math.deg(math.atan2(look.X,-look.Z))
end
-- Reserve the compact HUD's left column and combat/talk controls below.
function CityMap.MiniLayout(viewport,touch)
 local available=viewport.X>=280 and viewport.Y>=(touch and 315 or 168)
 local width=math.min(160,viewport.X-278)
 -- The quest tracker is wider than the HUD. Stay above it or to its right.
 width=math.min(width,math.max(119,viewport.X-328))
 if touch then width=math.min(width,(viewport.Y-269)*1.2+16) end
 local expanded=width>=96 and viewport.Y>=360
 if not expanded then return {width=math.min(90,math.max(44,viewport.X-220)),height=44,expanded=false,available=available} end
 return {width=width,height=52+(width-16)/1.2,expanded=true,available=available}
end
function CityMap.MiniUpdate(view,root,now,visible)
 if not view or not view.map.Parent then return end
 if not visible or not root or not root.Parent then
  view.dot.Visible=false;view.nextUpdate=nil;view.lastRoot=nil;return
 end
 if view.lastRoot==root and view.nextUpdate and now<view.nextUpdate then return end
 view.lastRoot=root;view.nextUpdate=now+.1
 CityMap.update(view,root)
end
CityMap.legend='1  Plaça del Sol / spawn     2  Rambla gardens\n3  Basilica     4  Market     5  Old town\n6  Beach & promenade     7  Timber pier\n8  Training fighters (west beach)'
return CityMap
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="55">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[local CityMap=require(script.Parent:WaitForChild("CityMap"))
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local UIS=game:GetService("UserInputService")
local Run=game:GetService("RunService")
local Tween=game:GetService("TweenService")
local Debris=game:GetService("Debris")
local TextService=game:GetService("TextService")
local GuiService=game:GetService("GuiService")
-- External signals outlive the HUD; suppress queued callbacks during teardown too.
local clientConnections={}
local clientDestroyed=false
local function connectClient(signal,callback)
 if clientDestroyed then return end
 local connection=signal:Connect(function(...)
  if not clientDestroyed then callback(...) end
 end)
 table.insert(clientConnections,connection)
 return connection
end
script.Destroying:Connect(function()
 clientDestroyed=true
 for _,connection in ipairs(clientConnections) do connection:Disconnect() end
 table.clear(clientConnections)
end)
local originalTouchControls=GuiService.TouchControlsEnabled
script.Destroying:Connect(function() GuiService.TouchControlsEnabled=originalTouchControls end)
local p=Players.LocalPlayer
local originalCameraMode=p.CameraMode
local originalMinZoom,originalMaxZoom=p.CameraMinZoomDistance,p.CameraMaxZoomDistance
-- Keep wheel/pinch zoom outside first person on desktop and touch.
local function applyThirdPerson()
 p.CameraMaxZoomDistance=math.max(originalMaxZoom,6)
 p.CameraMinZoomDistance=math.max(originalMinZoom,6)
 p.CameraMode=Enum.CameraMode.Classic
end
applyThirdPerson()
connectClient(p.CharacterAdded,applyThirdPerson)
local Config=require(RS:WaitForChild("Shared"):WaitForChild("Config"))
local FirstBeamGuide=require(RS.Shared:WaitForChild("FirstBeamGuide"))
local InteractionRules=require(RS.Shared:WaitForChild("InteractionRules"))
local DestructionRules=require(RS.Shared:WaitForChild("DestructionRules"))
local mic=require(script.Parent:WaitForChild("Microphone")).new()
local attackAudio=require(script.Parent:WaitForChild("AttackAudio")).new()
local attackAudioSettings=require(RS.Shared.AttackAudioConfig)
local gameplayAudio=require(script.Parent:WaitForChild("GameplayAudio")).new()
local gameplayAudioSettings=require(RS.Shared.GameplayAudioConfig)
script.Destroying:Connect(function() gameplayAudio:Destroy() end)
connectClient(p.CharacterRemoving,function() gameplayAudio:Clear() end)
local function cueContext()
 gameplayAudio:SetContext(mic.ready and mic.power>.12,mic.phase~=nil or not mic.ready)
end
local function playGameplayCue(kind,position)
 cueContext()
 if position then
  local root=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
  if not root or (root.Position-position).Magnitude>gameplayAudioSettings.Range then return end
 end
 gameplayAudio:Play(kind,os.clock(),position)
end
script.Destroying:Connect(function() attackAudio:Destroy() end)
script.Destroying:Connect(function() mic:Destroy() end)
local ShopUI=require(script.Parent:WaitForChild("ShopUI"))
script.Destroying:Connect(function() ShopUI.Clear() end)
local ScreamEffects=require(script.Parent:WaitForChild("ScreamEffects"))
script.Destroying:Connect(function() ScreamEffects.Clear() end)
local remotes=RS:WaitForChild("ScreamRemotes")
local action=remotes:WaitForChild("Action")
local gui=Instance.new("ScreenGui");gui.Name="ScreamUI";gui.ResetOnSpawn=false;gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling;gui.Parent=p:WaitForChild("PlayerGui")
local dark=Color3.fromRGB(10,16,31);local panel=Color3.fromRGB(23,34,55);local gold=Color3.fromRGB(80,226,255);local white=Color3.fromRGB(240,247,255);local muted=Color3.fromRGB(159,178,207)
local data={level=1,xp=0,xpNext=Config.XPToNext(1),coins=0,health=100,sound="TinyAah",aura="Gold",quests={},settings={volume=.55,reducedShake=false}}
local function frame(parent,name,size,pos,color)
 local f=Instance.new("Frame");f.Name=name;f.Size=size;f.Position=pos;f.BackgroundColor3=color or dark;f.BorderSizePixel=0;f.Parent=parent
 local c=Instance.new("UICorner");c.CornerRadius=UDim.new(0,10);c.Parent=f;return f
end
local function label(parent,text,size,pos,fontSize,color)
 local l=Instance.new("TextLabel");l.Size=size;l.Position=pos;l.BackgroundTransparency=1;l.Text=text;l.TextSize=fontSize or 15;l.Font=Enum.Font.GothamMedium;l.TextColor3=color or white;l.TextXAlignment=Enum.TextXAlignment.Left;l.TextWrapped=true;l.Parent=parent;return l
end
local function button(parent,name,text,size,pos,callback,color)
 local b=Instance.new("TextButton");b.Name=name;b.Size=size;b.Position=pos;b.BackgroundColor3=color or panel;b.TextColor3=white;b.Text=text;b.TextSize=14;b.Font=Enum.Font.GothamBold;b.AutoButtonColor=true;b.BorderSizePixel=0;b.Parent=parent
 local c=Instance.new("UICorner");c.CornerRadius=UDim.new(0,8);c.Parent=b;b.Activated:Connect(callback);return b
end
local top=frame(gui,"Navigation",UDim2.fromOffset(250,40),UDim2.fromOffset(14,12));top.BackgroundTransparency=1
local modal=frame(gui,"Menu",UDim2.fromOffset(720,520),UDim2.fromScale(.5,.5));modal.AnchorPoint=Vector2.new(.5,0);modal.ZIndex=10;modal.Visible=false
local menuEdge=Instance.new("UIStroke");menuEdge.Color=gold;menuEdge.Transparency=.5;menuEdge.Parent=modal
modal.BackgroundColor3=Color3.new(1,1,1)
local menuGlow=Instance.new("UIGradient");menuGlow.Color=ColorSequence.new(Color3.fromRGB(36,50,76),dark);menuGlow.Rotation=80;menuGlow.Parent=modal
local brandStripe=frame(modal,"SignalStripe",UDim2.new(1,-44,0,2),UDim2.fromOffset(22,8),gold)
local menuScale=Instance.new("UIScale");menuScale.Parent=modal
local title=label(modal,"BEAM COLLECTION",UDim2.new(1,-85,0,36),UDim2.fromOffset(22,15),23,gold)
local subtitle=label(modal,"Train for XP. Unlock a new beam style every ten levels.",UDim2.new(1,-44,0,25),UDim2.fromOffset(22,52),14,muted)
button(modal,"Close","X",UDim2.fromOffset(44,44),UDim2.new(1,-56,0,10),function() modal.Visible=false end)
local content=Instance.new("ScrollingFrame");content.Name="Content";content.Size=UDim2.new(1,-40,1,-148);content.Position=UDim2.fromOffset(20,132);content.BackgroundTransparency=1;content.BorderSizePixel=0;content.ScrollBarThickness=4;content.AutomaticCanvasSize=Enum.AutomaticSize.Y;content.CanvasSize=UDim2.new();content.Parent=modal
local list=Instance.new("UIListLayout");list.Padding=UDim.new(0,10);list.SortOrder=Enum.SortOrder.LayoutOrder;list.Parent=content
local selected="Shop";local render;local tabs={};local mapDot;local devPanel;local narrow=false;local lastLayoutWidth=0
local conversationPanel,showConversation,closeConversation
local function toggleTab(name)
 local opening=not modal.Visible or selected~=name
 selected=name;modal.Visible=opening
 if opening then
  if name=="Shop" then action:FireServer("ShopRefresh") end
  if closeConversation then closeConversation() end
  if devPanel then devPanel.Visible=false end
  render()
 end
end
local function toggle()
 if modal.Visible then modal.Visible=false else toggleTab(selected) end
end
local shop=button(top,"ShopToggle","SHOP  [B]",UDim2.fromOffset(125,36),UDim2.fromOffset(0,0),function() toggleTab("Shop") end,gold);shop.TextColor3=dark
local questsToggle=button(top,"QuestsToggle","QUESTS",UDim2.fromOffset(95,36),UDim2.fromOffset(134,0),function() toggleTab("Quests") end)
local hud=frame(gui,"CompactHUD",UDim2.fromOffset(242,94),UDim2.new(0,14,1,-108));hud.BackgroundTransparency=.08
frame(hud,"EnergyAccent",UDim2.new(1,-24,0,2),UDim2.fromOffset(12,2),gold)
local stats=label(hud,"LEVEL 1     •     0 coins",UDim2.new(1,-24,0,22),UDim2.fromOffset(12,7),14,gold)
local health=label(hud,"100 HP",UDim2.fromOffset(65,20),UDim2.fromOffset(12,31),12)
local hb=frame(hud,"HealthTrack",UDim2.fromOffset(142,6),UDim2.fromOffset(83,38),panel)
local hf=frame(hb,"Fill",UDim2.fromScale(1,1),UDim2.new(),Color3.fromRGB(105,224,158))
local displayedHealth,displayedMaximum
local function refreshHealth()
 local character=p.Character
 local humanoid=character and character:FindFirstChildOfClass("Humanoid")
 -- Keep the last observed value between characters; a generic server snapshot
 -- must not briefly show full health over a dead or missing character.
 if not humanoid and displayedHealth~=nil then return end
 local maximum=math.max(1,humanoid and humanoid.MaxHealth or data.maxHealth or 100)
 local current=math.clamp(humanoid and humanoid.Health or data.health or maximum,0,maximum)
 if current==displayedHealth and maximum==displayedMaximum then return end
 displayedHealth,displayedMaximum=current,maximum
 health.Text=string.format("%d/%d",math.ceil(current),math.ceil(maximum))
 hf.Size=UDim2.fromScale(current/maximum,1)
end
local xpText=label(hud,"0 / 103 XP",UDim2.new(1,-24,0,19),UDim2.fromOffset(12,52),12,muted)
local xb=frame(hud,"XPTrack",UDim2.fromOffset(218,4),UDim2.fromOffset(12,79),panel)
local xf=frame(xb,"Fill",UDim2.fromScale(0,1),UDim2.new(),gold)
local zone=label(gui,"SAFE CITY • PvP off",UDim2.fromOffset(240,28),UDim2.new(.5,-120,0,12),13);zone.TextXAlignment=Enum.TextXAlignment.Center
local tracked=label(gui,"",UDim2.fromOffset(290,50),UDim2.fromOffset(16,56),13);tracked.Name="QuestTracker";tracked.TextYAlignment=Enum.TextYAlignment.Top
tracked.BackgroundColor3=dark;tracked.BackgroundTransparency=.12
local trackerCorner=Instance.new("UICorner");trackerCorner.CornerRadius=UDim.new(0,8);trackerCorner.Parent=tracked
local trackerPadding=Instance.new("UIPadding");trackerPadding.PaddingLeft=UDim.new(0,6);trackerPadding.PaddingRight=UDim.new(0,6);trackerPadding.PaddingTop=UDim.new(0,4);trackerPadding.PaddingBottom=UDim.new(0,4);trackerPadding.Parent=tracked
local toast=label(gui,"",UDim2.new(.7,0,0,48),UDim2.new(.15,0,.72,0),16,gold);toast.TextXAlignment=Enum.TextXAlignment.Center;toast.AnchorPoint=Vector2.new(.5,1);toast.Position=UDim2.fromScale(.5,.72)
toast.Name="Notification";toast.ZIndex=30;toast.BackgroundColor3=dark;toast.BackgroundTransparency=.08;toast.Visible=false
local saveNotice=label(gui,"",UDim2.fromOffset(250,28),UDim2.new(.5,-125,0,40),12,gold);saveNotice.TextXAlignment=Enum.TextXAlignment.Center
local notifications=require(script.Parent:WaitForChild("NotificationQueue")).new()
local toastWidth=0
local function notify(t,urgent,key) notifications:Push(t,urgent,key) end
local nextCast=0;local sequence=0;local captureSource=nil
local sustainedControl,sustainedRules
local windowFocused=true
local function cancelCapture()
 if sustainedControl then sustainedControl:Cancel();return end
 captureSource=nil;mic:Cancel();action:FireServer("CancelCast")
end
script.Destroying:Connect(function()
 p.CameraMode=originalCameraMode
 p.CameraMinZoomDistance=originalMinZoom;p.CameraMaxZoomDistance=originalMaxZoom
end)
local function blocked()
 local character=p.Character
 local humanoid=character and character:FindFirstChildOfClass("Humanoid")
 if not humanoid or humanoid.Health<=0 or humanoid.PlatformStand then return true end
 local now=workspace:GetServerTimeNow()
 return GuiService.MenuIsOpen or UIS:GetFocusedTextBox()~=nil or (conversationPanel and conversationPanel.Visible) or modal.Visible or (devPanel and devPanel.Visible) or not mic.ready or now<(p:GetAttribute("ProtectionEnds") or 0) or now<(p:GetAttribute("DodgeEnds") or 0) or now<(p:GetAttribute("KnockdownEnds") or 0)
end
local function beginCapture(source)
 if sustainedControl or captureSource or blocked() or os.clock()<nextCast then return end
 if mic:Begin() then sequence+=1;captureSource=source;action:FireServer("BeginCast",sequence) end
end
local function aimRay()
 local camera=workspace.CurrentCamera
 if not camera or camera.ViewportSize.X<2 or camera.ViewportSize.Y<2 then return nil end
 local location=UIS.TouchEnabled and camera.ViewportSize/2 or UIS:GetMouseLocation()
 local ray=camera:ViewportPointToRay(location.X,location.Y)
 local params=RaycastParams.new();params.FilterDescendantsInstances={p.Character};params.FilterType=Enum.RaycastFilterType.Exclude;params.RespectCanCollide=true
 return ray,workspace:Raycast(ray.Origin,ray.Direction*1000,params)
end
if remotes:GetAttribute("AutomaticVoice")==true then
 sustainedRules=require(RS.Shared:WaitForChild("SustainedAttack"))
 local VoiceActivation=require(RS.Shared:WaitForChild("VoiceActivation"))
 sustainedControl=require(script.Parent:WaitForChild("SustainedControls")).new(VoiceActivation.new(),
  function(verb,arg) action:FireServer(verb,arg) end,
  function()
   if not workspace.CurrentCamera then return nil end
   local ray,hit=aimRay()
   if not ray then return nil end
   return hit and hit.Position or ray.Origin+ray.Direction*1000
  end,function() notifications:Remove("voice") end)
 script.Destroying:Connect(function() sustainedControl:Destroy() end)
end
local function toggleVoice()
 if not sustainedControl then return end
 -- Pausing is always allowed; arming must be an available gameplay action.
 if not sustainedControl.armed and (not windowFocused or blocked()) then
  notify("Beams stay OFF. Finish mic setup or wait for gameplay to be ready, then turn them on.",true,"voice");return
 end
 sustainedControl:SetArmed(not sustainedControl.armed)
 notify(sustainedControl.armed and "Beams ON. Normal speech can fire attacks. Go quiet, then speak. Turn OFF to talk freely; voice chat is unchanged."
  or "Beams OFF. Talk freely without attacking. Voice chat is unchanged.",false,"voice")
end
local function screamToggleLabel(armed,touch)
 return (armed and "BEAMS: ON" or "BEAMS: OFF").."\n"..(touch and "Tap" or "[E]")..(armed and " to turn off" or " to turn on")
end
local function releaseCapture(source)
 if captureSource~=source then return end
 captureSource=nil
 if blocked() then cancelCapture();return end
 local power,reason=mic:Release();if power<.08 then action:FireServer("CancelCast");notify(reason or "Use your voice while holding attack.",true,"capture");return end
 local ray,hit=aimRay()
 if not ray then action:FireServer("CancelCast");return end
 action:FireServer("Cast",{sequence=sequence,power=power,aim=hit and hit.Position or ray.Origin+ray.Direction*1000})
 nextCast=os.clock()+4
end
local function dodge()
 cancelCapture()
 if not blocked() then action:FireServer("Dodge") end
end
