      <Item class="Script" referent="48">
        <Properties>
          <string name="Name">Health</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- This script intentionally replaces Roblox default health regeneration.
-- The server uses Shared.Healing: 20% after twelve seconds without dealing/taking damage.
