 for _,side in ipairs({-1,1}) do part(m,"MarketRoof",V(66,1,165),CFrame.new(x+side*30,27,z)*CFrame.Angles(0,0,side*-.16),Color3.fromRGB(109,137,118),Enum.Material.Metal) end
