    <Item class="ModuleScript" referent="27">
      <Properties>
        <string name="Name">CombatRules</string>
        <string name="Source"><![CDATA[local Config=require(game:GetService("ReplicatedStorage").Shared.Config)
local Rules={}
function Rules.CanCast(session,sound,now)
 return sound~=nil and sound.level<=session.data.level and now>=session.protectedUntil and now>=session.dodgingUntil and now>=session.nextCast and now>=(session.knockedUntil or 0)
end
function Rules.CanTarget(attackerPosition,targetPosition,targetProtectedUntil,now,radius)
 return Config.InArena(attackerPosition) and Config.InArena(targetPosition) and now>=targetProtectedUntil and (targetPosition-attackerPosition).Magnitude<=radius
end
function Rules.InBeam(origin,direction,target,length,width,targetRadius)
 local delta=target-origin;local along=delta:Dot(direction)
 if along<0 or along>length then return false end
 return (delta-direction*along).Magnitude<=width/2+(targetRadius or 0)
end
function Rules.VehicleSweep(previous,nextFrame,target,halfSize)
 local a=previous:PointToObjectSpace(target);local b=nextFrame:PointToObjectSpace(target)
 local delta=b-a;local enter,leave=0,1
 for _,axis in ipairs({"X","Y","Z"}) do
  local origin,speed,extent=a[axis],delta[axis],halfSize[axis]
  if math.abs(speed)<.00001 then if math.abs(origin)>extent then return false end
  else
   local near,far=(-extent-origin)/speed,(extent-origin)/speed
   if near>far then near,far=far,near end
   enter=math.max(enter,near);leave=math.min(leave,far);if enter>leave then return false end
  end
 end
 return true
end
return Rules
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="28">
      <Properties>
        <string name="Name">Commerce</string>
        <string name="Source"><![CDATA[-- Separate atomic purchase ledger: gameplay profile snapshots never write it.
local Marketplace=game:GetService("MarketplaceService")
local Players=game:GetService("Players")
local Run=game:GetService("RunService")
local Http=game:GetService("HttpService")
local Catalog=require(game:GetService("ReplicatedStorage").Shared.ShopCatalog)
local Ledger=require(game:GetService("ReplicatedStorage").Shared.BoostLedger)
local Config=require(game:GetService("ReplicatedStorage").Shared.Config)
local Entitlements=require(script.Parent.Entitlements)
local Commerce={}
local cache,locks,promptAt={},{},{}
local loadAt,activateAt={},{}
local allowed,changed,store
local function database()
 if Run:IsStudio() then return end
 if not store then
  local ok,value=pcall(function() return game:GetService("DataStoreService"):GetDataStore("ScreamSimulator_Purchases_v1") end)
  if ok then store=value end
 end
 return store
end
local function transact(player,transform)
 local db=database();if not db then return false end
 local id=player.UserId
 while locks[id] do task.wait(.05) end
 -- A leave, unavailable profile or test command may have happened while waiting.
 if not player.Parent or not allowed(player) then return false end
 locks[id]=true
 local success,result
 for attempt=1,3 do
  success,result=pcall(function() return db:UpdateAsync("Player_"..id,transform) end)
  if success then break end
  task.wait(attempt)
 end
 if success and result then
  if player.Parent then cache[player]=Ledger.Normalize(result) end
 elseif not success then cache[player]=nil end -- never grant from an ambiguous write
 locks[id]=nil
 return success and result~=nil
end
function Commerce.Load(player)
 if not database() or not allowed(player) then return end
 if os.clock()<(loadAt[player] or 0) or locks[player.UserId] then return end
 loadAt[player]=os.clock()+15
 local ok=transact(player,Ledger.Normalize)
 if ok and player.Parent then changed(player) end
end
function Commerce.Status(player)
 local d=cache[player]
 return {ready=d~=nil and allowed(player),inventory=d and d.inventory or {xp=0,coins=0},ends=d and d.ends or {xp=0,coins=0},serverNow=os.time()}
end
function Commerce.Multiplier(player,kind) return Ledger.Multiplier(cache[player],kind,os.time()) end
function Commerce.Busy(player) return locks[player.UserId]==true end
function Commerce.Activate(player,kind)
 if (kind~="xp" and kind~="coins") or not allowed(player) or not cache[player] then return end
 if os.clock()<(activateAt[player] or 0) or locks[player.UserId] then return end
 activateAt[player]=os.clock()+2
 local operation=Http:GenerateGUID(false);local started=os.time()
 local ok=transact(player,function(raw)
  local data=Ledger.Activate(raw,kind,operation,started,os.time())
  return data -- UpdateAsync's second return is user IDs, not a status string.
 end)
 if player.Parent then changed(player,ok and "Boost activated · 30 minutes added" or "Boost not activated. Check your inventory and try again.",nil,not ok) end
end
function Commerce.Prompt(player,key)
 local item=Catalog.Get(key)
 if not item or Run:IsStudio() or not allowed(player) then changed(player,"Purchases are unavailable in this session.",nil,true);return end
 local id=item.key=="Movement" and Config.MovementPassId or item.id
 if type(id)~="number" or id<=0 then changed(player,"This unlock is coming soon.",nil,true);return end
 if os.clock()<(promptAt[player] or 0) then return end
 promptAt[player]=os.clock()+3
 if item.kind=="product" and not cache[player] then changed(player,"Loading your purchases. Please try again.",nil,true);task.spawn(Commerce.Load,player);return end
 if item.kind=="product" then
  local count=0;for _ in pairs(cache[player].receipts) do count+=1 end
  if Catalog.Product(id)~=item or count>=Ledger.ReceiptLimit or math.max(os.time(),cache[player].ends[item.boost])>Ledger.MaxExpiry-Ledger.Duration then
   changed(player,"This purchase is currently unavailable.",nil,true);return
  end
 end
 if item.key=="Spectrum" and Entitlements.HasSpectrum(player) or item.key=="Movement" and Entitlements.HasMovement(player) then return end
 local ok=pcall(function()
  if item.kind=="pass" then Marketplace:PromptGamePassPurchase(player,id)
  else Marketplace:PromptProductPurchase(player,id) end
 end)
 if not ok then changed(player,"Roblox could not open this purchase. Please try again.",nil,true) end
end
function Commerce.Start(canPurchase,onChanged)
 assert(not allowed,"Commerce already started")
 allowed=canPurchase;changed=onChanged
 Marketplace.ProcessReceipt=function(receipt)
  local item=Catalog.Product(receipt.ProductId)
  local player=Players:GetPlayerByUserId(receipt.PlayerId)
  if not item or not player or Run:IsStudio() or not allowed(player) then return Enum.ProductPurchaseDecision.NotProcessedYet end
  local ok=transact(player,function(raw)
   local data=Ledger.GrantActive(raw,receipt.PurchaseId,item.boost,os.time())
   return data
  end)
  if not ok then return Enum.ProductPurchaseDecision.NotProcessedYet end
  if player.Parent then changed(player,"Boost purchase processed. Check the shop for your current boost status.") end
  return Enum.ProductPurchaseDecision.PurchaseGranted
 end
 Players.PlayerRemoving:Connect(function(player) cache[player]=nil;promptAt[player]=nil;loadAt[player]=nil;activateAt[player]=nil end)
end
return Commerce
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="29">
      <Properties>
        <string name="Name">Destruction</string>
        <string name="Source"><![CDATA[local Players=game:GetService('Players')
local Collection=game:GetService('CollectionService')
local Rules=require(game.ReplicatedStorage.Shared.DestructionRules)
local RepairTimer=require(script.Parent.RepairTimer)
local Service={objects={},ids={}}
function Service.Register(model)
 if Service.objects[model] then return end
 local kind=model:GetAttribute('DestructibleType');local spec=Rules.Types[kind]
 if not spec then return end
 local parts={}
 for _,part in ipairs(model:GetDescendants()) do
  if part:IsA('BasePart') then parts[part]={color=part.Color,transparency=part.Transparency,collide=part.CanCollide,query=part.CanQuery,touch=part.CanTouch,seatDisabled=part:IsA("Seat") and part.Disabled or false} end
 end
 if next(parts)==nil then return end
 local cf,size=model:GetBoundingBox()
 local id=string.format("%s:%.3f:%.3f:%.3f",kind,cf.Position.X,cf.Position.Y,cf.Position.Z)
 if Service.ids[id] and Service.ids[id]~=model then warn("Duplicate destructible position",id);return end
 Service.ids[id]=model;model:SetAttribute("ObjectId",id)
 Service.objects[model]={parts=parts,kind=kind,health=spec.health,box=cf,size=size,version=0,prompts={}}
 for _,item in ipairs(model:GetDescendants()) do if item:IsA("ProximityPrompt") then Service.objects[model].prompts[item]=item.Enabled end end
 model:SetAttribute('ObjectName',spec.name);model:SetAttribute('ObjectHealth',spec.health);model:SetAttribute('ObjectMaxHealth',spec.health);model:SetAttribute('RequiredLevel',spec.level);model:SetAttribute('Destroyed',false);model:SetAttribute('RepairBlocked',false)
end
local function occupied(object)
 local characters={};for _,p in ipairs(Players:GetPlayers()) do if p.Character then table.insert(characters,p.Character) end end
 local world=Service.world
 if world then for _,model in ipairs(game:GetService("CollectionService"):GetTagged("CityResident")) do if model:IsDescendantOf(world) then table.insert(characters,model) end end end
 if #characters==0 then return false end
 local params=OverlapParams.new();params.FilterType=Enum.RaycastFilterType.Include;params.FilterDescendantsInstances=characters;params.MaxParts=1;params.RespectCanCollide=false
 return #workspace:GetPartBoundsInBox(object.box,object.size+Vector3.new(2,3,2),params)>0
end
local function restore(model,object,version)
 if not model.Parent or Service.objects[model]~=object or object.version~=version then return true end
 if occupied(object) then return false end
 local spec=Rules.Types[object.kind];object.health=spec.health
 for part,original in pairs(object.parts) do if part.Parent then part.Transparency=original.transparency;part.CanCollide=original.collide;part.CanQuery=original.query;part.CanTouch=original.touch;part.Color=original.color;if part:IsA("Seat") then part.Disabled=original.seatDisabled end end end
 for prompt,enabled in pairs(object.prompts) do if prompt.Parent then prompt.Enabled=enabled end end
 model:SetAttribute('ObjectHealth',spec.health);model:SetAttribute('Destroyed',false);model:SetAttribute('RepairBlocked',false);model:SetAttribute('RepairAt',0);model:SetAttribute('DamageStage',0)
 return true
end
function Service.Damage(instance,level,damage)
 local model=instance
 while model and not Service.objects[model] do model=model.Parent end
 local object=model and Service.objects[model]
 if not object then return nil end
 local health,destroyed,reason=Rules.Hit(object.kind,level,object.health,damage)
 if reason then return {model=model,reason=reason,required=Rules.Types[object.kind].level} end
 object.health=health;object.lastDamaged=os.clock();model:SetAttribute('ObjectHealth',health)
 local ratio=health/Rules.Types[object.kind].health;model:SetAttribute('DamageStage',destroyed and 3 or ratio<.35 and 2 or ratio<.7 and 1 or 0)
 for part,original in pairs(object.parts) do if part.Parent then
  if destroyed then part.Transparency=1;part.CanCollide=false;part.CanQuery=false;part.CanTouch=false;if part:IsA("Seat") then if part.Occupant then part.Occupant.Sit=false end;part.Disabled=true end
  else part.Color=original.color:Lerp(Color3.fromRGB(90,76,67),(1-ratio)*.45) end
 end end
 if destroyed then
  for prompt in pairs(object.prompts) do if prompt.Parent then prompt.Enabled=false end end
  model:SetAttribute('Destroyed',true)
 end
 -- Every accepted hit restarts repair, including damage that leaves the object standing.
 -- A single pending callback follows the latest deadline instead of accumulating per-hit tasks.
 object.version+=1;local duration=Rules.Types[object.kind].repair
 model:SetAttribute('RepairBlocked',false);model:SetAttribute('RepairAt',workspace:GetServerTimeNow()+duration)
 if not object.timer then
  object.timer=RepairTimer.new(os.clock,task.delay,
   function() return model.Parent~=nil and Service.objects[model]==object end,
   function()
    -- A maintenance worker may have repaired it while this timer was waiting.
    if object.health>=Rules.Types[object.kind].health then return true end
    return restore(model,object,object.version)
   end,
   function(delay) model:SetAttribute("RepairBlocked",true);model:SetAttribute("RepairAt",workspace:GetServerTimeNow()+delay) end)
 end
 object.timer:Touch(duration)
 return {model=model,destroyed=destroyed,health=health,kind=object.kind,position=object.box.Position}
end
-- Local maintenance complements the automatic repair timer. A worker must
-- physically reach the object and finish its work after a quiet interval.
function Service.MaintenanceTarget(origin,radius)
 local candidates={}
 for model,object in pairs(Service.objects) do
  if model.Parent and (object.kind=="Bench" or object.kind=="Bin")
   and object.health<Rules.Types[object.kind].health and os.clock()-(object.lastDamaged or os.clock())>=45
   and (object.box.Position-origin).Magnitude<=radius then
   table.insert(candidates,{model=model,object=object,distance=(object.box.Position-origin).Magnitude})
  end
 end
 table.sort(candidates,function(a,b) return a.distance<b.distance end)
 for _,candidate in ipairs(candidates) do
  local object=candidate.object
  if not occupied(object) then
   local approach
   for _,offset in ipairs({Vector3.new(object.size.X/2+2.4,0,0),Vector3.new(-object.size.X/2-2.4,0,0),Vector3.new(0,0,object.size.Z/2+2.4),Vector3.new(0,0,-object.size.Z/2-2.4)}) do
    local p=object.box:PointToWorldSpace(offset);p=Vector3.new(p.X,origin.Y,p.Z)
    if not approach or (p-origin).Magnitude<(approach-origin).Magnitude then approach=p end
   end
   return {position=approach,lookAt=object.box.Position,action="Repairing "..Rules.Types[object.kind].name:lower(),maintenanceModel=candidate.model,maintenanceVersion=object.version}
  end
 end
end
function Service.FinishMaintenance(station,workerPosition)
 local model=station.maintenanceModel;local object=Service.objects[model]
 if not object or not model.Parent or object.version~=station.maintenanceVersion
  or (object.kind~="Bench" and object.kind~="Bin") or object.health>=Rules.Types[object.kind].health
  or os.clock()-(object.lastDamaged or os.clock())<45 or (workerPosition-station.position).Magnitude>2
  or (workerPosition-object.box.Position).Magnitude>12 or occupied(object) then return false end
 -- Invalidate the old timer only after all safety checks pass.
 object.version+=1;restore(model,object,object.version)
 return true
end
function Service.Start(world)
 Service.generation=(Service.generation or 0)+1;local generation=Service.generation
 Service.objects={};Service.ids={};Service.world=world
 for _,model in ipairs(Collection:GetTagged('CityDestructible')) do if model:IsDescendantOf(world) then Service.Register(model) end end
 if Service.added then Service.added:Disconnect() end
 Service.added=Collection:GetInstanceAddedSignal('CityDestructible'):Connect(function(model) if Service.generation==generation and model:IsDescendantOf(world) then task.defer(function() if Service.generation==generation and model:IsDescendantOf(world) and Collection:HasTag(model,"CityDestructible") then Service.Register(model) end end) end end)
 if Service.removed then Service.removed:Disconnect() end
 Service.removed=Collection:GetInstanceRemovedSignal("CityDestructible"):Connect(function(model) if Service.generation~=generation then return end;local id=model:GetAttribute("ObjectId");if id and Service.ids[id]==model then Service.ids[id]=nil end;Service.objects[model]=nil end)
end
return Service
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="30">
      <Properties>
        <string name="Name">DeveloperAccess</string>
        <string name="Source"><![CDATA[local Access = {}

-- This is the account that owns the published Scream Simulator experience.
-- Studio is supplied by server RunService, never by a client argument.
-- The client only receives visibility; every test command is checked again here.
Access.OwnerUserId = 11499795799

function Access.IsAuthorized(player, creatorType, creatorId, isStudio)
    return player ~= nil and (isStudio == true or (player.UserId == Access.OwnerUserId
        and creatorType == Enum.CreatorType.User
        and creatorId == Access.OwnerUserId))
end

return Access
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="31">
      <Properties>
        <string name="Name">Entitlements</string>
        <string name="Source"><![CDATA[-- Server-owned entitlement cache. A zero ID disables purchases and paid benefits.
local Marketplace=game:GetService("MarketplaceService")
local Players=game:GetService("Players")
local Config=require(game.ReplicatedStorage.Shared.Config)
local Catalog=require(game.ReplicatedStorage.Shared.ShopCatalog)
local Entitlements={}
local spectrum={}
local owned={}
local testOwned={}
function Entitlements.SetStudioMovement(player,enabled)
 if not game:GetService("RunService"):IsStudio() then return false end
 testOwned[player]=enabled==true
 return true
end
function Entitlements.HasStudioMovement(player)
 return game:GetService("RunService"):IsStudio() and testOwned[player]==true
end
function Entitlements.Refresh(player)
 local spectrumId=Catalog.Get("Spectrum").id
 if spectrumId>0 then
  local success,result=pcall(Marketplace.UserOwnsGamePassAsync,Marketplace,player.UserId,spectrumId)
  if player.Parent and success then spectrum[player]=result==true end
 else spectrum[player]=false end
 local id=Config.MovementPassId
 if type(id)~="number" or id<=0 then owned[player]=false;return false end
 local success,result=pcall(Marketplace.UserOwnsGamePassAsync,Marketplace,player.UserId,id)
 if player.Parent and success then owned[player]=result==true end
 return owned[player]==true
end
function Entitlements.HasSpectrum(player) return spectrum[player]==true end
function Entitlements.HasMovement(player)
 return owned[player]==true or Entitlements.HasStudioMovement(player)
end
function Entitlements.CanUseMovement(player,position)
 return Entitlements.HasMovement(player) and not Config.InArena(position)
end
Marketplace.PromptGamePassPurchaseFinished:Connect(function(player,id,purchased)
 if (id==Config.MovementPassId or id==Catalog.Get("Spectrum").id) and purchased then task.spawn(Entitlements.Refresh,player) end
end)
Players.PlayerRemoving:Connect(function(player) owned[player]=nil;testOwned[player]=nil;spectrum[player]=nil end)
return Entitlements
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="32">
      <Properties>
        <string name="Name">Equipment</string>
        <string name="Source"><![CDATA[-- Original handheld amplifier geometry; gameplay power remains server-calculated in VoiceCombat.
local Equipment={}
local function piece(model,torso,name,size,offset,color,shape)
 local part=Instance.new("Part");part.Name=name;part.Size=size;part.Color=color;part.Material=Enum.Material.SmoothPlastic
 part.CanCollide=false;part.CanTouch=false;part.CanQuery=false;part.Massless=true;part.CFrame=torso.CFrame*offset
 if shape then part.Shape=shape end
 part.Parent=model
 local weld=Instance.new("WeldConstraint");weld.Part0=torso;weld.Part1=part;weld.Parent=part
 return part
end
function Equipment.Sync(player,equipped)
 local character=player.Character;if not character then return end
 local existing=character:FindFirstChild("MicroSpeakerAccessory")
 if not equipped then if existing then existing:Destroy() end;return end
 if existing then return end
 local hand=character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm");if not hand then return end
 local model=Instance.new("Model");model.Name="MicroSpeakerAccessory"
 -- R15 grips at the palm; R6 grips at the end of its full-length arm.
 local grip=CFrame.new(0,-hand.Size.Y/2+.15,-.25)
 local function add(name,size,offset,color,shape) return piece(model,hand,name,size,grip*offset,color,shape) end
 add("Grip",Vector3.new(.25,.6,.25),CFrame.new(0,0,0),Color3.fromRGB(46,57,64))
 add("Enclosure",Vector3.new(.72,.78,.5),CFrame.new(0,.42,-.28),Color3.fromRGB(38,56,62))
 add("GoldTrim",Vector3.new(.64,.7,.06),CFrame.new(0,.42,-.56),Color3.fromRGB(232,186,92))
 add("SpeakerGrille",Vector3.new(.54,.58,.06),CFrame.new(0,.42,-.6),Color3.fromRGB(36,42,47))
 for i=-2,2 do add("GrilleSlot",Vector3.new(.43,.025,.02),CFrame.new(0,.42+i*.1,-.64),Color3.fromRGB(98,117,120)) end
 add("StatusLight",Vector3.new(.08,.08,.04),CFrame.new(.23,.7,-.65),Color3.fromRGB(119,233,182),Enum.PartType.Ball).Material=Enum.Material.Neon
 model.Parent=character
end
return Equipment
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="33">
      <Properties>
        <string name="Name">Fountain</string>
        <string name="Source"><![CDATA[-- Shared collision and water with a client-selected mesh or built-in fallback.
local Install={}
function Install.create(template,parent,origin)
 local m=Instance.new("Model");m.Name="MosaicFountain";m.ModelStreamingMode=Enum.ModelStreamingMode.Atomic
 local visual=template:Clone();visual.Name="DetailedVisual";visual.Parent=m
 for _,item in visual:GetDescendants() do
  if item:IsA("LuaSourceContainer") or item:IsA("PackageLink") then item:Destroy()
  elseif item:IsA("BasePart") then
   item.Anchored=true;item.CanCollide=false;item.CanTouch=false;item.CanQuery=false
  end
 end
 visual:ScaleTo(2)
 local box,size=visual:GetBoundingBox()
 visual:PivotTo(CFrame.new(origin+Vector3.new(0,size.Y/2,0))*box:ToObjectSpace(visual:GetPivot()))
 local fallback=Instance.new("Model");fallback.Name="FallbackVisual";fallback.Parent=m
 local function disk(name,radius,height,y,color,solid)
  local p=Instance.new("Part")
  p.Name=name;p.Shape=Enum.PartType.Cylinder
  p.Size=Vector3.new(height,radius*2,radius*2)
  p.CFrame=CFrame.new(origin+Vector3.new(0,y,0))*CFrame.Angles(0,0,math.pi/2)
  p.Anchored=true;p.CanCollide=solid;p.CanTouch=false;p.CanQuery=solid
  p.Color=color;p.CastShadow=false;p.Parent=m
  return p
 end
 -- One stable obstacle inside the original 32-stud navigation exclusion.
 -- Render meshes never use generated convex-hull collisions.
 local collider=disk("FountainCollision",14,5,2.5,Color3.new(),true)
 collider.Transparency=1
 local column=disk("ColumnCollision",2.5,14,10,Color3.new(),true);column.Transparency=1
 local bowl=disk("BowlCollision",5.5,1,18,Color3.new(),true);bowl.Transparency=1
 local stone=Color3.fromRGB(207,191,159)
 local function fallbackDisk(name,radius,height,y,color)
  local p=disk(name,radius,height,y,color,false);p.Material=Enum.Material.Limestone;p.CastShadow=true;p.Parent=fallback
 end
 fallbackDisk("BasinBase",14,.8,.4,stone)
 fallbackDisk("PedestalFoot",3.2,1.2,1.4,stone)
 fallbackDisk("Pedestal",2.2,14.7,9.3,stone)
 fallbackDisk("Bowl",5.5,1.1,17.9,stone)
 -- Separate rim segments leave the shared water visible in the fallback.
 for i=0,11 do
  local a=i*math.pi/6
  local rim=Instance.new("Part");rim.Name="StoneRim";rim.Size=Vector3.new(7.2,4.2,1.4)
  rim.CFrame=CFrame.new(origin+Vector3.new(math.sin(a)*12.9,2.8,math.cos(a)*12.9))*CFrame.Angles(0,a,0)
  rim.Anchored=true;rim.CanCollide=false;rim.CanTouch=false;rim.CanQuery=false;rim.Material=Enum.Material.Limestone;rim.Color=stone;rim.Parent=fallback
  local tile=rim:Clone();tile.Name="MosaicBand";tile.Size=Vector3.new(6.7,1.6,.05)
  tile.CFrame=rim.CFrame*CFrame.new(0,0,.73);tile.Color=i%2==0 and Color3.fromRGB(40,125,150) or Color3.fromRGB(53,85,143);tile.Material=Enum.Material.CeramicTiles;tile.Parent=fallback
 end
 local water=disk("BasinWater",11.35,.12,3.45,Color3.fromRGB(63,169,184),false)
 water.Material=Enum.Material.Glass;water.Transparency=.25;water.Reflectance=.12
 local upper=disk("BowlWater",2.3,.1,18.4,Color3.fromRGB(91,189,204),false)
 upper.Material=Enum.Material.Glass;upper.Transparency=.25
 -- Curved continuous streams; no physics droplets or per-frame script.
 for i=0,3 do
  local a=i*math.pi/2
  local radial=Vector3.new(math.cos(a),0,math.sin(a))
  local start=Instance.new("Attachment");start.Name="Spout"..i
  start.Parent=collider
  start.WorldCFrame=CFrame.fromMatrix(origin+radial*5+Vector3.new(0,18.2,0),radial,Vector3.yAxis)
  local finish=Instance.new("Attachment");finish.Name="Splash"..i;finish.Parent=collider
  finish.WorldCFrame=CFrame.fromMatrix(origin+radial*9+Vector3.new(0,3.5,0),-Vector3.yAxis,radial)
  local stream=Instance.new("Beam");stream.Name="WaterStream"..i
  stream.Attachment0=start;stream.Attachment1=finish
  stream.Width0=.16;stream.Width1=.24;stream.CurveSize0=2;stream.CurveSize1=7
  stream.Segments=12;stream.FaceCamera=true
  stream.Color=ColorSequence.new(Color3.fromRGB(156,225,234))
  stream.Transparency=NumberSequence.new(.3);stream.LightInfluence=.7;stream.Parent=collider
 end
 m.Parent=parent
 game:GetService("CollectionService"):AddTag(m,"OptionalLandmarkVisual")
 return m
end
return Install
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="34">
      <Properties>
        <string name="Name">Profiles</string>
        <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local Lease=require(ReplicatedStorage.Shared.ProfileLease)
local RunService=game:GetService("RunService")
local HttpService=game:GetService("HttpService")
local owner=game.JobId~="" and game.JobId or HttpService:GenerateGUID(false)
local locks,owned,admissions={},{},{}
local bindings=setmetatable({},{__mode="k"})
local acquisition=0
local incarnation=HttpService:GenerateGUID(false)
local RECOVERY_WINDOW=12
-- Two normal 60-second autosave intervals of headroom at admission.
local MIN_ADMISSION_LIFETIME=120
local RECOVERY_NOTICE="Loaded the last confirmed save. Recent progress may be missing."
local Profiles = {}
local store
local storeReady, storeResult = pcall(function()
    return DataStoreService:GetDataStore(RunService:IsStudio() and "ScreamSimulator_Studio_v2" or "ScreamSimulator_v1")
end)
if storeReady then
    store = storeResult
else
    warn("ScreamSimulator save data unavailable; using temporary test profiles.")
end

local function wholeNumber(value, fallback, minimum, maximum)
    if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
        return fallback
    end
    return math.clamp(math.floor(value), minimum, maximum)
end

function Profiles.Default()
    return {schemaVersion=4,amplifierOwned=false,amplifierEquipped=false,achievements={},availableQuests={},coins=0,level=1,xp=0,sound="TinyAah",aura="Gold",quests={},combatChallenges={},settings={volume=0.55,reducedShake=false}}
end
function Profiles.Sanitize(raw)
    local data=Profiles.Default()
    if type(raw)~="table" then return data end
    -- Archive pre-cap progress once; never apply it to active level-100 combat.
    local legacy=type(raw.legacyProgress)=="table" and raw.legacyProgress or raw.schemaVersion~=4 and raw or nil
    if legacy then
        data.legacyProgress={level=wholeNumber(legacy.level,1,1,300),xp=wholeNumber(legacy.xp,0,0,1000000000)}
        if Config.GetSound(legacy.sound) then data.legacyProgress.sound=legacy.sound end
    end
    data.amplifierOwned=raw.amplifierOwned==true
    data.amplifierEquipped=data.amplifierOwned and raw.amplifierEquipped==true
    if type(raw.achievements)=="table" then
        for _,id in ipairs({"FoundNick","NickChampion","FirstBeam"}) do if raw.achievements[id]==true then data.achievements[id]=true end end
    end
    data.coins=wholeNumber(raw.coins,0,0,1000000000)
    data.level,data.xp=Config.Progression.Normalize(raw.level,raw.xp)
    if type(raw.combatChallenges)=="table" then
        -- Keep retired counters dormant under their original IDs. No conversion
        -- into another objective or reward; repeated save/load preserves history.
        for _,specs in ipairs({Config.Progression.Challenges,Config.Progression.RetiredChallenges or {}}) do
            for _,spec in ipairs(specs) do
                data.combatChallenges[spec.id]=wholeNumber(raw.combatChallenges[spec.id],0,0,spec.goal-1)
            end
        end
    end
    local sound=Config.GetSound(raw.sound)
    if sound then data.sound=(sound.level<=data.level and sound or Config.SoundForLevel(data.level)).id end
    if type(raw.customColor)=="string" and #raw.customColor==6 and raw.customColor:match("^%x+$") then data.customColor=raw.customColor:upper();data.useCustomColor=raw.useCustomColor==true end
    if type(raw.aura)=="string" and Config.Auras[raw.aura] then data.aura=raw.aura end
    if type(raw.availableQuests)=="table" then
        for _,q in ipairs(Config.Quests) do if raw.availableQuests[q.id]==true then data.availableQuests[q.id]=true end end
    end
    if type(raw.quests)=="table" then
        for _,q in ipairs(Config.Quests) do
            local old=raw.quests[q.id]
            if type(old)=="table" then data.availableQuests[q.id]=true;data.quests[q.id]={progress=wholeNumber(old.progress,0,0,q.goal),claimed=old.claimed==true} end
        end
    end
    if type(raw.settings)=="table" then
        local v=raw.settings.volume
        if type(v)=="number" and v==v then data.settings.volume=math.clamp(v,0,1) end
        data.settings.reducedShake=raw.settings.reducedShake==true
    end
    -- Preserve only the in-memory acquisition binding for legitimate baseline
    -- copies. No token is accepted from player data or persisted by Sanitize.
    bindings[data]=bindings[raw]
    -- Legacy shield and purchased-track fields are deliberately discarded.
    return data
end

-- Every retry uses the same immutable snapshot and (acquisition, revision).
-- An already committed operation is acknowledged without restamping its lease.
-- Callback retries must recheck the current record, not a cached ownership flag.
local function commit(userId,session,operation,deadline)
    for attempt=1,3 do
        if deadline and os.clock()>=deadline then break end
        local success,result=pcall(function()
            return store:UpdateAsync("Player_"..userId,function(raw)
                local saved=type(raw)=="table" and raw._save
                if type(saved)=="table" and saved.token==session.token and saved.revision==operation.revision then return raw end
                if not Lease.Owns(raw,owner,session.token) then return nil end
                if type(saved)=="table" and saved.token==session.token and type(saved.revision)=="number" and saved.revision>=operation.revision then return nil end
                local record=Profiles.Sanitize(operation.snapshot)
                record._save={token=session.token,revision=operation.revision}
                if operation.release then return record end
                return Lease.Stamp(record,owner,os.time(),session.token)
            end)
        end)
        if success then
            if result==nil then return false,"ownership" end
            session.confirmed=Profiles.Sanitize(result)
            return true
        end
        warn("ScreamSimulator profile save failed",userId,attempt)
        if deadline then
            if attempt<3 then task.wait(math.max(0,math.min(attempt,deadline-os.clock()))) end
        else task.wait(attempt) end
    end
    return false,"retry"
end

-- A matching token alone is not enough to start writable gameplay. Slow
-- responses can consume the lease after the atomic callback has completed.
local function usableAcquisition(record,token)
    if not Lease.Owns(record,owner,token) then return false end
    local expires=record._lease.expires
    return type(expires)=="number" and expires<math.huge and expires-os.time()>=MIN_ADMISSION_LIFETIME
end

function Profiles.Load(userId)
    if not store then return Profiles.Default(),false,"Saving is unavailable. This session uses temporary progress." end
    while locks[userId] do task.wait(.05) end
    local previous=owned[userId]
    if previous and not previous.pending then
        return Profiles.Default(),false,"Your previous session is still saving. Rejoin shortly."
    end
    locks[userId]=true
    local admission=admissions[userId]
    local fallback=admission and admission.fallback or false
    local confirmed=previous and previous.confirmed or admission and admission.confirmed
    if previous then
        -- Recovery only runs on rejoin, within the same lock as acquisition.
        -- A slow engine request cannot be cancelled; the deadline bounds new
        -- attempts/backoff, not the duration of an already in-flight request.
        local recovered=commit(userId,previous,previous.pending,os.clock()+RECOVERY_WINDOW)
        fallback=not recovered
        confirmed=previous.confirmed
        owned[userId]=nil
    end
    if not admission then
        acquisition+=1
        -- Keep admission identity across unavailable/ambiguous acquisitions, but
        -- never retain the abandoned save operation or grant a writable handle.
        admission={token=owner..":"..incarnation..":"..acquisition,
            terminalToken=previous and previous.token,fallback=fallback,confirmed=confirmed}
        admissions[userId]=admission
    end
    local token=admission.token
    local observed,hadLease
    for attempt=1,3 do
        local success,result=pcall(function()
            return store:UpdateAsync("Player_"..userId,function(raw)
                observed=type(raw)=="table" and Profiles.Sanitize(raw) or nil
                hadLease=type(raw)=="table" and type(raw._lease)=="table" and not Lease.Owns(raw,owner,token)
                if not Lease.CanAcquire(raw,owner,os.time(),token) then
                    -- A terminal local release has finished its bounded retry.
                    -- Only its exact token may be replaced before expiry.
                    if not (admission.terminalToken and Lease.Owns(raw,owner,admission.terminalToken)) then return nil end
                end
                if Lease.Owns(raw,owner,token) then
                    if usableAcquisition(raw,token) then return raw end
                    -- Refresh only this exact, unconfirmed acquisition. Preserve
                    -- current stored data/markers, never an old local snapshot.
                    return Lease.Stamp(raw,owner,os.time(),token)
                end
                local record=Profiles.Sanitize(raw)
                record._save=type(raw)=="table" and raw._save or nil
                -- Retain a warning across a lost acquisition response.
                record._recovered=fallback or hadLease or false
                return Lease.Stamp(record,owner,os.time(),token)
            end)
        end)
        if success then
            if Lease.Owns(result,owner,token) then
                if usableAcquisition(result,token) then
                    admissions[userId]=nil;locks[userId]=nil
                    local data=Profiles.Sanitize(result)
                    local session={token=token,revision=0,confirmed=Profiles.Sanitize(result)}
                    owned[userId]=session;bindings[data]=session
                    local notice=result._recovered==true
                    return data,true,notice and RECOVERY_NOTICE or nil,notice
                end
                -- The response arrived too late. Recheck/renew atomically on
                -- the next bounded attempt; no writable handle exists yet.
                observed=Profiles.Sanitize(result)
                warn("ScreamSimulator profile acquisition lifetime too short",userId,attempt)
            else
                admissions[userId]=nil;locks[userId]=nil
                return observed or confirmed or Profiles.Default(),false,
                    RECOVERY_NOTICE.." Another session owns this profile; progress here is temporary. Rejoin shortly.",true
            end
        else
            warn("ScreamSimulator profile load failed",userId,attempt)
        end
        -- A callback may have read a durable checkpoint before the write or
        -- response failed. It is safe to display, never to grant ownership.
        confirmed=observed or confirmed
        admission.confirmed=confirmed
        task.wait(attempt)
    end
    locks[userId]=nil
    -- Never enable saving or overwrite storage with a default/cached fallback.
    return confirmed and Profiles.Sanitize(confirmed) or Profiles.Default(),false,
        (confirmed and RECOVERY_NOTICE.." " or "Could not confirm a saved profile. ").."Saving is unavailable; progress here is temporary.",confirmed~=nil
end

function Profiles.Save(userId,data,release)
    if not store then return false,"unavailable" end
    local session=owned[userId]
    if not session or bindings[data]~=session then return false,"ownership" end
    while locks[userId] do task.wait(.05) end
    if owned[userId]~=session or session.pending then return false,"ownership" end
    locks[userId]=true
    session.revision+=1
    local operation={snapshot=Profiles.Sanitize(data),release=release==true,revision=session.revision}
    local ok,reason=commit(userId,session,operation)
    if release and not ok then
        -- Keep only one frozen final snapshot. Caller tables may change later.
        session.pending=operation
    elseif reason=="ownership" or release then owned[userId]=nil end
    locks[userId]=nil
    return ok,reason
end

return Profiles
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="35">
      <Properties>
        <string name="Name">RepairTimer</string>
        <string name="Source"><![CDATA[-- One pending callback per object; clock/scheduler injected for deterministic tests.
local Timer={};Timer.__index=Timer
function Timer.new(clock,schedule,valid,repair,retry)
 return setmetatable({clock=clock,schedule=schedule,valid=valid,repair=repair,retry=retry,pending=false,due=0},Timer)
end
function Timer:Queue(delay)
 self.pending=true
 self.schedule(delay,function() self:Wake() end)
end
function Timer:Touch(duration)
 self.due=self.clock()+duration
 if not self.pending then self:Queue(duration) end
end
function Timer:Wake()
 if not self.valid() then self.pending=false;return end
 local remaining=self.due-self.clock()
 if remaining>1e-6 then self:Queue(remaining);return end
 if self.repair() then self.pending=false;return end
 self.due=self.clock()+5
 self.retry(5)
 self:Queue(5)
end
return Timer
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="36">
      <Properties>
        <string name="Name">SoccerChallenge</string>
        <string name="Source"><![CDATA[-- Personal server-owned challenge state; other players cannot collect or shoot your balls.
local Players=game:GetService("Players")
local Run=game:GetService("RunService")
local Rules=require(script.Parent.CombatRules)
local Soccer={}
local runs={}
local V=Vector3.new
local origin=V(615,2.2,550)
local lost={V(590,2.2,460),V(552,2.2,563),V(683,2.2,482)}
local gates={V(638,2.2,530),V(653,2.2,555),V(633,2.2,578),V(676,2.2,559)}
local obstacles={V(625,2.2,540),V(645,2.2,541),V(643,2.2,568),V(655,2.2,571)}
local goals={V(664,2.2,550),V(606,2.2,518),V(690,2.2,517),V(617,2.2,576),V(686,2.2,575)}
local function sphere(parent,name,size,color)
 local p=Instance.new("Part");p.Name=name;p.Shape=Enum.PartType.Ball;p.Size=V(size,size,size);p.Color=color;p.Material=Enum.Material.SmoothPlastic;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Parent=parent;return p
end
local function caption(part,text)
 local gui=Instance.new("BillboardGui");gui.Size=UDim2.fromOffset(190,38);gui.StudsOffset=V(0,3,0);gui.MaxDistance=35;gui.Parent=part
 local label=Instance.new("TextLabel");label.BackgroundTransparency=1;label.Size=UDim2.fromScale(1,1);label.Font=Enum.Font.GothamBold;label.TextSize=13;label.TextColor3=Color3.new(1,1,1);label.TextStrokeTransparency=.3;label.Text=text;label.Parent=gui
end
local function target(run,now)
 if run.phase=="Dribble" then return gates[run.stage] end
 local p=goals[run.stage]
 return p+(run.stage>=4 and V(math.sin((now-run.phaseStarted)*1.5)*5,0,0) or Vector3.zero)
end
function Soccer.Cancel(player)
 local run=runs[player];if run then runs[player]=nil;run.model:Destroy() end
end
function Soccer.Status(player)
 local run=runs[player];if not run then return nil end
 local detail=run.phase=="Find" and ("Find balls "..run.found.."/3") or run.phase=="Dribble" and ("Dribble gates "..(run.stage-1).."/4") or ("Moving targets "..(run.stage-1).."/5")
 return {phase=run.phase,detail=detail,remaining=math.max(0,math.ceil(run.deadline-os.clock()))}
end
local function setPhase(run,phase,seconds)
 run.phase=phase;run.phaseStarted=os.clock();run.deadline=run.phaseStarted+seconds;run.stage=1;run.position=origin;run.velocity=Vector3.zero
 run.model:SetAttribute("Phase",phase);run.ball.Position=origin;run.goal.Position=origin
 if phase~="Find" then
  run.ball.Transparency=0;run.goal.Transparency=.65;run.ball.Position=origin;run.goal.Position=target(run,os.clock())
 end
end
function Soccer.Collect(player,index)
 local run=runs[player];local point=type(index)=="number" and lost[index]
 local h=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
 local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 if not run or run.phase~="Find" or not point or run.collected[index] or not root or not h or h.Health<=0 or os.clock()>run.deadline or (root.Position-point).Magnitude>10 then return false end
 run.collected[index]=true;run.found+=1;run.lostParts[index]:Destroy()
 if run.found==3 then
  setPhase(run,"Dribble",90)
  for _,position in ipairs(obstacles) do
   for tier=1,3 do
    local cone=sphere(run.cones,"TrainingCone",2-tier*.4,Color3.fromRGB(238,141,63));cone.Shape=Enum.PartType.Cylinder;cone.Size=V(.7,2-tier*.4,2-tier*.4);cone.CFrame=CFrame.new(position.X,1.35+tier*.6,position.Z)*CFrame.Angles(0,0,math.pi/2)
   end
  end
  run.notify("Nick: Found them! Return to the court. Four dribble gates in 90 seconds—steer around the orange cones. Soft mic shots help!")
 else run.notify("Training ball "..run.found.."/3. Clues: north beach loungers, the pier's east side, and the path north of the court.") end
 return true
end
function Soccer.Start(player,notify,complete,failed)
 Soccer.Cancel(player)
 local model=Instance.new("Model");model.Name="SoccerAttempt_"..player.UserId;model:SetAttribute("OwnerUserId",player.UserId);model.Parent=workspace.ScreamSimulatorWorld
 local cones=Instance.new("Folder");cones.Name="CourseCones";cones.Parent=model
 local run={model=model,cones=cones,ball=sphere(model,"ChallengeBall",2.2,Color3.fromRGB(242,233,211)),goal=sphere(model,"Target",7,Color3.fromRGB(96,224,176)),found=0,collected={},lostParts={},notify=notify,complete=complete,failed=failed}
 run.ball.Transparency=1;run.goal.Transparency=1;run.goal.Material=Enum.Material.Neon
 caption(run.ball,player.DisplayName.." · Nick's challenge")
 setPhase(run,"Find",120);runs[player]=run
 for i,pos in ipairs(lost) do
  local part=sphere(model,"LostTrainingBall"..i,2.2,Color3.fromRGB(239,213,140));part.Position=pos;run.lostParts[i]=part
  caption(part,player.DisplayName.." · training ball")
  local prompt=Instance.new("ProximityPrompt");prompt.ActionText="Recover ball";prompt.ObjectText="Nick's lost training ball";prompt.KeyboardKeyCode=Enum.KeyCode.F;prompt.HoldDuration=.5;prompt.MaxActivationDistance=8;prompt.Parent=part
  prompt.Triggered:Connect(function(actor) if actor==player and runs[player]==run then Soccer.Collect(player,i) end end)
 end
 notify("Nick: I lost THREE balls. You have 120 seconds! Check the north beach loungers, east of the pier, and the path north of this court. Hold F nearby.")
end
function Soccer.Hit(player,beamOrigin,direction,length,width,power)
 local run=runs[player];if not run or run.phase=="Find" then return end
 if (run.position-beamOrigin).Magnitude>35 or not Rules.InBeam(beamOrigin,direction,run.position,length,width,1.1) then return end
 local flat=V(direction.X,0,direction.Z);if flat.Magnitude<.05 then return end
 run.velocity=flat.Unit*(12+math.clamp(power,0,1)*34)
 return true
end
local function segmentDistance(a,step,point)
 local denominator=step:Dot(step);local alpha=denominator>.000001 and math.clamp((point-a):Dot(step)/denominator,0,1) or 0
 return (a+step*alpha-point).Magnitude
end
Players.PlayerRemoving:Connect(Soccer.Cancel)
Run.Heartbeat:Connect(function(dt)
 dt=math.min(dt,.1);local now=os.clock()
 for player,run in pairs(runs) do
  local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
  local h=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
  if not root or not h or h.Health<=0 or now>run.deadline or (root.Position-V(647,4,547)).Magnitude>150 then
   local failed=run.failed;Soccer.Cancel(player)
   if failed then failed() else run.notify("Nick: Let's retry at the court!") end
   continue
  end
  if run.phase=="Find" then continue end
  local goal=target(run,now);run.goal.Position=goal
  local old=run.position;local step=run.velocity*dt;local nextPosition=old+step
  local blocked=false
  if run.phase=="Dribble" and run.velocity.Magnitude>1 then
   for _,cone in ipairs(obstacles) do if segmentDistance(old,step,cone)<2 then
    run.velocity=-run.velocity*.25;blocked=true
    if now>(run.nextConePenalty or 0) then run.deadline-=3;run.nextConePenalty=now+2;run.notify("Cone clipped! -3 seconds. Use softer shots around it.") end
    break
   end end
  end
  if nextPosition.X<592 or nextPosition.X>704 or nextPosition.Z<502 or nextPosition.Z>587 then
   run.position=origin;run.velocity=Vector3.zero;run.notify("Out of bounds! Ball reset; your completed gates remain, but the timer keeps running.")
  elseif not blocked then
   run.position=nextPosition;run.velocity*=math.exp(-1.05*dt)
   local radius=run.phase=="Dribble" and 4.5 or run.stage>=4 and 3.5 or 4.5
   if run.velocity.Magnitude>1 and segmentDistance(old,step,goal)<radius then
    run.stage+=1
    if run.phase=="Dribble" and run.stage>#gates then
     run.cones:ClearAllChildren();setPhase(run,"Targets",120)
     run.notify("Checkpoint! Five shots in 120 seconds. The last two targets move—and watch out for my terrible assist!")
    elseif run.phase=="Targets" and run.stage>#goals then
     local complete=run.complete;Soccer.Cancel(player);complete();continue
    else
     run.velocity*=.3
     if run.phase=="Targets" and run.stage==4 then run.velocity+=V(6,0,0);run.notify("Nick: My assist drifts RIGHT! Compensate before the moving target.")
     else run.notify((run.phase=="Dribble" and "Gate " or "Target ")..(run.stage-1).." cleared · "..math.ceil(run.deadline-now).."s left") end
    end
   end
  end
  run.ball.CFrame=CFrame.new(run.position)*CFrame.Angles(0,0,now*run.velocity.Magnitude*.25)
 end
end)
return Soccer
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="37">
      <Properties>
        <string name="Name">StreetArt</string>
        <string name="Source"><![CDATA[-- Original, asset-free courtyard murals. Decorative only: no navigation or combat geometry.
local Art={}
local colors={sand=Color3.fromRGB(243,213,162),sun=Color3.fromRGB(242,166,75),
 teal=Color3.fromRGB(55,133,137),coral=Color3.fromRGB(209,107,90),ink=Color3.fromRGB(39,71,78),
 leaf=Color3.fromRGB(98,144,103),cream=Color3.fromRGB(250,235,205)}
function Art.create(parent,cf,width,coastal)
 local wall=Instance.new("Part");wall.Name="CourtyardMural";wall.Size=Vector3.new(width,5.5,.06);wall.CFrame=cf
 wall.Anchored=true;wall.CanCollide=false;wall.CanTouch=false;wall.CanQuery=false;wall.CastShadow=false;wall.Color=colors.sand;wall.Parent=parent
 local canvas=Instance.new("SurfaceGui");canvas.Name="OriginalStreetArt";canvas.Face=Enum.NormalId.Front
 canvas.SizingMode=Enum.SurfaceGuiSizingMode.FixedSize;canvas.CanvasSize=Vector2.new(512,160)
 canvas.AlwaysOnTop=false;canvas.LightInfluence=1;canvas.MaxDistance=100;canvas.Parent=wall
 local function shape(name,x,y,w,h,color,round)
  local f=Instance.new("Frame");f.Name=name;f.BorderSizePixel=0;f.BackgroundColor3=color
  f.Position=UDim2.fromOffset(x,y);f.Size=UDim2.fromOffset(w,h);f.Parent=canvas
  if round then local corner=Instance.new("UICorner");corner.CornerRadius=UDim.new(.5,0);corner.Parent=f end
  return f
 end
 shape("Paper",0,0,512,160,colors.sand)
 shape("Sun",34,22,94,94,colors.sun,true)
 if coastal then
  shape("Horizon",0,94,512,66,colors.teal)
  for i=0,4 do
   local x=math.max(0,i*112-28)
   shape("SeaLight",x,110+(i%2)*17,math.min(84,512-x),8,colors.cream,true)
   shape("SeaShadow",i*112+10,139,math.min(60,502-i*112),7,colors.ink,true)
  end
  shape("Sail",151,32,8,62,colors.ink)
  local sail=shape("Sailcloth",163,40,42,42,colors.coral);sail.Rotation=12
 else
  for i=0,2 do
   local x=154+i*58;local y=39+(i%2)*20
   shape("Stem",x+13,y+23,5,97-y,colors.ink)
   local leaf=shape("Leaf",x-9,y+58,30,13,colors.leaf,true);leaf.Rotation=-25
   shape("Petal",x,y,32,32,i%2==0 and colors.coral or colors.teal,true)
   shape("FlowerCenter",x+10,y+10,12,12,colors.sun,true)
  end
  shape("Garden",0,143,512,17,colors.leaf)
 end
 local title=Instance.new("TextLabel");title.Name="MuralTitle";title.BackgroundTransparency=1
 title.Position=UDim2.fromOffset(335,24);title.Size=UDim2.fromOffset(157,64)
 title.Font=Enum.Font.GothamBold;title.TextColor3=colors.ink;title.TextSize=26;title.TextWrapped=true
 title.Text=coastal and "SOL I MAR" or "VIU EL BARRI";title.Parent=canvas
 return wall
end
return Art
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="38">
      <Properties>
        <string name="Name">SustainedAim</string>
        <string name="Source"><![CDATA[-- Reconstruct aim from a trusted server origin. Cover and target eligibility
-- must still be resolved from that origin by the server on each damage tick.
local function finite(n) return n==n and math.abs(n)<math.huge end
return function(origin,aim)
 if typeof(aim)~="Vector3" or not finite(aim.X) or not finite(aim.Y) or not finite(aim.Z) then return nil end
 local delta=aim-origin
 local distance=delta.Magnitude
 if not finite(distance) or distance<.01 or distance>2048 then return nil end
 return delta.Unit
end
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="39">
      <Properties>
        <string name="Name">SustainedAttackAdapter</string>
        <string name="Source"><![CDATA[-- Automatic voice server adapter. Context (including origin and character identity)
-- must come from the server; only aim, power and sequence fields come from remotes.
local Adapter={}
function Adapter.new(Attack, Combat, directionFor)
 local api={}
 local function validPower(power)
  return Combat.IsFinite(power) and power>=0 and power<=1
 end
 local function sampleIndex(n)
  return Combat.IsFinite(n) and n%1==0 and n>=1 and n<=2^31
 end
 function api.New()
  return {protocol=Attack.New()}
 end
 local function clear(s)
  s.intent=nil
 end
 function api.Begin(s,now,request,context)
  if type(request)~="table" then return false,"request" end
  local direction=context and directionFor(context.origin,request.aim)
  local power=validPower(request.power) and request.power or nil
  local level=context and Combat.Level(context.level) or 1
  local amplifier=context~=nil and context.amplifier==true
  local stats=power and Combat.Stats(level,power,amplifier)
  local ok,reason,ended=Attack.Begin(s.protocol,now,request.sequence,
   Combat.Stats(level,1,false).maxDps,stats and stats.power,
   context~=nil and context.character~=nil and direction~=nil)
  if not s.protocol.active then clear(s) end
  if ok then
   s.intent={character=context.character,level=level,amplifier=amplifier,aim=request.aim,sample=0}
  end
  return ok,reason,ended
 end
 function api.Pulse(s,now,request,context)
  local intent=s.intent;local active=s.protocol.active
  if type(request)~="table" or not intent or not active or request.sequence~=active.sequence then return false,"sequence" end
  if not sampleIndex(request.sample) or request.sample<=intent.sample then return false,"sample" end
  -- Consume even rate-rejected samples so delayed/replayed packets cannot revive input.
  intent.sample=request.sample
  local allowed=context~=nil and context.character==intent.character
   and directionFor(context.origin,request.aim)~=nil
  local power=validPower(request.power) and Combat.Stats(intent.level,request.power,intent.amplifier).power or nil
  local ok,reason,ended=Attack.Pulse(s.protocol,now,request.sequence,power,allowed)
  if ok then intent.aim=request.aim end
  if not s.protocol.active then clear(s) end
  return ok,reason,ended
 end
 function api.Stop(s,now,sequence)
  local ended,reason=Attack.Stop(s.protocol,now,sequence)
  if not s.protocol.active then clear(s) end
  return ended,reason
 end
 function api.Cancel(s,now)
  local ended,reason=Attack.Cancel(s.protocol,now)
  if not s.protocol.active then clear(s) end
  return ended,reason
 end
 function api.Step(s,now,context,resolve)
  local a=s.protocol.active;local intent=s.intent
  if not a then return {} end
  local allowed=intent~=nil and context~=nil and context.character==intent.character
  local direction=allowed and directionFor(context.origin,intent.aim)
  local ids,details,beam
  if direction and Attack.NeedsTargets(s.protocol,now) then
   -- Power was already amplified when accepted; do not amplify a second time.
   local stats=Combat.Stats(intent.level,a.power,false)
   ids,details,beam=resolve(context,direction,stats,now)
  end
  local hits,ended,reason=Attack.Step(s.protocol,now,direction~=nil and direction~=false,ids)
  if not s.protocol.active then clear(s) end
  return hits,ended,details,beam,reason
 end
 return api
end
return Adapter
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="40">
      <Properties>
        <string name="Name">World</string>
        <string name="Source"><![CDATA[local Config = require(game:GetService("ReplicatedStorage").Shared.Config)
local TrainingRules=require(game:GetService("ReplicatedStorage").Shared.TrainingRules)
local InteractionRules=require(game:GetService("ReplicatedStorage").Shared.InteractionRules)
local RunService = game:GetService("RunService")
local PathfindingService = game:GetService("PathfindingService")
local Collection=game:GetService("CollectionService")

local World = {}
World.ZoneMin = Config.ZoneMin
World.ZoneMax = Config.ZoneMax
World.SafeSpawn = CFrame.new(-600, 4, 210)
World.Cars = {}
local PhysicsService=game:GetService("PhysicsService")
local City=require(script.Parent.City)
World.Bots = {}
World.WalkPoints = {}
World.ActivityPoints = {}
World.Seats = {}

local rng = Random.new(8044)
local C = {
    road = Color3.fromRGB(43, 48, 54), concrete = Color3.fromRGB(184, 183, 171),
    gold = Color3.fromRGB(247, 192, 59), glass = Color3.fromRGB(76, 139, 159),
    dark = Color3.fromRGB(30, 50, 52), green = Color3.fromRGB(60, 126, 79),
}

local function part(parent, name, size, cf, color, material, solid)
    local p = Instance.new("Part")
    p.Name, p.Size = name, size
    p.CFrame = typeof(cf) == "CFrame" and cf or CFrame.new(cf)
    p.Anchored = true
    p.Color = color
    p.Material = material or Enum.Material.SmoothPlastic
    p.CanCollide = solid ~= false
    p.CanQuery = solid ~= false
    p.Parent = parent
    return p
end

local function billboard(parent, words, offset, width)
    local gui = Instance.new("BillboardGui")
    gui.Name = "Label"
    gui.Size = UDim2.fromOffset(math.min(width or 150, 180), 30)
    gui.StudsOffsetWorldSpace = offset
    gui.AlwaysOnTop = false
    gui.MaxDistance = 24
    gui.Parent = parent
    local text = Instance.new("TextLabel")
    text.Size = UDim2.fromScale(1, 1)
    text.BackgroundColor3 = C.dark
    text.BackgroundTransparency = 0.12
    text.TextColor3 = Color3.fromRGB(255, 247, 218)
    text.Font = Enum.Font.GothamBold
    text.TextSize = 12
    text.TextWrapped = true
    text.Text = words
    text.Parent = gui
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = text
    return text
end

local function vehicle(parent, kind, paint)
    local model = Instance.new("Model")
    model.Name = kind .. "Car"
    model.Parent = parent
    local body = part(model, "PaintedBody", Vector3.new(12, 1.8, 5.7), CFrame.new(), paint, Enum.Material.SmoothPlastic, false)
    model.PrimaryPart = body
    local hull=part(model,"CollisionHull",Vector3.new(12.6,4.2,6.2),CFrame.new(0,.55,0),paint,Enum.Material.SmoothPlastic,true)
    hull.Transparency=1;hull.CanTouch=true
    hull.CustomPhysicalProperties=PhysicalProperties.new(1,.35,0)
    model:SetAttribute("Vehicle",true)
    part(model, "LowerChassis", Vector3.new(12.5, 0.65, 5.9), CFrame.new(0, -0.85, 0),
        Color3.fromRGB(37, 43, 47), Enum.Material.Metal, false)
    part(model, "Hood", Vector3.new(3.1, 0.45, 5.35), CFrame.new(4.3, 1.03, 0), paint, Enum.Material.SmoothPlastic, false)
    part(model, "Trunk", Vector3.new(2.3, 0.35, 5.35), CFrame.new(-4.65, 1, 0), paint, Enum.Material.SmoothPlastic, false)
    part(model, "Cabin", Vector3.new(5.8, 1.8, 4.9), CFrame.new(-0.2, 1.8, 0),
        Color3.fromRGB(47, 72, 78), Enum.Material.Metal, false)
    part(model, "CabinRoof", Vector3.new(5.4, 0.25, 4.8), CFrame.new(-0.2, 2.78, 0), paint, Enum.Material.SmoothPlastic, false)
    for _, side in ipairs({-1, 1}) do
        local z = side * 2.52
        for _, x in ipairs({-1.45, 1.05}) do
            part(model, "SideGlass", Vector3.new(2, 1.25, 0.12), CFrame.new(x, 1.85, z),
                Color3.fromRGB(95, 150, 169), Enum.Material.Glass, false)
        end
        for _, x in ipairs({-4.2, 0.2}) do
            part(model, "DoorHandle", Vector3.new(0.85, 0.13, 0.15), CFrame.new(x, 0.38, side * 2.93),
                Color3.fromRGB(210, 218, 216), Enum.Material.Metal, false)
        end
        part(model, "SideMirror", Vector3.new(0.7, 0.35, 0.7), CFrame.new(2.65, 1.25, side * 3),
            Color3.fromRGB(42, 50, 54), Enum.Material.Metal, false)
        for _, x in ipairs({-3.85, 3.85}) do
            local tire = part(model, "RubberTire", Vector3.new(0.8, 2.1, 2.1),
                CFrame.new(x, -1.05, side * 2.83) * CFrame.Angles(0, math.pi / 2, 0),
                Color3.fromRGB(26, 29, 32), Enum.Material.Rubber, false)
            tire.Shape = Enum.PartType.Cylinder
            local hub = part(model, "WheelHub", Vector3.new(0.84, 1.05, 1.05),
                CFrame.new(x, -1.05, side * 3.27) * CFrame.Angles(0, math.pi / 2, 0),
                Color3.fromRGB(156, 165, 163), Enum.Material.Metal, false)
            hub.Shape = Enum.PartType.Cylinder
        end
        part(model, "Headlight", Vector3.new(0.2, 0.55, 1.1), CFrame.new(6.08, 0.3, side * 1.7),
            Color3.fromRGB(255, 239, 194), Enum.Material.Neon, false)
        part(model, "Taillight", Vector3.new(0.2, 0.58, 1.1), CFrame.new(-6.08, 0.3, side * 1.7),
            Color3.fromRGB(197, 58, 54), Enum.Material.Neon, false)
    end
    part(model, "Windshield", Vector3.new(0.18, 1.62, 4.55),
        CFrame.new(2.78, 1.8, 0) * CFrame.Angles(0, 0, math.rad(-23)),
        Color3.fromRGB(106, 162, 177), Enum.Material.Glass, false)
    part(model, "RearGlass", Vector3.new(0.18, 1.55, 4.55),
        CFrame.new(-3.15, 1.78, 0) * CFrame.Angles(0, 0, math.rad(22)),
        Color3.fromRGB(86, 139, 158), Enum.Material.Glass, false)
    part(model, "FrontGrille", Vector3.new(0.2, 0.65, 3), CFrame.new(6.12, -0.28, 0),
        Color3.fromRGB(45, 54, 59), Enum.Material.Metal, false)
    for _, x in ipairs({-6.2, 6.2}) do
        part(model, "Bumper", Vector3.new(0.35, 0.35, 5.75), CFrame.new(x, -0.75, 0),
            Color3.fromRGB(65, 73, 74), Enum.Material.Metal, false)
    end
    if kind == "Taxi" then
        part(model, "TaxiRoofSign", Vector3.new(2.8, 0.8, 1.35), CFrame.new(-0.2, 3.36, 0),
            Color3.fromRGB(252, 227, 161), Enum.Material.Neon, false)
        part(model, "TaxiChecker", Vector3.new(8, 0.25, 0.12), CFrame.new(0, -0.12, -2.94),
            Color3.fromRGB(44, 50, 52), Enum.Material.Metal, false)
    elseif kind == "Delivery" then
        part(model, "CargoRoof", Vector3.new(5.8, 0.7, 4.8), CFrame.new(-0.4, 3.17, 0),
            Color3.fromRGB(214, 212, 198), Enum.Material.Metal, false)
    end
    return model
end

local function taxi(parent, x, z, kind, paint)
    local car = vehicle(parent, kind or "Taxi", paint or Color3.fromRGB(244, 184, 42))
    car:PivotTo(CFrame.new(x, 2, z))
end

local names = {
    "Alex", "Jordan", "Sam", "Casey", "Taylor", "Riley", "Morgan", "Jamie", "Avery", "Cameron",
    "Drew", "Robin", "Parker", "Quinn", "Sky", "Hayden", "Blake", "Rowan", "Nico", "Ari",
    "Ellis", "Remy", "Sage", "Kit", "Milo", "Lena", "Zoe", "Noor", "Owen", "Jules",
    "Kai", "Maya", "Theo", "Ada", "Rafi", "Indie", "Marin", "Leo", "Nia", "Finn",
    "Uma", "Ezra", "Luca", "Iris", "Mira", "Dani", "June", "Sol", "Tess", "Jae", "Bea",
}
local lines = {"That was loud!", "Can you hear me?", "This city is wild!", "Nice beam!", "Watch out for the War Zone!", "I need some quiet.", "Whoa, my ears!", "You leveled up yet?"}
local roleLines = {
    CafeWorker = {"Two coffees for the terrace!", "The cups are hot. My jokes are lukewarm.", "Take a seat; the sea is the best view."},
    Sanitation = {"This promenade deserves a little care.", "If you find litter, Mar can use a hand.", "Keeping the city ready for tomorrow."},
    BeachWorker = {"Sunshade, water, and a little sea breeze.", "The loungers are ready. Please leave the sand clean.", "Someone keeps kicking footballs down the beach."},
    Soccer = {"I aimed for the goal. The goal moved. Probably.", "My best trick is missing from here.", "I celebrated before looking. It did not go in."},
    Gardener = {"These flowers need water, not another beam!", "I planted the blue ones for the sea.", "The garden is everyone’s front yard."},
    Artist = {"Hold still! You might end up in this painting.", "The sea changes color every hour.", "My last seagull looked like a potato."},
    Busker = {"One more song before the train!", "The market's got rhythm today.", "Toss me a request!"},
    Commuter = {"The next train is always late.", "I know a shortcut through the square.", "Coffee first, then the commute."},
    Tourist = {"That plaza is incredible!", "Where's the best snack cart?", "I keep finding new corners."},
    Local = {"I grew up on this block.", "The pier is my quiet spot.", "Meet me by the market later."},
    Fighter = {"The War Zone is getting loud.", "Time your dodge when you see a beam coming.", "I heard a knockout from the plaza."},
    Vendor = {"Fresh snacks on the corner!", "Busy day at the market.", "Try the stall across the street."},
}
local skinColors = {
    Color3.fromRGB(244, 204, 164), Color3.fromRGB(204, 149, 107), Color3.fromRGB(130, 88, 63),
    Color3.fromRGB(238, 184, 135), Color3.fromRGB(89, 59, 46), Color3.fromRGB(174, 118, 83),
    Color3.fromRGB(229, 172, 125), Color3.fromRGB(108, 72, 53),
}
local shirtColors = {
    Color3.fromRGB(63, 120, 173), Color3.fromRGB(192, 83, 79), Color3.fromRGB(77, 145, 105),
    Color3.fromRGB(169, 117, 65), Color3.fromRGB(117, 88, 150), Color3.fromRGB(56, 91, 114),
    Color3.fromRGB(203, 159, 96), Color3.fromRGB(65, 121, 124), Color3.fromRGB(170, 105, 141),
}
local pantsColors = {
    Color3.fromRGB(49, 58, 70), Color3.fromRGB(77, 64, 58), Color3.fromRGB(46, 68, 93),
    Color3.fromRGB(107, 102, 88), Color3.fromRGB(43, 49, 56), Color3.fromRGB(98, 76, 68),
}
local hairColors = {
    Color3.fromRGB(42, 33, 29), Color3.fromRGB(94, 58, 37), Color3.fromRGB(174, 128, 73),
    Color3.fromRGB(55, 61, 65), Color3.fromRGB(105, 74, 58), Color3.fromRGB(184, 164, 129),
}

-- Named workers have recognizable uniforms while ordinary residents keep
-- independent seeded palettes/accessories. Uniform fronts must stay visible.
local workwear={
 CafeWorker={shirt=Color3.fromRGB(236,220,190),pants=Color3.fromRGB(40,76,74),outfit=2},
 Sanitation={shirt=Color3.fromRGB(56,99,108),pants=Color3.fromRGB(49,58,70),outfit=2},
 BeachWorker={shirt=Color3.fromRGB(203,105,87),pants=Color3.fromRGB(213,198,165),outfit=2},
 Gardener={shirt=Color3.fromRGB(81,127,91),pants=Color3.fromRGB(104,82,63),outfit=1},
 Artist={shirt=Color3.fromRGB(226,213,187),pants=Color3.fromRGB(99,83,103),outfit=3},
 Busker={shirt=Color3.fromRGB(157,74,77),pants=Color3.fromRGB(46,62,81),outfit=3},
 Vendor={shirt=Color3.fromRGB(58,111,108),pants=Color3.fromRGB(77,64,58),outfit=2},
 Soccer={shirt=Color3.fromRGB(43,105,168),pants=Color3.fromRGB(32,47,70),outfit=3},
}

local function rigPart(model, name, size, cf, color, collide)
    local p = Instance.new("Part")
    p.Name, p.Size, p.CFrame = name, size, cf
    p.Color = color
    p.CanCollide = collide == true
    p.CanQuery = false
    p.CanTouch = false
    p.CollisionGroup="Residents"
    p.Massless=name~="HumanoidRootPart"
    p.Parent = model
    return p
end

local function joint(parent, name, p0, p1, c0, c1)
    local m = Instance.new("Motor6D")
    m.Name, m.Part0, m.Part1, m.C0, m.C1 = name, p0, p1, c0, c1
    m.Parent = parent
    return m
end

local function accessory(model, attachedTo, name, size, offset, color, material, shape)
    local p = rigPart(model, name, size, attachedTo.CFrame * offset, color, false)
    p.Material = material or Enum.Material.SmoothPlastic
    p.Massless = true
    if shape then p.Shape = shape end
    local weld = Instance.new("WeldConstraint")
    weld.Part0, weld.Part1, weld.Parent = attachedTo, p, p
    return p
end

local function faceToward(bot, position)
    if not bot.alive or not bot.model.Parent then return end
    local flat = Vector3.new(position.X, bot.root.Position.Y, position.Z)
    if (flat - bot.root.Position).Magnitude > 0.4 then
        bot.root.CFrame = CFrame.lookAt(bot.root.Position, flat)
    end
end

function World.Speak(bot, message)
    if not bot.model.Parent or not bot.alive then return end
    bot.speech.Text = message
    bot.speech.Visible = true
    bot.speechToken = (bot.speechToken or 0) + 1
    local token = bot.speechToken
    task.delay(3.5, function()
        if bot.speechToken == token and bot.speech.Parent then bot.speech.Visible = false end
    end)
end

local seatReservations={}
local function releaseSeat(bot)
    local seat=bot.restSeat
    if seat and seatReservations[seat]==bot then seatReservations[seat]=nil end
    bot.restSeat=nil
    if bot.readingBook then bot.readingBook:Destroy();bot.readingBook=nil end
    if bot.model.Parent then bot.model:SetAttribute("Resting",false);bot.model:SetAttribute("Reading",false) end
    local physicalSeat=bot.humanoid.SeatPart
    if physicalSeat then
        -- Sit=false/GettingUp can leave a server-owned NPC's SeatWeld intact.
        -- Remove only this character's seating weld, never another occupant's joint.
        for _,weld in ipairs(physicalSeat:GetChildren()) do
            if weld:IsA("Weld") and weld.Name=="SeatWeld" and weld.Part1 and weld.Part1:IsDescendantOf(bot.model) then weld:Destroy() end
        end
        bot.humanoid.Sit=false
        bot.humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end
local function stopWalking(bot)
    bot.watchingUntil=nil;bot.watchingPerformer=nil
    bot.model:SetAttribute("Repairing",false)
    bot.model:SetAttribute("Applauding",false)
    releaseSeat(bot)
    bot.pathVersion=(bot.pathVersion or 0)+1
    if bot.training then bot.trainingDestination=nil;bot.trainingNextMove=nil;bot.trainingStepAt=nil;bot.trainingMoveUntil=nil end
    bot.humanoid:MoveTo(bot.root.Position)
    bot.working=false
    bot.model:SetAttribute("Working",false)
    if bot.water then bot.water.Enabled=false end
end
function World.Talk(bot, player, contextLine)
    stopWalking(bot)
    if player and player.Character then
        local root = player.Character:FindFirstChild("HumanoidRootPart")
        if root then faceToward(bot, root.Position) end
        bot.gestureUntil = os.clock() + 2.2
        bot.socialUntil = os.clock() + 5
    end
    local options = roleLines[bot.role] or lines
    local index=rng:NextInteger(1,bot.lastTalkIndex and #options-1 or #options)
    if bot.lastTalkIndex and index>=bot.lastTalkIndex then index+=1 end
    bot.lastTalkIndex=index
    local message = contextLine or options[index]
    World.Speak(bot, message)
    return message
end

local function chooseDestination(bot)
    local candidates = {}
    local useActivity = rng:NextNumber() < 0.47
    local source = useActivity and World.ActivityPoints or World.WalkPoints
    for _, entry in ipairs(source) do
        local point = useActivity and entry.position or entry
        local homeDistance = (point - bot.start).Magnitude
        local currentDistance = (point - bot.root.Position).Magnitude
        if homeDistance < bot.roamRadius and currentDistance > 14 and currentDistance < 145
            and (not bot.lastDestination or (point - bot.lastDestination).Magnitude > 18) then
            table.insert(candidates, {position = point, kind = useActivity and entry.kind or "Stroll"})
        end
    end
    if #candidates == 0 then return bot.start, "Stroll" end
    local chosen = candidates[rng:NextInteger(1, #candidates)]
    bot.lastDestination = chosen.position
    return chosen.position, chosen.kind
end

local function roamTo(bot, destination, precise)
    if bot.humanoid.SeatPart and not bot.restSeat then releaseSeat(bot) end
    bot.pathVersion=(bot.pathVersion or 0)+1;local version=bot.pathVersion
    local path = PathfindingService:CreatePath({AgentRadius=2, AgentHeight=5, AgentCanJump=false, AgentCanClimb=false, WaypointSpacing=5, Costs={Fountain=math.huge,Asphalt=8}})
    local ok = pcall(function() path:ComputeAsync(bot.root.Position, destination) end)
    if not ok or path.Status ~= Enum.PathStatus.Success or bot.pathVersion~=version then path:Destroy();task.wait(0.3); return end
    local blocked = false
    local currentWaypoint=1
    -- Roblox can report an obstruction behind an agent that has already passed it.
    local connection = path.Blocked:Connect(function(index)
        if index>=currentWaypoint then blocked=true end
    end)
    for index, waypoint in ipairs(path:GetWaypoints()) do
        currentWaypoint=index
        if bot.pathVersion~=version or blocked or not bot.alive or not bot.model.Parent or (bot.reactionUntil or 0) > os.clock() then break end
        if waypoint.Action == Enum.PathWaypointAction.Jump then blocked=true;break end
        bot.humanoid:MoveTo(waypoint.Position)
        local started, lastProgress, previous = os.clock(), os.clock(), bot.root.Position
        while (Vector3.new(waypoint.Position.X,bot.root.Position.Y,waypoint.Position.Z)-bot.root.Position).Magnitude > 2.8 do
            if bot.pathVersion~=version or not bot.alive or not bot.model.Parent or blocked or (bot.reactionUntil or 0) > os.clock() then break end
            -- Never skip ahead to the next waypoint through an obstruction.
            if os.clock()-started>4 then blocked=true;break end
            if (bot.root.Position-previous).Magnitude > 0.7 then previous = bot.root.Position; lastProgress = os.clock() end
            if os.clock()-lastProgress > 0.8 then bot.humanoid:MoveTo(bot.root.Position); blocked=true; break end
            task.wait(0.06)
        end
    end
    connection:Disconnect();path:Destroy()
    if blocked and bot.pathVersion==version and bot.model.Parent then bot.humanoid:MoveTo(bot.root.Position) end
    -- MoveTo's broad arrival tolerance is fine for strolling, but leaves tools
    -- out of reach of work surfaces after an interrupted route. Finish the last
    -- short, path-checked segment using physical movement, never a position snap.
    if precise and not blocked and bot.pathVersion==version and (bot.root.Position-destination).Magnitude<4 then
        local speed=bot.humanoid.WalkSpeed;bot.humanoid.WalkSpeed=math.min(speed,4)
        local deadline=os.clock()+2
        while bot.alive and bot.model.Parent and bot.pathVersion==version and os.clock()<deadline and (bot.reactionUntil or 0)<=os.clock() do
            local delta=Vector3.new(destination.X-bot.root.Position.X,0,destination.Z-bot.root.Position.Z)
            if delta.Magnitude<.45 then break end
            bot.humanoid:Move(delta.Unit,false);task.wait(.05)
        end
        if bot.pathVersion==version then bot.humanoid:Move(Vector3.zero,false) end
        bot.humanoid.WalkSpeed=speed
    end
end

local function usableSeat(seat)
    local group=seat and seat.Parent
    return seat and seat.Parent and seat:IsA("Seat") and not seat.Disabled and group and not group:GetAttribute("Destroyed")
end
function World.UseSeat(bot,seat,duration)
    if not bot.alive or (bot.socialUntil or 0)>os.clock() or (bot.reactionUntil or 0)>os.clock() or not usableSeat(seat) or seat.Occupant or seatReservations[seat] then return false end
    stopWalking(bot);seatReservations[seat]=bot;bot.restSeat=seat
    bot.model:SetAttribute("Activity","Finding a seat")
    local approach=seat.Position+seat.CFrame.LookVector*4+Vector3.new(0,1,0)
    roamTo(bot,approach)
    if bot.restSeat~=seat then return false end
    if not bot.alive or not usableSeat(seat) or seat.Occupant or (bot.root.Position-seat.Position).Magnitude>8 then releaseSeat(bot);return false end
    bot.humanoid:MoveTo(bot.root.Position);seat:Sit(bot.humanoid)
    task.wait(.2)
    if bot.restSeat~=seat then return false end
    if bot.humanoid.SeatPart~=seat then releaseSeat(bot);return false end
    local reading=(bot.model:GetAttribute("AnimationSeed") or 0)%2==0
    bot.model:SetAttribute("Resting",true);bot.model:SetAttribute("Reading",reading)
    bot.model:SetAttribute("Activity",reading and (seat:GetAttribute("RestSetting")=="Beach" and "Reading by the sea" or "Reading in the courtyard") or "Taking a quiet break")
    if reading then
        local arm=bot.model:FindFirstChild("Left Arm")
        if arm then bot.readingBook=accessory(bot.model,arm,"CourtyardBook",Vector3.new(1.3,.15,1.1),CFrame.new(.3,-1,-.4),Color3.fromRGB(57,112,105),Enum.Material.Fabric) end
    end
    local ends=os.clock()+math.clamp(duration or rng:NextNumber(9,16),1,20)
    while bot.restSeat==seat and bot.alive and bot.model.Parent and usableSeat(seat) and seat.Occupant==bot.humanoid and os.clock()<ends do task.wait(.15) end
    if bot.restSeat==seat then releaseSeat(bot) end
    return true
end
local function restNearby(bot,destination)
    local choices={}
    for _,seat in ipairs(World.Seats) do
        if seat:IsA("Seat") and usableSeat(seat) and not seat.Occupant and not seatReservations[seat] and (seat.Position-destination).Magnitude<25 then table.insert(choices,seat) end
    end
    table.sort(choices,function(a,b) return (a.Position-bot.root.Position).Magnitude<(b.Position-bot.root.Position).Magnitude end)
    return choices[1] and World.UseSeat(bot,choices[1]) or false
end

-- Residents already near the stage can listen without adding another path request
-- or drawing a crowd into the through-route. Interruptions use stopWalking.
function World.WatchPerformance(bot)
    local now=os.clock()
    if not bot.alive or not bot.model.Parent or not bot.root.Parent or bot.job or bot.restSeat or (bot.socialUntil or 0)>now
        or (bot.reactionUntil or 0)>now or (bot.nextPerformance or 0)>now then return false end
    local performer
    for _,other in ipairs(World.Bots) do
        if other~=bot and other.model.Parent and other.root.Parent and other.role=="Busker" and other.job and other.alive and other.working
            and (other.root.Position-bot.root.Position).Magnitude<26 then
            performer=other;break
        end
    end
    if not performer then return false end
    local audience=0
    for _,other in ipairs(World.Bots) do
        if other.watchingPerformer==performer and (other.watchingUntil or 0)>now then audience+=1 end
    end
    if audience>=3 then return false end
    local ray=RaycastParams.new();ray.FilterType=Enum.RaycastFilterType.Exclude
    ray.FilterDescendantsInstances={bot.model,performer.model};ray.RespectCanCollide=true
    if workspace:Raycast(bot.root.Position,performer.root.Position-bot.root.Position,ray) then return false end
    stopWalking(bot)
    local version=bot.pathVersion
    bot.watchingPerformer=performer;bot.watchingUntil=now+rng:NextNumber(5,8)
    bot.nextPerformance=now+30
    bot.model:SetAttribute("Activity","Listening to Èric's performance")
    faceToward(bot,performer.root.Position)
    while bot.model.Parent and bot.root.Parent and bot.alive and bot.pathVersion==version and performer.model.Parent and performer.root.Parent and performer.alive and performer.working
        and os.clock()<(bot.watchingUntil or 0) and (bot.reactionUntil or 0)<=os.clock() do
        bot.model:SetAttribute("Applauding",bot.watchingUntil-os.clock()<2.5)
        task.wait(.2)
    end
    if bot.pathVersion==version then
        bot.watchingUntil=nil;bot.watchingPerformer=nil
        bot.model:SetAttribute("Applauding",false)
        bot.model:SetAttribute("Activity","Exploring the neighborhood")
    end
    return true
end

local function socialize(bot)
    if not bot.alive or (bot.socialUntil or 0)>os.clock() or (bot.reactionUntil or 0)>os.clock() then return false end
    local friends = {}
    for _, other in ipairs(World.Bots) do
        if other ~= bot and other.alive and not other.working and not other.watchingPerformer and (other.socialUntil or 0) < os.clock()
            and (other.reactionUntil or 0)<=os.clock() and (other.root.Position - bot.root.Position).Magnitude < 22 then
            table.insert(friends, other)
        end
    end
    if #friends == 0 then return false end
    local friend = friends[rng:NextInteger(1, #friends)]
    if not InteractionRules.CanReachNpc(bot.model,friend.model,22) then return false end
    stopWalking(bot);stopWalking(friend)
    -- Both previous social windows have expired. Do not let an old player
    -- reference suppress this conversation or let its late close cancel it.
    bot.talkingTo=nil;friend.talkingTo=nil
    bot.socialUntil, friend.socialUntil = os.clock() + 8, os.clock() + 8
    bot.gestureUntil, friend.gestureUntil = os.clock() + 3, os.clock() + 3
    faceToward(bot, friend.root.Position)
    faceToward(friend, bot.root.Position)
    World.Speak(bot, roleLines[bot.role][rng:NextInteger(1, #roleLines[bot.role])])
    local botVersion,friendVersion=bot.pathVersion,friend.pathVersion
    task.delay(1.8, function()
        if bot.alive and bot.model.Parent and friend.alive and friend.model.Parent
            and bot.pathVersion==botVersion and friend.pathVersion==friendVersion
            and not bot.talkingTo and not friend.talkingTo
            and os.clock()<(bot.socialUntil or 0) and os.clock()<(friend.socialUntil or 0) then
            World.Speak(friend, roleLines[friend.role][rng:NextInteger(1, #roleLines[friend.role])])
        end
    end)
    return true
end

local function noticePlayers(bot)
    if not bot.alive or bot.working or bot.restSeat or bot.watchingPerformer or (bot.socialUntil or 0)>os.clock() or (bot.reactionUntil or 0)>os.clock() then return end
    if (bot.lastGreeting or 0) + 14 > os.clock() then return end
    for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if root and (root.Position - bot.root.Position).Magnitude < 16 and InteractionRules.CanReachNpc(character,bot.model,16) then
            bot.lastGreeting = os.clock()
            bot.gestureUntil = os.clock() + 1.5
            faceToward(bot, root.Position)
            World.Speak(bot, ({"Hey there!", "Nice to see you around!", "What a day in the city!"})[rng:NextInteger(1, 3)])
            return
        end
    end
end

function World.ReactToScream(bot, origin)
    if bot.training then return end
    stopWalking(bot)
    bot.reactionUntil = os.clock() + 2.3
    bot.gestureUntil = bot.reactionUntil
    local delta = bot.root.Position - origin
    local away = Vector3.new(delta.X,0,delta.Z)
    if away.Magnitude > 0.5 then
        bot.humanoid:MoveTo(bot.root.Position + away.Unit * 8)
    end
    World.Speak(bot, ({"Whoa, my ears!", "That echoed down the block!", "Careful with that beam!"})[rng:NextInteger(1, 3)])
end

local function makeBot(parent, index, x, z, role, job, training)
    local displayName = names[(index - 1) % #names + 1] .. (index > #names and " " .. ({"Park", "Reed", "Chen", "Rivera", "Brooks", "Shah"})[(index-1)%6+1] or "")
    if job then displayName=job.name end
    if training then displayName=training.name.." · Lv "..training.level end
    local model = Instance.new("Model")
    model.Name = displayName .. "_TrainingNPC"
    model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
    model.Parent = parent
    model:SetAttribute("NpcId", "Bot" .. index)
    model:SetAttribute("ResidentActive",true)
    model:SetAttribute("DisplayName", displayName)
    model:SetAttribute("Role", role)
    local avatarRng = Random.new(8044 + index * 479)
    local home=Vector3.new(x,training and 4.2 or job and job.stations[1].position.Y or 3.9,z)
    local cf = CFrame.new(home)
    local skin = skinColors[avatarRng:NextInteger(1, #skinColors)]
    local shirt = shirtColors[avatarRng:NextInteger(1, #shirtColors)]
    local pants = pantsColors[avatarRng:NextInteger(1, #pantsColors)]
    local hairColor = hairColors[avatarRng:NextInteger(1, #hairColors)]
    local outfit = avatarRng:NextInteger(1, 5)
    local uniform=job and workwear[role]
    if uniform then shirt=uniform.shirt;pants=uniform.pants;outfit=uniform.outfit end
    model:SetAttribute("WorkUniform",uniform~=nil)
    model:SetAttribute("OutfitVariant", outfit)
    local root = rigPart(model, "HumanoidRootPart", Vector3.new(2, 2, 1), cf, Color3.new(1, 1, 1), false)
    root.Transparency = 1
    root.CanCollide = false
    local torso = rigPart(model, "Torso", Vector3.new(2, 2, 1), cf, shirt, true)
    local head = rigPart(model, "Head", Vector3.new(2, 1, 1), cf * CFrame.new(0, 1.5, 0), skin, false)
    local headMesh = Instance.new("SpecialMesh")
    headMesh.MeshType = Enum.MeshType.Head
    headMesh.Scale = Vector3.new(1.08, 1.08, 1.08)
    headMesh.Parent = head
    local la = rigPart(model, "Left Arm", Vector3.new(1, 2, 1), cf * CFrame.new(-1.5, 0, 0), skin, false)
    local ra = rigPart(model, "Right Arm", Vector3.new(1, 2, 1), cf * CFrame.new(1.5, 0, 0), skin, false)
    local ll = rigPart(model, "Left Leg", Vector3.new(1, 2, 1), cf * CFrame.new(-0.5, -2, 0), pants, false)
    local rl = rigPart(model, "Right Leg", Vector3.new(1, 2, 1), cf * CFrame.new(0.5, -2, 0), pants, false)
    joint(torso, "RootJoint", root, torso, CFrame.new(), CFrame.new())
    joint(torso, "Neck", torso, head, CFrame.new(0, 1, 0), CFrame.new(0, -0.5, 0))
    local ls = joint(torso, "Left Shoulder", torso, la, CFrame.new(-1, 0.5, 0), CFrame.new(0.5, 0.5, 0))
    local rs = joint(torso, "Right Shoulder", torso, ra, CFrame.new(1, 0.5, 0), CFrame.new(-0.5, 0.5, 0))
    local lh = joint(torso, "Left Hip", torso, ll, CFrame.new(-0.5, -1, 0), CFrame.new(0, 1, 0))
    local rh = joint(torso, "Right Hip", torso, rl, CFrame.new(0.5, -1, 0), CFrame.new(0, 1, 0))
    local face = Instance.new("Decal")
    face.Name, face.Texture, face.Face = "face", "rbxasset://textures/face.png", Enum.NormalId.Front
    face.Parent = head
    accessory(model, la, "LeftSleeve", Vector3.new(1.03, 0.9, 1.03), CFrame.new(0, 0.58, 0), shirt)
    accessory(model, ra, "RightSleeve", Vector3.new(1.03, 0.9, 1.03), CFrame.new(0, 0.58, 0), shirt)
    local shoeColor = avatarRng:NextNumber() < 0.5 and Color3.fromRGB(38, 42, 47) or Color3.fromRGB(230, 224, 209)
    accessory(model, ll, "LeftShoe", Vector3.new(1.05, 0.43, 1.22), CFrame.new(0, -0.78, -0.1), shoeColor)
    accessory(model, rl, "RightShoe", Vector3.new(1.05, 0.43, 1.22), CFrame.new(0, -0.78, -0.1), shoeColor)
    if outfit == 1 then
        accessory(model, head, "Beanie", Vector3.new(2.2, 0.6, 1.25), CFrame.new(0, 0.66, 0), hairColor, Enum.Material.Fabric, Enum.PartType.Ball)
        accessory(model, head, "BeanieBand", Vector3.new(2.24, 0.22, 1.3), CFrame.new(0, 0.34, 0), shirt, Enum.Material.Fabric, Enum.PartType.Ball)
    elseif outfit == 2 then
        accessory(model, head, "Cap", Vector3.new(2.15, 0.48, 1.2), CFrame.new(0, 0.66, 0), shirt, Enum.Material.Fabric, Enum.PartType.Ball)
        accessory(model, head, "CapBrim", Vector3.new(1.7, 0.13, 1.0), CFrame.new(0, 0.49, -0.85), shirt, Enum.Material.Fabric, Enum.PartType.Ball)
    elseif outfit == 3 then
        accessory(model, head, "Hair", Vector3.new(2.14, 0.5, 1.18), CFrame.new(0, 0.62, 0), hairColor, nil, Enum.PartType.Ball)
        for _, dx in ipairs({-0.65, 0, 0.65}) do
            accessory(model, head, "CurlyHair", Vector3.new(0.78, 0.65, 0.8), CFrame.new(dx, 0.82, -0.21), hairColor, nil, Enum.PartType.Ball)
        end
    elseif outfit == 4 then
        accessory(model, head, "Hair", Vector3.new(2.17, 0.62, 1.27), CFrame.new(0, 0.66, 0), hairColor, nil, Enum.PartType.Ball)
        for _, dx in ipairs({-1.07, 1.07}) do
            accessory(model, head, "HeadphoneEar", Vector3.new(0.35, 0.8, 0.7), CFrame.new(dx, 0.05, 0), C.dark)
        end
        accessory(model, head, "HeadphoneBand", Vector3.new(2.3, 0.18, 0.5), CFrame.new(0, 1.0, 0), C.dark)
    else
        accessory(model, head, "Hair", Vector3.new(2.16, 0.42, 1.2), CFrame.new(0, 0.61, 0), hairColor)
        accessory(model, torso, "Jacket", Vector3.new(2.12, 1.65, 0.18), CFrame.new(0, 0.05, -0.58),
            Color3.fromRGB(52, 67, 70), Enum.Material.Fabric)
    end
    if avatarRng:NextNumber() < 0.42 then
        for _, dx in ipairs({-0.47, 0.47}) do
            accessory(model, head, "GlassesLens", Vector3.new(0.68, 0.32, 0.1),
                CFrame.new(dx, 0.08, -0.58), Color3.fromRGB(58, 87, 93), Enum.Material.Glass)
        end
        accessory(model, head, "GlassesBridge", Vector3.new(0.28, 0.08, 0.14),
            CFrame.new(0, 0.09, -0.62), C.dark, Enum.Material.Metal)
    end
    local jobTool,water;local carryParts={};local cleaningParts={};local repairParts={}
    if role=="Soccer" and job then
        for _,leg in ipairs({ll,rl}) do accessory(model,leg,"FootballSock",Vector3.new(1.03,.9,1.03),CFrame.new(0,-.25,0),Color3.fromRGB(240,231,212),Enum.Material.Fabric) end
        local badge=accessory(model,torso,"NumberZero",Vector3.new(.62,.74,.12),CFrame.new(0,.15,-.58),Color3.fromRGB(240,231,212),Enum.Material.Fabric)
        local face=Instance.new("SurfaceGui");face.Face=Enum.NormalId.Front;face.CanvasSize=Vector2.new(80,100);face.Parent=badge
        local number=Instance.new("TextLabel");number.Size=UDim2.fromScale(1,1);number.BackgroundTransparency=1;number.Text="0";number.Font=Enum.Font.GothamBold;number.TextSize=76;number.TextColor3=Color3.fromRGB(32,47,70);number.Parent=face
    elseif role=="CafeWorker" then
        local trayGrip=CFrame.new(0,-1,-.6)*CFrame.Angles(-.8,0,0)
        table.insert(carryParts,accessory(model,la,"ServingTray",Vector3.new(1.5,.12,1),trayGrip,Color3.fromRGB(104,139,124),Enum.Material.Metal))
        for _,dx in ipairs({-.35,.35}) do table.insert(carryParts,accessory(model,la,"CoffeeCup",Vector3.new(.3,.4,.3),trayGrip*CFrame.new(dx,.26,0),Color3.fromRGB(243,225,191),Enum.Material.CeramicTiles)) end
        accessory(model,torso,"CafeApron",Vector3.new(1.7,1.5,.1),CFrame.new(0,-.2,-.57),Color3.fromRGB(71,139,125),Enum.Material.Fabric)
    elseif role=="Sanitation" then
        table.insert(cleaningParts,accessory(model,ra,"BroomHandle",Vector3.new(.14,2.7,.14),CFrame.new(0,-1.25,-.45),Color3.fromRGB(155,113,77),Enum.Material.Wood))
        table.insert(cleaningParts,accessory(model,ra,"BroomHead",Vector3.new(1.6,.35,.65),CFrame.new(0,-2.6,-.45),Color3.fromRGB(196,163,97),Enum.Material.Fabric))
        table.insert(repairParts,accessory(model,ra,"RepairHandle",Vector3.new(.18,1.1,.18),CFrame.new(0,-1.3,-.35),Color3.fromRGB(155,113,77),Enum.Material.Wood))
        table.insert(repairParts,accessory(model,ra,"RepairHammer",Vector3.new(.85,.3,.35),CFrame.new(0,-1.85,-.35),Color3.fromRGB(105,121,126),Enum.Material.Metal))
        for _,item in ipairs(repairParts) do item.Transparency=1 end
        accessory(model,torso,"SafetyVest",Vector3.new(1.85,1.5,.12),CFrame.new(0,0,-.58),Color3.fromRGB(224,176,69),Enum.Material.Fabric)
    elseif role=="BeachWorker" then
        accessory(model,ra,"CleaningCloth",Vector3.new(.7,.15,.65),CFrame.new(0,-1,-.25),Color3.fromRGB(235,220,181),Enum.Material.Fabric)
        accessory(model,torso,"BeachCrewBadge",Vector3.new(.6,.4,.12),CFrame.new(.45,.4,-.59),Color3.fromRGB(244,228,189))
    elseif role=="Busker" and job then
        accessory(model,torso,"GuitarBody",Vector3.new(1.5,1.7,.5),CFrame.new(.2,-.35,-.9),Color3.fromRGB(183,121,65),Enum.Material.Wood,Enum.PartType.Ball)
        accessory(model,torso,"GuitarSoundhole",Vector3.new(.45,.45,.04),CFrame.new(.2,-.1,-1.17),Color3.fromRGB(55,41,32),nil,Enum.PartType.Ball)
        accessory(model,torso,"GuitarNeck",Vector3.new(.35,2.3,.17),CFrame.new(-.3,.9,-.92)*CFrame.Angles(0,0,-.35),Color3.fromRGB(112,74,47),Enum.Material.Wood)
    elseif role=="Gardener" then
        local canGrip=CFrame.new(0,-1.15,-.35)*CFrame.Angles(-1.15,0,0)
        jobTool=accessory(model,ra,"WateringCan",Vector3.new(.9,.85,.7),canGrip,Color3.fromRGB(77,133,123),Enum.Material.Metal)
        accessory(model,ra,"CanSpout",Vector3.new(.2,.2,.9),canGrip*CFrame.new(0,.1,-.65),Color3.fromRGB(77,133,123),Enum.Material.Metal)
        local outlet=Instance.new("Attachment");outlet.Position=Vector3.new(0,.1,-1.1);outlet.Parent=jobTool
        water=Instance.new("ParticleEmitter");water.Name="WaterDrops";water.EmissionDirection=Enum.NormalId.Front;water.Rate=12;water.Lifetime=NumberRange.new(.35,.6);water.Speed=NumberRange.new(1,2);water.Acceleration=Vector3.new(0,-12,0);water.Size=NumberSequence.new(.08);water.Color=ColorSequence.new(Color3.fromRGB(134,213,235));water.Enabled=false;water.Parent=outlet
    elseif role=="Artist" then
        jobTool=accessory(model,ra,"PaintBrush",Vector3.new(.14,1.3,.14),CFrame.new(0,-1.1,-.35),Color3.fromRGB(131,88,61),Enum.Material.Wood)
        accessory(model,ra,"BrushTip",Vector3.new(.19,.3,.19),CFrame.new(0,-1.8,-.35),Color3.fromRGB(64,143,165),Enum.Material.Fabric)
        accessory(model,la,"PaintPalette",Vector3.new(.9,.12,.7),CFrame.new(0,-1,-.3)*CFrame.Angles(-.7,0,0),Color3.fromRGB(190,144,92),Enum.Material.Wood)
    end
    if role == "Vendor" then
        accessory(model, torso, "VendorApron", Vector3.new(1.65, 1.4, 0.14),
            CFrame.new(0, -0.32, -0.61), Color3.fromRGB(222, 215, 188), Enum.Material.Fabric)
    elseif role == "Tourist" then
        accessory(model, torso, "Backpack", Vector3.new(1.4, 1.5, 0.55),
            CFrame.new(0, 0.05, 0.75), Color3.fromRGB(102, 74, 89), Enum.Material.Fabric)
    elseif role == "Fighter" then
        accessory(model, ra, "FighterArmband", Vector3.new(1.08, 0.3, 1.08),
            CFrame.new(0, 0.38, 0), C.gold, Enum.Material.Fabric)
    elseif role == "Commuter" then
        accessory(model, torso, "CrossbodyBag", Vector3.new(1.25, 0.9, 0.35),
            CFrame.new(0.4, -0.5, -0.72), Color3.fromRGB(86, 61, 47), Enum.Material.Fabric)
    end
    local humanoid = Instance.new("Humanoid")
    humanoid.RigType = Enum.HumanoidRigType.R6
    humanoid.HipHeight=0;humanoid.AutoJumpEnabled=false;humanoid.JumpPower=0;humanoid.JumpHeight=0
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping,false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing,false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown,false)
    local maximum=training and training.health or Config.BotMaxHealth
    humanoid.MaxHealth, humanoid.Health = maximum, maximum
    humanoid.WalkSpeed = avatarRng:NextInteger(7, 11)
    humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    humanoid.Parent = model
    model.PrimaryPart = root
    if RunService:IsRunning() then root:SetNetworkOwner(nil) end
    local nameLabel = billboard(head, displayName, Vector3.new(0, 2.5, 0))
    local speech = billboard(head, "", Vector3.new(0, 4.4, 0), 185)
    nameLabel.Parent.Name="Nameplate"
    speech.Parent.Name="SpeechBubble";speech.Parent.Size=UDim2.fromOffset(200,48)
    nameLabel.Parent.MaxDistance = 18
    speech.Parent.MaxDistance = 24
    speech.Visible = false
    speech.BackgroundColor3 = Color3.fromRGB(244, 237, 211)
    speech.TextColor3 = C.dark
    local bot = {id = "Bot" .. index, name = displayName, role = role, model = model, root = root, humanoid = humanoid,
        training=training,credit={},maxHealth=maximum,health = maximum, alive = true, label = nameLabel, speech = speech, questIds=job and job.quests or index==4 and {"sprint"} or index==5 and {"crowd"} or index==6 and {"dodge","arena"} or nil, job=job, jobTool=jobTool, water=water, carryParts=carryParts, cleaningParts=cleaningParts, repairParts=repairParts, jobStep=0,
        start = home, lastGrounded=home, roamRadius = role == "Commuter" and 200 or 125,
        joints = {ls, rs, lh, rh}, lastGreeting = -1000}
    for _, limb in ipairs(bot.joints) do limb:SetAttribute("RestPose", limb.C0) end
    table.insert(World.Bots, bot)
    model:SetAttribute("AnimationSeed",index);Collection:AddTag(model,"CityResident")
    if training then
        humanoid.WalkSpeed=TrainingRules.RoamSpeed
        bot.trainingRoamStep=index
        model:SetAttribute("TrainingTier",training.id)
        nameLabel.Parent.MaxDistance=65
        return bot
    end
    if RunService:IsRunning() then
        task.spawn(function()
            task.wait(index * 0.08)
            while model.Parent do
                if bot.alive then
                    if bot.restSeat then
                        task.wait(.2)
                    elseif (bot.reactionUntil or 0) > os.clock() then
                        task.wait(0.5)
                    elseif (bot.socialUntil or 0)>os.clock() then
                        task.wait(.2)
                    elseif job then
                        bot.jobStep=bot.jobStep%#job.stations+1
                        local station=role=="Sanitation" and World.FindMaintenance and World.FindMaintenance(bot) or job.stations[bot.jobStep]
                        model:SetAttribute("WorkStep",bot.jobStep)
                        for _,item in ipairs(bot.carryParts) do item.Transparency=bot.jobStep==2 and 0 or 1 end
                        bot.working=false;model:SetAttribute("Activity","Walking to work")
                        roamTo(bot,station.position,true)
                        if bot.alive and (Vector3.new(bot.root.Position.X,station.position.Y,bot.root.Position.Z)-station.position).Magnitude<.8 and (bot.reactionUntil or 0)<=os.clock() and (bot.socialUntil or 0)<=os.clock() then
                            bot.humanoid:MoveTo(bot.root.Position);faceToward(bot,station.lookAt)
                            if role=="Soccer" then
                                bot.practiceCycle=(bot.practiceCycle or 0)+1
                                model:SetAttribute("PracticeRoutine",({"Miss","Trip","OwnGoal"})[(bot.practiceCycle-1)%3+1])
                            end
                            bot.working=true;model:SetAttribute("Repairing",station.maintenanceModel~=nil);model:SetAttribute("WorkStarted",workspace:GetServerTimeNow());model:SetAttribute("Activity",station.action or role=="Soccer" and "Practicing missed kicks" or role=="Gardener" and "Watering flowers" or role=="Artist" and "Painting the coast" or "Arranging produce")
                            local workVersion=bot.pathVersion
                            local untilTime=os.clock()+(role=="Soccer" and 6.5 or rng:NextNumber(5,9))
                            while model.Parent and bot.alive and bot.working and bot.pathVersion==workVersion and os.clock()<untilTime and (bot.socialUntil or 0)<=os.clock() and (bot.reactionUntil or 0)<=os.clock() do task.wait(.2) end
                            if model.Parent and bot.working and bot.alive and bot.pathVersion==workVersion and (bot.socialUntil or 0)<=os.clock() and (bot.reactionUntil or 0)<=os.clock() and os.clock()>=untilTime and station.maintenanceModel and World.FinishMaintenance then
                                World.FinishMaintenance(bot,station)
                            end
                            bot.working=false;model:SetAttribute("Repairing",false)
                        end
                        task.wait(.3)
                    else
                        local choice = rng:NextNumber()
                        if choice < .2 and World.WatchPerformance(bot) then
                            task.wait(.3)
                        elseif choice < 0.23 then
                            bot.gestureUntil = os.clock() + rng:NextNumber(1.5, 3.5)
                            if role == "Busker" or role == "Vendor" or rng:NextNumber() < 0.45 then
                                World.Talk(bot)
                            end
                            task.wait(rng:NextNumber(2.5, 5.5))
                        elseif choice < 0.45 and socialize(bot) then
                            task.wait(rng:NextNumber(2.5, 4.5))
                        else
                            local destination, kind = chooseDestination(bot)
                            roamTo(bot, destination)
                            if bot.alive and (destination - bot.root.Position).Magnitude < 13 then
                                if kind=="Performance" then
                                    World.WatchPerformance(bot)
                                elseif kind=="Rest" and restNearby(bot,destination) then
                                    bot.model:SetAttribute("Activity","Exploring the neighborhood")
                                elseif kind == "Browse" or kind == "Watch" or kind == "Rest" then
                                    bot.gestureUntil = os.clock() + 2.5
                                    task.wait(rng:NextNumber(2, 4))
                                elseif rng:NextNumber() < 0.3 then
                                    task.wait(rng:NextNumber(0.7, 2))
                                end
                            end
                        end
                    end
                else task.wait(0.5) end
            end
        end)
        task.spawn(function()
            task.wait(3 + index % 9)
            while model.Parent do
                if bot.alive then noticePlayers(bot) end
                task.wait(2.5 + index % 4)
            end
        end)
    end
end

local function atmosphere()
    local lighting = game:GetService("Lighting")
    lighting.ClockTime = 16.5
    lighting.Brightness = 3
    lighting.EnvironmentDiffuseScale = 0.65
    lighting.EnvironmentSpecularScale = 0.65
    lighting.GlobalShadows = true
    lighting.ShadowSoftness = 0.35
    local grade = lighting:FindFirstChild("CityGrade") or Instance.new("ColorCorrectionEffect")
    grade.Name = "CityGrade"
    grade.Contrast = 0.08
    grade.Saturation = 0.08
    grade.TintColor = Color3.fromRGB(255, 248, 237)
    grade.Parent = lighting
    local haze = lighting:FindFirstChild("CityHaze")
    if not haze then
        haze = Instance.new("Atmosphere")
        haze.Name = "CityHaze"
        haze.Parent = lighting
    end
    haze.Density = 0.17
    haze.Haze = 0.3
    haze.Color = Color3.fromRGB(235, 210, 181)
end


function World.IsInWarZone(position) return Config.InArena(position) end

local function carAt(car,distance)
    local x=-690+distance*car.direction
    if car.direction<0 then x=690-distance end
    return CFrame.new(x,2.05,car.lane)*CFrame.Angles(0,car.direction>0 and 0 or math.pi,0)
end
-- Traffic yields to residents in its lane. Players remain subject to impact rules.
function World.StepTraffic(car,dt)
    dt=math.clamp(dt,0,.1)
    local previous=car.model:GetPivot()
    local clearance=math.huge
    for _,bot in ipairs(World.Bots) do
        if bot.alive and bot.root.Parent then
            local relative=previous:PointToObjectSpace(bot.root.Position)
            if relative.X>=-8 and math.abs(relative.Z)<5.5 and math.abs(relative.Y)<6 then
                clearance=math.min(clearance,math.max(0,relative.X-9))
            end
        end
    end
    local cruise=car.cruiseSpeed or car.speed
    local target=math.min(cruise,math.sqrt(2*30*clearance))
    car.speed=math.clamp(target,math.max(0,car.speed-30*dt),car.speed+8*dt)
    local travel=math.min(dt*car.speed,clearance)
    if dt>0 and travel<dt*car.speed then car.speed=travel/dt end
    car.distance+=travel
    local wrapped=car.distance>1380
    if wrapped then car.distance-=1380 end
    local nextFrame=carAt(car,car.distance)
    if travel>0 and not wrapped and World.OnVehicleSweep then World.OnVehicleSweep(car,previous,nextFrame) end
    car.model:PivotTo(nextFrame)
    car.model:SetAttribute("Speed",car.speed)
    car.model:SetAttribute("Yielding",target<cruise)
end
-- Three server-owned trainers stroll only inside their original sparring pads.
-- No city path coroutine or player pursuit: targets stay well inside the 32-stud
-- combat boundary, and a stuck MoveTo expires rather than teleporting through cover.
function World.StepTrainingRoam(bot,now)
    if not bot.training or not bot.alive or not bot.model.Parent or not bot.root.Parent or not bot.humanoid.Parent then return end
    local position=bot.root.Position
    local delta=position-bot.start
    if Vector3.new(delta.X,0,delta.Z).Magnitude>TrainingRules.RoamLeash then
        stopWalking(bot)
        bot.model:PivotTo(CFrame.new(bot.start));bot.lastGrounded=bot.start;bot.airSince=nil
        bot.root.AssemblyLinearVelocity=Vector3.zero;bot.root.AssemblyAngularVelocity=Vector3.zero
        bot.humanoid:MoveTo(bot.start);bot.trainingNextMove=now+1.25
        return
    end
    -- Stop on the first frame of a windup, conversation or immobilization, not
    -- only on the slower waypoint cadence. The strike's aim remains fixed.
    if bot.strike or (bot.socialUntil or 0)>now or (bot.reactionUntil or 0)>now
        or bot.root.Anchored or bot.humanoid.SeatPart or bot.humanoid.Sit or bot.humanoid.PlatformStand then
        if bot.trainingDestination then bot.humanoid:MoveTo(position) end
        bot.trainingDestination=nil;bot.trainingNextMove=now+.5
        return
    end
    if now<(bot.trainingStepAt or 0) then return end
    bot.trainingStepAt=now+.25
    if bot.trainingDestination then
        local remaining=bot.trainingDestination-position
        if Vector3.new(remaining.X,0,remaining.Z).Magnitude<=2 or now>=(bot.trainingMoveUntil or 0) then
            bot.humanoid:MoveTo(position);bot.trainingDestination=nil;bot.trainingNextMove=now+1.25
        end
        return
    end
    if now<(bot.trainingNextMove or 0) then return end
    bot.trainingRoamStep=(bot.trainingRoamStep or 0)+1
    local angle=bot.trainingRoamStep*2.399963229728653
    local radius=TrainingRules.RoamRadius*(.65+.175*(bot.trainingRoamStep%3))
    local destination=bot.start+Vector3.new(math.cos(angle)*radius,0,math.sin(angle)*radius)
    bot.trainingDestination=destination;bot.trainingMoveUntil=now+5
    bot.humanoid.WalkSpeed=TrainingRules.RoamSpeed
    bot.humanoid:MoveTo(destination)
end

function World.Build()
    local old=workspace:FindFirstChild("ScreamSimulatorWorld");if old then old:Destroy() end
    table.clear(World.Bots);table.clear(World.Cars);table.clear(seatReservations)
    pcall(function() PhysicsService:RegisterCollisionGroup("Residents") end)
    PhysicsService:CollisionGroupSetCollidable("Residents","Residents",false)
    atmosphere()
    local parent=Instance.new("Model");parent.Name="ScreamSimulatorWorld";parent.Parent=workspace
    local layout=City.Build(parent);World.WalkPoints=layout.walk;World.ActivityPoints=layout.activities;World.SafeSpawn=layout.spawn
    table.clear(World.Seats);for _,item in ipairs(parent:GetDescendants()) do if item:IsA("Seat") then table.insert(World.Seats,item) end end
    local spawn=Instance.new("SpawnLocation");spawn.Name="SafeSpawn";spawn.Size=Vector3.new(7,.2,7);spawn.CFrame=World.SafeSpawn-Vector3.new(0,3,0);spawn.Anchored=true;spawn.Neutral=true;spawn.Duration=0;spawn.Transparency=1;spawn.CanCollide=false;spawn.Parent=parent
    local roles={"Local","Tourist","Vendor","Commuter","Busker","Fighter"}
    -- Cluster residents at destinations; leave roads and building interiors clear.
    local seeds={{-625,205},{-575,205},{-600,185},{-610,265},{-360,180},{-360,260},{-120,-32},{-145,15},{-92,15},{85,-71},{155,-71},{85,7},{155,7},{-240,403},{0,403},{200,403},{420,403},{-540,403}}
    for i=1,20 do local point=layout.walk[((i-1)*29+5)%#layout.walk+1];table.insert(seeds,{point.X,point.Z}) end
    for i,spot in ipairs(seeds) do makeBot(parent,i,spot[1],spot[2],roles[(i-1)%#roles+1]) end
    for i,job in ipairs(layout.jobs or {}) do local point=job.stations[1].position;makeBot(parent,#seeds+i,point.X,point.Z,job.role,job) end
    -- Dedicated sparring pads sit outside PvP and do not recruit city workers.
    for _,tier in ipairs(TrainingRules.Tiers) do
        local pad=part(parent,"TrainingPad_"..tier.id,Vector3.new(64,.2,64),Vector3.new(tier.x,1.1,tier.z),C.green,Enum.Material.SmoothPlastic)
        local sign=part(parent,"TrainingSign_"..tier.id,Vector3.new(1,1,1),Vector3.new(tier.x,7,tier.z+30),C.gold,nil,false);sign.Transparency=1
        local words=billboard(sign,tier.name.." · recommended Lv "..tier.level.."\n"..tier.health.." HP · "..tier.xp.." base XP\nHit to spar · move out of red strikes",Vector3.zero,280)
        words.Parent.Size=UDim2.fromOffset(280,76);words.Parent.MaxDistance=100
        makeBot(parent,#World.Bots+1,tier.x,tier.z,"Fighter",nil,tier)
    end
    for i,spec in ipairs({{-368,1,23},{-352,-1,21},{112,1,20},{128,-1,24},{352,1,18},{368,-1,22}}) do
        local m=vehicle(parent,i%2==0 and "Sedan" or "Taxi",i%2==0 and Color3.fromRGB(65+i*15,104,115) or Color3.fromRGB(226,177,64));m.Name="TrafficCar"..i
        local car={model=m,hull=m.CollisionHull,lane=spec[1],direction=spec[2],speed=spec[3],cruiseSpeed=spec[3],distance=(i-1)*210};m:PivotTo(carAt(car,car.distance));table.insert(World.Cars,car)
    end
    for i,pos in ipairs({{-490,-110},{490,105},{-490,130},{690,120}}) do taxi(parent,pos[1],pos[2],"Sedan",Color3.fromRGB(91+i*22,93,99)) end
    if RunService:IsRunning() then
        task.spawn(function()
            local grounding=0
            while parent.Parent do
                local dt=RunService.Heartbeat:Wait();local now=os.clock();grounding+=dt
                for _,car in ipairs(World.Cars) do
                    World.StepTraffic(car,dt)
                end
                local groundParams
                if grounding>=.25 then
                    groundParams=RaycastParams.new();groundParams.FilterType=Enum.RaycastFilterType.Exclude
                    local exclude={}
                    for _,bot in ipairs(World.Bots) do table.insert(exclude,bot.model) end
                    for _,player in ipairs(game.Players:GetPlayers()) do if player.Character then table.insert(exclude,player.Character) end end
                    groundParams.FilterDescendantsInstances=exclude;groundParams.RespectCanCollide=true
                end
                for _,bot in ipairs(World.Bots) do
                    if bot.water then bot.water.Enabled=bot.alive and bot.working==true end
                    local repairing=bot.alive and bot.working and bot.model:GetAttribute("Repairing")==true
                    for _,item in ipairs(bot.cleaningParts or {}) do item.Transparency=repairing and 1 or 0 end
                    for _,item in ipairs(bot.repairParts or {}) do item.Transparency=repairing and 0 or 1 end
                    if not bot.alive or not bot.root.Parent then continue end
                    World.StepTrainingRoam(bot,now)
                    local gesture=(bot.gestureUntil or 0)>now
                    if bot.model:GetAttribute("Gesturing")~=gesture then bot.model:SetAttribute("Gesturing",gesture) end
                    if bot.model:GetAttribute("Working")~=(bot.working==true) then bot.model:SetAttribute("Working",bot.working==true) end
                    if grounding>=.25 and not bot.humanoid.SeatPart then
                        local hit=workspace:Raycast(bot.root.Position+Vector3.new(0,2,0),Vector3.new(0,-20,0),groundParams)
                        local gap=hit and bot.root.Position.Y-hit.Position.Y or 99
                        if gap>5 or gap<1.5 or bot.root.Position.Y>8 or bot.root.Position.Y< -3 then
                            bot.airSince=bot.airSince or now
                            if now-bot.airSince>.45 then
                                -- Invalidate the old path/precision approach before moving
                                -- the resident back. Otherwise its sleeping route coroutine
                                -- can resume toward the waypoint that caused the fall.
                                stopWalking(bot)
                                bot.model:SetAttribute("Activity","Finding a safe route")
                                bot.model:PivotTo(CFrame.new(bot.lastGrounded or bot.start));bot.root.AssemblyLinearVelocity=Vector3.zero;bot.root.AssemblyAngularVelocity=Vector3.zero;bot.humanoid:MoveTo(bot.root.Position);bot.airSince=nil
                            end
                        else bot.airSince=nil;bot.lastGrounded=bot.root.Position end
                    end
                end
                if grounding>=.25 then grounding=0 end
            end
        end)
    end
    return parent
end
function World.UpdateBot(bot)
    bot.model:SetAttribute("ResidentActive",bot.alive==true)
    -- A normal hit already started its flee reaction. Do not cancel that MoveTo here.
    if not bot.alive or bot.health==(bot.maxHealth or Config.BotMaxHealth) then
        stopWalking(bot);bot.model:SetAttribute("Working",false)
        bot.socialUntil=0;bot.talkingTo=nil;bot.reactionUntil=0;bot.gestureUntil=0
        bot.speechToken=(bot.speechToken or 0)+1;bot.speech.Visible=false
    end
    bot.label.Text=bot.alive and (bot.health<(bot.maxHealth or Config.BotMaxHealth) and (bot.name.."  "..bot.health.."/"..(bot.maxHealth or Config.BotMaxHealth)) or bot.name) or "RECOVERING"
    if bot.alive then
        bot.humanoid.Health=bot.health
        if bot.health==(bot.maxHealth or Config.BotMaxHealth) then
            bot.root.Anchored=false;bot.model:PivotTo(CFrame.new(bot.start));bot.root.AssemblyLinearVelocity=Vector3.zero
            if bot.training then
                bot.lastGrounded=bot.start;bot.airSince=nil;bot.root.AssemblyAngularVelocity=Vector3.zero
                bot.humanoid.WalkSpeed=TrainingRules.RoamSpeed
            end
            bot.root:SetNetworkOwner(nil)
        end
    else
        bot.humanoid:MoveTo(bot.root.Position);bot.root.Anchored=true;bot.model:PivotTo(CFrame.new(bot.start-Vector3.new(0,100,0)));bot.speech.Visible=false
    end
end
return World
]]></string>
