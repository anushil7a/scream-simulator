      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">CueAudioMix</string>
          <string name="Source"><![CDATA[-- Bounded presentation-only one-shots. Never records voice or sends remotes.
local Mix={};Mix.__index=Mix
local function finite(n)return type(n)=="number" and n==n and math.abs(n)<math.huge end
function Mix.new(settings,create,update,destroy)
 return setmetatable({settings=settings,create=create,update=update,destroy=destroy,
  entries={},lastPlayed={},enabled=true,duck=1,voiceActive=false,suppressed=false},Mix)
end
function Mix:Clear()
 for _,entry in ipairs(self.entries) do self.destroy(entry.handle) end
 table.clear(self.entries)
end
function Mix:SetEnabled(enabled)
 if self.destroyed then return end
 self.enabled=enabled==true
 if not self.enabled then self:Clear() end
end
function Mix:SetContext(voiceActive,suppressed)
 if self.destroyed then return end
 self.voiceActive=voiceActive==true;self.suppressed=suppressed==true
 if self.voiceActive then self.duck=self.settings.VoiceDuck end
 if self.suppressed then self:Clear() end
end
function Mix:Play(kind,now,position)
 if self.destroyed or not self.enabled or self.suppressed or not finite(now) then return false end
 local cue=self.settings.Cues[kind]
 if not cue or not self.settings.Asset(kind) or (cue.Spatial and not position) then return false end
 local last=self.lastPlayed[kind]
 if last and now-last<cue.Cooldown then return false end
 if #self.entries>=self.settings.Limit then return false end
 local handle=self.create(kind,position)
 if not handle then return false end
 self.lastPlayed[kind]=now
 table.insert(self.entries,{handle=handle,started=now,expires=now+cue.Lifetime})
 -- Rebudget older voices before the new handle starts. The original WAVs
 -- have baked onset fades; a frame-driven fade would erase short transients.
 self:Step(now,0)
 return true
end
function Mix:ObserveLevel(level,temporary,now)
 if not finite(level) or level%1~=0 or level<1 or level>100 then return false end
 local previous,wasTemporary=self.level,self.temporary
 self.level=level;self.temporary=temporary==true
 if not previous or level<=previous or self.temporary or wasTemporary then return false end
 return self:Play("LevelUp",now)
end
function Mix:Step(now,dt)
 if self.destroyed or not finite(now) or not finite(dt) then return end
 if self.suppressed then self:Clear();return end
 if not self.voiceActive then self.duck+=(1-self.duck)*(1-math.exp(-math.clamp(dt,0,.25)*5)) end
 for i=#self.entries,1,-1 do
  local entry=self.entries[i]
  if now>=entry.expires then self.destroy(entry.handle);table.remove(self.entries,i) end
 end
 local gain=self.settings.TotalVolume/math.max(1,#self.entries)*self.duck
 for _,entry in ipairs(self.entries) do
  local envelope=math.clamp((entry.expires-now)/self.settings.FadeOut,0,1)
  self.update(entry.handle,gain*envelope)
 end
end
function Mix:Destroy()
 if self.destroyed then return end
 self.destroyed=true;self:Clear();table.clear(self.lastPlayed)
end
return Mix
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">GameplayAudio</string>
          <string name="Source"><![CDATA[local SoundService=game:GetService("SoundService")
local Content=game:GetService("ContentProvider")
local Settings=require(game:GetService("ReplicatedStorage").Shared.GameplayAudioConfig)
local Mix=require(script.Parent:WaitForChild("CueAudioMix"))
local Audio={}
function Audio.new()
 local destroyed=false;local ready={}
 local group=Instance.new("SoundGroup");group.Name="QuietGameplayEffects";group.Volume=Settings.GroupVolume;group.Parent=SoundService
 local eq=Instance.new("EqualizerSoundEffect");eq.LowGain=-3;eq.MidGain=-2;eq.HighGain=-3;eq.Parent=group
 local function create(kind,position)
  local asset=Settings.Asset(kind)
  if not asset or not ready[kind] then return nil end
  local parent=SoundService;local anchor
  if Settings.Cues[kind].Spatial then
   anchor=Instance.new("Part");anchor.Name="LocalGameplayAudio"
   anchor.Anchored=true;anchor.CanCollide=false;anchor.CanQuery=false;anchor.CanTouch=false
   anchor.CastShadow=false;anchor.Transparency=1;anchor.Size=Vector3.one;anchor.Position=position;anchor.Parent=workspace
   parent=anchor
  end
  local sound=Instance.new("Sound");sound.Name="Gameplay"..kind;sound.SoundId=asset
  sound.Looped=false;sound.Volume=0;sound.PlaybackSpeed=1;sound.PlayOnRemove=false
  sound.RollOffMode=Enum.RollOffMode.InverseTapered
  sound.RollOffMinDistance=Settings.NearDistance;sound.RollOffMaxDistance=Settings.Range
  sound.SoundGroup=group;sound.Parent=parent
  return {anchor=anchor,sound=sound}
 end
 local mix=Mix.new(Settings,create,function(handle,volume)
  handle.sound.Volume=volume
  if not handle.started and volume>0 then
   handle.started=true;handle.sound:Play()
  end
 end,
  function(handle)handle.sound:Stop();if handle.anchor then handle.anchor:Destroy() else handle.sound:Destroy() end end)
 local destroy=mix.Destroy
 function mix:Destroy()
  if self.destroyed then return end
  destroyed=true;destroy(self);group:Destroy()
 end
 -- Preload once per configured cue with bounded retries. No short-lived emitter
 -- is allocated until cached; slow/failed loads never stall gameplay or play late.
 for kind in pairs(Settings.Cues) do
  local cueKind=kind;local asset=Settings.Asset(kind)
  if asset then task.spawn(function()
   for attempt=1,3 do
    if destroyed then return end
    local loaded=false
    pcall(function()
     Content:PreloadAsync({asset},function(_,status)
      if status==Enum.AssetFetchStatus.Success then loaded=true end
     end)
    end)
    if destroyed then return end
    if loaded then ready[cueKind]=true;return end
    if attempt<3 then task.wait(attempt) end
   end
  end) end
 end
 return mix
end
return Audio
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">HitFeedback</string>
          <string name="Source"><![CDATA[-- Presentation only: accept monotonically increasing, server-confirmed damage.
local Feedback={};Feedback.__index=Feedback
local function number(n)return type(n)=="number" and n==n and math.abs(n)<math.huge end
function Feedback.new()return setmetatable({sequence=0,total=0,expires=0,discardedThrough=0},Feedback)end
function Feedback:Accept(sequence,total,now)
 if not number(sequence) or sequence%1~=0 or sequence<1 or sequence<self.sequence or sequence<=self.discardedThrough
  or not number(total) or total%1~=0 or total<=0 or total>32768 or not number(now) then return false end
 if sequence==self.sequence and total<=self.total then return false end
 self.sequence=sequence;self.total=total;self.expires=now+.7
 return true
end
function Feedback:DiscardThrough(sequence)
 if not number(sequence) or sequence%1~=0 or sequence<0 then return false end
 self.discardedThrough=math.max(self.discardedThrough,self.sequence,sequence)
 self.expires=0
 return true
end
function Feedback:Read(now)
 if now>=self.expires then return nil end
 return self.total
end
return Feedback
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="59">
        <Properties>
          <string name="Name">LandmarkVisuals</string>
          <string name="Source"><![CDATA[-- Keep authored fallback geometry visible unless every required mesh and texture loads.
local Collection=game:GetService("CollectionService")
local Content=game:GetService("ContentProvider")
local destroyed=false
local connections={}
local pending=setmetatable({},{__mode="k"})
local function apply(model)
 if destroyed or pending[model] then return end
 local detail=model:FindFirstChild("DetailedVisual")
 local fallback=model:FindFirstChild("FallbackVisual")
 if not detail or not fallback then return end
 local ticket={};pending[model]=ticket
 -- Re-entry may reuse an instance whose fallback was hidden on a prior load.
 for _,part in fallback:GetDescendants() do if part:IsA("BasePart") then part.LocalTransparencyModifier=0 end end
 local meshes={};local expected={}
 for _,part in detail:GetDescendants() do
  if part:IsA("BasePart") then part.LocalTransparencyModifier=1 end
  if part:IsA("MeshPart") then
   table.insert(meshes,part)
   for _,id in {part.MeshId,part.TextureID} do if id~="" then expected[id]=false end end
  end
 end
 task.spawn(function()
  if destroyed or pending[model]~=ticket then return end
  local ok=pcall(function()
   Content:PreloadAsync(meshes,function(id,status)
    if expected[id]~=nil then expected[id]=status==Enum.AssetFetchStatus.Success end
   end)
  end)
  if destroyed or pending[model]~=ticket then return end
  if not model:IsDescendantOf(workspace) then pending[model]=nil;return end
  local loaded=ok and #meshes>0
  for _,success in expected do if not success then loaded=false end end
  if loaded then
   for _,part in fallback:GetDescendants() do if part:IsA("BasePart") then part.LocalTransparencyModifier=1 end end
   for _,part in detail:GetDescendants() do if part:IsA("BasePart") then part.LocalTransparencyModifier=0 end end
  end
  model:SetAttribute("LocalVisualStatus",loaded and "Detailed" or "Fallback")
 end)
end
table.insert(connections,Collection:GetInstanceAddedSignal("OptionalLandmarkVisual"):Connect(apply))
table.insert(connections,Collection:GetInstanceRemovedSignal("OptionalLandmarkVisual"):Connect(function(model) pending[model]=nil end))
for _,model in Collection:GetTagged("OptionalLandmarkVisual") do apply(model) end

script.Destroying:Connect(function()
 destroyed=true
 for _,connection in connections do connection:Disconnect() end
 for model in pending do
  pending[model]=nil
  for _,name in {"FallbackVisual","DetailedVisual"} do
   local visual=model:FindFirstChild(name)
   if visual then
    for _,part in visual:GetDescendants() do
     if part:IsA("BasePart") then part.LocalTransparencyModifier=name=="FallbackVisual" and 0 or 1 end
    end
   end
  end
  model:SetAttribute("LocalVisualStatus","Fallback")
 end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">Microphone</string>
          <string name="Source"><![CDATA[local Players=game:GetService('Players')
local Voice=game:GetService('VoiceChatService')
local Run=game:GetService('RunService')
local Power=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("MicPower"))
local Microphone={};Microphone.__index=Microphone
function Microphone.new()
 local self=setmetatable({model=Power.new(),power=0,eligible=false,ready=false,status='Checking Roblox voice access…',captureStarted=nil,phase=nil,quiet={},spoken={},generation=0},Microphone)
 self.connection=Run.Heartbeat:Connect(function(dt) self:Step(dt) end)
 self:Check()
 return self
end
function Microphone:Check()
 if self.destroyed then return end
 self.generation+=1;local generation=self.generation
 self.status='Checking Roblox voice access…';self.eligible=false;self.ready=false;self.checkPending=true;self:CancelCalibration();self:Cancel()
 task.delay(10,function() if self.generation==generation and self.checkPending then self.status='Voice access check timed out. Check Roblox voice settings, then retry.' end end)
 task.spawn(function()
  local ok,enabled=pcall(function() return Voice:IsVoiceEnabledForUserIdAsync(Players.LocalPlayer.UserId) end)
  if self.generation~=generation then return end
  self.checkPending=false
  self.eligible=ok and enabled==true
  self.status=self.eligible and 'Unmute your Roblox microphone, then calibrate.' or 'Roblox voice access is required. Enable eligible voice access in your account and allow microphone permission.'
 end)
end
function Microphone:CancelCalibration()
 self.phase=nil;self.phaseStarted=nil;self.quiet={};self.spoken={}
end
function Microphone:FindInput()
 if self.destroyed then return nil end
 if self.input and self.input.Parent and self.analyzer and self.analyzer.Parent
  and self.wire and self.wire.Parent==self.analyzer
  and self.wire.SourceInstance==self.input and self.wire.TargetInstance==self.analyzer then return self.input end
 self:Cancel();self:CancelCalibration();self.ready=false
 if self.wire then self.wire:Destroy();self.wire=nil end
 if self.analyzer then self.analyzer:Destroy();self.analyzer=nil end
 local input=Players.LocalPlayer:FindFirstChildWhichIsA('AudioDeviceInput',true)
 if not input then return nil end
 if self.input then self.model=Power.new() end
 self.input=input
 local analyzer=Instance.new('AudioAnalyzer');analyzer.Name='ScreamInputMeter';analyzer.SpectrumEnabled=false;analyzer.Parent=Players.LocalPlayer
 local wire=Instance.new('Wire');wire.SourceInstance=input;wire.TargetInstance=analyzer;wire.Parent=analyzer
 self.analyzer=analyzer;self.wire=wire
 self.status='Microphone input found. Calibrate before attacking.'
 return input
end
function Microphone:Calibrate()
 if self.destroyed or self.checkPending then return end
 local input=self:FindInput()
 if not self.eligible or not input then self.status='Enable Roblox voice and reconnect your microphone first.';return end
 if input.Muted then self:HandleMute();self.status='Unmute using the Roblox microphone control, then calibrate.';return end
 -- A new attempt supersedes the previous calibration, including failed retries.
 self:Cancel();self.model=Power.new();self.power=0;self.ready=false;self.phase='quiet';self.phaseStarted=os.clock();self.quiet={};self.spoken={}
 self.status='Calibration 1/2: stay quiet for two seconds.'
end
function Microphone:Cancel()
 self.captureStarted=nil;self.model:BeginCapture()
end
function Microphone:Begin()
 if self.destroyed then return false end
 if not self.ready then return false end
 self.model:BeginCapture();self.captureStarted=os.clock();return true
end
function Microphone:CapturePower()
 return self.captureStarted and self.ready and self.model:CapturePower() or 0
end
function Microphone:Release()
 local started=self.captureStarted;self.captureStarted=nil
 if not started or not self.ready then self.model:BeginCapture();return 0,'Microphone capture canceled. Try again.' end
 local elapsed=os.clock()-started
 if elapsed<.25 then self.model:BeginCapture();return 0,'Hold attack while speaking for at least 0.25 seconds.' end
 if elapsed>8 then self.model:BeginCapture();return 0,'Capture expired. Start a new live beam.' end
 local power=self.model:Release()
 return power,power<.08 and 'Hold attack FIRST, speak immediately, then release within 1.25 seconds.' or nil
end
function Microphone:HandleMute()
 self.wasMuted=true;self.ready=false;self:CancelCalibration();self:Cancel();self.model:Reset();self.power=0
 self.status='Microphone muted. Unmute in Roblox to continue.'
end
function Microphone:Step(dt)
 if self.destroyed then return end
 if not self.eligible then self.power=0;return end
 local input=self:FindInput()
 if not input then self.status='Waiting for Roblox mic input. The experience needs Voice Chat and the Audio API enabled.';self.power=0;return end
 if input.Muted then
  self:HandleMute();return
 end
 if self.wasMuted then
  self.wasMuted=false
  if not self.model.calibrated and not self.phase then self.status='Microphone unmuted. Calibrate before attacking.' end
 end
 local rms=self.analyzer.RmsLevel
 if type(rms)~="number" or rms~=rms or math.abs(rms)==math.huge or rms<0 then
  self.signalUnavailable=true;self.ready=false;self.power=0;self:CancelCalibration();self:Cancel()
  self.status='Microphone signal unavailable. Check your input.';return
 end
 if self.signalUnavailable then
  self.signalUnavailable=false
  if not self.model.calibrated and not self.phase then self.status='Microphone signal restored. Calibrate before attacking.' end
 end
 self.power=self.model:Step(rms,dt)
 if self.phase then
  table.insert(self.phase=='quiet' and self.quiet or self.spoken,rms)
  if os.clock()-self.phaseStarted>=2 then
   if self.phase=='quiet' then self.phase='voice';self.phaseStarted=os.clock();self.status='Calibration 2/2: use a comfortable strong voice for two seconds.'
   else local ok,message=self.model:Calibrate(self.quiet,self.spoken);self.phase=nil;self.ready=ok;self.status=ok and 'Calibration complete. Follow the voice meter to attack.' or message end
  end
 elseif self.model.calibrated then self.ready=true;self.status='Microphone ready • live input detected' end
 if self.captureStarted and os.clock()-self.captureStarted<=1.25 then self.model:Capture(self.power) end
end
function Microphone:Destroy()
 if self.destroyed then return end
 self.destroyed=true;self.generation+=1;self.checkPending=false
 self.ready=false;self.eligible=false;self.power=0
 self:CancelCalibration();self:Cancel();self.model.calibrated=false
 self.connection:Disconnect()
 if self.wire then self.wire:Destroy();self.wire=nil end
 if self.analyzer then self.analyzer:Destroy();self.analyzer=nil end
 self.input=nil
end
return Microphone
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">NotificationQueue</string>
          <string name="Source"><![CDATA[-- Bounded UI notices. Time advances only on visible rendered frames.
local Queue={};Queue.__index=Queue
Queue.Limit=8
function Queue.new() return setmetatable({pending={}},Queue) end
local function duration(text) return math.clamp(utf8.len(text) or #text,88,264)/22 end
function Queue:Remove(key)
 if key==nil then return end
 for i=#self.pending,1,-1 do if self.pending[i].key==key then table.remove(self.pending,i) end end
 -- Removing active status opens a slot for existing queued work first.
 if self.active and self.active.key==key then self.active=table.remove(self.pending,1) end
end
function Queue:Push(text,urgent,key)
 if type(text)~="string" or text=="" then return end
 urgent=urgent==true
 if self.active and self.active.text==text then return end
 for _,entry in ipairs(self.pending) do if entry.text==text then return end end
 -- Stateful keys coalesce obsolete guidance; save has one highest-priority entry.
 if key then self:Remove(key) end
 local priority=key=="save" and 2 or urgent and 1 or 0
 local entry={text=text,urgent=urgent,key=key,priority=priority,remaining=duration(text)}
 if self.active and priority>self.active.priority then
  self.active.remaining=duration(self.active.text);self.active.presented=false
  table.insert(self.pending,1,self.active);self.active=nil
 end
 if not self.active then self.active=entry
 elseif priority>0 then
  local index=1
  while self.pending[index] and self.pending[index].priority>=priority do index+=1 end
  table.insert(self.pending,index,entry)
 else table.insert(self.pending,entry) end
 if #self.pending>Queue.Limit then
  local drop=1
  for i,item in ipairs(self.pending) do if item.priority<self.pending[drop].priority then drop=i end end
  table.remove(self.pending,drop)
 end
end
function Queue:Step(dt,visible)
 local entry=self.active
 if not entry then return "" end
 if visible then
  if entry.presented then entry.remaining-=math.clamp(dt,0,.1) end
  entry.presented=true
  if entry.remaining<=0 then self.active=table.remove(self.pending,1);entry=self.active end
 end
 return entry and entry.text or ""
end
return Queue
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="62">
        <Properties>
          <string name="Name">Residents</string>
          <string name="Source"><![CDATA[-- Local visual animation avoids replicating every resident's joints each frame.
local Collection=game:GetService("CollectionService")
local Run=game:GetService("RunService")
local rigs={}
local connections={}
local destroyed=false
local jointNames={"Left Shoulder","Right Shoulder","Left Hip","Right Hip"}
local function makePracticeBall()
 local model=Instance.new("Model");model.Name="NickPracticeVisual"
 local function piece(name,size,cf)
  local p=Instance.new("Part");p.Name=name;p.Shape=Enum.PartType.Ball;p.Size=size;p.CFrame=cf;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false;p.Transparency=1;p.Color=name=="Ball" and Color3.fromRGB(241,232,210) or Color3.fromRGB(43,54,60);p.Parent=model;return p
 end
 model.PrimaryPart=piece("Ball",Vector3.new(1.5,1.5,1.5),CFrame.identity)
 for _,axis in ipairs({Vector3.xAxis,-Vector3.xAxis,Vector3.yAxis,-Vector3.yAxis,Vector3.zAxis,-Vector3.zAxis}) do
  piece("Panel",Vector3.new(.4,.035,.4),CFrame.lookAt(axis*.745,axis*2,math.abs(axis.Y)>.98 and Vector3.zAxis or Vector3.yAxis)*CFrame.Angles(math.pi/2,0,0))
 end
 model.Parent=workspace;return model
end
local function suspendRig(rig)
 rig.blend=0;rig.elapsed=0
 for _,joint in pairs(rig.joints) do if joint.Parent then joint.Transform=CFrame.identity end end
 for _,joint in pairs({rig.rootJoint,rig.neck}) do if joint.Parent then joint.Transform=CFrame.identity end end
 if rig.practiceBall then
  rig.ballVisible=false
  for _,piece in ipairs(rig.practiceBall:GetChildren()) do piece.Transparency=1 end
 end
end
local function clearRig(model)
 local rig=rigs[model];if not rig then return end
 if rig.practiceBall then rig.practiceBall:Destroy() end
 for _,joint in pairs(rig.joints) do if joint.Parent then joint.Transform=CFrame.identity end end
 for _,joint in pairs({rig.rootJoint,rig.neck}) do if joint.Parent then joint.Transform=CFrame.identity end end
 rigs[model]=nil
end
local function register(model)
 if destroyed or rigs[model] then return end
 rigs[model]={model=model,joints={},phase=(model:GetAttribute("AnimationSeed") or 1)*.71,blend=0,elapsed=0}
 if model:GetAttribute("DisplayName")=="Nick Booty" then rigs[model].practiceBall=makePracticeBall() end
end
table.insert(connections,Collection:GetInstanceAddedSignal("CityResident"):Connect(register))
table.insert(connections,Collection:GetInstanceRemovedSignal("CityResident"):Connect(clearRig))
for _,model in ipairs(Collection:GetTagged("CityResident")) do register(model) end
table.insert(connections,Run.PreSimulation:Connect(function(dt)
 local camera=workspace.CurrentCamera;if not camera then return end
 for model,rig in pairs(rigs) do
  if not model:IsDescendantOf(workspace) or model:GetAttribute("ResidentActive")==false then
   if not rig.suspended then suspendRig(rig);rig.suspended=true end
   continue
  end
  local root=model:FindFirstChild("HumanoidRootPart");local torso=model:FindFirstChild("Torso")
  local humanoid=model:FindFirstChildOfClass("Humanoid")
  if not root or not torso or not humanoid then
   -- Partial streaming must not leave a detached local practice prop visible.
   if not rig.suspended then suspendRig(rig);rig.suspended=true end
   continue
  end
  rig.suspended=false
  local distance=(root.Position-camera.CFrame.Position).Magnitude
  rig.elapsed+=dt
  local interval=distance<70 and 0 or distance<160 and 1/20 or 1/5
  if rig.elapsed<interval then continue end
  local elapsed=math.min(rig.elapsed,.2);rig.elapsed=0
  local poseAlpha=1-math.exp(-elapsed*14)
  local speed=Vector3.new(root.AssemblyLinearVelocity.X,0,root.AssemblyLinearVelocity.Z).Magnitude
  local seated=humanoid.SeatPart~=nil
  local moving=not seated and humanoid.Health>0 and speed>.4 and humanoid.FloorMaterial~=Enum.Material.Air
  rig.blend+=((moving and 1 or 0)-rig.blend)*math.min(elapsed*10,1)
  rig.phase+=elapsed*math.max(6,speed*1.2)
  local swing=math.sin(rig.phase)*.42*rig.blend
  local now=workspace:GetServerTimeNow();local role=model:GetAttribute("Role")
  local working=model:GetAttribute("Working") and humanoid.Health>0 and not moving
  local workAge=(now-(model:GetAttribute("WorkStarted") or now))%(role=="Soccer" and 6.5 or 5)
  local routine=model:GetAttribute("PracticeRoutine") or "Miss"
  rig.rootJoint=rig.rootJoint and rig.rootJoint.Parent and rig.rootJoint or torso:FindFirstChild("RootJoint")
  if rig.rootJoint then
   local stumble=working and role=="Soccer" and routine=="Trip" and workAge>=1.3 and workAge<4.3 and math.sin((workAge-1.3)/3*math.pi) or 0
   local gaitBob=math.sin(rig.phase*2)*.035*rig.blend
   local breath=math.sin(now*1.7+(model:GetAttribute("AnimationSeed") or 1))*.012*(1-rig.blend)
   local workLean=working and (role=="Gardener" or role=="Sanitation") and .09 or 0
   local pose=CFrame.new(0,gaitBob+breath,0)*CFrame.Angles(-.65*stumble-workLean-.05*rig.blend,0,math.sin(workAge*8)*.12*stumble)
   rig.rootJoint.Transform=rig.rootJoint.Transform:Lerp(pose,poseAlpha)
  end
  rig.neck=rig.neck and rig.neck.Parent and rig.neck or torso:FindFirstChild("Neck")
  if rig.neck then
   local reading=seated and model:GetAttribute("Reading")==true
   local idle=not moving and not working and not seated and not model:GetAttribute("Gesturing")
   local glance=idle and distance<100 and math.sin(now*.55+(model:GetAttribute("AnimationSeed") or 1))* .13 or 0
   rig.neck.Transform=rig.neck.Transform:Lerp(CFrame.Angles(reading and -.22 or working and -.06 or 0,glance,0),poseAlpha)
  end
  if rig.practiceBall then
   local visible=working and distance<180
   if rig.ballVisible~=visible then
    rig.ballVisible=visible
    for _,piece in ipairs(rig.practiceBall:GetChildren()) do piece.Transparency=visible and 0 or 1 end
   end
   if visible then
    local forward=Vector3.new(root.CFrame.LookVector.X,0,root.CFrame.LookVector.Z)
    if forward.Magnitude>.01 then forward=forward.Unit end
    local position=root.Position-Vector3.new(0,1.9,0)+forward*1.65
    local spin=0
    if routine=="OwnGoal" then
     local t=math.clamp((workAge-1.2)/2.5,0,1)
     -- This local prop rolls through the existing goal; it never scores quest progress.
     position=position:Lerp(Vector3.new(628,2.05,586),1-(1-t)^2);spin=t*math.pi*10
    elseif routine=="Trip" then
     local t=math.clamp((workAge-1.3)/1.5,0,1)
     position+=forward*t*2.2;spin=t*3
    end
    rig.practiceBall:PivotTo(CFrame.new(position)*CFrame.Angles(spin,0,0))
   end
  end
  for i,name in ipairs(jointNames) do
   local joint=rig.joints[i]
   if not joint or not joint.Parent then joint=torso:FindFirstChild(name);rig.joints[i]=joint end
   if not joint then continue end
   local angle=(i==1 or i==4) and swing or -swing
   if distance<180 and not moving then
    if model:GetAttribute("Gesturing") and i==1 then angle=-.8+math.sin(now*5)*.15 end
    if model:GetAttribute("Working") then
     if role=="CafeWorker" and i<=2 then angle=-.8+(i==2 and math.sin(now*3)*.15 or 0)
     elseif role=="Sanitation" and i==2 then angle=model:GetAttribute("Repairing") and (-.9+math.sin(now*5)*.4) or (-.15+math.sin(now*2)*.3)
     elseif role=="BeachWorker" and i==2 then angle=-.7+math.sin(now*2.5)*.2
     elseif role=="Busker" and i<=2 then angle=-.6+(i==2 and math.sin(now*8)*.13 or 0)
     elseif role=="Soccer" then
      if workAge<1 and i==4 then angle=.6*math.sin(workAge*math.pi/2)
      elseif workAge<1.5 and i==4 then angle=-1.1*math.sin((workAge-1)*math.pi*2)
      elseif routine=="Trip" and workAge>=1.3 and workAge<4.3 then
       local flail=math.sin((workAge-1.3)/3*math.pi)
       if i<=2 then angle=(-1.7+math.sin(workAge*9+i)*.3)*flail
       else angle=(i==3 and .5 or -.8)*flail end
      elseif routine=="OwnGoal" and workAge>=3.7 and workAge<5.1 and i<=2 then angle=-2.5
      elseif routine=="OwnGoal" and workAge>=5.1 and i==2 then angle=-2.1
      elseif routine=="Miss" and workAge>=1.5 and workAge<3 and i<=2 then angle=-2.5
      elseif routine=="Miss" and workAge>=3 and workAge<4.8 and i==2 then angle=-2.1 end
     elseif role=="Gardener" and i==2 then angle=-.9+math.sin(now*1.6)*.12
     elseif role=="Artist" and i==2 then angle=-1.2+math.sin(now*3)*.18
     elseif role=="Artist" and i==1 then angle=-.7
     elseif role=="Vendor" and i<=2 then angle=-.6+math.sin(now*2+i)*.3 end
    end
   end
   if role=="CafeWorker" and model:GetAttribute("WorkStep")==2 and i==1 then angle=-.8 end
   if seated then
    if i>=3 then angle=-math.pi/2 elseif model:GetAttribute("Reading") and i==1 then angle=-1.15 else angle=-.15 end
   end
   -- These custom R6 joints have no rotated basis: positive X bends toward -Z.
   if model:GetAttribute("Applauding") and humanoid.Health>0 and not moving and not seated and i<=2 then
    -- Bring both hands together in front of the chest; phase offsets keep
    -- several spectators from clapping in perfect synchronization.
    local inward=.55+math.sin(now*9+(model:GetAttribute("AnimationSeed") or 1))*.2
    joint.Transform=joint.Transform:Lerp(CFrame.Angles(1.15,0,(i==1 and 1 or -1)*inward),poseAlpha)
   else
    joint.Transform=joint.Transform:Lerp(CFrame.Angles(-angle,0,0),poseAlpha)
   end
  end
 end
end))
script.Destroying:Connect(function()
 destroyed=true
 for _,connection in ipairs(connections) do connection:Disconnect() end
 for model in pairs(rigs) do clearRig(model) end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="63">
        <Properties>
          <string name="Name">RunAnimation</string>
          <string name="Source"><![CDATA[-- Additive locomotion and combat poses. Inputs never originate in this animation layer.
-- Default Roblox locomotion remains underneath; offsets are removed before each animation step.
local Players=game:GetService("Players")
local Run=game:GetService("RunService")
local Config=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local rigs,watchers,connections={},{},{}
local destroyed=false
local function clearRig(player)
 local rig=rigs[player]
 if not rig then return end
 for _,connection in ipairs(rig.connections) do connection:Disconnect() end
 for joint,offset in pairs(rig.offsets) do
  if joint.Parent then joint.Transform=joint.Transform*offset:Inverse() end
 end
 rigs[player]=nil
end
local function clearPlayer(player)
 local links=watchers[player]
 if links then for _,connection in ipairs(links) do connection:Disconnect() end end
 watchers[player]=nil;clearRig(player)
end
local function watch(player)
 if destroyed or watchers[player] then return end
 local links={};watchers[player]=links
 local function added(character)
  local humanoid=character:WaitForChild("Humanoid",10);local root=character:WaitForChild("HumanoidRootPart",10)
  if destroyed or watchers[player]~=links or not humanoid or not root or player.Character~=character then return end
  clearRig(player)
  local rig={character=character,humanoid=humanoid,root=root,joints={},offsets={},phase=0,blend=0,airborne=false,landing=0,charge=0,connections={}};rigs[player]=rig
  local function collect(item)
   if item:IsA("Motor6D") or item:IsA("AnimationConstraint") then
    rig.joints[item.Name]=item
    if item:IsA("Motor6D") and item.Part0==root or item:IsA("AnimationConstraint") and item.Attachment0 and item.Attachment0.Parent==root then rig.rootJoint=item end
   end
  end
  for _,item in ipairs(character:GetDescendants()) do collect(item) end
  table.insert(rig.connections,character.DescendantAdded:Connect(collect))
 end
 table.insert(links,player.CharacterRemoving:Connect(function(character)
  local rig=rigs[player];if rig and rig.character==character then
   clearRig(player)
  end
 end))
 table.insert(links,player.CharacterAdded:Connect(added));if player.Character then task.spawn(added,player.Character) end
end
table.insert(connections,Players.PlayerAdded:Connect(watch))
table.insert(connections,Players.PlayerRemoving:Connect(clearPlayer))
for _,p in ipairs(Players:GetPlayers()) do watch(p) end
table.insert(connections,Run.PreAnimation:Connect(function()
 for _,rig in pairs(rigs) do for joint,offset in pairs(rig.offsets) do if joint.Parent then joint.Transform=joint.Transform*offset:Inverse() end end;table.clear(rig.offsets) end
end))
table.insert(connections,Run.PreSimulation:Connect(function(dt)
 for player,rig in pairs(rigs) do
  if not rig.character.Parent then continue end
  local function pose(name,offset,jointSpace)
   local j=rig.joints[name]
   if j and j.Parent then
    if not jointSpace then
     -- R6 joint bases include quarter turns. Express body motions in the
     -- parent part's axes so forward motion stays forward on both rig types.
     local basis=j:IsA("Motor6D") and j.C0.Rotation or j.Attachment0 and j.Attachment0.CFrame.Rotation or CFrame.identity
     offset=basis:Inverse()*offset*basis
    end
    j.Transform=j.Transform*offset;rig.offsets[j]=(rig.offsets[j] or CFrame.identity)*offset
   end
  end
  local now=workspace:GetServerTimeNow();local ends=player:GetAttribute("DodgeEnds") or 0;local started=player:GetAttribute("DodgeStarted") or 0
  local grounded=rig.humanoid.FloorMaterial~=Enum.Material.Air
  if rig.airborne and grounded then rig.landing=now end
  rig.airborne=not grounded
  if not rig.root.Parent or not rig.humanoid.Parent or rig.humanoid.Health<=0 or rig.humanoid.Sit or rig.humanoid.SeatPart or rig.humanoid.PlatformStand or now<(player:GetAttribute("KnockdownEnds") or 0) then
   rig.charge=0;rig.blend=0;rig.airborne=false;rig.landing=0
   rig.character:SetAttribute("RollAnimationProgress",-1)
   rig.character:SetAttribute("SprintAnimationBlend",0)
   continue
  end
  if now<ends and started>0 then
   rig.charge=0
   local t=math.clamp((now-started)/Config.DodgeDuration,0,1);local tuck=math.sin(t*math.pi)
   local rootJoint=rig.rootJoint or rig.joints.RootJoint or rig.joints.Root or rig.joints.RootMotor
   if rootJoint then
    local roll=CFrame.new(0,-1.1*tuck,0)*CFrame.Angles(-math.pi*2*t,0,0)
    local basis=rootJoint:IsA("Motor6D") and rootJoint.C0 or rootJoint.Attachment0 and rootJoint.Attachment0.CFrame or CFrame.identity
    local offset=basis:Inverse()*roll*basis
    pose(rootJoint.Name,offset,true)
   end
   for _,name in ipairs({"Left Shoulder","Right Shoulder","LeftShoulder","RightShoulder"}) do pose(name,CFrame.Angles(-1.4*tuck,0,0)) end
   for _,name in ipairs({"Left Hip","Right Hip","LeftHip","RightHip"}) do pose(name,CFrame.Angles(1.2*tuck,0,0)) end
   for _,name in ipairs({"LeftKnee","RightKnee"}) do pose(name,CFrame.Angles(-1.6*tuck,0,0)) end
   pose("Waist",CFrame.Angles(-.4*tuck,0,0))
   rig.character:SetAttribute("RollAnimationProgress",t)
   continue
  end
  rig.character:SetAttribute("RollAnimationProgress",-1)
  local v=rig.root.AssemblyLinearVelocity;local speed=Vector3.new(v.X,0,v.Z).Magnitude
  local sprinting=player:GetAttribute("Sprinting") and speed>3 and rig.humanoid.FloorMaterial~=Enum.Material.Air and now>=(player:GetAttribute("KnockdownEnds") or 0)
  rig.blend+=((sprinting and 1 or 0)-rig.blend)*math.min(dt*12,1)
  -- Both attack modes use accepted server state; movement input never fires attacks.
  -- Sustained attacks hold the existing braced scream pose until cancellation,
  -- then blend back into the default Animator instead of snapping to idle.
  local charging=(player:GetAttribute("CaptureStarted") or 0)>0 or player:GetAttribute("SustainedActive")==true
  rig.charge+=((charging and 1 or 0)-rig.charge)*math.min(dt*14,1)
  local released=player:GetAttribute("ScreamReleased") or 0
  local age=now-released
  local recoil=age>=0 and age<.38 and math.sin(age/.38*math.pi) or 0
  local charge=rig.charge
  for _,name in ipairs({"Left Shoulder","LeftShoulder"}) do pose(name,CFrame.Angles(-.65*charge-.9*recoil,0,-.32*charge)) end
  local equipped=rig.character:FindFirstChild("MicroSpeakerAccessory")~=nil
  for _,name in ipairs({"Right Shoulder","RightShoulder"}) do pose(name,CFrame.Angles(-(equipped and 1.15 or .65)*charge-.9*recoil,0,(equipped and -.15 or .32)*charge)) end
  pose("Waist",CFrame.Angles(.12*charge-.28*recoil,0,0))
  pose("Neck",CFrame.Angles(-.12*charge+.1*recoil,0,0))
  if not grounded and rig.humanoid:GetState()~=Enum.HumanoidStateType.Swimming then
   local rising=v.Y>1
   local bend=rising and .26 or -.13
   for _,name in ipairs({"Left Hip","LeftHip","Right Hip","RightHip"}) do pose(name,CFrame.Angles(bend,0,0)) end
   pose("LeftKnee",CFrame.Angles(rising and -.5 or -.15,0,0))
   pose("RightKnee",CFrame.Angles(rising and -.3 or -.2,0,0))
  elseif grounded then
   local elapsed=now-rig.landing
   local compress=elapsed>=0 and elapsed<.22 and math.sin(elapsed/.22*math.pi) or 0
   pose("Waist",CFrame.Angles(-.13*compress,0,0))
   pose("LeftKnee",CFrame.Angles(-.35*compress,0,0));pose("RightKnee",CFrame.Angles(-.35*compress,0,0))
  end
  if rig.blend<.01 then continue end
  rig.phase+=dt*13;local swing=math.sin(rig.phase)*.32*rig.blend
  for _,spec in ipairs({{"Left Shoulder",swing},{"Right Shoulder",-swing},{"Left Hip",-swing},{"Right Hip",swing},{"LeftShoulder",swing},{"RightShoulder",-swing},{"LeftHip",-swing},{"RightHip",swing},{"LeftKnee",math.max(0,swing)*.7},{"RightKnee",math.max(0,-swing)*.7}}) do pose(spec[1],CFrame.Angles(spec[2],0,0)) end
  pose("Waist",CFrame.Angles(-.14*rig.blend,math.sin(rig.phase)*.04*rig.blend,0));rig.character:SetAttribute("SprintAnimationBlend",rig.blend)
 end
end))
script.Destroying:Connect(function()
 destroyed=true
 for _,connection in ipairs(connections) do connection:Disconnect() end
 for player in pairs(watchers) do clearPlayer(player) end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="64">
        <Properties>
          <string name="Name">ScreamEffects</string>
          <string name="Source"><![CDATA[-- Cosmetic only. Server beam length/width remain authoritative; no voice recordings.
local Tween=game:GetService("TweenService")
local Effects={}
local limits={core=64,detail=144}
local active={core=0,detail=0}
local pools={core={},detail={}}
local live={}
local function facing(a,b)
 local direction=(b-a).Unit
 return CFrame.lookAt(a,b,math.abs(direction.Y)>.98 and Vector3.zAxis or Vector3.yAxis)
end
local function particle(kind,cf,size,color,shape,lifetime,goal)
 if active[kind]>=limits[kind] then return end
 local p=table.remove(pools[kind]) or Instance.new("Part")
 p.Name="ScreamVisual";p.Anchored=true;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false;p.CastShadow=false
 p.Material=Enum.Material.Neon;p.Color=color;p.Shape=shape or Enum.PartType.Block
 p.Size=size;p.CFrame=cf;p.Transparency=kind=="core" and .55 or .25;p.Parent=workspace
 active[kind]+=1
 local target=goal or {};target.Transparency=1
 local tween=Tween:Create(p,TweenInfo.new(lifetime,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),target)
 live[p]=tween;tween:Play()
 task.delay(lifetime+.05,function()
  if live[p]~=tween then return end
  live[p]=nil;p.Parent=nil;active[kind]-=1;table.insert(pools[kind],p)
 end)
end
local function line(kind,a,b,thickness,color,lifetime)
 local distance=(b-a).Magnitude;if distance<.01 then return end
 particle(kind,facing((a+b)/2,b),Vector3.new(thickness,thickness,distance),color,nil,lifetime)
end
function Effects.Render(family,origin,direction,length,width,color,reduced,variant)
 if length<=.01 or direction.Magnitude<.01 then return end
 direction=direction.Unit;length=math.clamp(length,.01,110);width=math.clamp(width,1,7)
 local basis=facing(origin,origin+direction)
 local right,up=basis.RightVector,basis.UpVector
 local center=origin+direction*length/2
 -- Separate budgets reserve a readable core even when decoration is saturated.
 particle("core",facing(center,center+direction),Vector3.new(width*.42,width*.42,length),color,nil,.32)
 particle("core",facing(center,center+direction),Vector3.new(.18,.18,length),Color3.fromRGB(255,240,203),nil,.24)
 if reduced then return end
 local rank=math.clamp(tonumber(variant) or 1,1,10)
 local function ring(distance,radius,life)
  local at=origin+direction*distance
  for i=1,8 do
   local a=(i-1)*math.pi/4;local b=i*math.pi/4
   line("detail",at+(right*math.cos(a)+up*math.sin(a))*radius,at+(right*math.cos(b)+up*math.sin(b))*radius,.12+rank*.006,color,life)
  end
 end
 if family=="Echo" then
  for i=1,3 do ring(length*i/4,width*(.3+i*.11),.25+i*.08) end
 elseif family=="Feathers" then
  for i=1,8 do
   local phase=i*math.pi/4;local offset=(right*math.cos(phase)+up*math.sin(phase))*width*.4
   local start=origin+offset
   local cf=facing(start,start+direction)*CFrame.Angles(0,0,phase)
   particle("detail",cf,Vector3.new(.18,.9+rank*.03,.35),color,nil,.45,{Position=origin+direction*length+offset,Orientation=Vector3.new(i*31,i*19,i*43)})
  end
 elseif family=="Quake" then
  -- Jagged ribbons follow the aimed beam, including when aiming upward.
  for _,side in ipairs({-1,1}) do
   local last=origin+right*side*width*.3-up*width*.25
   for i=1,5 do
    local nextPoint=origin+direction*(length*i/5)+right*side*width*(i%2==0 and .45 or .25)-up*width*.25
    line("detail",last,nextPoint,.25,color,.4);last=nextPoint
   end
  end
 elseif family=="Storm" then
  for strand=1,2 do
   local last=origin
   for i=1,7 do
    local offset=(right*math.sin(i*2.4+strand)+up*math.cos(i*1.7+strand))*width*.3
    local nextPoint=origin+direction*(length*i/7)+(i==7 and Vector3.zero or offset)
    line("detail",last,nextPoint,.12,color,.2+strand*.05);last=nextPoint
   end
  end
 elseif family=="Nova" then
  local finish=origin+direction*length
  for i=1,8 do
   local phase=i*math.pi/4;local offset=(right*math.cos(phase)+up*math.sin(phase))*width*.7
   line("detail",finish+offset*.25,finish+offset,.16,color,.35)
  end
  ring(length,width*.45,.4)
 else -- Pulse
  ring(math.min(length,4),width*.4,.3)
 end
end
function Effects.Clear()
 for part,tween in pairs(live) do live[part]=nil;tween:Cancel();part:Destroy() end
 for kind,pool in pairs(pools) do
  for _,part in ipairs(pool) do part:Destroy() end
  table.clear(pool);active[kind]=0
 end
end
function Effects.Budget()
 return {core=active.core,detail=active.detail,cachedCore=#pools.core,cachedDetail=#pools.detail,coreLimit=limits.core,detailLimit=limits.detail}
end
return Effects
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="65">
        <Properties>
          <string name="Name">ShopUI</string>
          <string name="Source"><![CDATA[local Marketplace=game:GetService("MarketplaceService")
local UIS=game:GetService("UserInputService")
local Catalog=require(game:GetService("ReplicatedStorage").Shared.ShopCatalog)
local Config=require(game:GetService("ReplicatedStorage").Shared.Config)
local Shop={}
local connections,timers={},{}
local prices={}
local generation=0
local accent=Color3.fromRGB(79,225,255)
local violet=Color3.fromRGB(173,139,255)
local gold=Color3.fromRGB(255,209,111)
local ink=Color3.fromRGB(9,14,28)
local soft=Color3.fromRGB(160,178,208)
function Shop.Clear()
 generation+=1
 for _,connection in ipairs(connections) do connection:Disconnect() end
 table.clear(connections);table.clear(timers)
end
local function stroke(parent,color,thickness)
 local edge=Instance.new("UIStroke");edge.Color=color;edge.Transparency=.65;edge.Thickness=thickness or 1;edge.Parent=parent
end
local function gradient(parent,colors,rotation)
 local g=Instance.new("UIGradient");g.Color=ColorSequence.new(colors);g.Rotation=rotation or 0;g.Parent=parent;return g
end
function Shop.Tick()
 for _,timer in ipairs(timers) do
  local remaining=math.max(0,math.ceil(timer.ends-timer.serverNow-(os.clock()-timer.received)))
  local text=not timer.ready and "Boost status unavailable" or remaining>0 and string.format("ACTIVE · %02d:%02d remaining",math.floor(remaining/60),remaining%60) or "Not active"
  if timer.label.Text~=text then timer.label.Text=text end
 end
end
local function purchaseButton(item,parent,owned,data,ui,action,size,pos)
 local id=item.key=="Movement" and Config.MovementPassId or item.id
 local text=owned and "OWNED" or id<=0 and "COMING SOON" or "CHECKING PRICE…"
 local available=false
 local b=ui.button(parent,"Buy"..item.key,text,size,pos,function()
  if available then action:FireServer("ShopPurchase",item.key) end
 end,owned and Color3.fromRGB(32,75,73) or ink)
 b.TextSize=13;stroke(b,accent)
 if owned or id<=0 then b.AutoButtonColor=false;return end
 local revision=generation
 local function apply(info)
  if revision~=generation or not b.Parent then return end
  available=info and info.IsForSale==true and type(info.PriceInRobux)=="number" and data.savingAvailable==true
  b.Text=available and ("R$ "..tostring(info.PriceInRobux)) or data.savingAvailable~=true and "TEST / UNAVAILABLE" or "UNAVAILABLE"
  b.AutoButtonColor=available
 end
 local key=item.kind..":"..id;local cached=prices[key]
 if cached and os.clock()-cached.at<60 then apply(cached.info);return end
 task.spawn(function()
  local ok,info=pcall(Marketplace.GetProductInfoAsync,Marketplace,id,item.kind=="pass" and Enum.InfoType.GamePass or Enum.InfoType.Product)
  if ok then prices[key]={info=info,at=os.clock()} end
  apply(ok and info or nil)
 end)
end
function Shop.Render(data,ui,action)
 Shop.Clear()
 local narrow=ui.narrow
 local hero=ui.card(narrow and 300 or 260);hero.Name="SpectrumFeature"
 hero.BackgroundColor3=Color3.new(1,1,1)
 gradient(hero,{ColorSequenceKeypoint.new(0,Color3.fromRGB(30,49,76)),ColorSequenceKeypoint.new(1,Color3.fromRGB(39,24,61))},25)
 stroke(hero,accent)
 ui.label(hero,"01 / MAKE IT YOURS",UDim2.new(1,-32,0,20),UDim2.fromOffset(16,12),12,accent)
 local heading=ui.label(hero,"SPECTRUM",UDim2.new(1,-32,0,38),UDim2.fromOffset(16,35),30);heading.Font=Enum.Font.GothamBlack
 ui.label(hero,"One pass. Choose your beam hue.",UDim2.new(1,-32,0,38),UDim2.fromOffset(16,78),15)
 local beam=ui.frame(hero,"SpectrumBeam",UDim2.new(1,-48,0,12),UDim2.fromOffset(24,137),Color3.new(1,1,1))
 local keys={};for i=0,6 do table.insert(keys,ColorSequenceKeypoint.new(i/6,Color3.fromHSV(i/6,.8,1))) end
 gradient(beam,keys)
 ui.frame(beam,"HotCore",UDim2.new(1,0,0,3),UDim2.fromOffset(0,4),Color3.new(1,1,1))
 for i=1,4 do
  local ring=ui.frame(hero,"EnergyRing",UDim2.fromOffset(14,42),UDim2.new(i/5,-7,0,122),accent)
  ring.BackgroundTransparency=1;stroke(ring,Color3.fromHSV(i/5,.5,1),2)
 end
 ui.label(hero,"Unlock the hue picker. Yellow is the base color; saved colors are kept.",UDim2.new(1,-32,0,narrow and 42 or 30),UDim2.fromOffset(16,167),13,soft)
 purchaseButton(Catalog.Get("Spectrum"),hero,data.spectrumPass,data,ui,action,UDim2.new(1,-32,0,44),UDim2.fromOffset(16,narrow and 238 or 206))
 for index,key in ipairs({"XP","Coins"}) do
  local item=Catalog.Get(key);local tint=key=="XP" and violet or gold
  local c=ui.card(narrow and 244 or 210);c.Name="Boost"..key;stroke(c,tint)
  local badge=ui.frame(c,"Multiplier",UDim2.fromOffset(54,54),UDim2.fromOffset(16,16),ink)
  local badgeText=ui.label(badge,"2×",UDim2.fromScale(1,1),UDim2.new(),27,tint);badgeText.TextXAlignment=Enum.TextXAlignment.Center;badgeText.Font=Enum.Font.GothamBlack
  ui.label(c,"0"..(index+1).." / "..item.tag,UDim2.new(1,-100,0,20),UDim2.fromOffset(84,13),12,tint)
  ui.label(c,item.name,UDim2.new(1,-100,0,32),UDim2.fromOffset(84,34),narrow and 18 or 22)
  ui.label(c,item.description.." Starts automatically on confirmed delivery.",UDim2.new(1,-32,0,narrow and 56 or 40),UDim2.fromOffset(16,80),14,soft)
  local shop=data.shop or {};local inventory=shop.inventory or {};local ends=shop.ends or {}
  local status=ui.label(c,shop.ready==true and "Not active" or "Boost status unavailable",UDim2.new(1,-32,0,24),UDim2.fromOffset(16,narrow and 143 or 124),13,tint)
  table.insert(timers,{label=status,ready=shop.ready==true,ends=ends[item.boost] or 0,serverNow=shop.serverNow or os.time(),received=os.clock()})
  local y=narrow and 184 or 158
  local count=inventory[item.boost] or 0
  purchaseButton(item,c,false,data,ui,action,UDim2.new(count>0 and .5 or 1,count>0 and -22 or -32,0,44),UDim2.fromOffset(16,y))
  if count>0 then
   local b=ui.button(c,"Activate"..key,"USE SAVED ("..count..")",UDim2.new(.5,-22,0,44),UDim2.new(.5,6,0,y),function()
    if shop.ready then action:FireServer("ActivateBoost",item.boost) end
   end,ink);b.TextSize=13;b.TextColor3=tint;b.AutoButtonColor=shop.ready==true
  end
 end
 local movement=ui.card(narrow and 202 or 170);stroke(movement,accent)
 ui.label(movement,"04 / FREERUNNER",UDim2.new(1,-32,0,28),UDim2.fromOffset(16,12),20,accent)
 ui.label(movement,"Chain jumps and rolls through the safe city. Standard movement rules apply inside the PvP arena.",UDim2.new(1,-32,0,narrow and 70 or 48),UDim2.fromOffset(16,48),14,soft)
 purchaseButton(Catalog.Get("Movement"),movement,data.movementPass,data,ui,action,UDim2.new(1,-32,0,44),UDim2.fromOffset(16,narrow and 142 or 110))
 ui.info("New boosts activate automatically on confirmed delivery and stack time, not multiplier. Previously saved boosts remain usable.")
 Shop.Tick()
end
function Shop.ColorMixer(data,ui,action)
 local revision=generation
 local c=ui.card(292);c.Name="ColorMixer";stroke(c,violet)
 ui.label(c,"SIGNATURE COLOR",UDim2.new(1,-32,0,28),UDim2.fromOffset(16,12),20,violet)
 ui.label(c,data.spectrumPass and "Choose a hue, then equip it. Saved shades stay unchanged until you move the hue control." or "Preview a hue. Spectrum is required to equip it; yellow is the base color.",UDim2.new(1,-32,0,60),UDim2.fromOffset(16,44),14,soft)
 -- Preserve a saved custom shade exactly until an explicit hue edit.
 local color=data.customColor and Color3.fromHex(data.customColor) or Config.Auras[data.aura] or Config.Auras.Gold
 local hue=color:ToHSV()
 ui.label(c,"HUE",UDim2.new(1,-32,0,20),UDim2.fromOffset(16,110),12,soft)
 local bar=ui.frame(c,"HUE",UDim2.new(1,-32,0,44),UDim2.fromOffset(16,134),Color3.new(1,1,1));bar.Active=true
 local colors={};for j=0,6 do table.insert(colors,ColorSequenceKeypoint.new(j/6,Color3.fromHSV(j/6,1,1))) end
 gradient(bar,colors)
 local knob=ui.frame(bar,"Thumb",UDim2.fromOffset(10,44),UDim2.new(),Color3.new(1,1,1));stroke(knob,ink)
 local code=ui.label(c,"",UDim2.new(1,-32,0,24),UDim2.fromOffset(16,186),13,soft);code.Name="SelectedColor"
 local function update()
  code.Text="Selected color #"..color:ToHex():upper()
  knob.Position=UDim2.new(hue,-10*hue,.5,-22)
 end
 local dragInput
 local function setHue(input)
  hue=math.clamp((input.Position.X-bar.AbsolutePosition.X)/math.max(1,bar.AbsoluteSize.X),0,1)
  color=Color3.fromHSV(hue,1,1);update()
 end
 table.insert(connections,bar.InputBegan:Connect(function(input)
  if revision~=generation or dragInput then return end
  if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
   dragInput=input;setHue(input)
  end
 end))
 table.insert(connections,UIS.InputChanged:Connect(function(input)
  if revision==generation and dragInput and (input==dragInput or input.UserInputType==Enum.UserInputType.MouseMovement and dragInput.UserInputType==Enum.UserInputType.MouseButton1) then setHue(input) end
 end))
 table.insert(connections,UIS.InputEnded:Connect(function(input) if input==dragInput then dragInput=nil end end))
 local equip=ui.button(c,"EquipCustom",data.spectrumPass and "EQUIP COLOR" or "PASS REQUIRED",UDim2.new(1,-32,0,44),UDim2.fromOffset(16,232),function()
  if revision==generation and data.spectrumPass then action:FireServer("SetCustomColor",color:ToHex()) end
 end,ink);equip.TextSize=13;stroke(equip,violet)
 update()
end
return Shop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="66">
        <Properties>
          <string name="Name">SustainedBeams</string>
          <string name="Source"><![CDATA[-- Bounded client visual lifetime, independent of damage and microphone input.
local Beams={}
Beams.__index=Beams
Beams.Limit=24
Beams.Timeout=.5

function Beams.new(create,update,destroy)
 return setmetatable({create=create,update=update,destroy=destroy,entries={},count=0},Beams)
end
function Beams:Remove(id)
 local entry=self.entries[id]
 if not entry then return end
 self.entries[id]=nil
 self.count-=1
 self.destroy(entry.visual)
end
function Beams:Expire(now)
 for id,entry in pairs(self.entries) do
  if now>=entry.expires then self:Remove(id) end
 end
end
function Beams:Update(id,now,...)
 if self.destroyed then return false end
 local entry=self.entries[id]
 if not entry then
  if self.count>=Beams.Limit then self:Expire(now) end
  if self.count>=Beams.Limit then return false end
  entry={visual=self.create()}
  self.entries[id]=entry
  self.count+=1
 end
 entry.expires=now+Beams.Timeout
 self.update(entry.visual,...)
 return true
end
function Beams:Clear()
 for id in pairs(self.entries) do self:Remove(id) end
end
function Beams:Destroy()
 if self.destroyed then return end
 self.destroyed=true
 self:Clear()
end
return Beams
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="67">
        <Properties>
          <string name="Name">SustainedControls</string>
          <string name="Source"><![CDATA[-- Local prototype input. Roblox transports voice independently; only power and
-- aim are sent here. Server acceptance, damage and cooldown stay authoritative.
local Controls={}
Controls.__index=Controls
local PULSE_INTERVAL=.125
local ACK_TIMEOUT=.4
local MIN_PULSE_POWER=.08

function Controls.new(gate,send,getAim,onArmedChanged)
 return setmetatable({gate=gate,send=send,getAim=getAim,onArmedChanged=onArmedChanged,armed=false,sequence=0},Controls)
end
function Controls:Cancel()
 self.gate:Cancel()
 local attack=self.attack
 self.attack=nil
 if attack then self.send("SustainedStop",attack.sequence) end
end
function Controls:SetArmed(armed)
 if self.destroyed then return end
 if self.armed==armed then return end
 self.armed=armed
 self:Cancel()
 if self.onArmedChanged then self.onArmedChanged(armed) end
end
-- Auto-arm only on the first valid calibration. A mute, death or explicit pause
-- requires a deliberate resume; returning focus must never silently re-arm.
function Controls:ObserveAvailability(available,autoArmAllowed)
 if self.destroyed then return end
 if not available then self:SetArmed(false);return end
 if not self.initialized then self.initialized=true;self:SetArmed(autoArmAllowed~=false) end
end
function Controls:Step(dt,now,power,allowed,ready,active,serverSequence)
 if self.destroyed then return end
 if not self.armed or not allowed or not ready then self:Cancel();return end
 local attack=self.attack
 if attack then
  if active and serverSequence==attack.sequence then
   attack.acknowledged=true;self.unconfirmedUntil=0
  elseif attack.acknowledged then
   self.attack=nil;self.gate:Cancel();return
  elseif now>=attack.ackDeadline then
   self.unconfirmedUntil=now+2;self:Cancel();return
  end
 elseif active then
  self.gate:Cancel();return
 end
 local transition=self.gate:Step(dt,power,self.armed,allowed,ready)
 if transition=="stop" then self:Cancel();return end
 if transition=="start" then
  local aim=self.getAim()
  if not aim then self:Cancel();return end
  self.unconfirmedUntil=0;self.sequence+=1
  self.attack={sequence=self.sequence,sample=0,nextPulse=now+PULSE_INTERVAL,ackDeadline=now+ACK_TIMEOUT}
  self.send("SustainedBegin",{sequence=self.sequence,power=power,aim=aim})
 elseif attack and attack.acknowledged and now>=attack.nextPulse and power>=MIN_PULSE_POWER then
  local aim=self.getAim()
  if not aim then self:Cancel();return end
  attack.sample+=1;attack.nextPulse=now+PULSE_INTERVAL
  self.send("SustainedPulse",{sequence=attack.sequence,sample=attack.sample,power=power,aim=aim})
 end
end
function Controls:Destroy()
 if self.destroyed then return end
 self.destroyed=true;self.armed=false
 self:Cancel()
end
return Controls
]]></string>
        </Properties>
      </Item>
