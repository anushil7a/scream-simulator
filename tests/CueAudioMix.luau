local Mix=require("../src/StarterPlayer/StarterPlayerScripts/CueAudioMix")
local config=require("../src/ReplicatedStorage/Shared/GameplayAudioConfig")
local checks=0;local function check(ok,msg)assert(ok,msg);checks+=1 end
check(not config.Ready(),"Unapproved assets became active")
for kind in pairs(config.Cues) do check(config.Asset(kind)==nil,"An unapproved asset was configured") end
local handles={};local created=0;local removed=0
local function new(settings)
 return Mix.new(settings,function(kind,position)
  created+=1;local h={kind=kind,position=position,volume=0};table.insert(handles,h);return h
 end,function(h,volume)h.volume=volume end,function(h)
  check(not h.destroyed,"Double destruction");h.destroyed=true;removed+=1
 end)
end
local unavailable=new(config)
check(not unavailable:Play("Hit",0) and created==0,"Unconfigured cue allocated")
local settings=table.clone(config);settings.Asset=function(kind)return settings.Cues[kind] and "rbxassetid://123" end
local mix=new(settings)
check(not mix:Play("Missing",0) and not mix:Play("Hit",0/0),"Invalid cue/time accepted")
check(not mix:Play("Dodge",0),"Spatial cue accepted without a position")
check(mix:Play("Hit",0),"Hit cue not accepted")
check(handles[1].volume>0 and handles[1].volume<=config.TotalVolume,"Short cue waited for a render frame")
mix:Step(.05,.05)
check(handles[1].volume>0 and handles[1].volume<=config.TotalVolume,"Hit cue escaped gain cap")
check(not mix:Play("Hit",.1),"Hit cooldown allowed rapid ticks")
check(mix:Play("Dodge",.05,10),"Dodge cue not accepted")
mix:Step(.08,.03)
local function volume()local v=0;for _,h in ipairs(handles)do if not h.destroyed then v+=h.volume end end;return v end
check(volume()<=config.TotalVolume+.000001,"Overlaps multiplied gain")
mix:SetContext(true,false);mix:Step(.1,.02)
check(volume()<=config.TotalVolume*config.VoiceDuck+.000001,"Voice ducking not immediate")
mix:SetContext(false,false);mix:Step(.12,.02)
check(volume()>config.TotalVolume*config.VoiceDuck,"Duck did not recover")
mix:SetContext(false,true)
check(#mix.entries==0 and not mix:Play("Break",.2,10),"Calibration retained or created sound")
mix:SetContext(false,false)
check(mix:Play("Break",1,10),"Suppression permanently disabled sound")
mix:SetEnabled(false);check(#mix.entries==0 and not mix:Play("Hit",2),"Mute retained or recreated sound")
mix:SetEnabled(true);check(mix:Play("Hit",3),"Unmute failed")
mix:Step(4,1);check(#mix.entries==0,"Lost Ended signal leaked a cue")
local observed=new(settings)
check(not observed:ObserveLevel(50,false,0),"Initial profile triggered a reward")
check(not observed:ObserveLevel(50,false,1),"Repeated state triggered a reward")
check(observed:ObserveLevel(51,false,2),"Earned level did not cue")
check(not observed:ObserveLevel(52,false,2.1),"Multiple syncs ignored cooldown")
check(not observed:ObserveLevel(1,false,3),"Progress reset played reward")
check(not observed:ObserveLevel(100,true,4),"Temporary test level played reward")
check(not observed:ObserveLevel(2,false,5),"Exit from temporary session played reward")
check(not observed:ObserveLevel(101,false,6) and not observed:ObserveLevel(0/0,false,6),"Invalid level accepted")
observed:Clear()
observed:SetEnabled(false)
check(not observed:ObserveLevel(3,false,10),"Muted level gain played")
observed:SetEnabled(true)
check(not observed:ObserveLevel(3,false,11),"Muted level gain played late")
observed:SetContext(false,true)
check(not observed:ObserveLevel(4,false,12),"Calibrating level gain played")
observed:SetContext(false,false)
check(not observed:ObserveLevel(4,false,13),"Suppressed level gain played late")
local crowdedSettings=table.clone(settings);crowdedSettings.Cues={}
for kind,cue in pairs(settings.Cues)do crowdedSettings.Cues[kind]=table.clone(cue);crowdedSettings.Cues[kind].Cooldown=0 end
crowdedSettings.Asset=function(kind)return crowdedSettings.Cues[kind] and "rbxassetid://123" end
local crowded=new(crowdedSettings)
for _=1,config.Limit do check(crowded:Play("Hit",10),"Reached cap too early") end
check(not crowded:Play("Hit",10),"Exceeded simultaneous source cap")
crowded:Step(10.05,.05);check(volume()<=config.TotalVolume+.000001,"Dense cue budget exceeded")
crowded:Step(11,1);check(#crowded.entries==0,"Dense cues leaked")
mix:Clear();mix:Clear();mix:Destroy();mix:Destroy();mix:SetEnabled(true)
check(not mix:Play("Hit",20),"Destroyed mixer recreated audio")
observed:Destroy();crowded:Destroy();unavailable:Destroy()
check(created==removed,"Not all cue handles were cleaned up")
print("PASS "..checks.." gameplay cue mixer checks; synthetic handles, no playback evidence")
