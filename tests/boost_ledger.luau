local L=require("../src/ReplicatedStorage/Shared/BoostLedger")
local n=0;local function check(ok,msg) assert(ok,msg);n+=1 end
local d=L.Normalize(nil)
check(L.Multiplier(d,"xp",100)==1,"Default is paid")
check(L.Grant(d,"r","invalid")==nil,"Unknown product granted")
d=L.Grant(d,"receipt-1","xp")
check(d.inventory.xp==1,"Receipt missing")
d=L.Grant(d,"receipt-1","xp")
check(d.inventory.xp==1,"Receipt delivered twice")
d=L.Activate(d,"xp","operation-1",100,100)
check(d.inventory.xp==0 and d.ends.xp==1900,"Activation wrong")
d=L.Activate(d,"xp","operation-1",100,101)
check(d.ends.xp==1900 and d.inventory.xp==0,"Ambiguous activation retry spent twice")
check(L.Activate(d,"xp","operation-2",100,100)==nil,"Empty inventory activated")
check(L.Multiplier(d,"xp",1899)==2 and L.Multiplier(d,"xp",1900)==1,"Expiry boundary wrong")
check(L.Multiplier(L.Normalize(d),"xp",2000)==1,"Offline/rejoin paused expiry")
d=L.Grant(d,"receipt-2","xp");d=L.Activate(d,"xp","operation-3",110,110)
check(d.ends.xp==3700 and L.Multiplier(d,"xp",110)==2,"Stacking changed multiplier")
d=L.Grant(d,"receipt-3","coins");d=L.Activate(d,"coins","operation-4",5000,5000)
check(d.ends.coins==6800 and L.Multiplier(d,"xp",5000)==1 and L.Multiplier(d,"coins",5000)==2,"Types not independent")
check(L.Activate(d,"xp","stale",100,161)==nil,"Expired operation replayed")
local full=L.Normalize(nil)
for i=1,L.ReceiptLimit do full.receipts[tostring(i)]=true end
check(L.Grant(full,"new","xp")==nil,"Ledger capacity unbounded")
check(L.Grant(full,"1","xp")~=nil,"Old receipt forgotten at capacity")
print("PASS "..n.." boost receipt, activation, offline expiry and capacity checks")
