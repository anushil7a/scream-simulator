local L=require("../src/ReplicatedStorage/Shared/BoostLedger")
local n=0;local function check(ok,msg) assert(ok,msg);n+=1 end
local d=L.Normalize(nil)
check(L.Multiplier(d,"xp",100)==1,"Default is paid")
check(L.Grant(d,"r","invalid")==nil,"Unknown product granted")
d=L.Grant(d,"receipt-1","xp")
check(d.inventory.xp==1,"Receipt missing")
d=L.Grant(d,"receipt-1","xp")
check(d.inventory.xp==1,"Receipt delivered twice")
d=L.Activate(d,"xp","operation-1",100,100)
check(d.inventory.xp==0 and d.ends.xp==1900,"Activation wrong")
d=L.Activate(d,"xp","operation-1",100,101)
check(d.ends.xp==1900 and d.inventory.xp==0,"Ambiguous activation retry spent twice")
check(L.Activate(d,"xp","operation-2",100,100)==nil,"Empty inventory activated")
check(L.Multiplier(d,"xp",1899)==2 and L.Multiplier(d,"xp",1900)==1,"Expiry boundary wrong")
check(L.Multiplier(L.Normalize(d),"xp",2000)==1,"Offline/rejoin paused expiry")
d=L.Grant(d,"receipt-2","xp");d=L.Activate(d,"xp","operation-3",110,110)
check(d.ends.xp==3700 and L.Multiplier(d,"xp",110)==2,"Stacking changed multiplier")
d=L.Grant(d,"receipt-3","coins");d=L.Activate(d,"coins","operation-4",5000,5000)
check(d.ends.coins==6800 and L.Multiplier(d,"xp",5000)==1 and L.Multiplier(d,"coins",5000)==2,"Types not independent")
check(L.Activate(d,"xp","stale",100,161)==nil,"Expired operation replayed")
local full=L.Normalize(nil)
for i=1,L.ReceiptLimit do full.receipts[tostring(i)]=true end
check(L.Grant(full,"new","xp")==nil,"Ledger capacity unbounded")
check(L.Grant(full,"1","xp")~=nil,"Old receipt forgotten at capacity")

-- Automatic purchase delivery records id and time together, without inventory conversion.
local seed=L.Grant(nil,"saved","xp")
local active,status=L.GrantActive(seed,"auto","xp",100)
check(status=="activated" and active.ends.xp==1900 and active.inventory.xp==1,"Automatic grant missing")
check(seed.ends.xp==0 and not seed.receipts.auto,"Transaction mutated input")
local repeated=L.GrantActive(active,"auto","xp",500)
check(repeated.ends.xp==1900 and repeated.inventory.xp==1,"Automatic duplicate extended time")
local expired=L.GrantActive(active,"auto","xp",5000)
check(expired.ends.xp==1900 and L.Multiplier(expired,"xp",5000)==1,"Expired duplicate restarted")
local old=L.GrantActive(seed,"saved","xp",100)
check(old.inventory.xp==1 and old.ends.xp==0,"Historical receipt converted existing token")
local second=L.GrantActive(active,"auto2","xp",200)
check(second.ends.xp==3700 and L.Multiplier(second,"xp",200)==2,"Stack changed multiplier")
local coin=L.GrantActive(second,"coin","coins",250)
check(coin.ends.coins==2050 and coin.ends.xp==3700,"Cross-type deadline changed")
check(L.Multiplier(coin,"coins",2049)==2 and L.Multiplier(coin,"coins",2050)==1,"Automatic expiry boundary")
local late=L.GrantActive(coin,"late","xp",5000.9)
check(late.ends.xp==6800,"Post-expiry start or timestamp precision wrong")
local normalized=L.Normalize(coin)
check(normalized.ends.xp==3700 and L.Multiplier(normalized,"xp",4000)==1,"Reload paused timer")
check(L.GrantActive(nil,nil,"xp",100)==nil,"Missing receipt accepted")
check(L.GrantActive(nil,"","xp",100)==nil,"Empty receipt accepted")
check(L.GrantActive(nil,string.rep("a",129),"xp",100)==nil,"Oversize receipt accepted")
check(L.GrantActive(nil,7,"xp",100)==nil,"Numeric receipt accepted")
check(L.GrantActive(nil,"bad","bad",100)==nil,"Unknown boost accepted")
check(L.GrantActive(nil,"bad","xp",nil)==nil,"Missing time accepted")
for _,now in ipairs({-1,math.huge,-math.huge,0/0,L.MaxExpiry}) do
 check(L.GrantActive(nil,"bad","xp",now)==nil,"Invalid time accepted")
end
check(L.GrantActive(full,"new","xp",100)==nil,"Active receipt cap ignored")
check(L.GrantActive(full,"1","xp",100)~=nil,"Old active receipt forgotten at cap")
local boundary=L.GrantActive(nil,"edge","xp",L.MaxExpiry-L.Duration)
check(boundary.ends.xp==L.MaxExpiry,"Exact expiry bound rejected")
check(L.GrantActive(boundary,"overflow","xp",100)==nil,"Stacking exceeded expiry storage bound")
check(L.GrantActive(boundary,"edge","xp",100)~=nil,"Duplicate at expiry cap rejected")
local legacyFull={inventory={xp=1000000}}
local notInventory=L.GrantActive(legacyFull,"auto","xp",100)
check(notInventory.inventory.xp==1000000 and notInventory.ends.xp==1900,"Legacy inventory cap blocked automatic purchase")
print("PASS "..n.." pure boost receipt, activation, offline expiry and capacity checks")
