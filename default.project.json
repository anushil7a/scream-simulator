{
  "name": "ScreamSimulator",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/ServerScriptService"
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts",
        "$path": "src/StarterPlayer/StarterCharacterScripts"
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/StarterPlayer/StarterPlayerScripts"
      }
    },
    "VoiceChatService": {
      "$className": "VoiceChatService",
      "$properties": {
        "UseAudioApi": "Enabled",
        "EnableDefaultVoice": true
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 64,
        "StreamingTargetRadius": 512,
        "StreamOutBehavior": "Opportunistic",
        "StreamingIntegrityMode": "PauseOutsideLoadedArea"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "MosaicFountainTemplate": {
        "$path": "assets/review/MosaicFountain.rbxmx"
      }
    }
  }
}
